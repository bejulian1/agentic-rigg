#: crates/rigg-core/src/hjelper.rs:401
msgid "Effekt"
msgstr "Leistung"

#: crates/rigg-core/src/hjelper.rs:402
msgid "Vifter"
msgstr "Lüfter"

#: crates/rigg-core/src/hjelper.rs:403
msgid "Klokker"
msgstr "Takt"

#: crates/rigg-core/src/hjelper.rs:404
msgid "RGB-lys"
msgstr "RGB-Beleuchtung"

#: crates/rigg-core/src/hjelper.rs:409
msgid "Trinnet «{one}» er ikke godkjent. Godkjenn det i Innstillinger › Styring først."
msgstr "„{one}“ ist nicht freigegeben. Aktiviere die Funktion zuerst unter Einstellungen › GPU-Steuerung."

#: crates/rigg-core/src/hjelper.rs:410
msgid "Trinnene {steps} er ikke godkjent. Godkjenn dem i Innstillinger › Styring først."
msgstr "{steps} sind nicht freigegeben. Aktiviere sie zuerst unter Einstellungen › GPU-Steuerung."

#: crates/rigg-core/src/hjelper.rs:424
msgid "{felt}: Kortet tillater {min}–{max}. Ingenting er endret."
msgstr "{felt}: Die GPU erlaubt {min}–{max}. Nichts wurde geändert."

#: crates/rigg-core/src/hjelper.rs:427 crates/rigg-core/src/hjelper.rs:528
msgid "Kortet eller driveren støtter ikke denne funksjonen."
msgstr "Die GPU oder der Treiber unterstützt diese Funktion nicht."

#: crates/rigg-core/src/hjelper.rs:435
msgid "Effektgrense"
msgstr "Leistungslimit"

#: crates/rigg-core/src/hjelper.rs:436
msgid "Temperaturmål"
msgstr "Temperaturziel"

#: crates/rigg-core/src/hjelper.rs:437
msgid "GPU-justering"
msgstr "GPU-Takt-Offset"

#: crates/rigg-core/src/hjelper.rs:438
msgid "Minnejustering"
msgstr "Speichertakt-Offset"

#: crates/rigg-core/src/hjelper.rs:439
msgid "Viftefart"
msgstr "Lüfterdrehzahl"

#: crates/rigg-core/src/hjelper.rs:440
msgid "Temperaturen i kurven"
msgstr "Temperatur in der Lüfterkurve"

#: crates/rigg-core/src/hjelper.rs:441
msgid "Viftefarten i kurven"
msgstr "Drehzahl in der Lüfterkurve"

#: crates/rigg-core/src/hjelper.rs:456
msgid "Kan ikke lagre gjenopprettingsmerkør før endring: {feil}"
msgstr "Die Wiederherstellungsmarkierung konnte vor der Änderung nicht gespeichert werden: {feil}"

#: crates/rigg-core/src/hjelper.rs:459
msgid "Kortet ble gjenopprettet, men merkøren kunne ikke ryddes: {feil}"
msgstr "Die GPU-Einstellungen wurden wiederhergestellt, aber die Wiederherstellungsmarkierung konnte nicht entfernt werden: {feil}"

#: crates/rigg-core/src/hjelper.rs:462
msgid "Fikk ikke kontakt med hjelperen ({feil})"
msgstr "Keine Verbindung zum Hilfsdienst ({feil})"

#: crates/rigg-core/src/hjelper.rs:465
msgid "Hjelperen svarte ikke ({feil})"
msgstr "Der Hilfsdienst hat nicht geantwortet ({feil})"

#: crates/rigg-core/src/hjelper.rs:468
msgid "Hjelperen tok ikke imot ({feil})"
msgstr "Der Hilfsdienst hat die Anfrage nicht angenommen ({feil})"

#: crates/rigg-core/src/hjelper.rs:479
msgid "celsius må være 0–120"
msgstr "celsius muss zwischen 0 und 120 liegen"

#: crates/rigg-core/src/hjelper.rs:480
msgid "RGB-backenden er ikke identifisert eller tilgjengelig."
msgstr "Das RGB-Backend wurde nicht erkannt oder ist nicht verfügbar."

#: crates/rigg-core/src/hjelper.rs:481
msgid "Viftestyring krever en lesbar temperatur for overtemperaturvernet."
msgstr "Für den Überhitzungsschutz der Lüftersteuerung muss die Temperatur lesbar sein."

#: crates/rigg-core/src/hjelper.rs:482
msgid "Nødregelen gjelder. Vent til kortet er under 80 °C."
msgstr "Die Notkühlung ist aktiv. Warte, bis die GPU unter 80 °C liegt."

#: crates/rigg-core/src/hjelper.rs:483
msgid "Endringer er låst: endring av skjermkortet er ikke slått på. Slå på «Tillat endring av skjermkortet» i Innstillinger › Styring."
msgstr "Änderungen sind gesperrt, weil die GPU-Steuerung aus ist. Aktiviere „GPU-Einstellungen ändern“ unter Einstellungen › GPU-Steuerung."

#: crates/rigg-core/src/hjelper.rs:484
msgid "Hjelperen for endring svarer ikke. Se Innstillinger › Styring."
msgstr "Der GPU-Hilfsdienst antwortet nicht. Siehe Einstellungen › GPU-Steuerung."

#: crates/rigg-core/src/hjelper.rs:485
msgid "Hjelperen er fra en annen versjon av appen. Oppdater systemkomponentene fra Innstillinger › Skjermkortstyring."
msgstr "Der Hilfsdienst stammt aus einer anderen App-Version. Aktualisiere die Systemkomponenten unter Einstellungen › GPU-Steuerung."

#: crates/rigg-core/src/hjelper.rs:486
msgid "Hjelperen er fra en annen versjon av appen. Slå bryteren i Innstillinger › Styring av og på igjen."
msgstr "Der Hilfsdienst stammt aus einer anderen App-Version. Schalte ihn unter Einstellungen › GPU-Steuerung aus und wieder ein."

#: crates/rigg-core/src/hjelper.rs:487
msgid "Hjelperen og tjenesten bruker ulike kort (simulert og ekte). Ingenting er sendt."
msgstr "Hilfsdienst und Dienst verwenden unterschiedliche GPUs (simuliert und echt). Es wurde nichts gesendet."

#: crates/rigg-core/src/hjelper.rs:488
msgid "NVML-hjelperen er ikke klar til å endre dette kortet."
msgstr "Der NVML-Hilfsdienst kann diese GPU noch nicht steuern."

#: crates/rigg-core/src/hjelper.rs:489
msgid "Skjermkortstyring må aktiveres med bryteren i Innstillinger."
msgstr "Aktiviere die GPU-Steuerung mit dem Schalter in den Einstellungen."

#: crates/rigg-core/src/hjelper.rs:490 crates/rigg-core/src/hjelper.rs:530
msgid "Det valgte kortet er ikke kortet hjelperen er aktivert for."
msgstr "Der Hilfsdienst wurde für eine andere GPU aktiviert."

#: crates/rigg-core/src/hjelper.rs:491
msgid "Gjenoppretting kunne ikke bekreftes. Nye endringer er sperret."
msgstr "Die Wiederherstellung konnte nicht bestätigt werden. Weitere Änderungen sind gesperrt."

#: crates/rigg-core/src/hjelper.rs:492
msgid "Lys er ikke laget ennå."
msgstr "Die Beleuchtungssteuerung ist noch nicht implementiert."

#: crates/rigg-core/src/hjelper.rs:493
msgid "Endringer er låst. Skriving til skjermkortet er ikke slått på."
msgstr "Änderungen sind gesperrt. Schreibzugriffe auf die GPU sind deaktiviert."

#: crates/rigg-core/src/hjelper.rs:494
msgid "Funksjonen er ikke tilgjengelig på dette kortet."
msgstr "Diese Funktion ist auf dieser GPU nicht verfügbar."

#: crates/rigg-core/src/hjelper.rs:495
msgid "Hjelperen er aktivert for en annen bruker."
msgstr "Der Hilfsdienst ist für einen anderen Benutzer aktiviert."

#: crates/rigg-core/src/hjelper.rs:496
msgid "Hjelperen kjører, men helper.json mangler."
msgstr "Der Hilfsdienst läuft, aber helper.json fehlt."

#: crates/rigg-core/src/hjelper.rs:497
msgid "Gjenopprettingsmerkøren har feil identitet eller utrygg eier/modus."
msgstr "Die Wiederherstellungsmarkierung hat eine falsche Identität, einen unsicheren Eigentümer oder unsichere Zugriffsrechte."

#: crates/rigg-core/src/hjelper.rs:498
msgid "Skjermkortet eller tjenesten svarer ikke. Endringer er låst."
msgstr "Die GPU oder der Dienst antwortet nicht. Änderungen sind gesperrt."

#: crates/rigg-core/src/hjelper.rs:499
msgid "Hjelperen er aktivert for et annet kort. Aktiver styring for kortet som vises."
msgstr "Der Hilfsdienst ist für eine andere GPU aktiviert. Aktiviere die Steuerung für die hier angezeigte GPU."

#: crates/rigg-core/src/hjelper.rs:500
msgid "Valgt kort ble endret mens forespørselen ventet. Svaret brukes ikke på det nye kortet."
msgstr "Die ausgewählte GPU hat sich während der Anfrage geändert. Die Antwort wird nicht für die neue GPU verwendet."

#: crates/rigg-core/src/hjelper.rs:501
msgid "Endringer på skjermkortet er slått av. Aktiver én gang med administratorpassord i Innstillinger › Skjermkortstyring."
msgstr "Die GPU-Steuerung ist aus. Aktiviere sie einmalig mit deinem Administratorpasswort unter Einstellungen › GPU-Steuerung."

#: crates/rigg-core/src/hjelper.rs:502
msgid "Hjelperen er ikke skriveklar for kortet som vises."
msgstr "Der Hilfsdienst ist für Änderungen an dieser GPU nicht bereit."

#: crates/rigg-core/src/hjelper.rs:503
msgid "Dette eldre utkastet mangler opprinnelig grunnlag. Behold det som referanse, eller forkast det og lag et nytt utkast fra kortets verdier."
msgstr "Für diesen älteren Entwurf sind keine Ausgangswerte gespeichert. Behalte ihn als Referenz oder verwirf ihn und erstelle einen neuen Entwurf aus den aktuellen GPU-Werten."

#: crates/rigg-core/src/hjelper.rs:504
msgid "Utkastet tilhører en annen kortidentitet. Velg det opprinnelige kortet, eller forkast utkastet før du lager et nytt."
msgstr "Dieser Entwurf gehört zu einer anderen GPU. Wähle die ursprüngliche GPU oder verwirf den Entwurf, bevor du einen neuen erstellst."

#: crates/rigg-core/src/hjelper.rs:505
msgid "Det finnes ikke noe utkast å bruke."
msgstr "Kein Entwurf zum Anwenden vorhanden."

#: crates/rigg-core/src/hjelper.rs:506
msgid "Ugyldig argument."
msgstr "Ungültiges Argument."

#: crates/rigg-core/src/hjelper.rs:507
msgid "Ukjent skjermkort."
msgstr "Unbekannte GPU."

#: crates/rigg-core/src/hjelper.rs:508
msgid "Kortet eller driveren støtter ikke dette."
msgstr "Die GPU oder der Treiber unterstützt diese Funktion nicht."

#: crates/rigg-core/src/hjelper.rs:509
msgid "Ikke tillatt."
msgstr "Nicht zulässig."

#: crates/rigg-core/src/hjelper.rs:510
msgid "En annen klient har en endring som venter."
msgstr "Bei einem anderen Client steht eine Änderung aus."

#: crates/rigg-core/src/hjelper.rs:511
msgid "Ingen endring venter."
msgstr "Keine Änderung ausstehend."

#: crates/rigg-core/src/hjelper.rs:512
msgid "Endringen finnes ikke lenger."
msgstr "Die Änderung existiert nicht mehr."

#: crates/rigg-core/src/hjelper.rs:513
msgid "Bare klienten som gjorde endringen, kan bekrefte den."
msgstr "Nur der Client, der die Änderung vorgenommen hat, kann sie bestätigen."

#: crates/rigg-core/src/hjelper.rs:514
msgid "Tjenesten stopper."
msgstr "Der Dienst wird beendet."

#: crates/rigg-core/src/hjelper.rs:515
msgid "Feil i tjenesten."
msgstr "Dienstfehler."

#: crates/rigg-core/src/hjelper.rs:516
msgid "Ikke tilgjengelig nå."
msgstr "Derzeit nicht verfügbar."

#: crates/rigg-core/src/hjelper.rs:517
msgid "Trinnet er ikke godkjent."
msgstr "Dieser Schritt ist nicht freigegeben."

#: crates/rigg-core/src/hjelper.rs:518
msgid "Kortets standardtilstand kunne ikke bekreftes ved tilbakelesing."
msgstr "Die Werkseinstellungen der GPU konnten durch Auslesen nicht bestätigt werden."

#: crates/rigg-core/src/hjelper.rs:519
msgid "Hjelperen lukket forbindelsen"
msgstr "Der Hilfsdienst hat die Verbindung getrennt"

#: crates/rigg-core/src/hjelper.rs:520
msgid "For stort svar fra hjelperen"
msgstr "Die Antwort des Hilfsdienstes ist zu groß"

#: crates/rigg-core/src/hjelper.rs:521
msgid "Tjenesten svarte ikke på 5 s."
msgstr "Der Dienst hat nicht innerhalb von 5 s geantwortet."

#: crates/rigg-core/src/hjelper.rs:529
msgid "Driveren ga ikke tilgang til å endre kortet."
msgstr "Der Treiber verweigert die Änderung der GPU-Einstellungen."

#: crates/rigg-core/src/hjelper.rs:531
msgid "Kortet svarer ikke."
msgstr "Die GPU antwortet nicht."

#: crates/rigg-core/src/hjelper.rs:532
msgid "Kortets innstillinger kunne ikke bekreftes ved tilbakelesing."
msgstr "Die GPU-Einstellungen konnten beim Auslesen nicht bestätigt werden."

#: crates/rigg-core/src/hjelper.rs:533
msgid "De opprinnelige innstillingene for kortet mangler."
msgstr "Die ursprünglichen GPU-Einstellungen fehlen."

#: crates/rigg-core/src/hjelper.rs:534
msgid "Kortet må gjenopprettes før nye endringer."
msgstr "Die GPU muss vor weiteren Änderungen wiederhergestellt werden."

#: crates/rigg-core/src/hjelper.rs:535
msgid "NVML avviste en ugyldig verdi."
msgstr "NVML hat einen ungültigen Wert abgelehnt."

#: crates/rigg-core/src/hjelper.rs:536
msgid "En NVML-operasjon mislyktes."
msgstr "Ein NVML-Vorgang ist fehlgeschlagen."
