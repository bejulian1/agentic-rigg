#: crates/rigg/src/settings/sidefelt.rs:31
msgid "Verdier i statusblokken, i rekkefølge"
msgstr "Werte im Statusblock, in Reihenfolge"

#: crates/rigg/src/settings/sidefelt.rs:36
msgid "Statusblokken er tom"
msgstr "Statusblock ist leer"

#: crates/rigg/src/settings/sidefelt.rs:37
msgid "Legg til verdier her, eller fest sensorer med nålen på Sensorer."
msgstr "Füge hier Werte hinzu oder hefte Sensoren auf der Seite Sensoren an."

#: crates/rigg/src/settings/sidefelt.rs:54
msgid "{nr} av {totalt}: {navn}. Alt+pil opp eller ned flytter."
msgstr "{nr} von {totalt}: {navn}. Alt+Pfeil hoch/runter zum Verschieben."

#: crates/rigg/src/settings/sidefelt.rs:59
msgid "Skjermkort"
msgstr "Grafikkarte"

#: crates/rigg/src/settings/sidefelt.rs:60
msgid "Prosessor"
msgstr "Prozessor"

#: crates/rigg/src/settings/sidefelt.rs:61
msgid "Minne"
msgstr "Speicher"

#: crates/rigg/src/settings/sidefelt.rs:62
msgid "Nett (alle kort)"
msgstr "Netzwerk (alle Adapter)"

#: crates/rigg/src/settings/sidefelt.rs:63
msgid "Disker"
msgstr "Laufwerke"

#: crates/rigg/src/settings/sidefelt.rs:64
msgid "Andre sensorer"
msgstr "Andere Sensoren"

#: crates/rigg/src/settings/sidefelt.rs:66
msgid "{kilde} · i sidefeltet: {etikett}"
msgstr "{kilde} · in Seitenleiste: {etikett}"

#: crates/rigg/src/settings/sidefelt.rs:71
msgid "Fjern fra statusblokken"
msgstr "Aus Statusblock entfernen"

#: crates/rigg/src/settings/sidefelt.rs:72
msgid "Fjern {navn}"
msgstr "{navn} entfernen"

#: crates/rigg/src/settings/sidefelt.rs:136
msgid "Legg til verdi …"
msgstr "Wert hinzufügen …"

#: crates/rigg/src/settings/sidefelt.rs:140
msgid "Statusblokken er full ({antall} av {maks}). Fjern en verdi først."
msgstr "Statusblock ist voll ({antall} von {maks}). Entferne zuerst einen Wert."

#: crates/rigg/src/settings/sidefelt.rs:149
msgid "{antall} av {maks}"
msgstr "{antall} von {maks}"

#: crates/rigg/src/settings/sidefelt.rs:151
msgid "Statusblokken"
msgstr "Statusblock"

#: crates/rigg/src/settings/sidefelt.rs:153
msgid "Verdiene nederst i sidefeltet, i denne rekkefølgen. Velg en rad og bruk Alt+↑/↓ for å flytte. Fest flere fra Sensorer med nålen."
msgstr "Werte unten in der Seitenleiste, in dieser Reihenfolge. Zeile wählen und mit Alt+↑/↓ verschieben. Weitere unter Sensoren anheften."

#: crates/rigg/src/settings/sidefelt.rs:156
msgctxt "søkeord"
msgid "status nederst rekkefølge fest sensor verdier"
msgstr "status unten reihenfolge anheften sensor werte"

#: crates/rigg/src/settings/sidefelt.rs:170
msgid "Søk etter verdi"
msgstr "Nach Wert suchen"

#: crates/rigg/src/settings/sidefelt.rs:186
msgid "Faste verdier"
msgstr "Feste Werte"

#: crates/rigg/src/settings/sidefelt.rs:203
msgid "Lagt til"
msgstr "Hinzugefügt"

#: crates/rigg/src/settings/sidefelt.rs:219
msgid "Ingen verdi heter «{sok}»"
msgstr "Kein Wert passt zu „{sok}“"

#: crates/rigg/src/settings/sidefelt.rs:235
msgid "Full"
msgstr "Ausgeklappt"

#: crates/rigg/src/settings/sidefelt.rs:235
msgid "Ikonlist"
msgstr "Symbolleiste"

#: crates/rigg/src/settings/sidefelt.rs:235
msgid "Bredde på sidefeltet"
msgstr "Breite der Seitenleiste"

#: crates/rigg/src/settings/sidefelt.rs:244
msgid "Vinduet er smalt, så sidefeltet er en ikonlist nå. Valget gjelder i bredere vinduer."
msgstr "Schmale Fenster zeigen nur Symbole. Diese Einstellung gilt für breitere Fenster."

#: crates/rigg/src/settings/sidefelt.rs:246
msgid "Ikonlista viser bare ikoner og korte tall. Også Ctrl+B og knappen nederst i sidefeltet."
msgstr "Die Symbolleiste zeigt nur Symbole und kurze Werte. Auch mit Strg+B oder unten in der Seitenleiste."

#: crates/rigg/src/settings/sidefelt.rs:264
msgid "Minst én side må vises"
msgstr "Mindestens eine Seite muss sichtbar sein"

#: crates/rigg/src/settings/sidefelt.rs:279
msgid "Visning"
msgstr "Anzeige"

#: crates/rigg/src/settings/sidefelt.rs:282
msgid "Bredde"
msgstr "Breite"

#: crates/rigg/src/settings/sidefelt.rs:282
msgctxt "søkeord"
msgid "ikonlist legg sammen utvid smal"
msgstr "symbolleiste einklappen erweitern schmal breite"

#: crates/rigg/src/settings/sidefelt.rs:283
msgid "Sparklinjer"
msgstr "Minidiagramme"

#: crates/rigg/src/settings/sidefelt.rs:283
msgid "Liten graf for siste minutt ved hver verdi i statusblokken."
msgstr "Kleines Diagramm der letzten Minute neben jedem Wert im Statusblock."

#: crates/rigg/src/settings/sidefelt.rs:283
msgctxt "søkeord"
msgid "statusblokk graf"
msgstr "statusblock diagramm minidiagramm sparkline"

#: crates/rigg/src/settings/sidefelt.rs:289
msgid "Sider"
msgstr "Seiten"

#: crates/rigg/src/settings/sidefelt.rs:290
msgid "Sidene i sidefeltet. Skjulte sider kan fortsatt åpnes med hurtigtasten."
msgstr "Seiten in der Seitenleiste. Ausgeblendete Seiten bleiben per Tastenkürzel erreichbar."

#: crates/rigg/src/settings/sidefelt.rs:290
msgctxt "søkeord"
msgid "skjul vis navigasjon"
msgstr "ausblenden anzeigen navigation seiten"

#: crates/rigg/src/settings/sidefelt.rs:293
msgid "Vis hurtigtaster"
msgstr "Tastenkürzel anzeigen"

#: crates/rigg/src/settings/sidefelt.rs:293
msgid "Tallene 1–8 ved sidene. Ellers står de i verktøytipset og under Tastatursnarveier."
msgstr "Ziffern 1–8 neben den Seiten. Sonst im Tooltip und unter Tastenkürzel sichtbar."

#: crates/rigg/src/settings/sidefelt.rs:293
msgctxt "søkeord"
msgid "taster tall snarvei"
msgstr "tasten ziffern kürzel"
