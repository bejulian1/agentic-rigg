#: crates/rigg/src/settings/styring.rs:45
msgid "Venter på administratorgodkjenning …"
msgstr "Warte auf Administratorfreigabe …"

#: crates/rigg/src/settings/styring.rs:46
msgid "Installerer systemkomponentene …"
msgstr "Systemkomponenten werden installiert …"

#: crates/rigg/src/settings/styring.rs:47
msgid "Tjenesten svarer ikke. Endringer er låst."
msgstr "Der Dienst antwortet nicht. Änderungen sind gesperrt."

#: crates/rigg/src/settings/styring.rs:50
msgid "Styring er klar for det valgte skjermkortet. Endringer brukes først når du trykker Bruk."
msgstr "Die ausgewählte GPU ist bereit. Änderungen werden erst mit „Anwenden“ übernommen."

#: crates/rigg/src/settings/styring.rs:51
msgid "Simulert styring. Det ekte skjermkortet endres ikke."
msgstr "Simulierte Steuerung. Die echte GPU bleibt unverändert."

#: crates/rigg/src/settings/styring.rs:52
msgid "Hjelperen er ikke klar for kortet som vises. Se funksjonsstøtten under, eller trykk Sjekk igjen."
msgstr "Der Hilfsdienst ist für diese GPU nicht bereit. Prüfe die unterstützten Funktionen unten oder klicke auf „Erneut prüfen“."

#: crates/rigg/src/settings/styring.rs:53
msgid "Hjelperen må oppdateres. Trykk «Installer systemkomponenter» under; styringen slås på igjen etterpå."
msgstr "Der Hilfsdienst muss aktualisiert werden. Klicke unten auf „Systemkomponenten installieren“; die GPU-Steuerung wird danach wieder eingeschaltet."

#: crates/rigg/src/settings/styring.rs:54
msgid "Systemkomponentene mangler. Slå på bryteren for å installere dem og aktivere styring."
msgstr "Systemkomponenten fehlen. Schalte den Schalter ein, um sie zu installieren und die GPU-Steuerung zu aktivieren."

#: crates/rigg/src/settings/styring.rs:55
msgid "Systemkomponentene mangler eller må oppdateres."
msgstr "Systemkomponenten fehlen oder müssen aktualisiert werden."

#: crates/rigg/src/settings/styring.rs:56
msgid "Bare visning. Endring av skjermkortet er slått av."
msgstr "Nur Überwachung. GPU-Einstellungen können nicht geändert werden."

#: crates/rigg/src/settings/styring.rs:65
msgid "agentic-rigg-helper {versjon} · bygg {bygg}"
msgstr "agentic-rigg-helper {versjon} · Build {bygg}"

#: crates/rigg/src/settings/styring.rs:68
msgid "Simulert kort"
msgstr "Simulierte GPU"

#: crates/rigg/src/settings/styring.rs:68
msgid "Det ekte kortet (NVML)"
msgstr "Echte GPU (NVML)"

#: crates/rigg/src/settings/styring.rs:104
msgid "Avbrutt"
msgstr "Abgebrochen"

#: crates/rigg/src/settings/styring.rs:104
msgid "Passordet ble ikke gitt. Ingenting er endret."
msgstr "Es wurde kein Passwort eingegeben. Nichts wurde geändert."

#: crates/rigg/src/settings/styring.rs:105
msgid "Fant ikke pkexec, eller ingen kan spørre om passordet (polkit)."
msgstr "pkexec fehlt oder polkit kann kein Passwort abfragen."

#: crates/rigg/src/settings/styring.rs:106
msgid "Skriptet feilet."
msgstr "Das Skript ist fehlgeschlagen."

#: crates/rigg/src/settings/styring.rs:127 crates/rigg/src/settings/styring.rs:165
msgid "Hjelperen er installert, men styring er ikke klar"
msgstr "Hilfsdienst installiert, GPU-Steuerung noch nicht bereit"

#: crates/rigg/src/settings/styring.rs:144
msgid "Ingen skjermkort valgt"
msgstr "Keine GPU ausgewählt"

#: crates/rigg/src/settings/styring.rs:148
msgid "Kortidentiteten er ikke klar"
msgstr "GPU-Identität nicht verfügbar"

#: crates/rigg/src/settings/styring.rs:148
msgid "Vent til driveren har lest UUID, og prøv igjen."
msgstr "Warte, bis der Treiber die UUID gelesen hat, und versuche es erneut."

#: crates/rigg/src/settings/styring.rs:155
msgid "Kunne ikke aktivere styring"
msgstr "GPU-Steuerung konnte nicht aktiviert werden"

#: crates/rigg/src/settings/styring.rs:155
msgid "Kunne ikke slå av styring"
msgstr "GPU-Steuerung konnte nicht deaktiviert werden"

#: crates/rigg/src/settings/styring.rs:164
msgid "Skjermkortstyring er aktivert"
msgstr "GPU-Steuerung aktiviert"

#: crates/rigg/src/settings/styring.rs:164
msgid "Velg endringer og trykk Bruk. Behold dem innen fristen, ellers rulles de tilbake."
msgstr "Nimm Änderungen vor und klicke auf „Anwenden“. Klicke vor Ablauf der Frist auf „Beibehalten“, sonst werden sie zurückgesetzt."

#: crates/rigg/src/settings/styring.rs:166
msgid "Skjermkortstyring er slått av"
msgstr "GPU-Steuerung deaktiviert"

#: crates/rigg/src/settings/styring.rs:166
msgid "Hjelperen har gjenopprettet utgangspunktet og tillatelsen er fjernet."
msgstr "Der Hilfsdienst hat den Ausgangszustand wiederhergestellt und die Berechtigung entzogen."

#: crates/rigg/src/settings/styring.rs:175
msgid "Én aktivering"
msgstr "Einmalige Aktivierung"

#: crates/rigg/src/settings/styring.rs:175
msgid "Bruk Tillat endring av skjermkortet. Funksjonsstøtten bestemmes av kortet og driveren."
msgstr "Verwende „GPU-Einstellungen ändern“. Die verfügbaren Funktionen hängen von GPU und Treiber ab."

#: crates/rigg/src/settings/styring.rs:185
msgid "Effektgrense"
msgstr "Leistungslimit"

#: crates/rigg/src/settings/styring.rs:185
msgid "Manuell viftefart og Auto"
msgstr "Manuelle und automatische Lüfterdrehzahl"

#: crates/rigg/src/settings/styring.rs:185
msgid "Viftekurve"
msgstr "Lüfterkurve"

#: crates/rigg/src/settings/styring.rs:185
msgid "Kjerneklokke"
msgstr "Kerntakt"

#: crates/rigg/src/settings/styring.rs:185
msgid "Minneklokke"
msgstr "Speichertakt"

#: crates/rigg/src/settings/styring.rs:185
msgid "Temperaturmål"
msgstr "Temperaturziel"

#: crates/rigg/src/settings/styring.rs:187
msgid "Tilgjengelig"
msgstr "Verfügbar"

#: crates/rigg/src/settings/styring.rs:187
msgid "Ikke undersøkt"
msgstr "Nicht geprüft"

#: crates/rigg/src/settings/styring.rs:187
msgid "Utilgjengelig"
msgstr "Nicht verfügbar"

#: crates/rigg/src/settings/styring.rs:190
msgid "Leses når administratorhjelperen aktiveres for dette kortet."
msgstr "Wird geprüft, wenn der Hilfsdienst für diese GPU aktiviert wird."

#: crates/rigg/src/settings/styring.rs:200
msgid "Kortets rapporterte område: {omraade}."
msgstr "Von der Karte gemeldeter Bereich: {omraade}."

#: crates/rigg/src/settings/styring.rs:202
msgid "Støttes av den tilkoblede hjelperen."
msgstr "Vom verbundenen Hilfsdienst unterstützt."

#: crates/rigg/src/settings/styring.rs:207
msgid "Tilgjengelige funksjoner"
msgstr "Verfügbare Funktionen"

#: crates/rigg/src/settings/styring.rs:208
msgid "Én administratoraktivering gjelder støttede funksjoner på det valgte kortet. Listen er status, ikke ekstra godkjenninger."
msgstr "Eine Administratoraktivierung gilt für die unterstützten Funktionen der ausgewählten GPU. Die Liste zeigt den Status, keine zusätzlichen Freigaben."

#: crates/rigg/src/settings/styring.rs:209
msgid "Funksjoner uten støtte kan ikke brukes på kortet. RGB har egen tillatelse på siden RGB-lys."
msgstr "Nicht unterstützte Funktionen sind auf dieser Karte nicht nutzbar. Die RGB-Beleuchtung hat eine eigene Berechtigung."

#: crates/rigg/src/settings/styring.rs:210
msgctxt "søkeord"
msgid "funksjoner støtte effekt vifter klokker temperatur"
msgstr "Funktionen Unterstützung Leistung Lüfter Takt Temperatur"

#: crates/rigg/src/settings/styring.rs:238 crates/rigg/src/settings/styring.rs:253
msgid "Tillat endring av skjermkortet"
msgstr "GPU-Einstellungen ändern"

#: crates/rigg/src/settings/styring.rs:254
msgid "Gir Agentic Rigg tilgang til støttede GPU-funksjoner via en administratorhjelper. Du blir spurt om passord. Ingen verdier endres før du trykker Bruk på en styringsside."
msgstr "Erlaubt Agentic Rigg über einen Hilfsdienst mit Administratorrechten den Zugriff auf unterstützte GPU-Funktionen. Du wirst nach dem Passwort gefragt. Werte ändern sich erst mit „Anwenden“ auf einer Steuerungsseite."

#: crates/rigg/src/settings/styring.rs:256
msgctxt "søkeord"
msgid "root polkit pkexec hjelper skriving endre overklokking"
msgstr "root polkit pkexec Hilfsdienst schreiben ändern Übertaktung"

#: crates/rigg/src/settings/styring.rs:271
msgid "Venter"
msgstr "Wartet"

#: crates/rigg/src/settings/styring.rs:272
msgid "Klar"
msgstr "Bereit"

#: crates/rigg/src/settings/styring.rs:273
msgid "Simulert"
msgstr "Simuliert"

#: crates/rigg/src/settings/styring.rs:274
msgid "Ikke klar"
msgstr "Nicht bereit"

#: crates/rigg/src/settings/styring.rs:275
msgid "Feil"
msgstr "Fehler"

#: crates/rigg/src/settings/styring.rs:276
msgid "Oppdater hjelper"
msgstr "Hilfsdienst aktualisieren"

#: crates/rigg/src/settings/styring.rs:277
msgid "Av"
msgstr "Aus"

#: crates/rigg/src/settings/styring.rs:289
msgid "Åpne styring"
msgstr "GPU-Steuerung öffnen"

#: crates/rigg/src/settings/styring.rs:295
msgid "Sjekk igjen"
msgstr "Erneut prüfen"

#: crates/rigg/src/settings/styring.rs:306
msgctxt "søkeord"
msgid "systemkomponenter installasjon"
msgstr "Systemkomponenten Installation installieren"

#: crates/rigg/src/settings/styring.rs:309
msgid "Endring av skjermkortet"
msgstr "GPU-Steuerung"

#: crates/rigg/src/settings/styring.rs:311
msgid "Slår du bryteren av, gjenopprettes det lagrede utgangspunktet før tillatelsen fjernes. En feil vises hvis gjenopprettingen ikke kan bekreftes. Slå av styring før avinstallasjon."
msgstr "Beim Ausschalten wird der gespeicherte Ausgangszustand wiederhergestellt, bevor die Berechtigung entzogen wird. Lässt sich die Wiederherstellung nicht bestätigen, erscheint ein Fehler. Deaktiviere die Steuerung vor der Deinstallation."

#: crates/rigg/src/settings/styring.rs:312
msgctxt "søkeord"
msgid "bryter av på status"
msgstr "Schalter aus ein Status"

#: crates/rigg/src/settings/styring.rs:321
msgid "Hjelperen"
msgstr "Hilfsdienst"

#: crates/rigg/src/settings/styring.rs:321
msgid "Et lite program som kjører i bakgrunnen med administratorrettigheter. Det kan bare endre effekt, vifter og klokker, innenfor det kortet selv tillater"
msgstr "Ein kleines Programm, das mit Administratorrechten im Hintergrund läuft. Es ändert nur Leistung, Lüfter und Takt innerhalb der GPU-Grenzen"

#: crates/rigg/src/settings/styring.rs:322
msgid "Passord"
msgstr "Passwort"

#: crates/rigg/src/settings/styring.rs:322
msgid "Én administratorgodkjenning ved aktivering. Vanlige endringer bruker Bruk og Behold"
msgstr "Eine Administratorfreigabe bei der Aktivierung. Für normale Änderungen genügen „Anwenden“ und „Beibehalten“"

#: crates/rigg/src/settings/styring.rs:323
msgid "Hvem"
msgstr "Zugriff"

#: crates/rigg/src/settings/styring.rs:323
msgid "Bare brukeren din. Andre brukere på maskinen slipper ikke til"
msgstr "Nur dein Benutzerkonto. Andere Konten auf dem Rechner haben keinen Zugriff"

#: crates/rigg/src/settings/styring.rs:324
msgid "Vern"
msgstr "Schutz"

#: crates/rigg/src/settings/styring.rs:324
msgid "Endringer rulles tilbake uten Behold innen fristen. Viftekurven har nødregel ved høy temperatur. Frakobling og stopp gjenoppretter utgangspunktet; eventuelle feil rapporteres"
msgstr "Ohne „Beibehalten“ innerhalb der Frist werden Änderungen zurückgesetzt. Für hohe Temperaturen hat die Lüfterkurve eine Notfallregel. Beim Trennen oder Beenden werden die Ausgangswerte wiederhergestellt. Fehler werden gemeldet"

#: crates/rigg/src/settings/styring.rs:325
msgid "Filene"
msgstr "Dateien"

#: crates/rigg/src/settings/styring.rs:325
msgid "{hjelper}\n{konfigurasjon} (bruker, kort og aktivering)"
msgstr "{hjelper}\n{konfigurasjon} (Benutzer, Karte und Aktivierung)"

#: crates/rigg/src/settings/styring.rs:327
msgid "Skriptene"
msgstr "Skripte"

#: crates/rigg/src/settings/styring.rs:329
msgid "Hva bryteren gjør"
msgstr "So funktioniert der Schalter"

#: crates/rigg/src/settings/styring.rs:329
msgctxt "søkeord"
msgid "hjelper root polkit systemd sikkerhet passord"
msgstr "Hilfsdienst root polkit systemd Sicherheit Passwort"

#: crates/rigg/src/settings/styring.rs:331
msgctxt "søkeord"
msgid "hjelper root polkit systemd passord vern frist nødregel"
msgstr "Hilfsdienst root polkit systemd Passwort Schutz Frist Notfallregel"
