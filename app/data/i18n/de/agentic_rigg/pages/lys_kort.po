#: crates/rigg/src/pages/lys_kort.rs:136 crates/rigg/src/pages/lys_kort.rs:500
msgid "Pusting"
msgstr "Atmen"

#: crates/rigg/src/pages/lys_kort.rs:137 crates/rigg/src/pages/lys_kort.rs:501
msgid "Regnbue"
msgstr "Regenbogen"

#: crates/rigg/src/pages/lys_kort.rs:138 crates/rigg/src/pages/lys_kort.rs:502
msgid "Fargesyklus"
msgstr "Farbwechsel"

#: crates/rigg/src/pages/lys_kort.rs:156
msgid "Lysstyringen er opptatt eller tilhører et annet vindu."
msgstr "Die Lichtsteuerung ist belegt oder gehört einem anderen Fenster."

#: crates/rigg/src/pages/lys_kort.rs:157
msgid "Lysprøven finnes ikke lenger eller fristen er ute."
msgstr "Der Beleuchtungstest ist nicht mehr aktiv oder die Frist ist abgelaufen."

#: crates/rigg/src/pages/lys_kort.rs:158
msgid "Nye lysendringer er sperret. Kontroller status og avklar eventuell gjenoppretting."
msgstr "Neue Lichtänderungen sind gesperrt. Prüfe den Status und kläre eine ausstehende Wiederherstellung."

#: crates/rigg/src/pages/lys_kort.rs:159
msgid "RGB-tillatelsen for dette kortet kunne ikke bekreftes."
msgstr "Die RGB-Berechtigung für diese Karte konnte nicht bestätigt werden."

#: crates/rigg/src/pages/lys_kort.rs:160
msgid "Det valgte kortet er ikke tilgjengelig."
msgstr "Die ausgewählte Karte ist nicht verfügbar."

#: crates/rigg/src/pages/lys_kort.rs:161 crates/rigg/src/pages/lys_kort.rs:1468
msgid "RGB-hjelperen støtter ikke dette lysvalget."
msgstr "Der RGB-Hilfsdienst unterstützt diese Lichteinstellung nicht."

#: crates/rigg/src/pages/lys_kort.rs:162
msgid "RGB-hjelperen avviste forespørselen. Les status før du prøver igjen."
msgstr "Der RGB-Hilfsdienst hat die Anfrage abgewiesen. Prüfe den Status, bevor du es erneut versuchst."

#: crates/rigg/src/pages/lys_kort.rs:165
msgid "RGB-forespørselen mislyktes. Sjekk status og se på kortet før du prøver igjen."
msgstr "Die RGB-Anfrage ist fehlgeschlagen. Prüfe den Status und sieh dir die Karte an, bevor du es erneut versuchst."

#: crates/rigg/src/pages/lys_kort.rs:186
msgid "Avlesning av kortlyset mislyktes. Nye lysendringer er sperret."
msgstr "Die Kartenbeleuchtung konnte nicht ausgelesen werden. Neue Lichtänderungen sind gesperrt."

#: crates/rigg/src/pages/lys_kort.rs:189
msgid "Gjenopprettingen er bekreftet av deg. Effektmodusen er fortsatt ikke maskinelt avlest."
msgstr "Du hast die Wiederherstellung bestätigt. Der Effektmodus wurde weiterhin nicht von der Hardware ausgelesen."

#: crates/rigg/src/pages/lys_kort.rs:193
msgid "Farge og lysstyrke samsvarer etter tilbakeføring. Se på kortet før du bekrefter gjenopprettingen."
msgstr "Farbe und Helligkeit stimmen nach dem Zurücksetzen überein. Sieh dir die Karte an, bevor du die Wiederherstellung bestätigst."

#: crates/rigg/src/pages/lys_kort.rs:194
msgid "Tilbakeføringen samsvarer ikke med avlesningen. Nye fargeendringer er sperret."
msgstr "Der ausgelesene Zustand stimmt nicht mit der Rücksetzung überein. Neue Farbänderungen sind gesperrt."

#: crates/rigg/src/pages/lys_kort.rs:195 crates/rigg/src/pages/lys_kort.rs:196
msgid "Gjenopprettingen er uavklart. Nye fargeendringer er sperret."
msgstr "Die Wiederherstellung ist noch nicht geklärt. Neue Farbänderungen sind gesperrt."

#: crates/rigg/src/pages/lys_kort.rs:377 crates/rigg/src/pages/lys_kort.rs:380
msgid "Av"
msgstr "Aus"

#: crates/rigg/src/pages/lys_kort.rs:381
msgid "Fast farge {farge} · {styrke}"
msgstr "Statische Farbe {farge} · {styrke}"

#: crates/rigg/src/pages/lys_kort.rs:382
msgid "Ingen kjent innstilling"
msgstr "Keine bekannte Einstellung"

#: crates/rigg/src/pages/lys_kort.rs:454
msgid "Lys på kortet"
msgstr "Kartenbeleuchtung"

#: crates/rigg/src/pages/lys_kort.rs:459 crates/rigg/src/pages/lys_kort.rs:1257
msgid "Ikke aktivert"
msgstr "Nicht aktiviert"

#: crates/rigg/src/pages/lys_kort.rs:494
msgid "Kortlys på eller av"
msgstr "Kartenbeleuchtung ein oder aus"

#: crates/rigg/src/pages/lys_kort.rs:495
msgid "Kortlys"
msgstr "Kartenbeleuchtung"

#: crates/rigg/src/pages/lys_kort.rs:499
msgid "Fast farge"
msgstr "Statische Farbe"

#: crates/rigg/src/pages/lys_kort.rs:505
msgid "Fysisk lysmodus"
msgstr "Physischer Beleuchtungsmodus"

#: crates/rigg/src/pages/lys_kort.rs:509
msgid "Modus"
msgstr "Modus"

#: crates/rigg/src/pages/lys_kort.rs:531
msgid "Farge på kortet, seks heksadesimale siffer"
msgstr "Kartenfarbe, sechs hexadezimale Ziffern"

#: crates/rigg/src/pages/lys_kort.rs:538 crates/rigg/src/pages/lys_kort.rs:539
msgid "Velg farge …"
msgstr "Farbe wählen …"

#: crates/rigg/src/pages/lys_kort.rs:545
msgid "Hurtigfarger"
msgstr "Schnellfarben"

#: crates/rigg/src/pages/lys_kort.rs:577
msgid "Farge"
msgstr "Farbe"

#: crates/rigg/src/pages/lys_kort.rs:587 crates/rigg/src/pages/lys_kort.rs:597
msgid "Kortlysets lysstyrke i prosent"
msgstr "Helligkeit der Kartenbeleuchtung in Prozent"

#: crates/rigg/src/pages/lys_kort.rs:603
msgid "Lysstyrke"
msgstr "Helligkeit"

#: crates/rigg/src/pages/lys_kort.rs:606
msgid "Behold også etter at appen lukkes"
msgstr "Auch nach dem Schließen der App beibehalten"

#: crates/rigg/src/pages/lys_kort.rs:634
msgid "Bruk"
msgstr "Anwenden"

#: crates/rigg/src/pages/lys_kort.rs:637
msgid "Gjenopprett utgangspunkt"
msgstr "Ausgangswerte wiederherstellen"

#: crates/rigg/src/pages/lys_kort.rs:640 crates/rigg/src/pages/lys_kort.rs:1540
msgid "Avslutt lysstyring"
msgstr "Lichtsteuerung freigeben"

#: crates/rigg/src/pages/lys_kort.rs:641
msgid "Bekreft lyset …"
msgstr "Beleuchtung bestätigen …"

#: crates/rigg/src/pages/lys_kort.rs:657
msgid "Behold"
msgstr "Beibehalten"

#: crates/rigg/src/pages/lys_kort.rs:658
msgid "Rull tilbake"
msgstr "Zurücksetzen"

#: crates/rigg/src/pages/lys_kort.rs:668
msgid "Avlesning: ukjent. Kortet er ikke undersøkt av denne visningen."
msgstr "Auslesestatus unbekannt. Die Karte wurde in dieser Ansicht nicht geprüft."

#: crates/rigg/src/pages/lys_kort.rs:672
msgid "Farge og lysstyrke kan leses tilbake. Effektmodusen kan ikke leses; en visuell bekreftelse er din observasjon."
msgstr "Farbe und Helligkeit lassen sich auslesen. Der Effektmodus nicht; die visuelle Bestätigung beruht auf deiner Beobachtung."

#: crates/rigg/src/pages/lys_kort.rs:673
msgid "Agentic HW Monitor støtter Palit GeForce RTX 2080 Super JetStream via den separate RGB-hjelperen."
msgstr "Agentic HW Monitor unterstützt die Palit GeForce RTX 2080 Super JetStream über den separaten RGB-Hilfsdienst."

#: crates/rigg/src/pages/lys_kort.rs:680
msgid "Sjekk igjen"
msgstr "Erneut prüfen"

#: crates/rigg/src/pages/lys_kort.rs:681
msgid "Aktiver kortlys …"
msgstr "Kartenbeleuchtung aktivieren …"

#: crates/rigg/src/pages/lys_kort.rs:682
msgid "Gjenopprett lagret lys …"
msgstr "Gespeicherte Beleuchtung wiederherstellen …"

#: crates/rigg/src/pages/lys_kort.rs:683
msgid "Avklar tidligere økt …"
msgstr "Vorherige Sitzung klären …"

#: crates/rigg/src/pages/lys_kort.rs:684
msgid "Slå av RGB-tilgang …"
msgstr "RGB-Zugriff deaktivieren …"

#: crates/rigg/src/pages/lys_kort.rs:685
msgid "Tilbake til fabrikklyset"
msgstr "Zurück zur Werksbeleuchtung"

#: crates/rigg/src/pages/lys_kort.rs:690
msgid "Detaljer og feilsøking"
msgstr "Details und Fehlerbehebung"

#: crates/rigg/src/pages/lys_kort.rs:811
msgid "Velg farge"
msgstr "Farbe wählen"

#: crates/rigg/src/pages/lys_kort.rs:902
msgid "Jeg ser at lyset på kortet er slukket."
msgstr "Ich sehe, dass die Kartenbeleuchtung aus ist."

#: crates/rigg/src/pages/lys_kort.rs:903
msgid "Jeg ser at lyset viser den forventede faste fargen."
msgstr "Ich sehe die erwartete statische Farbe an der Karte."

#: crates/rigg/src/pages/lys_kort.rs:905 crates/rigg/src/pages/lys_kort.rs:2199
msgid "Bekreft lyset på kortet"
msgstr "Kartenbeleuchtung bestätigen"

#: crates/rigg/src/pages/lys_kort.rs:905
msgid "Forventet lys: {lys}.\n\nSe på det fysiske kortet. Samsvarende fargeverdier alene er ikke nok. Hjelperen leser verdiene på nytt før observasjonen din lagres."
msgstr "Erwartete Beleuchtung: {lys}.\n\nSieh dir die physische Karte an. Übereinstimmende Farbwerte allein genügen nicht. Der Hilfsdienst liest die Werte erneut aus, bevor er deine Beobachtung speichert."

#: crates/rigg/src/pages/lys_kort.rs:905 crates/rigg/src/pages/lys_kort.rs:2221
msgid "Bekreft min observasjon"
msgstr "Meine Beobachtung bestätigen"

#: crates/rigg/src/pages/lys_kort.rs:911
msgid "Lystilstanden er endret"
msgstr "Beleuchtungszustand hat sich geändert"

#: crates/rigg/src/pages/lys_kort.rs:911
msgid "Kontroller det nye forventede lyset og åpne bekreftelsen på nytt."
msgstr "Prüfe die neue erwartete Beleuchtung und öffne die Bestätigung erneut."

#: crates/rigg/src/pages/lys_kort.rs:1125
msgid "Kunne ikke lese kortlyset"
msgstr "Kartenbeleuchtung konnte nicht ausgelesen werden"

#: crates/rigg/src/pages/lys_kort.rs:1127
msgid "Lysendringen ble ikke fullført"
msgstr "Lichtänderung wurde nicht abgeschlossen"

#: crates/rigg/src/pages/lys_kort.rs:1247
msgid "Venter …"
msgstr "Warten …"

#: crates/rigg/src/pages/lys_kort.rs:1249
msgid "Frakoblet"
msgstr "Getrennt"

#: crates/rigg/src/pages/lys_kort.rs:1251
msgid "Kortet er utilgjengelig"
msgstr "Karte nicht verfügbar"

#: crates/rigg/src/pages/lys_kort.rs:1253
msgid "Ikke klar"
msgstr "Nicht bereit"

#: crates/rigg/src/pages/lys_kort.rs:1255
msgid "Må oppdateres"
msgstr "Update nötig"

#: crates/rigg/src/pages/lys_kort.rs:1259
msgid "Prøve pågår"
msgstr "Test läuft"

#: crates/rigg/src/pages/lys_kort.rs:1261
msgid "Må avklares"
msgstr "Klärung erforderlich"

#: crates/rigg/src/pages/lys_kort.rs:1263
msgid "Effekt aktiv"
msgstr "Effekt aktiv"

#: crates/rigg/src/pages/lys_kort.rs:1265
msgid "Lyset er av"
msgstr "Beleuchtung aus"

#: crates/rigg/src/pages/lys_kort.rs:1267
msgid "Klar"
msgstr "Bereit"

#: crates/rigg/src/pages/lys_kort.rs:1274
msgid "Simulerte RGB-data · {status}"
msgstr "Simulierte RGB-Daten · {status}"

#: crates/rigg/src/pages/lys_kort.rs:1285
msgid "Venter på svar. Ingen ny endring kan sendes nå."
msgstr "Antwort steht aus. Derzeit können keine neuen Änderungen gesendet werden."

#: crates/rigg/src/pages/lys_kort.rs:1287
msgid "Forbindelsen til tjenesten er brutt. Hjelperen håndterer eventuell tilbakeføring."
msgstr "Die Verbindung zum Dienst wurde getrennt. Der Hilfsdienst übernimmt eine gegebenenfalls nötige Rücksetzung."

#: crates/rigg/src/pages/lys_kort.rs:1292
msgid "Kortet er ikke tilgjengelig. Nye lysendringer og aktivering er sperret."
msgstr "Die Karte ist nicht verfügbar. Lichtänderungen und Aktivierung sind gesperrt."

#: crates/rigg/src/pages/lys_kort.rs:1294
msgid "Et annet vindu styrer kortlyset. Her vises bare status."
msgstr "Ein anderes Fenster steuert die Kartenbeleuchtung. Hier wird nur der Status angezeigt."

#: crates/rigg/src/pages/lys_kort.rs:1296
msgid "Hele kortlyset er én sone. Ingenting sendes før du trykker «Bruk»."
msgstr "Die Kartenbeleuchtung ist eine Zone. Nichts wird gesendet, bevor du „Anwenden“ drückst."

#: crates/rigg/src/pages/lys_kort.rs:1298
msgid "En tidligere RGB-økt er ikke avsluttet, og RGB-delen må oppdateres. Trykk «Bruk»: kortet settes tilbake til det lagrede lyset, du ser på kortet og bekrefter, og så oppdateres og aktiveres kortlyset med ett passord."
msgstr "Eine frühere RGB-Sitzung ist nicht abgeschlossen, und der RGB-Teil muss aktualisiert werden. Drücke „Anwenden“: Die Karte wird auf die gespeicherte Beleuchtung zurückgesetzt, du siehst auf die Karte und bestätigst, und dann wird die Kartenbeleuchtung mit einem Passwort aktualisiert und aktiviert."

#: crates/rigg/src/pages/lys_kort.rs:1300
msgid "RGB-delen er eldre enn GPU-delen og må oppdateres. Trykk «Bruk» for å oppdatere og aktivere kortlyset med ett passord."
msgstr "Der RGB-Teil ist älter als der GPU-Teil und muss aktualisiert werden. Drücke „Anwenden“, um die Kartenbeleuchtung mit einem Passwort zu aktualisieren und zu aktivieren."

#: crates/rigg/src/pages/lys_kort.rs:1302
msgid "RGB-tillatelsen gjelder ikke kortet som er valgt. Ingen endringer kan sendes her."
msgstr "Die RGB-Berechtigung gilt nicht für die ausgewählte Karte. Hier können keine Änderungen gesendet werden."

#: crates/rigg/src/pages/lys_kort.rs:1305 crates/rigg/src/pages/lys_kort.rs:1957
msgid "RGB-hjelperen er ikke klar. Se «Detaljer og feilsøking» nedenfor."
msgstr "Der RGB-Hilfsdienst ist nicht bereit. Siehe „Details und Fehlerbehebung“ unten."

#: crates/rigg/src/pages/lys_kort.rs:1307
msgid "Velg lys og trykk «Bruk». RGB-hjelperen oppdateres først, og du skriver passordet én gang."
msgstr "Wähle die Beleuchtung und drücke „Anwenden“. Zuerst wird der RGB-Hilfsdienst aktualisiert; du gibst dein Passwort einmal ein."

#: crates/rigg/src/pages/lys_kort.rs:1309
msgid "Velg lys og trykk «Bruk». Første gang aktiveres kortlyset med passordet ditt."
msgstr "Wähle die Beleuchtung und drücke „Anwenden“. Beim ersten Mal wird die Kartenbeleuchtung mit deinem Passwort aktiviert."

#: crates/rigg/src/pages/lys_kort.rs:1322
msgid "Venter på kortets PCI-adresse og UUID."
msgstr "Warte auf PCI-Adresse und UUID der Karte."

#: crates/rigg/src/pages/lys_kort.rs:1323
msgid "Valgt kort: {pci}"
msgstr "Ausgewählte Karte: {pci}"

#: crates/rigg/src/pages/lys_kort.rs:1328
msgid "{effekt} er valgt. Nå vises bare startfargen; animasjonen starter først etter «Behold»."
msgstr "{effekt} ist ausgewählt. Nur die Startfarbe wird angezeigt; die Animation startet erst mit „Beibehalten“."

#: crates/rigg/src/pages/lys_kort.rs:1332
msgid "{effekt} er aktiv på hele kortlyset. Velg en annen modus eller farge og trykk «Bruk» for å bytte, eller «Stopp effekten» for å gå tilbake til utgangspunktet."
msgstr "{effekt} ist auf der gesamten Kartenbeleuchtung aktiv. Wähle einen anderen Modus oder eine andere Farbe und drücke „Anwenden“, um zu wechseln, oder „Effekt stoppen“, um zum Ausgangszustand zurückzukehren."

#: crates/rigg/src/pages/lys_kort.rs:1338
msgid "Pusting varierer lysstyrken i fargen du velger."
msgstr "„Atmen“ ändert die Helligkeit der gewählten Farbe."

#: crates/rigg/src/pages/lys_kort.rs:1340
msgid "Regnbue går gjennom hele fargespekteret fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "„Regenbogen“ durchläuft das gesamte Farbspektrum ab dem gewählten Farbton. Grau beginnt bei Rot."

#: crates/rigg/src/pages/lys_kort.rs:1343
msgid "Fargesyklus veksler mellom seks tydelige fargetoner fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "„Farbwechsel“ wechselt zwischen sechs klar unterscheidbaren Farbtönen ab dem gewählten Farbton. Grau beginnt bei Rot."

#: crates/rigg/src/pages/lys_kort.rs:1346
msgid "{detalj} Først prøves startfargen; «Behold» starter animasjonen på én lyssone."
msgstr "{detalj} Zunächst wird die Startfarbe getestet. „Beibehalten“ startet die Animation in einer Beleuchtungszone."

#: crates/rigg/src/pages/lys_kort.rs:1355
msgid "RGB-hjelperen meldte en driftsfeil. Kontroller lyset før du fortsetter."
msgstr "Der RGB-Hilfsdienst hat einen Laufzeitfehler gemeldet. Prüfe die Beleuchtung, bevor du fortfährst."

#: crates/rigg/src/pages/lys_kort.rs:1367
msgid "{farge} · rå lysstyrke {styrke}, utenfor støttet område"
msgstr "{farge} · Helligkeitsrohwert {styrke} außerhalb des unterstützten Bereichs"

#: crates/rigg/src/pages/lys_kort.rs:1372
msgid "Lagret utgangspunkt: {lys}. Dette er ikke en ny avlesning."
msgstr "Gespeicherter Ausgangszustand: {lys}. Das ist keine neue Auslesung."

#: crates/rigg/src/pages/lys_kort.rs:1375
msgid "Sist lest fra kortet: {lys}. Effektmodus: ukjent."
msgstr "Zuletzt von der Karte gelesen: {lys}. Effektmodus: unbekannt."

#: crates/rigg/src/pages/lys_kort.rs:1377
msgid "Avlesning: ukjent. Effektmodusen er ikke bekreftet."
msgstr "Auslesestatus unbekannt. Der Effektmodus ist nicht bestätigt."

#: crates/rigg/src/pages/lys_kort.rs:1383
msgid "Sist bekreftede valg: {lys}. Valget er ikke bevis på avlest effektmodus."
msgstr "Zuletzt bestätigte Auswahl: {lys}. Das belegt keinen ausgelesenen Effektmodus."

#: crates/rigg/src/pages/lys_kort.rs:1395
msgid "Kontroller startfargen på kortet. «Behold» starter animasjonen; «Rull tilbake» eller fristutløp går tilbake til utgangspunktet."
msgstr "Prüfe die Startfarbe an der Karte. „Beibehalten“ startet die Animation. „Zurücksetzen“ oder Fristablauf stellt den Ausgangszustand wieder her."

#: crates/rigg/src/pages/lys_kort.rs:1397
msgid "Se på det fysiske kortet før du beholder endringen. Uten bekreftelse forsøker hjelperen å rulle tilbake."
msgstr "Sieh dir die physische Karte an, bevor du die Änderung beibehältst. Ohne Bestätigung versucht der Hilfsdienst, sie zurückzusetzen."

#: crates/rigg/src/pages/lys_kort.rs:1410
msgid "fristen styres av hjelperen"
msgstr "Frist wird vom Hilfsdienst gesteuert"

#: crates/rigg/src/pages/lys_kort.rs:1412
msgid "fristen er ute; venter på status"
msgstr "Frist abgelaufen; warte auf Status"

#: crates/rigg/src/pages/lys_kort.rs:1414
msgid "bekreft innen {tid}"
msgstr "innerhalb von {tid} bestätigen"

#: crates/rigg/src/pages/lys_kort.rs:1460
msgid "Oppgi en gyldig fargekode på seks tegn, for eksempel #3A7BF0."
msgstr "Geben Sie einen gültigen sechsstelligen Hex-Farbcode ein, z. B. #3A7BF0."

#: crates/rigg/src/pages/lys_kort.rs:1464
msgid "Bekreft eller rull tilbake prøven som pågår før du bruker en ny innstilling."
msgstr "Bestätigen oder verwerfen Sie zuerst den laufenden Test, bevor Sie eine neue Einstellung anwenden."

#: crates/rigg/src/pages/lys_kort.rs:1515
msgid "Se på kortet og bekreft lyset"
msgstr "Sieh auf die Karte und bestätige die Beleuchtung"

#: crates/rigg/src/pages/lys_kort.rs:1516
msgid "Kortet er satt tilbake til {lys}. Hjelperen kan bare lese fargeverdiene, ikke hva kortet faktisk lyser. Bekreft når kortet viser dette, eller gjenopprett på nytt."
msgstr "Die Karte wurde auf {lys} zurückgesetzt. Der Hilfsdienst kann nur die Farbwerte lesen, nicht was die Karte tatsächlich leuchtet. Bestätige, wenn die Karte das zeigt, oder stelle erneut wieder her."

#: crates/rigg/src/pages/lys_kort.rs:1518
msgid "Lyset må avklares"
msgstr "Die Beleuchtung muss geklärt werden"

#: crates/rigg/src/pages/lys_kort.rs:1520
msgid "RGB-hjelperen meldte en driftsfeil. Gjenopprett utgangspunktet og kontroller lyset før du fortsetter."
msgstr "Der RGB-Hilfsdienst hat einen Betriebsfehler gemeldet. Stelle den Ausgangszustand wieder her und prüfe die Beleuchtung, bevor du fortfährst."

#: crates/rigg/src/pages/lys_kort.rs:1525
msgid "Utgangspunktet er {lys}."
msgstr "Der Ausgangszustand ist {lys}."

#: crates/rigg/src/pages/lys_kort.rs:1531
msgid "Gjenopprett på nytt"
msgstr "Erneut wiederherstellen"

#: crates/rigg/src/pages/lys_kort.rs:1531
msgid "Gjenopprett utgangspunktet"
msgstr "Ausgangszustand wiederherstellen"

#: crates/rigg/src/pages/lys_kort.rs:1536 crates/rigg/src/pages/lys_kort.rs:2155
msgid "Stopp effekten"
msgstr "Effekt stoppen"

#: crates/rigg/src/pages/lys_kort.rs:1538
msgid "Slutt å holde av"
msgstr "Aus nicht mehr halten"

#: crates/rigg/src/pages/lys_kort.rs:1542
msgid "Kortet går tilbake til det lagrede utgangspunktet, og appen slipper lyset."
msgstr "Die Karte kehrt zum gespeicherten Ausgangszustand zurück, und die App gibt die Beleuchtung frei."

#: crates/rigg/src/pages/lys_kort.rs:1548
msgid "det lagrede utgangspunktet"
msgstr "den gespeicherten Ausgangszustand"

#: crates/rigg/src/pages/lys_kort.rs:1553
msgid "Effekter kjører bare mens appen er åpen. Når appen lukkes, stopper effekten og kortet går tilbake til {lys}."
msgstr "Effekte laufen nur, solange die App geöffnet ist. Beim Schließen der App stoppt der Effekt, und die Karte kehrt zu {lys} zurück."

#: crates/rigg/src/pages/lys_kort.rs:1555
msgid "«Av» skrives på nytt hvert 2. sekund mens appen er åpen, fordi kortet ellers kan gå tilbake til fabrikklyset av seg selv. Når appen lukkes, kan kortet derfor lyse igjen."
msgstr "„Aus“ wird alle 2 Sekunden erneut geschrieben, solange die App geöffnet ist, weil die Karte sonst von selbst zur Werksbeleuchtung zurückkehren kann. Nach dem Schließen der App kann die Karte daher wieder leuchten."

#: crates/rigg/src/pages/lys_kort.rs:1557
msgid "Etter «Behold» blir valget kortets utgangspunkt og skrives ikke tilbake når appen lukkes. Om kortet selv beholder lyset etter omstart, er ikke verifisert."
msgstr "Nach „Beibehalten“ wird die Auswahl zum Ausgangszustand der Karte und beim Schließen der App nicht zurückgesetzt. Ob die Karte die Beleuchtung nach einem Neustart selbst behält, ist nicht geprüft."

#: crates/rigg/src/pages/lys_kort.rs:1559
msgid "Når appen lukkes, går kortet tilbake til {lys}."
msgstr "Beim Schließen der App kehrt die Karte zu {lys} zurück."

#: crates/rigg/src/pages/lys_kort.rs:1568
msgid "Fabrikklyset: {lys}. Prøves som et vanlig valg; «Behold» gjør det til utgangspunktet igjen."
msgstr "Werksbeleuchtung: {lys}. Wird wie eine normale Auswahl ausprobiert; „Beibehalten“ macht sie wieder zum Ausgangszustand."

#: crates/rigg/src/pages/lys_kort.rs:1648 crates/rigg/src/pages/lys_kort.rs:1804
msgid "RGB-oppsettet er ikke klart"
msgstr "RGB-Einrichtung ist nicht bereit"

#: crates/rigg/src/pages/lys_kort.rs:1660
msgid "Slå av RGB-tilgang"
msgstr "RGB-Zugriff deaktivieren"

#: crates/rigg/src/pages/lys_kort.rs:1661
msgid "Dette stopper RGB-arbeideren og fjerner kortets RGB-tillatelse når gjenopprettingen er avklart. Det lagrede utgangspunktet beholdes."
msgstr "Der RGB-Prozess wird angehalten. Nach Klärung der Wiederherstellung wird der Karte die RGB-Berechtigung entzogen. Der gespeicherte Ausgangszustand bleibt erhalten."

#: crates/rigg/src/pages/lys_kort.rs:1662
msgid "Jeg vil slå av RGB-tilgangen for dette kortet."
msgstr "Ich möchte den RGB-Zugriff für diese Karte deaktivieren."

#: crates/rigg/src/pages/lys_kort.rs:1666
msgid "Gjenopprett lagret lys"
msgstr "Gespeicherte Beleuchtung wiederherstellen"

#: crates/rigg/src/pages/lys_kort.rs:1667
msgid "Administratorhjelperen stopper RGB-arbeideren hvis den kjører. Hvis det finnes en uavklart journal, forsøker den deretter å gjenopprette det lagrede utgangspunktet. Kontroller lyset og velg «Avklar tidligere økt» etterpå."
msgstr "Der Hilfsdienst mit Administratorrechten hält den RGB-Prozess an, falls er läuft. Enthält das Journal einen offenen Vorgang, versucht er danach, den gespeicherten Ausgangszustand wiederherzustellen. Prüfe die Beleuchtung und wähle anschließend „Vorherige Sitzung klären“."

#: crates/rigg/src/pages/lys_kort.rs:1668
msgid "Jeg vil gjenopprette det lagrede utgangspunktet på dette kortet."
msgstr "Ich möchte den gespeicherten Ausgangszustand dieser Karte wiederherstellen."

#: crates/rigg/src/pages/lys_kort.rs:1671
msgid "Aktiver lys på kortet"
msgstr "Kartenbeleuchtung aktivieren"

#: crates/rigg/src/pages/lys_kort.rs:1672
msgid "Se på det fysiske kortet før du fortsetter. Lyset må allerede vise én fast farge. Pust, fargeskift og et ukjent utgangspunkt kan ikke lagres som et sikkert utgangspunkt. Administratorgodkjenningen gjelder bare kortlyset; den endrer ikke GPU-tillatelsen."
msgstr "Sieh dir vor dem Fortfahren die physische Karte an. Die Beleuchtung muss bereits eine einzelne statische Farbe zeigen. Atmen, Farbwechsel oder ein unbekannter Zustand können nicht als sicherer Ausgangszustand gespeichert werden. Die Administratorfreigabe gilt nur für die Beleuchtung; die GPU-Berechtigung bleibt unverändert."

#: crates/rigg/src/pages/lys_kort.rs:1673
msgid "Jeg ser kortet og bekrefter at det viser én fast farge."
msgstr "Ich sehe die Karte und bestätige, dass sie eine einzelne statische Farbe zeigt."

#: crates/rigg/src/pages/lys_kort.rs:1682
msgid "GPU-styringen røres ikke."
msgstr "Die GPU-Steuerung bleibt unverändert."

#: crates/rigg/src/pages/lys_kort.rs:1684
msgid "GPU-hjelperen oppdateres også og startes på nytt: effekt, vifter og klokker går tilbake til utgangspunktet og må brukes på nytt."
msgstr "Der GPU-Hilfsdienst wird ebenfalls aktualisiert und neu gestartet: Leistung, Lüfter und Takt kehren zum Ausgangszustand zurück und müssen erneut angewendet werden."

#: crates/rigg/src/pages/lys_kort.rs:1688
msgid "Har en tidligere RGB-økt ikke blitt avsluttet, settes kortet først tilbake til det lagrede lyset i samme godkjenning. Deretter ber appen deg se på kortet og bekrefte det gjenopprettede lyset før økten avsluttes og oppdateringen fortsetter."
msgstr "Wurde eine frühere RGB-Sitzung nicht beendet, wird die Karte in derselben Freigabe zuerst auf das gespeicherte Licht zurückgesetzt. Danach bittet dich die App, auf die Karte zu schauen und das wiederhergestellte Licht zu bestätigen, bevor die Sitzung beendet wird und die Aktualisierung fortgesetzt wird."

#: crates/rigg/src/pages/lys_kort.rs:1697
msgid "Kort: {kort}\n\n{beskrivelse}"
msgstr "Karte: {kort}\n\n{beskrivelse}"

#: crates/rigg/src/pages/lys_kort.rs:1697
msgid "Lagret binding"
msgstr "Gespeicherte Kartenbindung"

#: crates/rigg/src/pages/lys_kort.rs:1699 crates/rigg/src/pages/lys_kort.rs:1713
msgid "Fortsett til administratorgodkjenning"
msgstr "Weiter zur Administratorfreigabe"

#: crates/rigg/src/pages/lys_kort.rs:1732
msgid "Avklar tidligere RGB-økt"
msgstr "Vorherige RGB-Sitzung klären"

#: crates/rigg/src/pages/lys_kort.rs:1733
msgid "Lagret lys for {kort}: {lys}.\n\nSe på kortet. Fortsett bare hvis lyset viser dette utgangspunktet som én fast farge."
msgstr "Gespeicherte Beleuchtung für {kort}: {lys}.\n\nSieh dir die Karte an. Fahre nur fort, wenn sie diesen Ausgangszustand als einzelne statische Farbe zeigt."

#: crates/rigg/src/pages/lys_kort.rs:1734
msgid "Jeg ser at kortlyset viser det lagrede, faste utgangspunktet."
msgstr "Ich sehe den gespeicherten statischen Ausgangszustand an der Karte."

#: crates/rigg/src/pages/lys_kort.rs:1764
msgid "Bekreft og fortsett oppdateringen"
msgstr "Bestätigen und Aktualisierung fortsetzen"

#: crates/rigg/src/pages/lys_kort.rs:1777 crates/rigg/src/pages/lys_kort.rs:1901
msgid "RGB-oppsettet er oppdatert. Kontroller status før du bruker en farge."
msgstr "RGB-Einrichtung aktualisiert. Prüfe den Status, bevor du eine Farbe anwendest."

#: crates/rigg/src/pages/lys_kort.rs:1779 crates/rigg/src/pages/lys_kort.rs:1909
msgid "RGB-oppsett"
msgstr "RGB-Einrichtung"

#: crates/rigg/src/pages/lys_kort.rs:1858 crates/rigg/src/pages/lys_kort.rs:1905
msgid "RGB-oppsettet kunne ikke fullføres."
msgstr "Die RGB-Einrichtung konnte nicht abgeschlossen werden."

#: crates/rigg/src/pages/lys_kort.rs:1897
msgid "RGB-arbeideren er stoppet. Kontroller lyset og velg «Avklar tidligere økt» hvis en gjenoppretting gjenstår."
msgstr "Der RGB-Prozess ist angehalten. Prüfe die Beleuchtung und wähle „Vorherige Sitzung klären“, falls eine Wiederherstellung noch aussteht."

#: crates/rigg/src/pages/lys_kort.rs:1898
msgid "Ingen uavklart RGB-journal for kortet. Du kan slå av RGB-tilgangen."
msgstr "Für diese Karte gibt es kein offenes RGB-Journal. Du kannst den RGB-Zugriff deaktivieren."

#: crates/rigg/src/pages/lys_kort.rs:1899
msgid "Gjenopprettingen er avklart. Du kan slå av RGB-tilgangen eller aktivere lysstyring på nytt."
msgstr "Die Wiederherstellung ist geklärt. Du kannst den RGB-Zugriff deaktivieren oder die Beleuchtungssteuerung erneut aktivieren."

#: crates/rigg/src/pages/lys_kort.rs:1900
msgid "RGB-tilgangen er slått av."
msgstr "RGB-Zugriff ist deaktiviert."

#: crates/rigg/src/pages/lys_kort.rs:1902
msgid "Administratorgodkjenningen ble avbrutt."
msgstr "Die Administratorfreigabe wurde abgebrochen."

#: crates/rigg/src/pages/lys_kort.rs:1903
msgid "Avklaringsmålet er ugyldig eller gjelder et annet valgt kort."
msgstr "Das Wiederherstellungsziel ist ungültig oder gehört zu einer anderen Karte."

#: crates/rigg/src/pages/lys_kort.rs:1909
msgid "RGB-oppsett ble ikke fullført"
msgstr "RGB-Einrichtung nicht abgeschlossen"

#: crates/rigg/src/pages/lys_kort.rs:1935
msgid "Administratorhandlinger for RGB krever appens vanlige maskinvareoppsett."
msgstr "RGB-Administratoraktionen erfordern die reguläre Hardware-Umgebung der App."

#: crates/rigg/src/pages/lys_kort.rs:1959
msgid "Systemkomponentene mangler. Se «Uten nett: bruk terminal» under «Detaljer og feilsøking»."
msgstr "Systemkomponenten fehlen. Siehe „Ohne Internet: Terminal verwenden“ unter „Details und Fehlerbehebung“."

#: crates/rigg/src/pages/lys_kort.rs:2003
msgid "Avbryt"
msgstr "Abbrechen"
