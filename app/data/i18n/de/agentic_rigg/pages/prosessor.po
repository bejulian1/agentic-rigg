#: crates/rigg/src/pages/prosessor.rs:190
msgid "L3-gruppe {nr}"
msgstr "L3-Gruppe {nr}"

#: crates/rigg/src/pages/prosessor.rs:190
msgid "Alle kjerner"
msgstr "Alle Kerne"

#: crates/rigg/src/pages/prosessor.rs:197
msgid "Pakke {pakke} · kjerne {kjerne}"
msgstr "Paket {pakke} · Kern {kjerne}"

#: crates/rigg/src/pages/prosessor.rs:198
msgid "Kjerne {kjerne}"
msgstr "Kern {kjerne}"

#: crates/rigg/src/pages/prosessor.rs:324
msgid "Faste data er lest på nytt"
msgstr "Hardwaredaten aktualisiert"

#: crates/rigg/src/pages/prosessor.rs:329
msgid "Kunne ikke hente prosessordata"
msgstr "CPU-Daten konnten nicht abgerufen werden"

#: crates/rigg/src/pages/prosessor.rs:415 crates/rigg/src/pages/prosessor.rs:616
msgid "CPU-temperatur"
msgstr "CPU-Temperatur"

#: crates/rigg/src/pages/prosessor.rs:428
msgid "travlest T{nr} {last}"
msgstr "höchste Auslastung: T{nr} {last}"

#: crates/rigg/src/pages/prosessor.rs:441
msgid "T{nr} {na} · maks {maks}"
msgstr "T{nr} {na} · max. {maks}"

#: crates/rigg/src/pages/prosessor.rs:447
msgid "Tråden med høyest klokke nå, og den høyeste trådklokken tjenesten har målt siden min og maks ble nullstilt."
msgstr "Der Thread mit dem aktuell höchsten Takt und der höchste seit dem Zurücksetzen von Min. und Max. gemessene Thread-Takt."

#: crates/rigg/src/pages/prosessor.rs:463
msgid "boost på"
msgstr "Boost an"

#: crates/rigg/src/pages/prosessor.rs:464
msgid "boost av"
msgstr "Boost aus"

#: crates/rigg/src/pages/prosessor.rs:465
msgid "boost ukjent"
msgstr "Boost unbekannt"

#: crates/rigg/src/pages/prosessor.rs:467
msgid "lastsnitt {verdi}"
msgstr "Ø Systemlast {verdi}"

#: crates/rigg/src/pages/prosessor.rs:470
msgid "Lastsnitt 1 / 5 / 15 min: {snitt}. Over antall tråder betyr kø."
msgstr "Mittlere Systemlast (1 / 5 / 15 min): {snitt}. Werte über der Thread-Anzahl deuten auf eine Warteschlange hin."

#: crates/rigg/src/pages/prosessor.rs:512
msgid "Ingen treff."
msgstr "Keine Treffer."

#: crates/rigg/src/pages/prosessor.rs:514
msgid "{antall} i alt"
msgstr "{antall} insgesamt"

#: crates/rigg/src/pages/prosessor.rs:514 crates/rigg/src/pages/prosessor.rs:524
msgid "{vist} av {totalt}"
msgstr "{vist} von {totalt}"

#: crates/rigg/src/pages/prosessor.rs:525
msgid "{utvalgte} utvalgte først, så noen av de andre. Vis alle for å se og søke i alle {totalt}."
msgstr "Zuerst werden {utvalgte} ausgewählte und dann einige weitere Einträge angezeigt. Wählen Sie „Alle anzeigen“, um alle {totalt} zu durchsuchen."

#: crates/rigg/src/pages/prosessor.rs:551
msgid "{antall} kjerne"
msgid_plural "{antall} kjerner"
msgstr[0] "{antall} Kern"
msgstr[1] "{antall} Kerne"

#: crates/rigg/src/pages/prosessor.rs:553
msgid "{antall} trådgruppe"
msgid_plural "{antall} trådgrupper"
msgstr[0] "{antall} Thread-Gruppe"
msgstr[1] "{antall} Thread-Gruppen"

#: crates/rigg/src/pages/prosessor.rs:580
msgid "Instruksjonssett"
msgstr "Befehlssätze"

#: crates/rigg/src/pages/prosessor.rs:584
msgid "Søk"
msgstr "Suchen"

#: crates/rigg/src/pages/prosessor.rs:586
msgid "Søk i instruksjonssett"
msgstr "Befehlssätze suchen"

#: crates/rigg/src/pages/prosessor.rs:593 crates/rigg/src/pages/prosessor.rs:594 crates/rigg/src/pages/prosessor.rs:668
msgid "Vis alle og søk"
msgstr "Alle anzeigen und suchen"

#: crates/rigg/src/pages/prosessor.rs:600
msgid "Uthevet: viktige for spill og koding. Navnet i /proc/cpuinfo står i verktøytipset."
msgstr "Hervorgehoben: wichtig für Spiele und Kodierung. Der Name aus /proc/cpuinfo steht im Tooltip."

#: crates/rigg/src/pages/prosessor.rs:609
msgid "Nå"
msgstr "Aktuell"

#: crates/rigg/src/pages/prosessor.rs:616
msgid "Temperatur fra CPU-sensoren. Sensorens navn står under verdien når det er tilgjengelig; det kan for eksempel være Tdie, Tctl eller Package id 0."
msgstr "Temperatur vom CPU-Sensor. Sein Name steht, sofern verfügbar, unter dem Wert, z. B. Tdie, Tctl oder Package id 0."

#: crates/rigg/src/pages/prosessor.rs:617
msgid "Last"
msgstr "Auslastung"

#: crates/rigg/src/pages/prosessor.rs:617
msgid "Total last fra /proc/stat, siste minutt i linja."
msgstr "Gesamtauslastung aus /proc/stat. Die Linie zeigt die letzte Minute."

#: crates/rigg/src/pages/prosessor.rs:618
msgid "Klokke (snitt)"
msgstr "Takt (Ø)"

#: crates/rigg/src/pages/prosessor.rs:618
msgid "Snittet over alle trådene (APERF/MPERF fra cpufreq). Med boost går enkelttråder over maks."
msgstr "Durchschnitt über alle Threads (APERF/MPERF aus cpufreq). Mit Boost können einzelne Threads das Maximum überschreiten."

#: crates/rigg/src/pages/prosessor.rs:619
msgid "Governor"
msgstr "Governor"

#: crates/rigg/src/pages/prosessor.rs:619
msgid "Strategien kjernen bruker for klokken, og driveren (cpufreq)."
msgstr "Strategie des Kernels zur Taktanpassung und zugehöriger Treiber (cpufreq)."

#: crates/rigg/src/pages/prosessor.rs:624
msgid "Klokke og last per tråd"
msgstr "Takt und Auslastung pro Thread"

#: crates/rigg/src/pages/prosessor.rs:632
msgid "stolpe = last"
msgstr "Balken = Auslastung"

#: crates/rigg/src/pages/prosessor.rs:668
msgid "Vis utvalget"
msgstr "Auswahl anzeigen"

#: crates/rigg/src/pages/prosessor.rs:697
msgid "{app} – Prosessor ({dato})"
msgstr "{app} – CPU ({dato})"

#: crates/rigg/src/pages/prosessor.rs:698
msgid "med klokke og last per tråd"
msgstr "mit Takt und Auslastung pro Thread"
