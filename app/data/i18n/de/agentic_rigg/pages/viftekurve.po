#: crates/rigg/src/pages/viftekurve.rs:66
msgid "Minste fart til 55 °C, 5 °C hysterese, rolig rampe (5 %/s opp, 2 %/s ned) og 5 s utjevning"
msgstr "Mindestdrehzahl bis 55 °C, 5 °C Hysterese, sanfte Rampe (5 %/s aufwärts, 2 %/s abwärts) und 5 s Glättung"

#: crates/rigg/src/pages/viftekurve.rs:70
msgid "Balansert"
msgstr "Ausgewogen"

#: crates/rigg/src/pages/viftekurve.rs:77
msgid "Standardkurven: 3 °C hysterese, 10 %/s opp og 3 %/s ned, ingen utjevning"
msgstr "Standardkurve: 3 °C Hysterese, 10 %/s aufwärts und 3 %/s abwärts, keine Glättung"

#: crates/rigg/src/pages/viftekurve.rs:81
msgid "Ytelse"
msgstr "Leistung"

#: crates/rigg/src/pages/viftekurve.rs:88
msgid "Kjøligst: høyere kurve, 2 °C hysterese og rask rampe (20 %/s opp, 5 %/s ned)"
msgstr "Kühlste Einstellung: höhere Lüfterkurve, 2 °C Hysterese und schnelle Rampe (20 %/s aufwärts, 5 %/s abwärts)"

