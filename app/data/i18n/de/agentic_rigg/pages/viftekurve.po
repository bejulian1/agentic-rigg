#: crates/rigg/src/pages/viftekurve.rs:1919 crates/rigg/src/pages/viftekurve.rs:2761
msgid "Fra {terskel} går viftene straks til {fart}, uten rampe, og tilbake til kurven under {slipp}. Den kan ikke slås av."
msgstr "Bei {terskel} wechseln die Lüfter sofort und ohne Rampe auf {fart}. Unter {slipp} folgen sie wieder der Kurve. Die Notfallregel lässt sich nicht deaktivieren."

#: crates/rigg/src/pages/viftekurve.rs:1920
msgid "Rekkefølgen"
msgstr "Reihenfolge"

#: crates/rigg/src/pages/viftekurve.rs:1920
msgid "Utjevning, hysterese, kurven med stille flate og minste fart, og til slutt rampen. Kan temperaturen ikke leses på 5 s, går viftene til 100 %."
msgstr "Zuerst Glättung, dann Hysterese, danach die Kurve unter Berücksichtigung des Bereichs mit Mindestdrehzahl und der Mindestdrehzahl selbst, zuletzt die Rampenbegrenzung. Fehlt 5 s lang ein Temperaturmesswert, laufen die Lüfter mit 100 %."

#: crates/rigg/src/pages/viftekurve.rs:1921
msgid "Mellom punktene"
msgstr "Zwischen den Punkten"

#: crates/rigg/src/pages/viftekurve.rs:1921
