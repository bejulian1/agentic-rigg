#: crates/rigg/src/pages/lys_kort.rs:118 crates/rigg/src/pages/lys_kort.rs:384
msgid "Pusting"
msgstr "Pulsation"

#: crates/rigg/src/pages/lys_kort.rs:119 crates/rigg/src/pages/lys_kort.rs:385
msgid "Regnbue"
msgstr "Arc-en-ciel"

#: crates/rigg/src/pages/lys_kort.rs:120 crates/rigg/src/pages/lys_kort.rs:386
msgid "Fargesyklus"
msgstr "Cycle de couleurs"

#: crates/rigg/src/pages/lys_kort.rs:138
msgid "Lysstyringen er opptatt eller tilhører et annet vindu."
msgstr "Le contrôle de l’éclairage est occupé ou appartient à une autre fenêtre."

#: crates/rigg/src/pages/lys_kort.rs:139
msgid "Lysprøven finnes ikke lenger eller fristen er ute."
msgstr "L’essai d’éclairage n’est plus actif ou a expiré."

#: crates/rigg/src/pages/lys_kort.rs:140
msgid "Nye lysendringer er sperret. Kontroller status og avklar eventuell gjenoppretting."
msgstr "Les nouvelles modifications sont bloquées. Vérifiez l’état et finalisez toute restauration en attente."

#: crates/rigg/src/pages/lys_kort.rs:141
msgid "RGB-tillatelsen for dette kortet kunne ikke bekreftes."
msgstr "Impossible de vérifier l’autorisation RGB pour cette carte."

#: crates/rigg/src/pages/lys_kort.rs:142
msgid "Det valgte kortet er ikke tilgjengelig."
msgstr "La carte sélectionnée n’est pas disponible."

#: crates/rigg/src/pages/lys_kort.rs:143 crates/rigg/src/pages/lys_kort.rs:1137
msgid "RGB-hjelperen støtter ikke dette lysvalget."
msgstr "L’assistant RGB ne prend pas en charge ce réglage."

#: crates/rigg/src/pages/lys_kort.rs:144
msgid "RGB-hjelperen avviste forespørselen. Les status før du prøver igjen."
msgstr "L’assistant RGB a rejeté la demande. Vérifiez l’état avant de réessayer."

#: crates/rigg/src/pages/lys_kort.rs:147
msgid "RGB-forespørselen mislyktes. Sjekk status og se på kortet før du prøver igjen."
msgstr "La demande RGB a échoué. Vérifiez l’état et observez la carte avant de réessayer."

#: crates/rigg/src/pages/lys_kort.rs:168
msgid "Avlesning av kortlyset mislyktes. Nye lysendringer er sperret."
msgstr "Impossible de lire l’éclairage. Les nouvelles modifications sont bloquées."

#: crates/rigg/src/pages/lys_kort.rs:171
msgid "Gjenopprettingen er bekreftet av deg. Effektmodusen er fortsatt ikke maskinelt avlest."
msgstr "Vous avez confirmé la restauration. Le mode d’effet n’a toujours pas été lu sur le matériel."

#: crates/rigg/src/pages/lys_kort.rs:175
msgid "Farge og lysstyrke samsvarer etter tilbakeføring. Se på kortet før du bekrefter gjenopprettingen."
msgstr "La couleur et la luminosité correspondent après l’annulation des modifications. Observez la carte avant de confirmer la restauration."

#: crates/rigg/src/pages/lys_kort.rs:176
msgid "Tilbakeføringen samsvarer ikke med avlesningen. Nye fargeendringer er sperret."
msgstr "La lecture ne correspond pas à l’état attendu après l’annulation des modifications. Les changements de couleur sont bloqués."

#: crates/rigg/src/pages/lys_kort.rs:177 crates/rigg/src/pages/lys_kort.rs:178
msgid "Gjenopprettingen er uavklart. Nye fargeendringer er sperret."
msgstr "La restauration n’est pas résolue. Les changements de couleur sont bloqués."

#: crates/rigg/src/pages/lys_kort.rs:305 crates/rigg/src/pages/lys_kort.rs:383
msgid "Av"
msgstr "Désactivé"

#: crates/rigg/src/pages/lys_kort.rs:306
msgid "Fast farge {farge} · {styrke}"
msgstr "Couleur fixe {farge} · {styrke}"

#: crates/rigg/src/pages/lys_kort.rs:307
msgid "Ingen kjent innstilling"
msgstr "Aucun réglage connu"

#: crates/rigg/src/pages/lys_kort.rs:359
msgid "Lys på kortet"
msgstr "Éclairage de la carte"

#: crates/rigg/src/pages/lys_kort.rs:361 crates/rigg/src/pages/lys_kort.rs:937
msgid "Ikke aktivert"
msgstr "Non activé"

#: crates/rigg/src/pages/lys_kort.rs:382
msgid "Fast farge"
msgstr "Couleur fixe"

#: crates/rigg/src/pages/lys_kort.rs:389
msgid "Fysisk lysmodus"
msgstr "Mode d’éclairage physique"

#: crates/rigg/src/pages/lys_kort.rs:393
msgid "Modus"
msgstr "Mode"

#: crates/rigg/src/pages/lys_kort.rs:415
msgid "Farge på kortet, seks heksadesimale siffer"
msgstr "Couleur de la carte, six chiffres hexadécimaux"

#: crates/rigg/src/pages/lys_kort.rs:422
msgid "Hurtigfarger"
msgstr "Couleurs rapides"

#: crates/rigg/src/pages/lys_kort.rs:458
msgid "Farge"
msgstr "Couleur"

#: crates/rigg/src/pages/lys_kort.rs:466 crates/rigg/src/pages/lys_kort.rs:472
msgid "Kortlysets lysstyrke i prosent"
msgstr "Luminosité de l’éclairage de la carte en pourcentage"

#: crates/rigg/src/pages/lys_kort.rs:478
msgid "Lysstyrke"
msgstr "Luminosité"

#: crates/rigg/src/pages/lys_kort.rs:490
msgid "Bruk"
msgstr "Appliquer"

#: crates/rigg/src/pages/lys_kort.rs:493
msgid "Gjenopprett utgangspunkt"
msgstr "Restaurer les réglages d’origine"

#: crates/rigg/src/pages/lys_kort.rs:496 crates/rigg/src/pages/lys_kort.rs:1187
msgid "Avslutt lysstyring"
msgstr "Libérer le contrôle de l’éclairage"

#: crates/rigg/src/pages/lys_kort.rs:497
msgid "Bekreft gjenoppretting …"
msgstr "Confirmer la restauration…"

#: crates/rigg/src/pages/lys_kort.rs:511
msgid "Behold"
msgstr "Conserver"

#: crates/rigg/src/pages/lys_kort.rs:512
msgid "Rull tilbake"
msgstr "Annuler"

#: crates/rigg/src/pages/lys_kort.rs:522
msgid "Avlesning: ukjent. Kortet er ikke undersøkt av denne visningen."
msgstr "Lecture inconnue. Cette vue n’a pas interrogé la carte."

#: crates/rigg/src/pages/lys_kort.rs:526
msgid "Farge og lysstyrke kan leses tilbake. Effektmodusen kan ikke leses; en visuell bekreftelse er din observasjon."
msgstr "La couleur et la luminosité sont lisibles, mais pas le mode d’effet. La confirmation visuelle repose sur votre observation."

#: crates/rigg/src/pages/lys_kort.rs:527
msgid "Agentic HW Monitor støtter Palit GeForce RTX 2080 Super JetStream via den separate RGB-hjelperen."
msgstr "Agentic HW Monitor prend en charge la Palit GeForce RTX 2080 Super JetStream via l’assistant RGB séparé."

#: crates/rigg/src/pages/lys_kort.rs:534
msgid "Sjekk igjen"
msgstr "Revérifier"

#: crates/rigg/src/pages/lys_kort.rs:535
msgid "Aktiver kortlys …"
msgstr "Activer l’éclairage de la carte…"

#: crates/rigg/src/pages/lys_kort.rs:536
msgid "Gjenopprett lagret lys …"
msgstr "Restaurer l’éclairage enregistré…"

#: crates/rigg/src/pages/lys_kort.rs:537
msgid "Avklar tidligere økt …"
msgstr "Résoudre la session précédente…"

#: crates/rigg/src/pages/lys_kort.rs:538
msgid "Slå av RGB-tilgang …"
msgstr "Désactiver l’accès RGB…"

#: crates/rigg/src/pages/lys_kort.rs:543
msgid "Detaljer og feilsøking"
msgstr "Détails et dépannage"

#: crates/rigg/src/pages/lys_kort.rs:680
msgid "Jeg ser at lyset på kortet er slukket."
msgstr "Je vois que l’éclairage de la carte est éteint."

#: crates/rigg/src/pages/lys_kort.rs:681
msgid "Jeg ser at lyset viser den forventede faste fargen."
msgstr "Je vois la couleur fixe attendue sur la carte."

#: crates/rigg/src/pages/lys_kort.rs:683 crates/rigg/src/pages/lys_kort.rs:1802
msgid "Bekreft lyset på kortet"
msgstr "Confirmer l’éclairage de la carte"

#: crates/rigg/src/pages/lys_kort.rs:683
msgid "Forventet lys: {lys}.\n\nSe på det fysiske kortet. Samsvarende fargeverdier alene er ikke nok. Hjelperen leser verdiene på nytt før observasjonen din lagres."
msgstr "Éclairage attendu : {lys}.\n\nObservez la carte elle-même. La seule concordance des valeurs de couleur ne suffit pas. L’assistant relit les valeurs avant d’enregistrer votre observation."

#: crates/rigg/src/pages/lys_kort.rs:683 crates/rigg/src/pages/lys_kort.rs:1824
msgid "Bekreft min observasjon"
msgstr "Confirmer mon observation"

#: crates/rigg/src/pages/lys_kort.rs:689
msgid "Lystilstanden er endret"
msgstr "L’état de l’éclairage a changé"

#: crates/rigg/src/pages/lys_kort.rs:689
msgid "Kontroller det nye forventede lyset og åpne bekreftelsen på nytt."
msgstr "Vérifiez le nouvel éclairage attendu et rouvrez la confirmation."

#: crates/rigg/src/pages/lys_kort.rs:881
msgid "Kunne ikke lese kortlyset"
msgstr "Impossible de lire l’éclairage de la carte"

#: crates/rigg/src/pages/lys_kort.rs:883
msgid "Lysendringen ble ikke fullført"
msgstr "La modification de l’éclairage n’a pas abouti"

#: crates/rigg/src/pages/lys_kort.rs:927
msgid "Venter …"
msgstr "En attente…"

#: crates/rigg/src/pages/lys_kort.rs:929
msgid "Frakoblet"
msgstr "Déconnecté"

#: crates/rigg/src/pages/lys_kort.rs:931
msgid "Kortet er utilgjengelig"
msgstr "Carte indisponible"

#: crates/rigg/src/pages/lys_kort.rs:933
msgid "Ikke klar"
msgstr "Non prêt"

#: crates/rigg/src/pages/lys_kort.rs:935
msgid "Må oppdateres"
msgstr "Mise à jour requise"

#: crates/rigg/src/pages/lys_kort.rs:939
msgid "Prøve pågår"
msgstr "Essai en cours"

#: crates/rigg/src/pages/lys_kort.rs:941
msgid "Effekt aktiv"
msgstr "Effet actif"

#: crates/rigg/src/pages/lys_kort.rs:943
msgid "Må avklares"
msgstr "À résoudre"

#: crates/rigg/src/pages/lys_kort.rs:945
msgid "Egen RGB-tillatelse"
msgstr "Autorisation RGB distincte"

#: crates/rigg/src/pages/lys_kort.rs:952
msgid "Simulerte RGB-data · {status}"
msgstr "Données RGB simulées · {status}"

#: crates/rigg/src/pages/lys_kort.rs:963
msgid "Venter på svar. Ingen ny endring kan sendes nå."
msgstr "En attente d’une réponse. Aucune nouvelle modification ne peut être envoyée."

#: crates/rigg/src/pages/lys_kort.rs:965
msgid "Forbindelsen til tjenesten er brutt. Hjelperen håndterer eventuell tilbakeføring."
msgstr "La connexion au service a été perdue. L’assistant annule les modifications si nécessaire."

#: crates/rigg/src/pages/lys_kort.rs:970
msgid "Kortet er ikke tilgjengelig. Nye lysendringer og aktivering er sperret."
msgstr "La carte est indisponible. L’activation et les modifications de l’éclairage sont bloquées."

#: crates/rigg/src/pages/lys_kort.rs:972
msgid "Et annet vindu styrer kortlyset. Her vises bare status."
msgstr "Une autre fenêtre contrôle l’éclairage de la carte. Seul l’état s’affiche ici."

#: crates/rigg/src/pages/lys_kort.rs:974
msgid "Hele kortlyset er én sone. Ingenting sendes før du trykker «Bruk»."
msgstr "L’éclairage de la carte forme une seule zone. Rien n’est envoyé avant que vous appuyiez sur « Appliquer »."

#: crates/rigg/src/pages/lys_kort.rs:976
msgid "RGB-tillatelsen gjelder ikke kortet som er valgt. Ingen endringer kan sendes her."
msgstr "L’autorisation RGB ne couvre pas la carte sélectionnée. Aucune modification ne peut être envoyée ici."

#: crates/rigg/src/pages/lys_kort.rs:979 crates/rigg/src/pages/lys_kort.rs:1565
msgid "RGB-hjelperen er ikke klar. Se «Detaljer og feilsøking» nedenfor."
msgstr "L’assistant RGB n’est pas prêt. Voir « Détails et dépannage » ci-dessous."

#: crates/rigg/src/pages/lys_kort.rs:981
msgid "Velg lys og trykk «Bruk». RGB-hjelperen oppdateres først, og du skriver passordet én gang."
msgstr "Choisissez l’éclairage et appuyez sur « Appliquer ». L’assistant RGB est d’abord mis à jour, et vous saisissez votre mot de passe une seule fois."

#: crates/rigg/src/pages/lys_kort.rs:983
msgid "Velg lys og trykk «Bruk». Første gang aktiveres kortlyset med passordet ditt."
msgstr "Choisissez l’éclairage et appuyez sur « Appliquer ». La première fois, l’éclairage de la carte est activé avec votre mot de passe."

#: crates/rigg/src/pages/lys_kort.rs:994
msgid "Venter på kortets PCI-adresse og UUID."
msgstr "En attente de l’adresse PCI et de l’UUID de la carte."

#: crates/rigg/src/pages/lys_kort.rs:995
msgid "Valgt kort: {pci}"
msgstr "Carte sélectionnée : {pci}"

#: crates/rigg/src/pages/lys_kort.rs:1000
msgid "{effekt} er valgt. Nå vises bare startfargen; animasjonen starter først etter «Behold»."
msgstr "{effekt} est sélectionné. Seule la couleur initiale s’affiche ; l’animation démarre après « Conserver »."

#: crates/rigg/src/pages/lys_kort.rs:1004
msgid "{effekt} er aktiv på hele kortlyset. Velg en annen modus eller farge og trykk «Bruk» for å bytte, eller «Stopp» for å gjenopprette det lagrede utgangspunktet."
msgstr "{effekt} est actif sur l’ensemble de l’éclairage de la carte. Choisissez un autre mode ou une autre couleur puis cliquez sur « Appliquer » pour changer, ou sur « Arrêter » pour restaurer l’état initial enregistré."

#: crates/rigg/src/pages/lys_kort.rs:1010
msgid "Pusting varierer lysstyrken i fargen du velger."
msgstr "La pulsation fait varier la luminosité de la couleur choisie."

#: crates/rigg/src/pages/lys_kort.rs:1012
msgid "Regnbue går gjennom hele fargespekteret fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "L’arc-en-ciel parcourt tout le spectre à partir de la teinte choisie. Les gris commencent au rouge."

#: crates/rigg/src/pages/lys_kort.rs:1015
msgid "Fargesyklus veksler mellom seks tydelige fargetoner fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "Le cycle de couleurs alterne entre six teintes distinctes à partir de la teinte choisie. Les gris commencent au rouge."

#: crates/rigg/src/pages/lys_kort.rs:1018
msgid "{detalj} Først prøves startfargen; «Behold» starter animasjonen på én lyssone."
msgstr "{detalj} La couleur initiale est testée d’abord. « Conserver » lance l’animation sur une zone."

#: crates/rigg/src/pages/lys_kort.rs:1027
msgid "RGB-hjelperen meldte en driftsfeil. Kontroller lyset før du fortsetter."
msgstr "L’assistant RGB a signalé une erreur de fonctionnement. Vérifiez l’éclairage avant de continuer."

#: crates/rigg/src/pages/lys_kort.rs:1039
msgid "{farge} · rå lysstyrke {styrke}, utenfor støttet område"
msgstr "{farge} · luminosité brute {styrke}, hors plage prise en charge"

#: crates/rigg/src/pages/lys_kort.rs:1044
msgid "Lagret utgangspunkt: {lys}. Dette er ikke en ny avlesning."
msgstr "État de référence enregistré : {lys}. Il ne s’agit pas d’une nouvelle lecture."

#: crates/rigg/src/pages/lys_kort.rs:1047
msgid "Sist lest fra kortet: {lys}. Effektmodus: ukjent."
msgstr "Dernière lecture de la carte : {lys}. Mode d’effet : inconnu."

#: crates/rigg/src/pages/lys_kort.rs:1049
msgid "Avlesning: ukjent. Effektmodusen er ikke bekreftet."
msgstr "Lecture inconnue. Le mode d’effet n’est pas confirmé."

#: crates/rigg/src/pages/lys_kort.rs:1055
msgid "Sist bekreftede valg: {lys}. Valget er ikke bevis på avlest effektmodus."
msgstr "Dernier choix confirmé : {lys}. Cela ne prouve pas que le mode d’effet a été relu."

#: crates/rigg/src/pages/lys_kort.rs:1066
msgid "Kontroller startfargen på kortet. «Behold» starter animasjonen; «Rull tilbake» eller fristutløp går tilbake til utgangspunktet."
msgstr "Vérifiez la couleur initiale sur la carte. « Conserver » lance l’animation ; « Annuler » ou l’expiration du délai rétablit l’état de référence."

#: crates/rigg/src/pages/lys_kort.rs:1068
msgid "Se på det fysiske kortet før du beholder endringen. Uten bekreftelse forsøker hjelperen å rulle tilbake."
msgstr "Observez la carte physique avant de conserver la modification. Sans confirmation, l’assistant tente d’annuler la modification."

#: crates/rigg/src/pages/lys_kort.rs:1081
msgid "fristen styres av hjelperen"
msgstr "délai géré par l’assistant"

#: crates/rigg/src/pages/lys_kort.rs:1083
msgid "fristen er ute; venter på status"
msgstr "délai expiré ; en attente de l’état"

#: crates/rigg/src/pages/lys_kort.rs:1085
msgid "bekreft innen {tid}"
msgstr "confirmer dans les {tid}"

#: crates/rigg/src/pages/lys_kort.rs:1129
msgid "Oppgi en gyldig fargekode på seks tegn, for eksempel #3A7BF0."
msgstr "Saisissez un code couleur hexadécimal valide à six caractères, par exemple #3A7BF0."

#: crates/rigg/src/pages/lys_kort.rs:1133
msgid "Bekreft eller rull tilbake prøven som pågår før du bruker en ny innstilling."
msgstr "Conservez ou annulez l’essai en cours avant d’appliquer un nouveau réglage."

#: crates/rigg/src/pages/lys_kort.rs:1135
msgid "Avklar gjenopprettingen eller feilen nedenfor før du bruker en ny innstilling."
msgstr "Réglez la restauration ou l’erreur ci-dessous avant d’appliquer un nouveau réglage."

#: crates/rigg/src/pages/lys_kort.rs:1185 crates/rigg/src/pages/lys_kort.rs:1760
msgid "Stopp"
msgstr "Arrêter"

#: crates/rigg/src/pages/lys_kort.rs:1189
msgid "Gjenopprett det lagrede utgangspunktet og frigi lysstyringen. Se på kortet før du bekrefter gjenopprettingen."
msgstr "Restaurez l’état de référence enregistré et libérez le contrôle. Observez la carte avant de confirmer la restauration."

#: crates/rigg/src/pages/lys_kort.rs:1266 crates/rigg/src/pages/lys_kort.rs:1412
msgid "RGB-oppsettet er ikke klart"
msgstr "Configuration RGB non prête"

#: crates/rigg/src/pages/lys_kort.rs:1278
msgid "Slå av RGB-tilgang"
msgstr "Désactiver l’accès RGB"

#: crates/rigg/src/pages/lys_kort.rs:1279
msgid "Dette stopper RGB-arbeideren og fjerner kortets RGB-tillatelse når gjenopprettingen er avklart. Det lagrede utgangspunktet beholdes."
msgstr "Cette action arrête le processus RGB et retire l’autorisation RGB de la carte une fois la restauration résolue. L’état de référence enregistré est conservé."

#: crates/rigg/src/pages/lys_kort.rs:1280
msgid "Jeg vil slå av RGB-tilgangen for dette kortet."
msgstr "Je veux désactiver l’accès RGB pour cette carte."

#: crates/rigg/src/pages/lys_kort.rs:1284
msgid "Gjenopprett lagret lys"
msgstr "Restaurer l’éclairage enregistré"

#: crates/rigg/src/pages/lys_kort.rs:1285
msgid "Administratorhjelperen stopper RGB-arbeideren hvis den kjører. Hvis det finnes en uavklart journal, forsøker den deretter å gjenopprette det lagrede utgangspunktet. Kontroller lyset og velg «Avklar tidligere økt» etterpå."
msgstr "L’assistant administrateur arrête le processus RGB s’il est en cours. Si le journal contient une opération non résolue, il tente ensuite de restaurer l’état de référence enregistré. Vérifiez l’éclairage, puis choisissez « Résoudre la session précédente »."

#: crates/rigg/src/pages/lys_kort.rs:1286
msgid "Jeg vil gjenopprette det lagrede utgangspunktet på dette kortet."
msgstr "Je veux restaurer l’état de référence enregistré sur cette carte."

#: crates/rigg/src/pages/lys_kort.rs:1289
msgid "Aktiver lys på kortet"
msgstr "Activer l’éclairage de la carte"

#: crates/rigg/src/pages/lys_kort.rs:1290
msgid "Se på det fysiske kortet før du fortsetter. Lyset må allerede vise én fast farge. Pust, fargeskift og et ukjent utgangspunkt kan ikke lagres som et sikkert utgangspunkt. Administratorgodkjenningen gjelder bare kortlyset; den endrer ikke GPU-tillatelsen."
msgstr "Observez la carte physique avant de continuer. Elle doit déjà afficher une couleur fixe unique. Une pulsation, des couleurs changeantes ou un état inconnu ne peuvent pas servir d’état de référence sûr. L’autorisation administrateur concerne uniquement l’éclairage et ne modifie pas les autorisations GPU."

#: crates/rigg/src/pages/lys_kort.rs:1291
msgid "Jeg ser kortet og bekrefter at det viser én fast farge."
msgstr "Je vois la carte et confirme qu’elle affiche une seule couleur fixe."

#: crates/rigg/src/pages/lys_kort.rs:1297
msgid "Har en tidligere RGB-økt ikke blitt avsluttet, settes kortet først tilbake til det lagrede lyset i samme godkjenning. Deretter ber appen deg se på kortet og bekrefte det gjenopprettede lyset før økten avsluttes og oppdateringen fortsetter."
msgstr "Si une session RGB précédente n’a pas été terminée, la carte revient d’abord à l’éclairage enregistré, dans la même autorisation. L’application vous demande ensuite de regarder la carte et de confirmer l’éclairage restauré avant que la session soit clôturée et que la mise à jour continue."

#: crates/rigg/src/pages/lys_kort.rs:1305
msgid "Kort: {kort}\n\n{beskrivelse}"
msgstr "Carte : {kort}\n\n{beskrivelse}"

#: crates/rigg/src/pages/lys_kort.rs:1305
msgid "Lagret binding"
msgstr "Association de carte enregistrée"

#: crates/rigg/src/pages/lys_kort.rs:1307 crates/rigg/src/pages/lys_kort.rs:1321
msgid "Fortsett til administratorgodkjenning"
msgstr "Continuer vers l’autorisation administrateur"

#: crates/rigg/src/pages/lys_kort.rs:1340
msgid "Avklar tidligere RGB-økt"
msgstr "Résoudre la session RGB précédente"

#: crates/rigg/src/pages/lys_kort.rs:1341
msgid "Lagret lys for {kort}: {lys}.\n\nSe på kortet. Fortsett bare hvis lyset viser dette utgangspunktet som én fast farge."
msgstr "Éclairage enregistré pour {kort} : {lys}.\n\nObservez la carte. Ne continuez que si elle affiche cet état de référence sous forme d’une seule couleur fixe."

#: crates/rigg/src/pages/lys_kort.rs:1342
msgid "Jeg ser at kortlyset viser det lagrede, faste utgangspunktet."
msgstr "Je vois que la carte affiche l’état de référence fixe enregistré."

#: crates/rigg/src/pages/lys_kort.rs:1372
msgid "Bekreft og fortsett oppdateringen"
msgstr "Confirmer et poursuivre la mise à jour"

#: crates/rigg/src/pages/lys_kort.rs:1385 crates/rigg/src/pages/lys_kort.rs:1509
msgid "RGB-oppsettet er oppdatert. Kontroller status før du bruker en farge."
msgstr "La configuration RGB a été mise à jour. Vérifiez l’état avant d’appliquer une couleur."

#: crates/rigg/src/pages/lys_kort.rs:1387 crates/rigg/src/pages/lys_kort.rs:1517
msgid "RGB-oppsett"
msgstr "Configuration RGB"

#: crates/rigg/src/pages/lys_kort.rs:1466 crates/rigg/src/pages/lys_kort.rs:1513
msgid "RGB-oppsettet kunne ikke fullføres."
msgstr "Impossible de terminer la configuration RGB."

#: crates/rigg/src/pages/lys_kort.rs:1505
msgid "RGB-arbeideren er stoppet. Kontroller lyset og velg «Avklar tidligere økt» hvis en gjenoppretting gjenstår."
msgstr "Le processus RGB est arrêté. Vérifiez l’éclairage et choisissez « Résoudre la session précédente » si une restauration est encore en attente."

#: crates/rigg/src/pages/lys_kort.rs:1506
msgid "Ingen uavklart RGB-journal for kortet. Du kan slå av RGB-tilgangen."
msgstr "Aucun journal RGB non résolu pour cette carte. Vous pouvez désactiver l’accès RGB."

#: crates/rigg/src/pages/lys_kort.rs:1507
msgid "Gjenopprettingen er avklart. Du kan slå av RGB-tilgangen eller aktivere lysstyring på nytt."
msgstr "La restauration est résolue. Vous pouvez désactiver l’accès RGB ou réactiver le contrôle de l’éclairage."

#: crates/rigg/src/pages/lys_kort.rs:1508
msgid "RGB-tilgangen er slått av."
msgstr "L’accès RGB est désactivé."

#: crates/rigg/src/pages/lys_kort.rs:1510
msgid "Administratorgodkjenningen ble avbrutt."
msgstr "L’autorisation administrateur a été annulée."

#: crates/rigg/src/pages/lys_kort.rs:1511
msgid "Avklaringsmålet er ugyldig eller gjelder et annet valgt kort."
msgstr "La cible de restauration est invalide ou concerne une autre carte."

#: crates/rigg/src/pages/lys_kort.rs:1517
msgid "RGB-oppsett ble ikke fullført"
msgstr "Configuration RGB incomplète"

#: crates/rigg/src/pages/lys_kort.rs:1543
msgid "Administratorhandlinger for RGB krever appens vanlige maskinvareoppsett."
msgstr "Les actions administrateur RGB nécessitent l’environnement matériel normal de l’application."

#: crates/rigg/src/pages/lys_kort.rs:1567
msgid "Systemkomponentene mangler. Se «Uten nett: bruk terminal» under «Detaljer og feilsøking»."
msgstr "Des composants système sont manquants. Voir « Hors ligne : utiliser un terminal » dans « Détails et dépannage »."

#: crates/rigg/src/pages/lys_kort.rs:1609
msgid "Avbryt"
msgstr "Annuler"
