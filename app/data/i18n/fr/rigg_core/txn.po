#: crates/rigg-core/src/txn.rs:278
msgid "Aktiver skjermkortstyring i Innstillinger, og vent til hjelperen er klar"
msgstr "Activez les réglages du GPU dans les Paramètres et attendez que l’assistant soit prêt"

#: crates/rigg-core/src/txn.rs:279
msgid "Viftekurven må være en liste med punkter"
msgstr "La courbe de ventilation doit être une liste de points"

#: crates/rigg-core/src/txn.rs:280
msgid "Temperaturene i viftekurven må stige"
msgstr "Les températures de la courbe de ventilation doivent augmenter"

#: crates/rigg-core/src/txn.rs:281
msgid "fan.curves må være en liste med kurver"
msgstr "fan.curves doit être une liste de courbes"

#: crates/rigg-core/src/txn.rs:282
msgid "settings må være et objekt"
msgstr "settings doit être un objet"

#: crates/rigg-core/src/txn.rs:283
msgid "clockOffsets må være et objekt"
msgstr "clockOffsets doit être un objet"

#: crates/rigg-core/src/txn.rs:284
msgid "fan må være et objekt"
msgstr "fan doit être un objet"

#: crates/rigg-core/src/txn.rs:285
msgid "fan.mode må være auto, curve eller manual"
msgstr "fan.mode doit être auto, curve ou manual"

#: crates/rigg-core/src/txn.rs:286
msgid "fan.perFan må være true eller false"
msgstr "fan.perFan doit être true ou false"

#: crates/rigg-core/src/txn.rs:287
msgid "confirmTimeoutS må være et tall"
msgstr "confirmTimeoutS doit être un nombre"

#: crates/rigg-core/src/txn.rs:288
msgid "Oppsettet må være innenfor rapporterte grenser og viftekurven må være stigende."
msgstr "Les réglages doivent respecter les limites indiquées et la courbe de ventilation doit être croissante."

#: crates/rigg-core/src/txn.rs:304
msgid "Vifte {nummer}: {feil}"
msgstr "Ventilateur {nummer} : {feil}"

#: crates/rigg-core/src/txn.rs:307
msgid "Ukjent felt: {felt}"
msgstr "Champ inconnu : {felt}"

#: crates/rigg-core/src/txn.rs:311
msgid "Effektgrensen"
msgstr "Limite de puissance"

#: crates/rigg-core/src/txn.rs:312
msgid "Temperaturmålet"
msgstr "Température cible"

#: crates/rigg-core/src/txn.rs:313
msgid "Kjerneklokke-offset"
msgstr "Décalage de la fréquence du cœur"

#: crates/rigg-core/src/txn.rs:314
msgid "Minneklokke-offset"
msgstr "Décalage de la fréquence mémoire"

#: crates/rigg-core/src/txn.rs:315
msgid "Viftefarten"
msgstr "Vitesse des ventilateurs"

#: crates/rigg-core/src/txn.rs:316
msgid "Viftefarten i kurven"
msgstr "Vitesse des ventilateurs sur la courbe"

#: crates/rigg-core/src/txn.rs:317
msgid "Temperaturen i kurven"
msgstr "Température sur la courbe"

#: crates/rigg-core/src/txn.rs:318
msgid "Hysteresen"
msgstr "Hystérésis"

#: crates/rigg-core/src/txn.rs:319
msgid "Rampefarten opp"
msgstr "Vitesse de montée"

#: crates/rigg-core/src/txn.rs:320
msgid "Rampefarten ned"
msgstr "Vitesse de descente"

#: crates/rigg-core/src/txn.rs:321
msgid "Utjevningen"
msgstr "Lissage"

#: crates/rigg-core/src/txn.rs:322
msgid "«Hold minimum til»"
msgstr "« Maintenir la vitesse minimale jusqu’à »"

#: crates/rigg-core/src/txn.rs:325
msgid "{felt} må være et tall"
msgstr "{felt} doit être un nombre"

#: crates/rigg-core/src/txn.rs:340
msgid "Viftekurven må ha {min}–{maks} punkter"
msgstr "La courbe de ventilation doit comporter de {min} à {maks} points"

#: crates/rigg-core/src/txn.rs:345
msgid "Ugyldig punkt {nummer} i viftekurven"
msgstr "Point {nummer} non valide dans la courbe de ventilation"

#: crates/rigg-core/src/txn.rs:350
msgid "Punkt {nummer}: temperaturen må være {min}–{maks}"
msgstr "Point {nummer} : la température doit être comprise entre {min} et {maks}"

#: crates/rigg-core/src/txn.rs:355
msgid "fan.curves kan ha høyst {maks} kurver"
msgstr "fan.curves accepte au maximum {maks} courbes"

