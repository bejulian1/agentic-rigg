msgid "Appen har ingen tilgjengelig minnetemperatur fra NVML for denne prøven. Tilgjengelighet avhenger av kortet og driveren."
msgstr "NVML ne fournit pas de température mémoire pour cet échantillon. La disponibilité dépend du GPU et du pilote."

#: crates/rigg-core/src/report/gpu.rs:520
msgid "Minnetemperatur"
msgstr "Température mémoire"

#: crates/rigg-core/src/report/gpu.rs:520 crates/rigg-core/src/report/gpu.rs:522
msgid "Ikke verifisert"
msgstr "Non vérifié"

#: crates/rigg-core/src/report/gpu.rs:521
