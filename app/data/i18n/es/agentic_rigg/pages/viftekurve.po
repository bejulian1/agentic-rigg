msgstr "Abrir vista avanzada"

#: crates/rigg/src/pages/viftekurve.rs:1906
msgid "Punktene"
msgstr "Puntos de control"

#: crates/rigg/src/pages/viftekurve.rs:1907
msgid "Legg til"
msgstr "Añadir"

#: crates/rigg/src/pages/viftekurve.rs:1908
