#: crates/rigg/src/pages/viftekurve.rs:59
msgid "Stille"
msgstr "Silencioso"

#: crates/rigg/src/pages/viftekurve.rs:66
msgid "Minste fart til 55 °C, 5 °C hysterese, rolig rampe (5 %/s opp, 2 %/s ned) og 5 s utjevning"
msgstr "Velocidad mínima hasta 55 °C, histéresis de 5 °C, rampa suave (subida de 5 %/s, bajada de 2 %/s) y suavizado de 5 s"

#: crates/rigg/src/pages/viftekurve.rs:70
msgid "Balansert"
msgstr "Equilibrado"

#: crates/rigg/src/pages/viftekurve.rs:77
msgid "Standardkurven: 3 °C hysterese, 10 %/s opp og 3 %/s ned, ingen utjevning"
msgstr "Curva predeterminada: histéresis de 3 °C, subida de 10 %/s y bajada de 3 %/s, sin suavizado"

#: crates/rigg/src/pages/viftekurve.rs:81
msgid "Ytelse"
msgstr "Rendimiento"

#: crates/rigg/src/pages/viftekurve.rs:88
msgid "Kjøligst: høyere kurve, 2 °C hysterese og rask rampe (20 %/s opp, 5 %/s ned)"
msgstr "Máxima refrigeración: curva más alta, histéresis de 2 °C y rampa rápida (subida de 20 %/s, bajada de 5 %/s)"

#: crates/rigg/src/pages/viftekurve.rs:121
msgid "{navn} · endret"
msgstr "{navn} · modificado"

#: crates/rigg/src/pages/viftekurve.rs:528
msgid "GPU-temperatur"
msgstr "Temperatura de la GPU"

#: crates/rigg/src/pages/viftekurve.rs:529
msgid "Minst {fart} (driver)"
msgstr "Mín. {fart} (controlador)"

#: crates/rigg/src/pages/viftekurve.rs:529
msgid "Minste fart er ikke avlest"
msgstr "No se indica la velocidad mínima"

#: crates/rigg/src/pages/viftekurve.rs:532
msgid "Under {fart} er ikke mulig"
msgstr "No se puede bajar de {fart}"

#: crates/rigg/src/pages/viftekurve.rs:536
msgid "Nødregel {fart} over {temperatur}"
msgstr "Emergencia: {fart} por encima de {temperatur}"

#: crates/rigg/src/pages/viftekurve.rs:595
msgid "Minst {fart} til {temperatur}"
msgstr "Al menos {fart} hasta {temperatur}"

#: crates/rigg/src/pages/viftekurve.rs:604
msgid "Ned · {grader} hysterese"
msgstr "Bajada · histéresis de {grader}"

#: crates/rigg/src/pages/viftekurve.rs:631
msgid "Nå {temperatur} · {fart}"
msgstr "Ahora: {temperatur} · {fart}"

#: crates/rigg/src/pages/viftekurve.rs:686
msgid "Ved {temperatur}: kurven {fart}"
msgstr "A {temperatur}: curva {fart}"

#: crates/rigg/src/pages/viftekurve.rs:689
msgid " (ned {fart})"
msgstr " (bajada: {fart})"

#: crates/rigg/src/pages/viftekurve.rs:692
msgid ", driveren {fart} (median av {n})"
msgstr ", controlador: {fart} (mediana de {n})"

#: crates/rigg/src/pages/viftekurve.rs:693
msgid ", {n} måling"
msgid_plural ", {n} målinger"
msgstr[0] ", {n} muestra"
msgstr[1] ", {n} muestras"

#: crates/rigg/src/pages/viftekurve.rs:756
msgid "Viftekurven: viftefart mot GPU-temperatur"
msgstr "Curva de ventiladores: velocidad según la temperatura de la GPU"

#: crates/rigg/src/pages/viftekurve.rs:1156
msgid "nå"
msgstr "ahora"

#: crates/rigg/src/pages/viftekurve.rs:1193
msgid "Viftene de siste fem minuttene, slik de gikk og med kurven"
msgstr "Ventiladores en los últimos cinco minutos: velocidad real y vista previa de la curva"

#: crates/rigg/src/pages/viftekurve.rs:1227 crates/rigg/src/pages/viftekurve.rs:2605
msgid "Auto (driveren)"
msgstr "Auto (controlador)"

#: crates/rigg/src/pages/viftekurve.rs:1227
msgid "Driveren styrer viftene etter temperaturen, som uten appen. Standard."
msgstr "El controlador regula los ventiladores según la temperatura, igual que sin la aplicación. Modo predeterminado."

#: crates/rigg/src/pages/viftekurve.rs:1228 crates/rigg/src/pages/viftekurve.rs:2607
msgid "Kurve"
msgstr "Curva"

#: crates/rigg/src/pages/viftekurve.rs:1228
msgid "Agentic Rigg setter farten etter viftekurven hvert sekund."
msgstr "Agentic Rigg actualiza cada segundo la velocidad de los ventiladores según la curva."

#: crates/rigg/src/pages/viftekurve.rs:1229 crates/rigg/src/pages/viftekurve.rs:2606
msgid "Manuell"
msgstr "Manual"

#: crates/rigg/src/pages/viftekurve.rs:1229
msgid "Fast fart, uansett temperatur. Pass på temperaturen under last."
msgstr "Velocidad fija independientemente de la temperatura. Vigila la temperatura bajo carga."

#: crates/rigg/src/pages/viftekurve.rs:1236
msgid "Egen kurve er aktiv på kortet. Modusbyttet ligger bare i utkastet til du trykker Bruk og Behold."
msgstr "Hay una curva personalizada activa. El cambio de modo queda en el borrador hasta que pulses Aplicar y Conservar."

#: crates/rigg/src/pages/viftekurve.rs:1238
msgid "Egen kurve er aktiv på kortet. Du har et kurveutkast; åpne Avansert for å se og redigere det."
msgstr "Hay una curva personalizada activa y un borrador guardado. Abre la vista avanzada para ver o editar el borrador."

#: crates/rigg/src/pages/viftekurve.rs:1240
msgid "Egen kurve er aktiv. Viftene fortsetter å følge den i Enkel visning. Åpne Avansert for å se og redigere kurven."
msgstr "Hay una curva personalizada activa. Los ventiladores la siguen también en la vista básica. Abre la vista avanzada para verla o editarla."

#: crates/rigg/src/pages/viftekurve.rs:1243
msgid "Egen kurve er valgt i utkastet. Åpne Avansert for å se kurven. Kortet endres først med Bruk og Behold."
msgstr "El borrador usa una curva personalizada. Abre la vista avanzada para verla. La GPU solo cambia cuando pulsas Aplicar y Conservar."

#: crates/rigg/src/pages/viftekurve.rs:1255
msgid "Felles kurve"
msgstr "Curva compartida"

#: crates/rigg/src/pages/viftekurve.rs:1257
msgid "Vifte {i}"
msgstr "Ventilador {i}"

#: crates/rigg/src/pages/viftekurve.rs:1265
msgid "Kurven som redigeres"
msgstr "Curva en edición"

#: crates/rigg/src/pages/viftekurve.rs:1268
msgid "Én felles kurve for kortets vifter"
msgstr "Una curva compartida para todos los ventiladores de la GPU"

#: crates/rigg/src/pages/viftekurve.rs:1270
msgid "Egen kurve for vifte {id}. En annen vifte kan vises svakt bak."
msgstr "Curva personalizada del ventilador {id}. La curva de otro ventilador puede verse atenuada detrás."

#: crates/rigg/src/pages/viftekurve.rs:1283
msgid "Antall GPU-vifter er ikke lest. Viftestyring venter på kortets informasjon."
msgstr "El control de ventiladores está a la espera de que la GPU indique cuántos tiene."

#: crates/rigg/src/pages/viftekurve.rs:1284
msgid "Kortet rapporterer ingen GPU-vifter. Viftestyring er utilgjengelig."
msgstr "La GPU indica que no tiene ventiladores. El control de ventiladores no está disponible."

#: crates/rigg/src/pages/viftekurve.rs:1285
msgid "Kortet rapporterer {n} vifter. Kurvemotoren støtter høyst {maks} vifter på ett kort."
msgstr "La GPU indica que tiene {n} ventiladores. El control por curva admite hasta {maks} ventiladores por GPU."

