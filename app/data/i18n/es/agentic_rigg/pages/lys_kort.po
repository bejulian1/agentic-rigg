#: crates/rigg/src/pages/lys_kort.rs:114 crates/rigg/src/pages/lys_kort.rs:592
msgid "Pusting"
msgstr "Respiración"

#: crates/rigg/src/pages/lys_kort.rs:115 crates/rigg/src/pages/lys_kort.rs:593
msgid "Regnbue"
msgstr "Arcoíris"

#: crates/rigg/src/pages/lys_kort.rs:116 crates/rigg/src/pages/lys_kort.rs:594
msgid "Fargesyklus"
msgstr "Ciclo de colores"

#: crates/rigg/src/pages/lys_kort.rs:134
msgid "Lysstyringen er opptatt eller tilhører et annet vindu."
msgstr "El control de iluminación está ocupado o pertenece a otra ventana."

#: crates/rigg/src/pages/lys_kort.rs:135
msgid "Lysprøven finnes ikke lenger eller fristen er ute."
msgstr "La prueba de iluminación ya no está activa o ha caducado."

#: crates/rigg/src/pages/lys_kort.rs:136
msgid "Nye lysendringer er sperret. Kontroller status og avklar eventuell gjenoppretting."
msgstr "No se permiten nuevos cambios de iluminación. Comprueba el estado y resuelve cualquier restauración pendiente."

#: crates/rigg/src/pages/lys_kort.rs:137
msgid "RGB-tillatelsen for dette kortet kunne ikke bekreftes."
msgstr "No se ha podido verificar el permiso RGB para esta tarjeta."

#: crates/rigg/src/pages/lys_kort.rs:138
msgid "Det valgte kortet er ikke tilgjengelig."
msgstr "La tarjeta seleccionada no está disponible."

#: crates/rigg/src/pages/lys_kort.rs:139 crates/rigg/src/pages/lys_kort.rs:1639
msgid "RGB-hjelperen støtter ikke dette lysvalget."
msgstr "El asistente RGB no admite este ajuste de iluminación."

#: crates/rigg/src/pages/lys_kort.rs:140
msgid "RGB-hjelperen avviste forespørselen. Les status før du prøver igjen."
msgstr "El asistente RGB ha rechazado la solicitud. Comprueba el estado antes de reintentar."

#: crates/rigg/src/pages/lys_kort.rs:143
msgid "RGB-forespørselen mislyktes. Sjekk status og se på kortet før du prøver igjen."
msgstr "Ha fallado la solicitud RGB. Comprueba el estado y mira la tarjeta antes de reintentar."

#: crates/rigg/src/pages/lys_kort.rs:164
msgid "Avlesning av kortlyset mislyktes. Nye lysendringer er sperret."
msgstr "No se ha podido leer la iluminación. Se han bloqueado los nuevos cambios."

#: crates/rigg/src/pages/lys_kort.rs:167
msgid "Gjenopprettingen er bekreftet av deg. Effektmodusen er fortsatt ikke maskinelt avlest."
msgstr "Has confirmado la restauración. Aún no se ha leído el modo de efecto del hardware."

#: crates/rigg/src/pages/lys_kort.rs:171
msgid "Farge og lysstyrke samsvarer etter tilbakeføring. Se på kortet før du bekrefter gjenopprettingen."
msgstr "El color y el brillo coinciden tras revertir. Mira la tarjeta antes de confirmar la restauración."

#: crates/rigg/src/pages/lys_kort.rs:172
msgid "Tilbakeføringen samsvarer ikke med avlesningen. Nye fargeendringer er sperret."
msgstr "La lectura no coincide con el estado esperado tras revertir. Se han bloqueado los cambios de color."

#: crates/rigg/src/pages/lys_kort.rs:173 crates/rigg/src/pages/lys_kort.rs:174
msgid "Gjenopprettingen er uavklart. Nye fargeendringer er sperret."
msgstr "La restauración sigue sin resolverse. Se han bloqueado los cambios de color."

#: crates/rigg/src/pages/lys_kort.rs:180
msgid "Gjenopprett lagret Av"
msgstr "Restaurar el apagado guardado"

#: crates/rigg/src/pages/lys_kort.rs:180
msgid "Gjenopprett lagret lys"
msgstr "Restaurar iluminación guardada"

#: crates/rigg/src/pages/lys_kort.rs:319
msgid "Svart med 0 %, holdt mens appen er åpen"
msgstr "Negro al 0 %, mantenido mientras la aplicación está abierta"

#: crates/rigg/src/pages/lys_kort.rs:320
msgid "Svart med 100 %"
msgstr "Negro al 100 %"

#: crates/rigg/src/pages/lys_kort.rs:321
msgid "Svart med 0 %"
msgstr "Negro al 0 %"

#: crates/rigg/src/pages/lys_kort.rs:322
msgid "Valgt farge med 0 %"
msgstr "Color elegido al 0 %"

#: crates/rigg/src/pages/lys_kort.rs:323
msgid "Nesten svart (#010101) med 1 %"
msgstr "Casi negro (#010101) al 1 %"

#: crates/rigg/src/pages/lys_kort.rs:353 crates/rigg/src/pages/lys_kort.rs:356
msgid "Av"
msgstr "Desactivado"

#: crates/rigg/src/pages/lys_kort.rs:358
msgid "fast farge {farge} · {styrke}"
msgstr "color fijo {farge} · {styrke}"

#: crates/rigg/src/pages/lys_kort.rs:359
msgid "Ingen kjent innstilling"
msgstr "No hay ajustes conocidos"

#: crates/rigg/src/pages/lys_kort.rs:376 crates/rigg/src/pages/lys_kort.rs:1546
msgid "{farge} · rå lysstyrke {styrke}, utenfor støttet område"
msgstr "{farge} · brillo bruto {styrke}, fuera del intervalo admitido"

#: crates/rigg/src/pages/lys_kort.rs:377
msgid "et lys som ikke kunne leses"
msgstr "una iluminación que no se pudo leer"

#: crates/rigg/src/pages/lys_kort.rs:547
msgid "Lys på kortet"
msgstr "Iluminación de la tarjeta"

#: crates/rigg/src/pages/lys_kort.rs:552 crates/rigg/src/pages/lys_kort.rs:1423
msgid "Ikke aktivert"
msgstr "Sin activar"

#: crates/rigg/src/pages/lys_kort.rs:586
msgid "Kortlys på eller av"
msgstr "Iluminación de la tarjeta encendida o apagada"

#: crates/rigg/src/pages/lys_kort.rs:587
msgid "Kortlys"
msgstr "Iluminación de la tarjeta"

#: crates/rigg/src/pages/lys_kort.rs:591
msgid "Fast farge"
msgstr "Color fijo"

#: crates/rigg/src/pages/lys_kort.rs:597
msgid "Fysisk lysmodus"
msgstr "Modo de iluminación física"

#: crates/rigg/src/pages/lys_kort.rs:601
msgid "Modus"
msgstr "Modo"

#: crates/rigg/src/pages/lys_kort.rs:618
msgid "Farge på kortet, seks heksadesimale siffer"
msgstr "Color de la tarjeta, seis dígitos hexadecimales"

#: crates/rigg/src/pages/lys_kort.rs:631 crates/rigg/src/pages/lys_kort.rs:632
msgid "Velg farge …"
msgstr "Elegir color…"

#: crates/rigg/src/pages/lys_kort.rs:638
msgid "Hurtigfarger"
msgstr "Colores rápidos"

#: crates/rigg/src/pages/lys_kort.rs:670
msgid "Farge"
msgstr "Color"

#: crates/rigg/src/pages/lys_kort.rs:680 crates/rigg/src/pages/lys_kort.rs:690
msgid "Kortlysets lysstyrke i prosent"
msgstr "Brillo de la iluminación de la tarjeta en porcentaje"

#: crates/rigg/src/pages/lys_kort.rs:696
msgid "Lysstyrke"
msgstr "Brillo"

#: crates/rigg/src/pages/lys_kort.rs:699
msgid "Behold også etter at appen lukkes"
msgstr "Conservar al cerrar la aplicación"

#: crates/rigg/src/pages/lys_kort.rs:727
msgid "Bruk"
msgstr "Aplicar"

#: crates/rigg/src/pages/lys_kort.rs:730
msgid "Gjenopprett utgangspunkt"
msgstr "Restaurar ajustes originales"

#: crates/rigg/src/pages/lys_kort.rs:733 crates/rigg/src/pages/lys_kort.rs:1700
msgid "Avslutt lysstyring"
msgstr "Liberar el control de iluminación"

#: crates/rigg/src/pages/lys_kort.rs:734
msgid "Bekreft lyset …"
msgstr "Confirmar la iluminación…"

#: crates/rigg/src/pages/lys_kort.rs:750 crates/rigg/src/pages/lys_kort.rs:1602
msgid "Behold"
msgstr "Conservar"

#: crates/rigg/src/pages/lys_kort.rs:751
msgid "Rull tilbake"
msgstr "Revertir"

#: crates/rigg/src/pages/lys_kort.rs:761
msgid "Avlesning: ukjent. Kortet er ikke undersøkt av denne visningen."
msgstr "Lectura desconocida. Esta vista no ha consultado la tarjeta."

#: crates/rigg/src/pages/lys_kort.rs:765
msgid "Farge og lysstyrke kan leses tilbake. Effektmodusen kan ikke leses; en visuell bekreftelse er din observasjon."
msgstr "Es posible leer el color y el brillo, pero no el modo de efecto. La confirmación visual se basa en lo que ves."

#: crates/rigg/src/pages/lys_kort.rs:766
msgid "Agentic HW Monitor støtter Palit GeForce RTX 2080 Super JetStream via den separate RGB-hjelperen."
msgstr "Agentic HW Monitor admite la Palit GeForce RTX 2080 Super JetStream mediante el asistente RGB independiente."

#: crates/rigg/src/pages/lys_kort.rs:775 crates/rigg/src/pages/lys_kort.rs:777
msgid "Skrivemåte for «Av»"
msgstr "Forma de escribir «Apagado»"

#: crates/rigg/src/pages/lys_kort.rs:781
msgid "Sjekk igjen"
msgstr "Volver a comprobar"

#: crates/rigg/src/pages/lys_kort.rs:782
msgid "Åpne Innstillinger › Skjermkortstyring"
msgstr "Abrir Ajustes › Control de GPU"

#: crates/rigg/src/pages/lys_kort.rs:783 crates/rigg/src/pages/lys_kort.rs:1652 crates/rigg/src/pages/lys_kort.rs:2263
msgid "Jeg ser én fast farge"
msgstr "Veo un color fijo"

#: crates/rigg/src/pages/lys_kort.rs:786
msgid "Tilbake til fabrikklyset"
msgstr "Volver a la iluminación de fábrica"

#: crates/rigg/src/pages/lys_kort.rs:790
msgid "Detaljer og feilsøking"
msgstr "Detalles y solución de problemas"

#: crates/rigg/src/pages/lys_kort.rs:999
msgid "Jeg ser at lyset på kortet er slukket."
msgstr "Veo que la iluminación de la tarjeta está apagada."

#: crates/rigg/src/pages/lys_kort.rs:1000
msgid "Jeg ser at lyset viser den forventede faste fargen."
msgstr "Veo el color fijo esperado en la tarjeta."

#: crates/rigg/src/pages/lys_kort.rs:1002 crates/rigg/src/pages/lys_kort.rs:2024
msgid "Bekreft lyset på kortet"
msgstr "Confirmar la iluminación de la tarjeta"

#: crates/rigg/src/pages/lys_kort.rs:1002
msgid "Forventet lys: {lys}.\n\nSe på det fysiske kortet. Samsvarende fargeverdier alene er ikke nok. Hjelperen leser verdiene på nytt før observasjonen din lagres."
msgstr "Iluminación esperada: {lys}.\n\nMira la tarjeta física. No basta con que coincidan los valores de color. El asistente vuelve a leer los valores antes de guardar tu observación."

#: crates/rigg/src/pages/lys_kort.rs:1002 crates/rigg/src/pages/lys_kort.rs:2046
msgid "Bekreft min observasjon"
msgstr "Confirmar lo que veo"

#: crates/rigg/src/pages/lys_kort.rs:1008 crates/rigg/src/pages/lys_kort.rs:1013
msgid "Lystilstanden er endret"
msgstr "El estado de la iluminación ha cambiado"

#: crates/rigg/src/pages/lys_kort.rs:1008 crates/rigg/src/pages/lys_kort.rs:1013
msgid "Kontroller det nye forventede lyset og åpne bekreftelsen på nytt."
msgstr "Comprueba la nueva iluminación esperada y vuelve a abrir la confirmación."

#: crates/rigg/src/pages/lys_kort.rs:1255 crates/rigg/src/pages/lys_kort.rs:1679
msgid "Kortet viser ikke det lagrede utgangspunktet"
msgstr "La tarjeta no muestra el punto de partida guardado"

#: crates/rigg/src/pages/lys_kort.rs:1262
msgid "Kunne ikke lese kortlyset"
msgstr "No se ha podido leer la iluminación de la tarjeta"

#: crates/rigg/src/pages/lys_kort.rs:1263 crates/rigg/src/pages/lys_kort.rs:1308
msgid "Valget ble ikke lagret som varig"
msgstr "La elección no se guardó como permanente"

#: crates/rigg/src/pages/lys_kort.rs:1264 crates/rigg/src/pages/lys_kort.rs:1312
msgid "«Av» holdes ikke"
msgstr "«Apagado» no se mantiene"

#: crates/rigg/src/pages/lys_kort.rs:1265 crates/rigg/src/pages/lys_kort.rs:1664
msgid "Lysendringen ble ikke fullført"
msgstr "No se ha completado el cambio de iluminación"

#: crates/rigg/src/pages/lys_kort.rs:1309
msgid "Lyset er beholdt, men ikke lagret som kortets utgangspunkt. Trykk «Bruk» og «Behold» igjen for å prøve på nytt."
msgstr "La iluminación se mantuvo, pero no se guardó como punto de partida de la tarjeta. Pulsa «Aplicar» y «Conservar» de nuevo para volver a intentarlo."

#: crates/rigg/src/pages/lys_kort.rs:1313
msgid "«Av» er satt, men skrives ikke på nytt mens appen er åpen. Trykk «Bruk» igjen for å starte det."
msgstr "«Apagado» está aplicado, pero no se vuelve a escribir mientras la aplicación está abierta. Pulsa «Aplicar» de nuevo para iniciarlo."

#: crates/rigg/src/pages/lys_kort.rs:1402 crates/rigg/src/pages/lys_kort.rs:2265
msgid "Bekreft kortets første lysopptak"
msgstr "Confirma la iluminación inicial de la tarjeta"

#: crates/rigg/src/pages/lys_kort.rs:1402 crates/rigg/src/pages/lys_kort.rs:1670 crates/rigg/src/pages/lys_kort.rs:2265
msgid "Lyset må avklares"
msgstr "Hay que resolver la iluminación"

#: crates/rigg/src/pages/lys_kort.rs:1404
msgid "Se på kortet. Bekreft bare hvis det viser én fast farge."
msgstr "Observa la tarjeta. Confirma solo si muestra un único color fijo."

#: crates/rigg/src/pages/lys_kort.rs:1406
msgid "Behold lyset du ser, eller gjenopprett det lagrede lyset."
msgstr "Conserva la iluminación que ves o restaura la iluminación guardada."

#: crates/rigg/src/pages/lys_kort.rs:1409
msgid "Venter …"
msgstr "Esperando…"

#: crates/rigg/src/pages/lys_kort.rs:1411
msgid "Frakoblet"
msgstr "Desconectado"

#: crates/rigg/src/pages/lys_kort.rs:1413
msgid "Kortet er utilgjengelig"
msgstr "Tarjeta no disponible"

#: crates/rigg/src/pages/lys_kort.rs:1415
msgid "Ikke klar"
msgstr "No lista"

#: crates/rigg/src/pages/lys_kort.rs:1417
msgid "Må oppdateres"
msgstr "Requiere actualización"

#: crates/rigg/src/pages/lys_kort.rs:1419 crates/rigg/src/pages/lys_kort.rs:1477
msgid "Ikke støttet"
msgstr "No compatible"

#: crates/rigg/src/pages/lys_kort.rs:1421 crates/rigg/src/pages/lys_kort.rs:1479
msgid "Venter på enhet"
msgstr "Esperando el dispositivo"

#: crates/rigg/src/pages/lys_kort.rs:1425
msgid "Prøve pågår"
msgstr "Prueba en curso"

#: crates/rigg/src/pages/lys_kort.rs:1427 crates/rigg/src/pages/lys_kort.rs:2258
msgid "Må avklares"
msgstr "Requiere resolución"

#: crates/rigg/src/pages/lys_kort.rs:1429
msgid "Avviker"
msgstr "Difiere"

#: crates/rigg/src/pages/lys_kort.rs:1431
msgid "Effekt aktiv"
msgstr "Efecto activo"

#: crates/rigg/src/pages/lys_kort.rs:1433
msgid "Lyset er av"
msgstr "Iluminación apagada"

#: crates/rigg/src/pages/lys_kort.rs:1435
msgid "Klar"
msgstr "Listo"

#: crates/rigg/src/pages/lys_kort.rs:1442
msgid "Simulerte RGB-data · {status}"
msgstr "Datos RGB simulados · {status}"

#: crates/rigg/src/pages/lys_kort.rs:1464
msgid "Venter på svar. Ingen ny endring kan sendes nå."
msgstr "Esperando respuesta. Ahora no se pueden enviar nuevos cambios."

#: crates/rigg/src/pages/lys_kort.rs:1466
msgid "Forbindelsen til tjenesten er brutt. Hjelperen håndterer eventuell tilbakeføring."
msgstr "Se ha perdido la conexión con el servicio. El asistente se encargará de una posible reversión."

#: crates/rigg/src/pages/lys_kort.rs:1471
msgid "Kortet er ikke tilgjengelig. Nye lysendringer og aktivering er sperret."
msgstr "La tarjeta no está disponible. Se han bloqueado la activación y los cambios de iluminación."

#: crates/rigg/src/pages/lys_kort.rs:1473
msgid "Et annet vindu styrer kortlyset. Her vises bare status."
msgstr "Otra ventana controla la iluminación. Aquí solo se muestra el estado."

#: crates/rigg/src/pages/lys_kort.rs:1475
msgid "Hele kortlyset er én sone. Ingenting sendes før du trykker «Bruk»."
msgstr "La iluminación de la tarjeta es una sola zona. No se envía nada hasta que pulses «Aplicar»."

#: crates/rigg/src/pages/lys_kort.rs:1481 crates/rigg/src/pages/lys_kort.rs:1487
msgid "RGB-hjelperen er ikke klar."
msgstr "El servicio RGB no está listo."

#: crates/rigg/src/pages/lys_kort.rs:1483
msgid "Skjermkortstyring er slått av."
msgstr "El control de GPU está desactivado."

#: crates/rigg/src/pages/lys_kort.rs:1485
msgid "Tillatelsen gjelder et annet skjermkort."
msgstr "El permiso corresponde a otra tarjeta gráfica."

#: crates/rigg/src/pages/lys_kort.rs:1490
msgid "Avklar lyset øverst før nye endringer kan sendes."
msgstr "Revisa la iluminación en el panel superior antes de enviar más cambios."

#: crates/rigg/src/pages/lys_kort.rs:1501
msgid "Venter på kortets PCI-adresse og UUID."
msgstr "Esperando la dirección PCI y el UUID de la tarjeta."

#: crates/rigg/src/pages/lys_kort.rs:1502
msgid "Valgt kort: {pci}"
msgstr "Tarjeta seleccionada: {pci}"

#: crates/rigg/src/pages/lys_kort.rs:1507
msgid "{effekt} er valgt. Nå vises bare startfargen; animasjonen starter først etter «Behold»."
msgstr "Se ha seleccionado {effekt}. Solo se muestra el color inicial; la animación empieza al pulsar «Conservar»."

#: crates/rigg/src/pages/lys_kort.rs:1511
msgid "{effekt} er aktiv på hele kortlyset. Velg en annen modus eller farge og trykk «Bruk» for å bytte, eller «Stopp effekten» for å gå tilbake til utgangspunktet."
msgstr "{effekt} está activo en toda la iluminación de la tarjeta. Elige otro modo o color y pulsa «Aplicar» para cambiar, o «Detener el efecto» para volver al estado de referencia."

#: crates/rigg/src/pages/lys_kort.rs:1517
msgid "Pusting varierer lysstyrken i fargen du velger."
msgstr "«Respiración» varía el brillo del color seleccionado."

#: crates/rigg/src/pages/lys_kort.rs:1519
msgid "Regnbue går gjennom hele fargespekteret fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "«Arcoíris» recorre todo el espectro desde el tono seleccionado. Los grises empiezan en rojo."

#: crates/rigg/src/pages/lys_kort.rs:1522
msgid "Fargesyklus veksler mellom seks tydelige fargetoner fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "«Ciclo de colores» alterna entre seis tonos distintos desde el seleccionado. Los grises empiezan en rojo."

#: crates/rigg/src/pages/lys_kort.rs:1525
msgid "{detalj} Først prøves startfargen; «Behold» starter animasjonen på én lyssone."
msgstr "{detalj} Primero se prueba el color inicial. «Conservar» inicia la animación en una zona."

#: crates/rigg/src/pages/lys_kort.rs:1534
msgid "RGB-hjelperen meldte en driftsfeil. Kontroller lyset før du fortsetter."
msgstr "El asistente RGB ha notificado un error de funcionamiento. Comprueba la iluminación antes de continuar."

#: crates/rigg/src/pages/lys_kort.rs:1551
msgid "Lagret utgangspunkt: {lys}. Dette er ikke en ny avlesning."
msgstr "Estado de referencia guardado: {lys}. No es una lectura nueva."

#: crates/rigg/src/pages/lys_kort.rs:1554
msgid "Sist lest fra kortet: {lys}. Effektmodus: ukjent."
msgstr "Última lectura de la tarjeta: {lys}. Modo de efecto: desconocido."

#: crates/rigg/src/pages/lys_kort.rs:1556
msgid "Avlesning: ukjent. Effektmodusen er ikke bekreftet."
msgstr "Lectura desconocida. No se ha confirmado el modo de efecto."

#: crates/rigg/src/pages/lys_kort.rs:1562
msgid "Sist bekreftede valg: {lys}. Valget er ikke bevis på avlest effektmodus."
msgstr "Última opción confirmada: {lys}. Esto no demuestra que se haya leído el modo de efecto."

#: crates/rigg/src/pages/lys_kort.rs:1575
msgid "Kontroller startfargen på kortet. «Behold» starter animasjonen; «Rull tilbake» eller fristutløp går tilbake til utgangspunktet."
msgstr "Comprueba el color inicial en la tarjeta. «Conservar» inicia la animación. El estado de referencia se restaura al seleccionar «Revertir» o al vencer el plazo."

#: crates/rigg/src/pages/lys_kort.rs:1577
msgid "Se på det fysiske kortet før du beholder endringen. Uten bekreftelse forsøker hjelperen å rulle tilbake."
msgstr "Mira la tarjeta física antes de conservar el cambio. Sin confirmación, el asistente intenta revertirlo."

#: crates/rigg/src/pages/lys_kort.rs:1590
msgid "fristen styres av hjelperen"
msgstr "el asistente gestiona el plazo"

#: crates/rigg/src/pages/lys_kort.rs:1592
msgid "fristen er ute; venter på status"
msgstr "plazo agotado; esperando el estado"

#: crates/rigg/src/pages/lys_kort.rs:1594
msgid "bekreft innen {tid}"
msgstr "confirma antes de {tid}"

#: crates/rigg/src/pages/lys_kort.rs:1603
msgid "Behold ({sek})"
msgstr "Conservar ({sek})"

#: crates/rigg/src/pages/lys_kort.rs:1631
msgid "Oppgi en gyldig fargekode på seks tegn, for eksempel #3A7BF0."
msgstr "Introduce un código de color hexadecimal válido de seis caracteres, por ejemplo #3A7BF0."

#: crates/rigg/src/pages/lys_kort.rs:1635
msgid "Bekreft eller rull tilbake prøven som pågår før du bruker en ny innstilling."
msgstr "Conserva o revierte la prueba en curso antes de aplicar un nuevo ajuste."

#: crates/rigg/src/pages/lys_kort.rs:1652 crates/rigg/src/pages/lys_kort.rs:2263
msgid "Behold lyset jeg ser"
msgstr "Conservar la luz que veo"

#: crates/rigg/src/pages/lys_kort.rs:1655
msgid "Avlest lys: {lys}"
msgstr "Iluminación detectada: {lys}"

#: crates/rigg/src/pages/lys_kort.rs:1657
msgid "Lagret lys: {lys}"
msgstr "Iluminación guardada: {lys}"

#: crates/rigg/src/pages/lys_kort.rs:1660
msgid "Fabrikklys: {lys}"
msgstr "Iluminación de fábrica: {lys}"

#: crates/rigg/src/pages/lys_kort.rs:1667
msgid "Se på kortet og bekreft lyset"
msgstr "Mira la tarjeta y confirma la iluminación"

#: crates/rigg/src/pages/lys_kort.rs:1668
msgid "Kortet er satt tilbake til {lys}. Hjelperen kan bare lese fargeverdiene, ikke hva kortet faktisk lyser. Bekreft når kortet viser dette, eller gjenopprett på nytt."
msgstr "La tarjeta se ha devuelto a {lys}. El asistente solo puede leer los valores de color, no lo que la tarjeta muestra realmente. Confirma cuando la tarjeta muestre esto o restaura de nuevo."

#: crates/rigg/src/pages/lys_kort.rs:1672
msgid "RGB-hjelperen meldte en driftsfeil. Gjenopprett utgangspunktet og kontroller lyset før du fortsetter."
msgstr "El asistente RGB informó de un error de funcionamiento. Restaura el estado de referencia y comprueba la iluminación antes de continuar."

#: crates/rigg/src/pages/lys_kort.rs:1677
msgid "Utgangspunktet er {lys}."
msgstr "El estado de referencia es {lys}."

#: crates/rigg/src/pages/lys_kort.rs:1681
msgid "Kortet viser {lest}. Velg «{knapp}» for å gjenopprette {lys}, og bekreft det du ser."
msgstr "La tarjeta muestra {lest}. Selecciona «{knapp}» para restaurar {lys} y confirma lo que ves."

#: crates/rigg/src/pages/lys_kort.rs:1690
msgid "Gjenopprett på nytt"
msgstr "Restaurar de nuevo"

#: crates/rigg/src/pages/lys_kort.rs:1696 crates/rigg/src/pages/lys_kort.rs:1980
msgid "Stopp effekten"
msgstr "Detener el efecto"

#: crates/rigg/src/pages/lys_kort.rs:1698 crates/rigg/src/pages/lys_kort.rs:2083
msgid "Slutt å holde av"
msgstr "Dejar de mantener apagado"

#: crates/rigg/src/pages/lys_kort.rs:1702
msgid "Kortet går tilbake til det lagrede utgangspunktet, og appen slipper lyset."
msgstr "La tarjeta vuelve al estado de referencia guardado y la aplicación libera la iluminación."

#: crates/rigg/src/pages/lys_kort.rs:1709
msgid "det lagrede utgangspunktet"
msgstr "el estado de referencia guardado"

#: crates/rigg/src/pages/lys_kort.rs:1714
msgid "Effekter kjører bare mens appen er åpen. Når appen lukkes, stopper effekten og kortet går tilbake til {lys}."
msgstr "Los efectos solo se ejecutan mientras la aplicación está abierta. Al cerrarla, el efecto se detiene y la tarjeta vuelve a {lys}."

#: crates/rigg/src/pages/lys_kort.rs:1718
msgid "«Av» er kortets utgangspunkt og skrives ikke tilbake når appen lukkes. Mens appen er åpen, skrives det på nytt hvert 2. sekund, fordi kortet ellers kan gå tilbake til fabrikklyset av seg selv. Det kan også skje etter at appen er lukket."
msgstr "«Apagado» es el punto de partida de la tarjeta y no se vuelve a escribir al cerrar la aplicación. Mientras la aplicación está abierta, se vuelve a escribir cada 2 segundos, porque si no la tarjeta puede volver sola a la iluminación de fábrica. Eso también puede ocurrir después de cerrar la aplicación."

#: crates/rigg/src/pages/lys_kort.rs:1720
msgid "«Av» er kortets utgangspunkt, men skrives ikke på nytt nå. Trykk «Bruk» for å holde det mens appen er åpen."
msgstr "«Apagado» es el punto de partida de la tarjeta, pero ahora no se vuelve a escribir. Pulsa «Aplicar» para mantenerlo mientras la aplicación está abierta."

#: crates/rigg/src/pages/lys_kort.rs:1723
msgid "«Av» blir kortets utgangspunkt etter «Behold» og skrives ikke tilbake når appen lukkes. Mens appen er åpen, skrives det på nytt hvert 2. sekund, fordi kortet ellers kan gå tilbake til fabrikklyset av seg selv. Det kan også skje etter at appen er lukket."
msgstr "Tras «Conservar», «Apagado» pasa a ser el punto de partida de la tarjeta y no se vuelve a escribir al cerrar la aplicación. Mientras la aplicación está abierta, se vuelve a escribir cada 2 segundos, porque si no la tarjeta puede volver sola a la iluminación de fábrica. Eso también puede ocurrir después de cerrar la aplicación."

#: crates/rigg/src/pages/lys_kort.rs:1725
msgid "«Av» skrives på nytt hvert 2. sekund mens appen er åpen, fordi kortet ellers kan gå tilbake til fabrikklyset av seg selv. Når appen lukkes, går kortet tilbake til {lys}."
msgstr "«Apagado» se vuelve a escribir cada 2 segundos mientras la aplicación está abierta, porque si no la tarjeta puede volver sola a la iluminación de fábrica. Al cerrar la aplicación, la tarjeta vuelve a {lys}."

#: crates/rigg/src/pages/lys_kort.rs:1727
msgid "Etter «Behold» blir valget kortets utgangspunkt og skrives ikke tilbake når appen lukkes. Om kortet selv beholder lyset etter omstart, er ikke verifisert."
msgstr "Tras «Conservar», la elección pasa a ser el estado de referencia de la tarjeta y no se revierte al cerrar la aplicación. No se ha verificado si la tarjeta conserva la iluminación tras un reinicio."

#: crates/rigg/src/pages/lys_kort.rs:1729
msgid "Når appen lukkes, går kortet tilbake til {lys}."
msgstr "Al cerrar la aplicación, la tarjeta vuelve a {lys}."

#: crates/rigg/src/pages/lys_kort.rs:1738
msgid "Fabrikklyset: {lys}. Prøves som et vanlig valg; «Behold» gjør det til utgangspunktet igjen."
msgstr "Iluminación de fábrica: {lys}. Se prueba como una elección normal; «Conservar» la convierte de nuevo en el estado de referencia."

#: crates/rigg/src/pages/lys_kort.rs:1821
msgid "Avbryt"
msgstr "Cancelar"
