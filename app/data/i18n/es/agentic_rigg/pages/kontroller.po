#: crates/rigg/src/pages/kontroller.rs:283 crates/rigg/src/pages/kontroller.rs:716
msgid "Tomgang"
msgstr "En reposo"

#: crates/rigg/src/pages/kontroller.rs:283
msgid "Kortet har ingenting å gjøre og holder klokkene nede."
msgstr "La GPU está en reposo y mantiene bajas las frecuencias."

#: crates/rigg/src/pages/kontroller.rs:284 crates/rigg/src/pages/kontroller.rs:336
msgid "Programklokker"
msgstr "Frecuencias de aplicación"

#: crates/rigg/src/pages/kontroller.rs:284
msgid "Klokkene er låst av et program (applications clocks)."
msgstr "Una aplicación ha fijado las frecuencias (frecuencias de aplicación)."

#: crates/rigg/src/pages/kontroller.rs:285
msgid "Kortet trekker så mye som effektgrensen tillater."
msgstr "La GPU consume toda la potencia que permite el límite."

#: crates/rigg/src/pages/kontroller.rs:286
msgid "Maskinvare-nedklokking"
msgstr "Reducción por hardware"

#: crates/rigg/src/pages/kontroller.rs:286 crates/rigg/src/pages/kontroller.rs:715
msgid "Kortet klokker ned av seg selv (strøm eller temperatur)."
msgstr "La GPU reduce automáticamente sus frecuencias por la potencia o la temperatura."

#: crates/rigg/src/pages/kontroller.rs:287
msgid "Synkronisert boost"
msgstr "Sync Boost"

#: crates/rigg/src/pages/kontroller.rs:287
msgid "Klokkene følger et annet kort."
msgstr "Las frecuencias siguen las de otra GPU."

#: crates/rigg/src/pages/kontroller.rs:288
msgid "Kortet har nådd temperaturmålet og senker klokkene."
msgstr "La GPU ha alcanzado la temperatura objetivo y está reduciendo sus frecuencias."

#: crates/rigg/src/pages/kontroller.rs:289
msgid "Termisk nedklokking"
msgstr "Reducción térmica"

#: crates/rigg/src/pages/kontroller.rs:289
msgid "Maskinvaren klokker ned fordi kortet er for varmt."
msgstr "El hardware reduce las frecuencias porque la GPU está demasiado caliente."

#: crates/rigg/src/pages/kontroller.rs:290
msgid "Effektbrems"
msgstr "Freno de potencia"

#: crates/rigg/src/pages/kontroller.rs:290
msgid "Strømforsyningen har bedt kortet bremse."
msgstr "La fuente de alimentación ha indicado a la GPU que reduzca sus frecuencias."

#: crates/rigg/src/pages/kontroller.rs:291 crates/rigg/src/pages/kontroller.rs:337
msgid "Skjermklokke"
msgstr "Frecuencias de pantalla"

#: crates/rigg/src/pages/kontroller.rs:291
msgid "Klokkene er satt for skjermen."
msgstr "Las frecuencias se ajustan a los requisitos de la pantalla."

#: crates/rigg/src/pages/kontroller.rs:316
msgid "Kortet svarer ikke"
msgstr "La GPU no responde"

#: crates/rigg/src/pages/kontroller.rs:321 crates/rigg/src/pages/kontroller.rs:358
msgid "Ingenting"
msgstr "Ninguno"

#: crates/rigg/src/pages/kontroller.rs:321 crates/rigg/src/pages/kontroller.rs:358
msgid "Kortet er i ro"
msgstr "GPU en reposo"

#: crates/rigg/src/pages/kontroller.rs:321
msgid "Kortet er i dyp tomgang (P8). Da spør tjenesten ikke om årsakene: kallet koster ca. 25 ms og vekker kortet."
msgstr "La GPU está en reposo profundo (P8). El servicio omite la consulta porque tarda unos 25 ms y saca a la GPU del reposo."

#: crates/rigg/src/pages/kontroller.rs:324
msgid "Kortet melder ikke årsaker"
msgstr "No se indican motivos"

#: crates/rigg/src/pages/kontroller.rs:324
msgid "nvmlDeviceGetCurrentClocksEventReasons svarer ikke på dette kortet."
msgstr "nvmlDeviceGetCurrentClocksEventReasons no responde en esta GPU."

#: crates/rigg/src/pages/kontroller.rs:331 crates/rigg/src/pages/kontroller.rs:334 crates/rigg/src/pages/kontroller.rs:597 crates/rigg/src/pages/kontroller.rs:713
msgid "Temperatur"
msgstr "Temperatura"

#: crates/rigg/src/pages/kontroller.rs:331
msgid "Maskinvaren klokker ned"
msgstr "Reducción por hardware"

#: crates/rigg/src/pages/kontroller.rs:332 crates/rigg/src/pages/kontroller.rs:335 crates/rigg/src/pages/kontroller.rs:597 crates/rigg/src/pages/kontroller.rs:712
msgid "Effekt"
msgstr "Potencia"

#: crates/rigg/src/pages/kontroller.rs:332
msgid "Strømforsyningen bremser"
msgstr "Freno de la fuente de alimentación"

#: crates/rigg/src/pages/kontroller.rs:333 crates/rigg/src/pages/kontroller.rs:715
msgid "Maskinvare"
msgstr "Hardware"

#: crates/rigg/src/pages/kontroller.rs:333
msgid "Kortet klokker ned selv"
msgstr "La GPU reduce sus frecuencias"

#: crates/rigg/src/pages/kontroller.rs:334
msgid "Temperaturmålet er nådd"
msgstr "Temperatura objetivo alcanzada"

#: crates/rigg/src/pages/kontroller.rs:335
msgid "Effektgrensen er nådd"
msgstr "Límite de potencia alcanzado"

#: crates/rigg/src/pages/kontroller.rs:336
msgid "Låst av et program"
msgstr "Fijadas por una aplicación"

#: crates/rigg/src/pages/kontroller.rs:337
msgid "Satt for skjermen"
msgstr "Ajustadas para la pantalla"

#: crates/rigg/src/pages/kontroller.rs:338
msgid "Synkronisert"
msgstr "Sincronizadas"

#: crates/rigg/src/pages/kontroller.rs:338
msgid "Følger et annet kort"
msgstr "Sigue a otra GPU"

#: crates/rigg/src/pages/kontroller.rs:345
msgid "Grensen {grense} er nådd"
msgstr "Límite de {grense} alcanzado"

#: crates/rigg/src/pages/kontroller.rs:349
msgid "Målet {maal} er nådd"
msgstr "Objetivo de {maal} alcanzado"

#: crates/rigg/src/pages/kontroller.rs:358
msgid "Kortet har ingenting å gjøre og holder klokkene nede (tomgang)."
msgstr "La GPU está en reposo y mantiene bajas las frecuencias."

#: crates/rigg/src/pages/kontroller.rs:362 crates/rigg/src/pages/kontroller.rs:714
msgid "Spenning"
msgstr "Voltaje"

#: crates/rigg/src/pages/kontroller.rs:363
msgid "Toppen av klokkekurven"
msgstr "Punto más alto de la curva de frecuencia"

#: crates/rigg/src/pages/kontroller.rs:365
msgid "NVML melder ingen begrensning, og kortet har last. Da går det så høyt spenningen tillater (det GPU-Z kaller VRel/VOp). Utledet, ikke lest fra kortet."
msgstr "NVML no indica ningún límite con la GPU bajo carga. La GPU aumenta su frecuencia hasta donde lo permite el voltaje (VRel/VOp en GPU-Z). Es una inferencia, no una lectura de la GPU."

#: crates/rigg/src/pages/kontroller.rs:368
msgid "Ingen"
msgstr "Ninguno"

#: crates/rigg/src/pages/kontroller.rs:368
msgid "Klokkene kan gå fritt"
msgstr "La frecuencia no está limitada"

#: crates/rigg/src/pages/kontroller.rs:368
msgid "NVML melder ingen begrensning."
msgstr "NVML no indica ningún límite."

#: crates/rigg/src/pages/kontroller.rs:374
msgid "full ytelse"
msgstr "rendimiento máximo"

#: crates/rigg/src/pages/kontroller.rs:375
msgid "høy ytelse"
msgstr "rendimiento alto"

#: crates/rigg/src/pages/kontroller.rs:376
msgid "middels"
msgstr "medio"

#: crates/rigg/src/pages/kontroller.rs:377
msgid "tomgang"
msgstr "reposo"

#: crates/rigg/src/pages/kontroller.rs:378
msgid "laveste"
msgstr "mínimo"

#: crates/rigg/src/pages/kontroller.rs:393
msgid "Hvor mye strøm kortet får bruke. 100 % er kortets oppgitte standardgrense."
msgstr "Potencia que puede consumir la GPU. El 100 % corresponde al límite predeterminado que indica la tarjeta."

#: crates/rigg/src/pages/kontroller.rs:395
msgid "Kortet holder seg under grensen ved å senke klokken. Under tung last kan effektgrensen begrense GPU-boost; en høyere grense kan da gi høyere klokke."
msgstr "La GPU reduce su frecuencia para no superar el límite. Con una carga alta, el límite de potencia puede restringir el aumento automático de frecuencia; elevarlo puede permitir frecuencias mayores."

#: crates/rigg/src/pages/kontroller.rs:396
msgid "Prisen er mer varme, mer viftestøy og høyere strømforbruk. En lavere grense gir et kjøligere og stillere kort med litt lavere ytelse."
msgstr "Un límite más alto supone más calor, ruido de los ventiladores y consumo. Un límite más bajo mantiene la GPU más fría y silenciosa a costa de algo de rendimiento."

#: crates/rigg/src/pages/kontroller.rs:402
msgid "Justering av GPU-klokken. 0 MHz betyr ingen justering; faktisk hastighet vises over."
msgstr "Desplazamiento de frecuencia de GPU. 0 MHz significa que no hay desplazamiento; la frecuencia medida se muestra arriba."

#: crates/rigg/src/pages/kontroller.rs:404
msgid "Offset legges på hvert punkt på klokkekurven (spenning mot klokke). Kortet booster fortsatt selv, men lander høyere. Spenningen endres ikke."
msgstr "La aplicación aplica el desplazamiento a cada punto de la curva de voltaje/frecuencia. La GPU sigue aumentando la frecuencia automáticamente, pero alcanza valores más altos. El voltaje no cambia."

#: crates/rigg/src/pages/kontroller.rs:405
msgid "For høy offset gir krasj, feil i bildet eller at driveren starter på nytt. Prøv i steg på 15–25 MHz og test under last."
msgstr "Un desplazamiento excesivo puede provocar bloqueos, artefactos o reinicios del controlador. Prueba cambios de 15–25 MHz y comprueba el resultado bajo carga."

#: crates/rigg/src/pages/kontroller.rs:411
msgid "Justering av minneklokken. 0 MHz betyr ingen justering, ikke at minnet står stille."
msgstr "Desplazamiento de frecuencia de memoria. 0 MHz significa que no hay desplazamiento, no que la memoria deje de funcionar."

#: crates/rigg/src/pages/kontroller.rs:413
msgid "Dette er en justering i MHz, ikke en fast sluttklokke eller minnebåndbredde i Gb/s. Kortets målte hastighet vises separat. Appen regner om til driverens skala når verdien sendes."
msgstr "Es un desplazamiento en MHz, no una frecuencia final fija ni el ancho de banda de la memoria en Gb/s. La frecuencia medida se muestra por separado. La aplicación convierte el valor a la escala del controlador al enviarlo."

#: crates/rigg/src/pages/kontroller.rs:414
msgid "En høyere justering er bare nyttig hvis programmer faktisk kjører raskere. For høy justering kan gi bildefeil, lavere ytelse eller ustabilitet."
msgstr "Un desplazamiento mayor solo es útil si las aplicaciones funcionan más rápido. Un desplazamiento excesivo puede causar artefactos visuales, menor rendimiento o inestabilidad."

#: crates/rigg/src/pages/kontroller.rs:420
msgid "Temperaturen kortet holder seg under. Lavere gir et kjøligere kort og lavere klokke."
msgstr "Temperatura que la GPU intenta no superar. Un objetivo más bajo reduce la temperatura, pero también las frecuencias."

#: crates/rigg/src/pages/kontroller.rs:422
msgid "Når temperaturen når målet, senker kortet klokken (begrensningen «Temperaturmål»). Viftene styres fortsatt av viftemodusen."
msgstr "Al alcanzar el objetivo, la GPU reduce sus frecuencias (límite de temperatura objetivo). El modo de ventiladores seleccionado sigue determinando su velocidad."

#: crates/rigg/src/pages/kontroller.rs:423
msgid "Nedklokking og avstenging er egne maskinvaregrenser. Temperaturmålet kan endres når kortet og driveren støtter det; grensen og støtten leses fra kortet."
msgstr "El hardware tiene umbrales distintos para reducir la frecuencia y para apagarse. La temperatura objetivo se puede ajustar si la GPU y el controlador lo permiten. La GPU indica si es compatible y qué intervalo admite."

#: crates/rigg/src/pages/kontroller.rs:429
msgid "Hvem som styrer viftene: driveren, viftekurven eller en fast fart."
msgstr "Elige cómo se ajusta la velocidad de los ventiladores: con el controlador, con una curva o con un valor fijo."

#: crates/rigg/src/pages/kontroller.rs:431
msgid "Auto: driveren styrer etter temperaturen, som uten appen. Kurve: tjenesten setter farten fra viftekurven hvert sekund. Manuell: fast fart, uansett temperatur."
msgstr "Auto: el controlador ajusta la velocidad según la temperatura, como lo haría sin la aplicación. Curva: el servicio actualiza la velocidad cada segundo según la curva. Manual: velocidad fija, independientemente de la temperatura."

#: crates/rigg/src/pages/kontroller.rs:432
msgid "Manuell fart følger grensene NVIDIA-driveren rapporterer. Automatisk viftestopp kan avhenge av kortmodell og driver; støtte for det er ikke bekreftet på dette kortet."
msgstr "La velocidad manual se ajusta al intervalo que indica el controlador de NVIDIA. La parada automática depende del modelo de GPU y del controlador, y no se ha confirmado para esta GPU."

#: crates/rigg/src/pages/kontroller.rs:496
msgid "Viser det kortet har nå. Det du endrer, blir et utkast som lagres i appen og ikke sendes til kortet."
msgstr "Muestra los ajustes actuales de la GPU. Los cambios se guardan como borrador en la aplicación, sin enviarlos a la GPU."

#: crates/rigg/src/pages/kontroller.rs:511
msgid "GPU-klokke nå"
msgstr "Frecuencia actual de GPU"

#: crates/rigg/src/pages/kontroller.rs:511
msgid "Minneklokke nå"
msgstr "Frecuencia actual de memoria"

#: crates/rigg/src/pages/kontroller.rs:511
msgid "Temperatur nå"
msgstr "Temperatura actual"

#: crates/rigg/src/pages/kontroller.rs:511
msgid "Forbruk nå"
msgstr "Consumo actual"

#: crates/rigg/src/pages/kontroller.rs:511
msgid "GPU-last"
msgstr "Carga de GPU"

#: crates/rigg/src/pages/kontroller.rs:511
msgid "Viftefart nå"
msgstr "Velocidad actual"

#: crates/rigg/src/pages/kontroller.rs:511
msgid "P-tilstand"
msgstr "Estado P"

#: crates/rigg/src/pages/kontroller.rs:511
msgid "Begrenset av"
msgstr "Limitado por"

#: crates/rigg/src/pages/kontroller.rs:525
msgid "Juster klokker og effekt"
msgstr "Ajustar frecuencias y potencia"

#: crates/rigg/src/pages/kontroller.rs:526
msgid "Utkast · ikke sendt til kortet"
msgstr "Borrador · no enviado a la GPU"

#: crates/rigg/src/pages/kontroller.rs:528
msgid "Gjenopprett utgangspunkt"
msgstr "Restaurar ajustes originales"

#: crates/rigg/src/pages/kontroller.rs:541
msgid "GPU-justering"
msgstr "Desplazamiento de frecuencia de GPU"

#: crates/rigg/src/pages/kontroller.rs:542
msgid "Minnejustering"
msgstr "Desplazamiento de frecuencia de memoria"

#: crates/rigg/src/pages/kontroller.rs:544
msgid "Vifte"
msgstr "Ventilador"

#: crates/rigg/src/pages/kontroller.rs:551
msgid "Avansert · temperaturmål og vifter"
msgstr "Avanzado · temperatura objetivo y ventiladores"

#: crates/rigg/src/pages/kontroller.rs:555
msgid "Auto, fast viftefart og egen kurve"
msgstr "Auto, velocidad fija y curva personalizada"

#: crates/rigg/src/pages/kontroller.rs:559
msgid "Åpne Vifter"
msgstr "Abrir Ventiladores"

#: crates/rigg/src/pages/kontroller.rs:573
msgid "Rediger kurven"
msgstr "Editar curva"

#: crates/rigg/src/pages/kontroller.rs:574
msgid "Gå til Vifter, der kurven redigeres"
msgstr "Ve a Ventiladores para editar la curva"

#: crates/rigg/src/pages/kontroller.rs:597
msgid "Kjerneklokke"
msgstr "Frecuencia del núcleo"

#: crates/rigg/src/pages/kontroller.rs:610
msgid "Utkast"
msgstr "Borrador"

#: crates/rigg/src/pages/kontroller.rs:616
msgid "Profiler"
msgstr "Perfiles"

#: crates/rigg/src/pages/kontroller.rs:619
msgid "Hent fyller utkastet med verdiene fra profilen. Ingenting sendes til kortet."
msgstr "Cargar copia los valores del perfil al borrador. No se envía nada a la GPU."

#: crates/rigg/src/pages/kontroller.rs:625
msgid "Begrensninger"
msgstr "Límites de rendimiento"

#: crates/rigg/src/pages/kontroller.rs:637
msgid "Funksjonsstøtte på kortet"
msgstr "Compatibilidad de la GPU"

#: crates/rigg/src/pages/kontroller.rs:641
msgid "Spenningsoffset"
msgstr "Desplazamiento de voltaje"

#: crates/rigg/src/pages/kontroller.rs:641
msgid "Spenningsstyring er ikke implementert i appen."
msgstr "El control de voltaje no está implementado."

#: crates/rigg/src/pages/kontroller.rs:642
msgid "Klokkekurven (V/F)"
msgstr "Curva de voltaje/frecuencia (V/F)"

#: crates/rigg/src/pages/kontroller.rs:642
msgid "Redigering av spennings-/klokkekurven er ikke implementert. GPU-justering bruker offset der driveren støtter det."
msgstr "La edición de la curva de voltaje/frecuencia no está implementada. Se puede ajustar el desplazamiento de frecuencia de GPU si el controlador lo admite."

#: crates/rigg/src/pages/kontroller.rs:643
msgid "Låst minneklokke"
msgstr "Frecuencia de memoria fija"

#: crates/rigg/src/pages/kontroller.rs:643
msgid "Fastlåsing av minneklokken er ikke implementert. Minnejustering bruker offset der driveren støtter det."
msgstr "No se ha implementado el bloqueo de la frecuencia de memoria. Se puede ajustar su desplazamiento si el controlador lo admite."

#: crates/rigg/src/pages/kontroller.rs:644
msgid "Viftestopp (0 %)"
msgstr "Parada de ventiladores (0 %)"

#: crates/rigg/src/pages/kontroller.rs:644
msgid "Egen viftestopp er ikke implementert. Manuell fart følger driverens område; automatisk viftestopp avhenger av kort og driver."
msgstr "No se ha implementado la parada personalizada de ventiladores. Las velocidades manuales respetan el intervalo del controlador; la parada automática depende de la GPU y del controlador."

#: crates/rigg/src/pages/kontroller.rs:651
msgid "Avansert · kortets grenser og funksjoner"
msgstr "Avanzado · límites y funciones de la GPU"

#: crates/rigg/src/pages/kontroller.rs:663
msgid "Forkast utkast"
msgstr "Descartar borrador"

#: crates/rigg/src/pages/kontroller.rs:664
msgid "Tilbake til det kortet har. Utkastet slettes (Ctrl+Z angrer)."
msgstr "Recupera los valores actuales de la GPU y descarta el borrador. Pulsa Ctrl+Z para deshacerlo."

#: crates/rigg/src/pages/kontroller.rs:665
msgid "Bruk"
msgstr "Aplicar"

#: crates/rigg/src/pages/kontroller.rs:712
msgid "Effektgrensen er nådd, eller strømforsyningen bremser."
msgstr "Se ha alcanzado el límite de potencia o la fuente de alimentación está aplicando el freno de potencia."

#: crates/rigg/src/pages/kontroller.rs:713
msgid "Temperaturmålet er nådd, eller maskinvaren klokker ned fordi kortet er for varmt."
msgstr "Se ha alcanzado la temperatura objetivo o el hardware está reduciendo las frecuencias porque la GPU está demasiado caliente."

#: crates/rigg/src/pages/kontroller.rs:714
msgid "Utledet: ingen begrensning fra NVML mens kortet har last. Da står det på toppen av klokkekurven."
