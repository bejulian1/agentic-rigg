#: crates/rigg/src/pages/lys.rs:154
msgid "Skjermkort"
msgstr "Tarjeta gráfica"

#: crates/rigg/src/pages/lys.rs:156 crates/rigg/src/pages/lys.rs:535
msgid "Ikke aktivert"
msgstr "No activado"

#: crates/rigg/src/pages/lys.rs:160
msgid "3D"
msgstr "3D"

#: crates/rigg/src/pages/lys.rs:160
msgid "2D"
msgstr "2D"

#: crates/rigg/src/pages/lys.rs:160
msgid "Visning"
msgstr "Vista"

#: crates/rigg/src/pages/lys.rs:184
msgid "Dra for å vri · rull for zoom · 0 tilbakestiller"
msgstr "Arrastra para girar · rueda para acercar · 0 restablece"

#: crates/rigg/src/pages/lys.rs:190
msgid "Bygger 3D-kortet …"
msgstr "Construyendo la tarjeta 3D …"

#: crates/rigg/src/pages/lys.rs:228 crates/rigg/src/pages/lys.rs:234
msgid "Vinkel"
msgstr "Ángulo"

#: crates/rigg/src/pages/lys.rs:230 crates/rigg/src/pages/lys.rs:231
msgid "Tilbakestill visningen"
msgstr "Restablecer la vista"

#: crates/rigg/src/pages/lys.rs:241 crates/rigg/src/pages/lys.rs:244
msgid "Lag"
msgstr "Capas"

#: crates/rigg/src/pages/lys.rs:252 crates/rigg/src/pages/lys.rs:257
msgid "Skill lagene"
msgstr "Separar capas"

#: crates/rigg/src/pages/lys.rs:265 crates/rigg/src/pages/lys.rs:268
msgid "Bakgrunnslys"
msgstr "Luz ambiental"

#: crates/rigg/src/pages/lys.rs:298
msgid "Deler i 3D-modellen"
msgstr "Piezas del modelo 3D"

#: crates/rigg/src/pages/lys.rs:537
msgid "Prøve på kortet"
msgstr "Prueba en la tarjeta"

#: crates/rigg/src/pages/lys.rs:539
msgid "Aktiv effekt"
msgstr "Efecto activo"

#: crates/rigg/src/pages/lys.rs:551
msgid "Speiler kortlyset"
msgstr "Refleja la tarjeta"

#: crates/rigg/src/pages/lys.rs:553
msgid "Forhåndsvisning av valg"
msgstr "Vista previa de la selección"

#: crates/rigg/src/pages/lys.rs:568
msgid "Utgangspunkt: Av"
msgstr "Estado de referencia: apagado"

#: crates/rigg/src/pages/lys.rs:570
msgid "Sist lest: Av"
msgstr "Última lectura: apagado"

#: crates/rigg/src/pages/lys.rs:572
msgid "Utgangspunkt: {farge} · {styrke}"
msgstr "Estado inicial: {farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:574
msgid "Sist lest: {farge} · {styrke}"
msgstr "Última lectura: {farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:748 crates/rigg/src/pages/lys.rs:969
msgid "Lys vises i 2D"
msgstr "Mostrando tarjeta en 2D"

#: crates/rigg/src/pages/lys.rs:748
msgid "3D-kortet kunne ikke tegnes med grafikken her. Det flate kortet viser de samme lysvalgene."
msgstr "No se pudo renderizar la tarjeta 3D con los gráficos actuales. La vista 2D muestra los mismos ajustes de luz."

#: crates/rigg/src/pages/lys.rs:847
msgid "3D kan ikke tegnes her ({feil}). Klikk for å prøve igjen."
msgstr "No se puede renderizar 3D aquí ({feil}). Haz clic para reintentar."

#: crates/rigg/src/pages/lys.rs:849
msgid "Grafikken tegnet 3D for tregt. Klikk for å prøve igjen."
msgstr "Los gráficos renderizaron 3D demasiado lento. Haz clic para reintentar."

#: crates/rigg/src/pages/lys.rs:851
msgid "Kortet i 3D. Dra for å vri."
msgstr "Tarjeta en 3D. Arrastra para girar."

#: crates/rigg/src/pages/lys.rs:856
msgid "Flatt kort sett forfra. Bruker minst ressurser."
msgstr "Tarjeta plana vista de frente. Usa menos recursos."

#: crates/rigg/src/pages/lys.rs:871
msgid "Stillbilde: grafikken tegner for tregt"
msgstr "Imagen fija: el renderizado gráfico es demasiado lento"

#: crates/rigg/src/pages/lys.rs:873
msgid "Animasjon av"
msgstr "Animación desactivada"

#: crates/rigg/src/pages/lys.rs:969
msgid "Grafikken tegnet 3D-kortet for tregt. Velg 3D over visningen for å prøve igjen."
msgstr "La tarjeta 3D se renderizó demasiado lento. Elige 3D sobre la vista para reintentar."

#: crates/rigg/src/pages/lys.rs:1076
msgid "Kortlys er ikke aktivert."
msgstr "La iluminación de la tarjeta no está activada."

#: crates/rigg/src/pages/lys.rs:1078
msgid "Lysene er av."
msgstr "Las luces están apagadas."

#: crates/rigg/src/pages/lys.rs:1080
msgid "Lysstyrke {styrke}."
msgstr "Brillo {styrke}."

#: crates/rigg/src/pages/lys.rs:1094
msgid "{lag} · lagene skilt"
msgstr "{lag} · capas separadas"

#: crates/rigg/src/pages/lys.rs:1117
msgid "Flatt skjermkort sett forfra."
msgstr "Tarjeta gráfica plana vista de frente."

#: crates/rigg/src/pages/lys.rs:1133
msgid "Kortet har én fysisk lyssone."
msgstr "La tarjeta tiene una sola zona física de iluminación."
