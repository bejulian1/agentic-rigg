#: crates/rigg/src/settings/styring.rs:54
msgid "Venter på administratorgodkjenning …"
msgstr "Esperando autorización de administrador…"

#: crates/rigg/src/settings/styring.rs:55
msgid "Installerer systemkomponentene …"
msgstr "Instalando componentes del sistema…"

#: crates/rigg/src/settings/styring.rs:56
msgid "Tjenesten svarer ikke. Endringer er låst."
msgstr "El servicio no responde. Los cambios están bloqueados."

#: crates/rigg/src/settings/styring.rs:59 crates/rigg/src/settings/styring.rs:65 crates/rigg/src/settings/styring.rs:148 crates/rigg/src/settings/styring.rs:230 crates/rigg/src/settings/styring.rs:302 crates/rigg/src/settings/styring.rs:312 crates/rigg/src/settings/styring.rs:411
msgid "Venter på enhet"
msgstr "Esperando el dispositivo"

#: crates/rigg/src/settings/styring.rs:60
msgid "Styring er klar for det valgte skjermkortet. Endringer brukes først når du trykker Bruk."
msgstr "La GPU seleccionada está lista para ajustarse. Los cambios solo se aplican al pulsar Aplicar."

#: crates/rigg/src/settings/styring.rs:61
msgid "Simulert styring. Det ekte skjermkortet endres ikke."
msgstr "Control simulado. La GPU real no se modifica."

#: crates/rigg/src/settings/styring.rs:62 crates/rigg/src/settings/styring.rs:64 crates/rigg/src/settings/styring.rs:226 crates/rigg/src/settings/styring.rs:232 crates/rigg/src/settings/styring.rs:302 crates/rigg/src/settings/styring.rs:437
msgid "Oppdater systemkomponenter"
msgstr "Actualizar componentes del sistema"

#: crates/rigg/src/settings/styring.rs:63
msgid "Hjelperen er ikke klar for kortet som vises. Se funksjonsstøtten under, eller trykk Sjekk igjen."
msgstr "El asistente no está listo para esta GPU. Consulta las funciones compatibles abajo o pulsa Volver a comprobar."

#: crates/rigg/src/settings/styring.rs:66
msgid "Systemkomponentene mangler. Slå på bryteren for å installere dem og aktivere styring."
msgstr "Faltan componentes del sistema. Activa el interruptor para instalarlos y activar los ajustes de GPU."

#: crates/rigg/src/settings/styring.rs:67
msgid "Systemkomponentene mangler eller må oppdateres."
msgstr "Faltan componentes del sistema o hay que actualizarlos."

#: crates/rigg/src/settings/styring.rs:68
msgid "Bare visning. Endring av skjermkortet er slått av."
msgstr "Solo monitorización. Los ajustes de GPU están desactivados."

#: crates/rigg/src/settings/styring.rs:77
msgid "agentic-rigg-helper {versjon} · bygg {bygg}"
msgstr "agentic-rigg-helper {versjon} · compilación {bygg}"

#: crates/rigg/src/settings/styring.rs:80
msgid "Simulert kort"
msgstr "GPU simulada"

#: crates/rigg/src/settings/styring.rs:80
msgid "Det ekte kortet (NVML)"
msgstr "GPU real (NVML)"

#: crates/rigg/src/settings/styring.rs:116
msgid "Avbrutt"
msgstr "Cancelado"

#: crates/rigg/src/settings/styring.rs:116
msgid "Passordet ble ikke gitt. Ingenting er endret."
msgstr "No se introdujo ninguna contraseña. No se ha cambiado nada."

#: crates/rigg/src/settings/styring.rs:117
msgid "Fant ikke pkexec, eller ingen kan spørre om passordet (polkit)."
msgstr "No se encontró pkexec o polkit no puede pedir la contraseña."

#: crates/rigg/src/settings/styring.rs:118
msgid "Skriptet feilet."
msgstr "El script ha fallado."

#: crates/rigg/src/settings/styring.rs:146 crates/rigg/src/settings/styring.rs:148
msgid "Skjermkortstyring er aktivert"
msgstr "Ajustes de GPU activados"

#: crates/rigg/src/settings/styring.rs:146
msgid "Velg endringer og trykk Bruk. Behold dem innen fristen, ellers rulles de tilbake."
msgstr "Haz los cambios y pulsa Aplicar. Pulsa Conservar antes de que termine el plazo o se revertirán."

#: crates/rigg/src/settings/styring.rs:150
msgid "Hjelperen er installert, men styring er ikke klar"
msgstr "El asistente está instalado, pero los ajustes de GPU no están listos"

#: crates/rigg/src/settings/styring.rs:165 crates/rigg/src/settings/styring.rs:205
msgid "Skjermkortstyring er slått av"
msgstr "Ajustes de GPU desactivados"

#: crates/rigg/src/settings/styring.rs:165 crates/rigg/src/settings/styring.rs:205
msgid "Tillatelsen er fjernet."
msgstr "Permiso revocado."

#: crates/rigg/src/settings/styring.rs:171
msgid "Ingen skjermkort valgt"
msgstr "Ninguna GPU seleccionada"

#: crates/rigg/src/settings/styring.rs:175
msgid "Kortidentiteten er ikke klar"
msgstr "Identidad de la GPU no disponible"

#: crates/rigg/src/settings/styring.rs:175
msgid "Vent til driveren har lest UUID, og prøv igjen."
msgstr "Espera a que el controlador lea el UUID y vuelve a intentarlo."

#: crates/rigg/src/settings/styring.rs:195
msgid "Kunne ikke aktivere styring"
msgstr "No se pudieron activar los ajustes de GPU"

#: crates/rigg/src/settings/styring.rs:195
msgid "Kunne ikke slå av styring"
msgstr "No se pudieron desactivar los ajustes de GPU"

#: crates/rigg/src/settings/styring.rs:214
msgid "Én aktivering"
msgstr "Activación única"

#: crates/rigg/src/settings/styring.rs:214
msgid "Bruk Tillat endring av skjermkortet. Funksjonsstøtten bestemmes av kortet og driveren."
msgstr "Usa Permitir ajustes de GPU. Las funciones disponibles dependen de la GPU y del controlador."

#: crates/rigg/src/settings/styring.rs:221 crates/rigg/src/settings/styring.rs:233 crates/rigg/src/settings/styring.rs:301 crates/rigg/src/settings/styring.rs:313 crates/rigg/src/settings/styring.rs:415
msgid "Ikke klar"
msgstr "No lista"

#: crates/rigg/src/settings/styring.rs:227 crates/rigg/src/settings/styring.rs:302 crates/rigg/src/settings/styring.rs:311
msgid "Må avklares"
msgstr "Requiere resolución"

#: crates/rigg/src/settings/styring.rs:228 crates/rigg/src/settings/styring.rs:247 crates/rigg/src/settings/styring.rs:300
msgid "Tilgjengelig"
msgstr "Disponible"

#: crates/rigg/src/settings/styring.rs:229
msgid "Ikke støttet"
msgstr "No compatible"

#: crates/rigg/src/settings/styring.rs:231 crates/rigg/src/settings/styring.rs:418
msgid "Av"
msgstr "Desactivado"

#: crates/rigg/src/settings/styring.rs:245
msgid "Effektgrense"
msgstr "Límite de potencia"

#: crates/rigg/src/settings/styring.rs:245
msgid "Manuell viftefart og Auto"
msgstr "Velocidad de ventiladores manual y automática"

#: crates/rigg/src/settings/styring.rs:245
msgid "Viftekurve"
msgstr "Curva de ventiladores"

#: crates/rigg/src/settings/styring.rs:245
msgid "Kjerneklokke"
msgstr "Frecuencia del núcleo"

#: crates/rigg/src/settings/styring.rs:245
msgid "Minneklokke"
msgstr "Frecuencia de memoria"

#: crates/rigg/src/settings/styring.rs:245
msgid "Temperaturmål"
msgstr "Temperatura objetivo"

#: crates/rigg/src/settings/styring.rs:247 crates/rigg/src/settings/styring.rs:267
msgid "Ikke undersøkt"
msgstr "Sin comprobar"

#: crates/rigg/src/settings/styring.rs:247
msgid "Utilgjengelig"
msgstr "No disponible"

#: crates/rigg/src/settings/styring.rs:250
msgid "Leses når administratorhjelperen aktiveres for dette kortet."
msgstr "Se comprueba al activar el asistente de administrador para esta GPU."

#: crates/rigg/src/settings/styring.rs:260
msgid "Kortets rapporterte område: {omraade}."
msgstr "Intervalo comunicado por la tarjeta: {omraade}."

#: crates/rigg/src/settings/styring.rs:262
msgid "Støttes av den tilkoblede hjelperen."
msgstr "Compatible con el asistente conectado."

#: crates/rigg/src/settings/styring.rs:311
msgid "Se RGB-lys"
msgstr "Ver iluminación RGB"

#: crates/rigg/src/settings/styring.rs:312
msgid "Venter på at RGB-arbeideren skal starte."
msgstr "Esperando a que se inicie el servicio RGB."

#: crates/rigg/src/settings/styring.rs:313 crates/rigg/src/settings/styring.rs:449
msgid "Sjekk igjen"
msgstr "Volver a comprobar"

#: crates/rigg/src/settings/styring.rs:330
msgid "Kortlys (RGB)"
msgstr "Iluminación de la tarjeta (RGB)"

#: crates/rigg/src/settings/styring.rs:331
msgid "Tilgjengelige funksjoner"
msgstr "Funciones disponibles"

#: crates/rigg/src/settings/styring.rs:332
msgid "Én administratoraktivering gjelder støttede funksjoner på det valgte kortet. Listen er status, ikke ekstra godkjenninger."
msgstr "Una sola activación de administrador cubre las funciones compatibles de la GPU seleccionada. La lista muestra el estado, no autorizaciones adicionales."

#: crates/rigg/src/settings/styring.rs:334
msgctxt "søkeord"
msgid "funksjoner støtte effekt vifter klokker temperatur"
msgstr "funciones compatibilidad potencia ventiladores frecuencias temperatura"

#: crates/rigg/src/settings/styring.rs:365 crates/rigg/src/settings/styring.rs:382
msgid "Tillat endring av skjermkortet"
msgstr "Permitir ajustes de GPU"

#: crates/rigg/src/settings/styring.rs:383
msgid "Tillater effekt, vifter, klokker og temperaturmål på valgt kort, samt kortlyset på støttede Palit-kort."
msgstr "Permite ajustar potencia, ventiladores, frecuencias y temperatura objetivo de la tarjeta elegida, así como la luz en tarjetas Palit compatibles."

#: crates/rigg/src/settings/styring.rs:385
msgctxt "søkeord"
msgid "root polkit pkexec hjelper skriving endre overklokking"
msgstr "root polkit pkexec asistente escritura cambiar overclocking"

#: crates/rigg/src/settings/styring.rs:410
msgid "Venter"
msgstr "En espera"

#: crates/rigg/src/settings/styring.rs:412 crates/rigg/src/settings/styring.rs:417
msgid "Oppdater hjelper"
msgstr "Actualizar asistente"

#: crates/rigg/src/settings/styring.rs:413
msgid "Klar"
msgstr "Lista"

#: crates/rigg/src/settings/styring.rs:414
msgid "Simulert"
msgstr "Simulada"

#: crates/rigg/src/settings/styring.rs:416
msgid "Feil"
msgstr "Error"

#: crates/rigg/src/settings/styring.rs:431
msgid "Åpne styring"
msgstr "Abrir ajustes de GPU"

#: crates/rigg/src/settings/styring.rs:443
msgid "Start på nytt"
msgstr "Reiniciar"

#: crates/rigg/src/settings/styring.rs:464
msgctxt "søkeord"
msgid "systemkomponenter installasjon terminal"
msgstr "componentes del sistema instalación instalar terminal sin conexión"

#: crates/rigg/src/settings/styring.rs:467
msgid "Endring av skjermkortet"
msgstr "Ajustes de GPU"

#: crates/rigg/src/settings/styring.rs:469
msgid "Når du slår av tilgangen, stoppes begge arbeiderne. Lagret lys og uavklarte endringer bevares."
msgstr "Al desactivar el acceso se detienen ambos servicios. Se conservan la iluminación guardada y los cambios pendientes."

#: crates/rigg/src/settings/styring.rs:470
msgctxt "søkeord"
msgid "bryter av på status"
msgstr "interruptor desactivar activar estado"

#: crates/rigg/src/settings/styring.rs:479
msgid "Hjelperen"
msgstr "Asistente"

#: crates/rigg/src/settings/styring.rs:479
msgid "To isolerte arbeidere for GPU-styring og kortlys"
msgstr "Dos servicios aislados para el control de GPU y la iluminación"

#: crates/rigg/src/settings/styring.rs:480
msgid "Passord"
msgstr "Contraseña"

#: crates/rigg/src/settings/styring.rs:480
msgid "Én administratorgodkjenning ved aktivering. Vanlige endringer bruker Bruk og Behold"
msgstr "Una autorización de administrador al activar. Para los cambios habituales, usa Aplicar y Conservar"

#: crates/rigg/src/settings/styring.rs:481
msgid "Hvem"
msgstr "Acceso"

#: crates/rigg/src/settings/styring.rs:481
msgid "Bare brukeren din. Andre brukere på maskinen slipper ikke til"
msgstr "Solo tu cuenta. Las demás cuentas del equipo no tienen acceso"

#: crates/rigg/src/settings/styring.rs:482
msgid "Vern"
msgstr "Protecciones"

#: crates/rigg/src/settings/styring.rs:482
msgid "Endringer rulles tilbake uten Behold innen fristen. Viftekurven har nødregel ved høy temperatur. Frakobling og stopp gjenoppretter utgangspunktet; eventuelle feil rapporteres"
msgstr "Los cambios se revierten si no pulsas Conservar a tiempo. La curva de ventiladores tiene una regla de emergencia para temperaturas altas. La desconexión o la detención restaura los ajustes originales. Se informa de cualquier error"

#: crates/rigg/src/settings/styring.rs:483
msgid "Filene"
msgstr "Archivos"

#: crates/rigg/src/settings/styring.rs:483
msgid "{hjelper}\n{konfigurasjon} (bruker, kort og aktivering)"
msgstr "{hjelper}\n{konfigurasjon} (usuario, tarjeta y activación)"

#: crates/rigg/src/settings/styring.rs:485
msgid "Skriptene"
msgstr "Scripts"

#: crates/rigg/src/settings/styring.rs:487
msgid "Hva bryteren gjør"
msgstr "Cómo funciona la opción"

#: crates/rigg/src/settings/styring.rs:487
msgctxt "søkeord"
msgid "hjelper root polkit systemd sikkerhet passord"
msgstr "asistente root polkit systemd seguridad contraseña"

#: crates/rigg/src/settings/styring.rs:489
msgctxt "søkeord"
msgid "hjelper root polkit systemd passord vern frist nødregel"
msgstr "asistente root polkit systemd contraseña protección plazo regla de emergencia"
