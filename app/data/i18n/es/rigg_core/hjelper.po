#: crates/rigg-core/src/hjelper.rs:399
msgid "Effekt"
msgstr "Potencia"

#: crates/rigg-core/src/hjelper.rs:400
msgid "Vifter"
msgstr "Ventiladores"

#: crates/rigg-core/src/hjelper.rs:401
msgid "Klokker"
msgstr "Frecuencias"

#: crates/rigg-core/src/hjelper.rs:402
msgid "RGB-lys"
msgstr "Iluminación RGB"

#: crates/rigg-core/src/hjelper.rs:407
msgid "Trinnet «{one}» er ikke godkjent. Godkjenn det i Innstillinger › Styring først."
msgstr "«{one}» no está autorizado. Activa primero el permiso en Configuración › Control."

#: crates/rigg-core/src/hjelper.rs:408
msgid "Trinnene {steps} er ikke godkjent. Godkjenn dem i Innstillinger › Styring først."
msgstr "No hay autorización para {steps}. Activa primero los permisos en Configuración › Control."

#: crates/rigg-core/src/hjelper.rs:422
msgid "{felt}: Kortet tillater {min}–{max}. Ingenting er endret."
msgstr "{felt}: la GPU admite {min}–{max}. No se ha cambiado nada."

#: crates/rigg-core/src/hjelper.rs:425 crates/rigg-core/src/hjelper.rs:525
msgid "Kortet eller driveren støtter ikke denne funksjonen."
msgstr "La GPU o el controlador no es compatible con esta función."

#: crates/rigg-core/src/hjelper.rs:433
msgid "Effektgrense"
msgstr "Límite de potencia"

#: crates/rigg-core/src/hjelper.rs:434
msgid "Temperaturmål"
msgstr "Temperatura objetivo"

#: crates/rigg-core/src/hjelper.rs:435
msgid "GPU-justering"
msgstr "Desplazamiento de frecuencia de GPU"

#: crates/rigg-core/src/hjelper.rs:436
msgid "Minnejustering"
msgstr "Desplazamiento de frecuencia de memoria"

#: crates/rigg-core/src/hjelper.rs:437
msgid "Viftefart"
msgstr "Velocidad de ventiladores"

#: crates/rigg-core/src/hjelper.rs:438
msgid "Temperaturen i kurven"
msgstr "Temperatura en la curva"

#: crates/rigg-core/src/hjelper.rs:439
msgid "Viftefarten i kurven"
msgstr "Velocidad de ventiladores en la curva"

#: crates/rigg-core/src/hjelper.rs:454
msgid "Kan ikke lagre gjenopprettingsmerkør før endring: {feil}"
msgstr "No se pudo guardar el marcador de recuperación antes de realizar los cambios: {feil}"

#: crates/rigg-core/src/hjelper.rs:457
msgid "Kortet ble gjenopprettet, men merkøren kunne ikke ryddes: {feil}"
msgstr "Se restauró la GPU, pero no se pudo eliminar el marcador de recuperación: {feil}"

#: crates/rigg-core/src/hjelper.rs:460
msgid "Fikk ikke kontakt med hjelperen ({feil})"
msgstr "No se pudo conectar con el asistente ({feil})"

#: crates/rigg-core/src/hjelper.rs:463
msgid "Hjelperen svarte ikke ({feil})"
msgstr "El asistente no respondió ({feil})"

#: crates/rigg-core/src/hjelper.rs:466
msgid "Hjelperen tok ikke imot ({feil})"
msgstr "El asistente no aceptó la solicitud ({feil})"

#: crates/rigg-core/src/hjelper.rs:477
msgid "celsius må være 0–120"
msgstr "celsius debe estar entre 0 y 120"

#: crates/rigg-core/src/hjelper.rs:478
msgid "RGB-backenden er ikke identifisert eller tilgjengelig."
msgstr "El backend RGB no está identificado o no está disponible."

#: crates/rigg-core/src/hjelper.rs:479
msgid "Viftestyring krever en lesbar temperatur for overtemperaturvernet."
msgstr "El control de ventiladores necesita una lectura de temperatura para proteger contra el sobrecalentamiento."

#: crates/rigg-core/src/hjelper.rs:480
msgid "Nødregelen gjelder. Vent til kortet er under 80 °C."
msgstr "La refrigeración de emergencia está activa. Espera a que la GPU baje de 80 °C."

#: crates/rigg-core/src/hjelper.rs:481
msgid "Endringer er låst: endring av skjermkortet er ikke slått på. Slå på «Tillat endring av skjermkortet» i Innstillinger › Styring."
msgstr "Los cambios están bloqueados porque los ajustes de GPU están desactivados. Activa Permitir ajustes de GPU en Configuración › Ajustes de GPU."

#: crates/rigg-core/src/hjelper.rs:482
msgid "Hjelperen for endring svarer ikke. Se Innstillinger › Styring."
msgstr "El asistente de GPU no responde. Consulta Configuración › Ajustes de GPU."

#: crates/rigg-core/src/hjelper.rs:483
msgid "Hjelperen er fra en annen versjon av appen. Slå bryteren i Innstillinger › Styring av og på igjen."
msgstr "El asistente pertenece a otra versión de la aplicación. Desactiva y reactiva la opción en Configuración › Ajustes de GPU."

#: crates/rigg-core/src/hjelper.rs:484
msgid "Hjelperen og tjenesten bruker ulike kort (simulert og ekte). Ingenting er sendt."
msgstr "El asistente y el servicio usan GPU distintas (simulada y real). No se ha enviado nada."

#: crates/rigg-core/src/hjelper.rs:485
msgid "NVML-hjelperen er ikke klar til å endre dette kortet."
msgstr "El asistente NVML no está listo para ajustar esta GPU."

#: crates/rigg-core/src/hjelper.rs:486
msgid "Skjermkortstyring må aktiveres med bryteren i Innstillinger."
msgstr "Activa los ajustes de GPU con el interruptor de Configuración."

#: crates/rigg-core/src/hjelper.rs:487 crates/rigg-core/src/hjelper.rs:527
msgid "Det valgte kortet er ikke kortet hjelperen er aktivert for."
msgstr "El asistente se activó para otra GPU."

#: crates/rigg-core/src/hjelper.rs:488
msgid "Gjenoppretting kunne ikke bekreftes. Nye endringer er sperret."
msgstr "No se pudo verificar la restauración. Se han bloqueado los cambios posteriores."

#: crates/rigg-core/src/hjelper.rs:489
msgid "Lys er ikke laget ennå."
msgstr "El control de iluminación aún no está implementado."

#: crates/rigg-core/src/hjelper.rs:490
msgid "Endringer er låst. Skriving til skjermkortet er ikke slått på."
msgstr "Los cambios están bloqueados. La escritura en la GPU está desactivada."

#: crates/rigg-core/src/hjelper.rs:491
msgid "Funksjonen er ikke tilgjengelig på dette kortet."
msgstr "Esta función no está disponible en esta GPU."

#: crates/rigg-core/src/hjelper.rs:492
msgid "Hjelperen er aktivert for en annen bruker."
msgstr "El asistente está activado para otro usuario."

#: crates/rigg-core/src/hjelper.rs:493
msgid "Hjelperen kjører, men helper.json mangler."
msgstr "El asistente está en ejecución, pero falta helper.json."

#: crates/rigg-core/src/hjelper.rs:494
msgid "Gjenopprettingsmerkøren har feil identitet eller utrygg eier/modus."
msgstr "El marcador de recuperación tiene una identidad incorrecta o un propietario o permisos inseguros."

#: crates/rigg-core/src/hjelper.rs:495
msgid "Skjermkortet eller tjenesten svarer ikke. Endringer er låst."
msgstr "La GPU o el servicio no responde. Los cambios están bloqueados."

#: crates/rigg-core/src/hjelper.rs:496
msgid "Hjelperen er aktivert for et annet kort. Aktiver styring for kortet som vises."
msgstr "El asistente está activado para otra GPU. Activa el control para la GPU que se muestra aquí."

#: crates/rigg-core/src/hjelper.rs:497
msgid "Valgt kort ble endret mens forespørselen ventet. Svaret brukes ikke på det nye kortet."
msgstr "La GPU seleccionada cambió mientras la solicitud estaba pendiente. La respuesta no se usará para la nueva GPU."

#: crates/rigg-core/src/hjelper.rs:498
msgid "Endringer på skjermkortet er slått av. Aktiver én gang med administratorpassord i Innstillinger › Skjermkortstyring."
msgstr "El control de GPU está desactivado. Actívalo una vez con tu contraseña de administrador en Configuración › Control de GPU."

#: crates/rigg-core/src/hjelper.rs:499
msgid "Hjelperen er ikke skriveklar for kortet som vises."
msgstr "El asistente no está listo para modificar esta GPU."

#: crates/rigg-core/src/hjelper.rs:500
msgid "Dette eldre utkastet mangler opprinnelig grunnlag. Behold det som referanse, eller forkast det og lag et nytt utkast fra kortets verdier."
msgstr "Este borrador antiguo no tiene valores de referencia guardados. Consérvalo como referencia o descártalo y crea otro con los valores actuales de la GPU."

#: crates/rigg-core/src/hjelper.rs:501
msgid "Utkastet tilhører en annen kortidentitet. Velg det opprinnelige kortet, eller forkast utkastet før du lager et nytt."
msgstr "Este borrador pertenece a otra GPU. Selecciona la GPU original o descarta el borrador antes de crear uno nuevo."

#: crates/rigg-core/src/hjelper.rs:502
msgid "Det finnes ikke noe utkast å bruke."
msgstr "No hay ningún borrador que aplicar."

#: crates/rigg-core/src/hjelper.rs:503
msgid "Ugyldig argument."
msgstr "Argumento no válido."

#: crates/rigg-core/src/hjelper.rs:504
msgid "Ukjent skjermkort."
msgstr "GPU desconocida."

#: crates/rigg-core/src/hjelper.rs:505
msgid "Kortet eller driveren støtter ikke dette."
msgstr "La GPU o el controlador no admite esta función."

#: crates/rigg-core/src/hjelper.rs:506
msgid "Ikke tillatt."
msgstr "No permitido."

#: crates/rigg-core/src/hjelper.rs:507
msgid "En annen klient har en endring som venter."
msgstr "Otro cliente tiene un cambio pendiente."

#: crates/rigg-core/src/hjelper.rs:508
msgid "Ingen endring venter."
msgstr "No hay ningún cambio pendiente."

#: crates/rigg-core/src/hjelper.rs:509
msgid "Endringen finnes ikke lenger."
msgstr "El cambio ya no existe."

#: crates/rigg-core/src/hjelper.rs:510
msgid "Bare klienten som gjorde endringen, kan bekrefte den."
msgstr "Solo el cliente que hizo el cambio puede confirmarlo."

#: crates/rigg-core/src/hjelper.rs:511
msgid "Tjenesten stopper."
msgstr "El servicio se está deteniendo."

#: crates/rigg-core/src/hjelper.rs:512
msgid "Feil i tjenesten."
msgstr "Error del servicio."

#: crates/rigg-core/src/hjelper.rs:513
msgid "Ikke tilgjengelig nå."
msgstr "No disponible por ahora."

#: crates/rigg-core/src/hjelper.rs:514
msgid "Trinnet er ikke godkjent."
msgstr "Este paso no está autorizado."

#: crates/rigg-core/src/hjelper.rs:515
msgid "Kortets standardtilstand kunne ikke bekreftes ved tilbakelesing."
msgstr "No se pudo verificar mediante una lectura que la GPU usa sus ajustes originales."

#: crates/rigg-core/src/hjelper.rs:516
msgid "Hjelperen lukket forbindelsen"
msgstr "El asistente cerró la conexión"

#: crates/rigg-core/src/hjelper.rs:517
msgid "For stort svar fra hjelperen"
msgstr "La respuesta del asistente es demasiado grande"

#: crates/rigg-core/src/hjelper.rs:518
msgid "Tjenesten svarte ikke på 5 s."
msgstr "El servicio no respondió en 5 s."

#: crates/rigg-core/src/hjelper.rs:526
msgid "Driveren ga ikke tilgang til å endre kortet."
msgstr "El controlador denegó el permiso para cambiar los ajustes de GPU."

#: crates/rigg-core/src/hjelper.rs:528
msgid "Kortet svarer ikke."
msgstr "La GPU no responde."

#: crates/rigg-core/src/hjelper.rs:529
msgid "Kortets innstillinger kunne ikke bekreftes ved tilbakelesing."
msgstr "No se pudieron verificar los ajustes de GPU al volver a leerlos."

#: crates/rigg-core/src/hjelper.rs:530
msgid "De opprinnelige innstillingene for kortet mangler."
msgstr "Faltan los ajustes originales de la GPU."

#: crates/rigg-core/src/hjelper.rs:531
msgid "Kortet må gjenopprettes før nye endringer."
msgstr "Restaura la GPU antes de hacer más cambios."

#: crates/rigg-core/src/hjelper.rs:532
msgid "NVML avviste en ugyldig verdi."
msgstr "NVML rechazó un valor no válido."

#: crates/rigg-core/src/hjelper.rs:533
msgid "En NVML-operasjon mislyktes."
msgstr "Falló una operación de NVML."
