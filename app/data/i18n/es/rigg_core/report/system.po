msgstr " y "

#: crates/rigg-core/src/report/system.rs:295
msgid "Grupper av tråder som deler L3-cache, slik kjernen rapporterer dem. Gruppene er ikke nødvendigvis CCX-er."
msgstr "Grupos de hilos que comparten caché L3 según el kernel. No tienen por qué coincidir con los CCX."

#: crates/rigg-core/src/report/system.rs:301
msgid "Klokke (cpufreq)"
msgstr "Frecuencia (cpufreq)"

#: crates/rigg-core/src/report/system.rs:305
msgid "{min}–{maks} · boost til {boost} (målt)"
msgstr "{min}–{maks} · boost hasta {boost} (medido)"

#: crates/rigg-core/src/report/system.rs:316
msgid "cpufreq er ikke tilgjengelig"
msgstr "cpufreq no está disponible"

#: crates/rigg-core/src/report/system.rs:317
msgid "Nominelt område fra cpufreq. Med boost på går kjernene over maks; «målt» er den høyeste trådklokken tjenesten har sett."
msgstr "Intervalo nominal de cpufreq. Con el boost activo, los núcleos pueden superar el máximo. El valor «medido» es la frecuencia de hilo más alta registrada por el servicio."

