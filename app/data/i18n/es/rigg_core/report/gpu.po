msgid "Videominne"
msgstr "Memoria de vídeo"

#: crates/rigg-core/src/report/gpu.rs:268
msgid "{minne} er reservert av driveren og regnes ikke som brukt (MemoryInfo_v2)."
msgstr "El controlador reserva {minne}; no se cuentan como memoria usada (MemoryInfo_v2)."

#: crates/rigg-core/src/report/gpu.rs:269
msgid "Minnebuss"
msgstr "Bus de memoria"

#: crates/rigg-core/src/report/gpu.rs:269
