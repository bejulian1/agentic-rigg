msgid "PCIe-feil"
msgstr "Errores PCIe"

#: crates/rigg-core/src/report/gpu.rs:313
msgid "{antall} gjentatt sending"
msgid_plural "{antall} gjentatte sendinger"
msgstr[0] "{antall} retransmisión"
msgstr[1] "{antall} retransmisiones"

#: crates/rigg-core/src/report/gpu.rs:318
msgid "{antall} korrigert"
msgid_plural "{antall} korrigerte"
msgstr[0] "{antall} error corregido"
msgstr[1] "{antall} errores corregidos"

#: crates/rigg-core/src/report/gpu.rs:328
msgid "Telleren for gjentatte sendinger (replay) fra NVML og korrigerte AER-feil fra sysfs, siden oppstart. Null er normalt."
msgstr "Retransmisiones según NVML y errores AER corregidos según sysfs, desde el arranque. Cero es normal."

