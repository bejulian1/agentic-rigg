msgstr "{navn} · actual"

#: crates/rigg-core/src/report/gpu.rs:384
msgid "Område per P-tilstand fra driveren. P0 er full ytelse, P8 er tomgang."
msgstr "Intervalo de cada estado según el controlador. P0 es máximo rendimiento; P8, reposo."

#: crates/rigg-core/src/report/gpu.rs:386
msgid "Støttede minneklokker: {klokker} MHz."
msgstr "Frecuencias de memoria compatibles: {klokker} MHz."

