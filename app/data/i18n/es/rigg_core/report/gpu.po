msgstr "rpm no compatibles"

#: crates/rigg-core/src/report/gpu.rs:480
msgid "mål {prosent}"
msgstr "objetivo {prosent}"

#: crates/rigg-core/src/report/gpu.rs:483
msgid "Vifte {nr}"
msgstr "Ventilador {nr}"

#: crates/rigg-core/src/report/gpu.rs:489
msgid "Styring"
msgstr "Control"

#: crates/rigg-core/src/report/gpu.rs:490
msgid "Auto · driveren styrer"
msgstr "Auto · gestionado por el controlador"

#: crates/rigg-core/src/report/gpu.rs:490
msgid "Manuell · rapportert av driveren"
msgstr "Manual · indicado por el controlador"

#: crates/rigg-core/src/report/gpu.rs:492
msgid "Lest med NVML (viftepolicy). Viser driverens rapporterte modus; angir ikke hvilket program som satte den."
msgstr "Leído mediante NVML (política del ventilador). Muestra el modo que indica el controlador, no el programa que lo configuró."

#: crates/rigg-core/src/report/gpu.rs:497
msgid "Termiske sensorer"
msgstr "Sensores térmicos"

#: crates/rigg-core/src/report/gpu.rs:501
msgid "intern GPU-kontroller"
msgstr "controlador interno de la GPU"

#: crates/rigg-core/src/report/gpu.rs:503
msgid "kontroller {id}"
msgstr "controlador {id}"

#: crates/rigg-core/src/report/gpu.rs:516
msgid "Datatilgjengelighet"
msgstr "Disponibilidad de datos"

#: crates/rigg-core/src/report/gpu.rs:517
msgid "ikke innsamlet eller utilgjengelig"
msgstr "sin recopilar o no disponible"

#: crates/rigg-core/src/report/gpu.rs:518
msgid "Hotspot-temperatur"
msgstr "Temperatura del punto caliente"

#: crates/rigg-core/src/report/gpu.rs:518 crates/rigg-core/src/report/gpu.rs:523 crates/rigg-core/src/report/gpu.rs:524
msgid "Ikke innsamlet"
msgstr "Sin recopilar"

#: crates/rigg-core/src/report/gpu.rs:518
msgid "Appen samler ikke inn en egen hotspot-temperatur. De termiske sensorene som driveren rapporterer, vises over; dette avklarer ikke alene om kortet har en hotspot-sensor."
msgstr "La aplicación no lee una temperatura de punto caliente por separado. Arriba se muestran los sensores que indica el controlador, pero no bastan para saber si la GPU tiene un sensor de punto caliente."

#: crates/rigg-core/src/report/gpu.rs:519
msgid "Appen har ingen tilgjengelig minnetemperatur fra NVML for denne prøven. Tilgjengelighet avhenger av kortet og driveren."
msgstr "NVML no ofrece temperatura de la memoria para esta muestra. Depende de la GPU y del controlador."

#: crates/rigg-core/src/report/gpu.rs:520
msgid "Minnetemperatur"
msgstr "Temperatura de la memoria"

#: crates/rigg-core/src/report/gpu.rs:520 crates/rigg-core/src/report/gpu.rs:522
msgid "Ikke verifisert"
msgstr "Sin verificar"

#: crates/rigg-core/src/report/gpu.rs:521
msgid "Appen har ingen tilgjengelig T.Limit-margin fra NVML for denne prøven. Avstanden til nedklokking under Grenser er regnet ut av appen."
msgstr "NVML no ofrece margen T.Limit para esta muestra. La aplicación calcula el margen antes de reducir la frecuencia que aparece en «Límites»."

#: crates/rigg-core/src/report/gpu.rs:522
msgid "T.Limit (margin)"
msgstr "T.Limit (margen)"

#: crates/rigg-core/src/report/gpu.rs:523
msgid "Kjernespenning"
msgstr "Voltaje del núcleo"

#: crates/rigg-core/src/report/gpu.rs:523
msgid "Appen samler ikke inn GPU-kjernespenning. Tilgang for dette kortet og denne driveren er ikke verifisert."
msgstr "La aplicación no lee el voltaje del núcleo de la GPU. No se ha comprobado el acceso con esta GPU y este controlador."

#: crates/rigg-core/src/report/gpu.rs:524
msgid "Gjennomsnittseffekt fra driveren"
msgstr "Potencia media del controlador"

#: crates/rigg-core/src/report/gpu.rs:524
msgid "Appen samler ikke inn driverens eget effektgjennomsnitt. Effekten beregnes fra energitelleren når den finnes, ellers brukes den rapporterte øyeblikksverdien."
msgstr "La aplicación no recopila la media del controlador. Calcula la potencia con el contador de energía si está disponible; de lo contrario, usa el valor instantáneo indicado."

#: crates/rigg-core/src/report/gpu.rs:526
msgid "Standardklokker (applications clocks)"
msgstr "Frecuencias predeterminadas (de aplicación)"

#: crates/rigg-core/src/report/gpu.rs:526
msgid "Avviklet"
msgstr "Obsoleto"

#: crates/rigg-core/src/report/gpu.rs:526
msgid "Avviklet i driveren for dette kortet."
msgstr "Obsoleto en el controlador para esta GPU."

#: crates/rigg-core/src/report/gpu.rs:529
msgid "Delenummer (board part number)"
msgstr "Número de pieza de la tarjeta"

#: crates/rigg-core/src/report/gpu.rs:529
msgid "Ikke oppgitt"
msgstr "No indicado"

#: crates/rigg-core/src/report/gpu.rs:529
msgid "Driveren svarer, men feltet er tomt på dette kortet."
msgstr "El controlador responde, pero el campo está vacío para esta GPU."

#: crates/rigg-core/src/report/gpu.rs:534
msgid "Viftens turtall"
msgstr "Ventilador (rpm)"

#: crates/rigg-core/src/report/gpu.rs:534
msgid "NVML gir «ikke støttet» for turtallet."
msgstr "NVML indica que no se admite la lectura de las RPM del ventilador."

#: crates/rigg-core/src/report/gpu.rs:535
msgid "Videokoder"
msgstr "Codificador de vídeo"

#: crates/rigg-core/src/report/gpu.rs:535
msgid "NVML gir «ikke støttet» for koderen."
msgstr "NVML indica que el codificador no es compatible."

#: crates/rigg-core/src/report/gpu.rs:536
msgid "Videodekoder"
msgstr "Decodificador de vídeo"

#: crates/rigg-core/src/report/gpu.rs:536
msgid "NVML gir «ikke støttet» for dekoderen."
msgstr "NVML indica que el decodificador no es compatible."

#: crates/rigg-core/src/report/gpu.rs:537
msgid "Klokkebegrensninger"
msgstr "Motivos de limitación de frecuencia"

#: crates/rigg-core/src/report/gpu.rs:537
