msgid "Farger"
msgstr "Colori"

#: crates/rigg/src/settings/utseende.rs:407 crates/rigg/src/settings/utseende.rs:409
msgid "Lyst eller mørkt"
msgstr "Chiaro o scuro"

#: crates/rigg/src/settings/utseende.rs:408
msgid "System følger GNOME og bytter med en gang."
msgstr "Sistema segue GNOME e cambia subito."

#: crates/rigg/src/settings/utseende.rs:409
msgid "System"
msgstr "Sistema"

#: crates/rigg/src/settings/utseende.rs:410
msgctxt "søkeord"
msgid "tema mørk modus lys dark light"
msgstr "tema scuro chiaro modalità aspetto"

#: crates/rigg/src/settings/utseende.rs:414
msgid "Tonen i flater, rammer og tekst, i både lyst og mørkt."
msgstr "Tonalità di superfici, bordi e testo in modalità chiara e scura."

#: crates/rigg/src/settings/utseende.rs:416
msgctxt "søkeord"
msgid "palett grafitt sand fjord midnatt"
msgstr "tavolozza grafite sabbia fiordo mezzanotte"

#: crates/rigg/src/settings/utseende.rs:420
msgid "Knapper, valgt side, stolper og glidere. Grafene har faste farger per serie."
msgstr "Pulsanti, pagina attiva, barre e cursori. I grafici usano colori fissi per serie."

#: crates/rigg/src/settings/utseende.rs:422
msgctxt "søkeord"
msgid "blå blågrønn grønn lilla rosa skifer"
msgstr "blu verde viola rosa ardesia"

#: crates/rigg/src/settings/utseende.rs:426
msgid "Ikonet i Vis programmer, dokken og Alt+Tab. Byttet vises etter noen sekunder, uten å logge ut."
msgstr "Icona nel menu delle app, nel dock e in Alt+Tab. Si aggiorna in pochi secondi senza disconnettersi."

#: crates/rigg/src/settings/utseende.rs:428
msgctxt "søkeord"
msgid "ikon appikon dokk vis programmer farge"
msgstr "icona dock menu colore"

#: crates/rigg/src/settings/utseende.rs:431
msgid "Høy kontrast"
msgstr "Contrasto elevato"

#: crates/rigg/src/settings/utseende.rs:432
msgid "Sterkere tekst, rammer, fokusringer og grafer i alle fargetemaer."
msgstr "Testo, bordi, focus e grafici più marcati in tutti i temi."

#: crates/rigg/src/settings/utseende.rs:434
msgctxt "søkeord"
msgid "tilgjengelighet synlighet"
msgstr "accessibilità contrasto visibilità"

