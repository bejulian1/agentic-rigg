msgid "Appikonet er «{navn}»"
msgstr "Icona impostata su «{navn}»"

#: crates/rigg/src/settings/utseende.rs:346
msgid "Appen er ikke installert, så bare vinduet har fått det nye ikonet. Valget brukes når appen installeres."
msgstr "L’app non è installata, quindi solo la finestra ha cambiato icona. La scelta varrà dopo l’installazione."

#: crates/rigg/src/settings/utseende.rs:381
msgid "Ikonet byttes i dokken og Vis programmer om noen sekunder."
msgstr "L’icona cambierà nel dock e nel menu delle app tra pochi secondi."

#: crates/rigg/src/settings/utseende.rs:382
msgid "Kunne ikke bytte appikonet"
msgstr "Impossibile cambiare l’icona"

#: crates/rigg/src/settings/utseende.rs:397
msgid "Automatisk følger systemets innstilling (nå: full)."
msgstr "Automatico segue il sistema (attuale: complete)."

#: crates/rigg/src/settings/utseende.rs:398
msgid "Automatisk følger systemets innstilling (nå: redusert)."
msgstr "Automatico segue il sistema (attuale: ridotte)."

