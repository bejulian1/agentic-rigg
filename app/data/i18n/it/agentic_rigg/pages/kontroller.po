#: crates/rigg/src/pages/kontroller.rs:283
msgid "Kortet har ingenting å gjøre og holder klokkene nede."
msgstr "La GPU è inattiva e mantiene basse le frequenze."

#: crates/rigg/src/pages/kontroller.rs:284 crates/rigg/src/pages/kontroller.rs:336
msgid "Programklokker"
msgstr "Frequenze app"

#: crates/rigg/src/pages/kontroller.rs:284
msgid "Klokkene er låst av et program (applications clocks)."
msgstr "Un’applicazione ha bloccato le frequenze (application clocks)."

#: crates/rigg/src/pages/kontroller.rs:285
msgid "Kortet trekker så mye som effektgrensen tillater."
msgstr "La GPU assorbe tutta la potenza consentita dal limite."

#: crates/rigg/src/pages/kontroller.rs:286
msgid "Maskinvare-nedklokking"
msgstr "Riduzione della frequenza imposta dall’hardware"

#: crates/rigg/src/pages/kontroller.rs:286 crates/rigg/src/pages/kontroller.rs:715
msgid "Kortet klokker ned av seg selv (strøm eller temperatur)."
msgstr "La GPU riduce automaticamente le frequenze per motivi di potenza o temperatura."

#: crates/rigg/src/pages/kontroller.rs:287
msgid "Synkronisert boost"
msgstr "Sync Boost"

#: crates/rigg/src/pages/kontroller.rs:287
msgid "Klokkene følger et annet kort."
msgstr "Le frequenze seguono quelle di un’altra GPU."

#: crates/rigg/src/pages/kontroller.rs:288
msgid "Kortet har nådd temperaturmålet og senker klokkene."
msgstr "La GPU ha raggiunto la temperatura obiettivo e riduce le frequenze."

#: crates/rigg/src/pages/kontroller.rs:289
msgid "Termisk nedklokking"
msgstr "Riduzione della frequenza per temperatura"

#: crates/rigg/src/pages/kontroller.rs:289
msgid "Maskinvaren klokker ned fordi kortet er for varmt."
msgstr "L’hardware riduce le frequenze perché la GPU è troppo calda."

#: crates/rigg/src/pages/kontroller.rs:290
msgid "Effektbrems"
msgstr "Limitazione da alimentatore"

#: crates/rigg/src/pages/kontroller.rs:290
msgid "Strømforsyningen har bedt kortet bremse."
msgstr "L’alimentatore ha richiesto alla GPU di ridurre le frequenze."

#: crates/rigg/src/pages/kontroller.rs:291 crates/rigg/src/pages/kontroller.rs:337
msgid "Skjermklokke"
msgstr "Frequenza display"

#: crates/rigg/src/pages/kontroller.rs:291
msgid "Klokkene er satt for skjermen."
msgstr "Le frequenze sono impostate in base alle esigenze del display."

#: crates/rigg/src/pages/kontroller.rs:316
msgid "Kortet svarer ikke"
msgstr "La GPU non risponde"

#: crates/rigg/src/pages/kontroller.rs:321 crates/rigg/src/pages/kontroller.rs:358
msgid "Ingenting"
msgstr "Nessuno"

#: crates/rigg/src/pages/kontroller.rs:321 crates/rigg/src/pages/kontroller.rs:358
msgid "Kortet er i ro"
msgstr "GPU inattiva"

#: crates/rigg/src/pages/kontroller.rs:321
msgid "Kortet er i dyp tomgang (P8). Da spør tjenesten ikke om årsakene: kallet koster ca. 25 ms og vekker kortet."
msgstr "La GPU è in inattività profonda (P8). Il servizio evita questa interrogazione perché richiede circa 25 ms e riattiva la GPU."

#: crates/rigg/src/pages/kontroller.rs:324
msgid "Kortet melder ikke årsaker"
msgstr "Nessun motivo segnalato"

#: crates/rigg/src/pages/kontroller.rs:324
msgid "nvmlDeviceGetCurrentClocksEventReasons svarer ikke på dette kortet."
msgstr "nvmlDeviceGetCurrentClocksEventReasons non risponde su questa GPU."

#: crates/rigg/src/pages/kontroller.rs:331 crates/rigg/src/pages/kontroller.rs:334 crates/rigg/src/pages/kontroller.rs:597 crates/rigg/src/pages/kontroller.rs:713
msgid "Temperatur"
msgstr "Temperatura"

#: crates/rigg/src/pages/kontroller.rs:331
msgid "Maskinvaren klokker ned"
msgstr "Riduzione della frequenza imposta dall’hardware"

#: crates/rigg/src/pages/kontroller.rs:332 crates/rigg/src/pages/kontroller.rs:335 crates/rigg/src/pages/kontroller.rs:597 crates/rigg/src/pages/kontroller.rs:712
msgid "Effekt"
msgstr "Potenza"

#: crates/rigg/src/pages/kontroller.rs:332
msgid "Strømforsyningen bremser"
msgstr "Limitazione da alimentatore"

#: crates/rigg/src/pages/kontroller.rs:333 crates/rigg/src/pages/kontroller.rs:715
msgid "Maskinvare"
msgstr "Hardware"

#: crates/rigg/src/pages/kontroller.rs:333
msgid "Kortet klokker ned selv"
msgstr "La GPU riduce automaticamente le frequenze"

#: crates/rigg/src/pages/kontroller.rs:334
msgid "Temperaturmålet er nådd"
msgstr "Temperatura obiettivo raggiunta"

#: crates/rigg/src/pages/kontroller.rs:335
msgid "Effektgrensen er nådd"
msgstr "Limite di potenza raggiunto"

#: crates/rigg/src/pages/kontroller.rs:336
msgid "Låst av et program"
msgstr "Bloccate da un’applicazione"

#: crates/rigg/src/pages/kontroller.rs:337
msgid "Satt for skjermen"
msgstr "Impostate per il display"

#: crates/rigg/src/pages/kontroller.rs:338
msgid "Synkronisert"
msgstr "Sincronizzate"

#: crates/rigg/src/pages/kontroller.rs:338
msgid "Følger et annet kort"
msgstr "Seguono un’altra GPU"

#: crates/rigg/src/pages/kontroller.rs:345
msgid "Grensen {grense} er nådd"
msgstr "Raggiunto il limite di {grense}"

#: crates/rigg/src/pages/kontroller.rs:349
msgid "Målet {maal} er nådd"
msgstr "Raggiunto l’obiettivo di {maal}"

#: crates/rigg/src/pages/kontroller.rs:358
msgid "Kortet har ingenting å gjøre og holder klokkene nede (tomgang)."
msgstr "La GPU è inattiva e mantiene basse le frequenze."

#: crates/rigg/src/pages/kontroller.rs:362 crates/rigg/src/pages/kontroller.rs:714
msgid "Spenning"
msgstr "Tensione"

#: crates/rigg/src/pages/kontroller.rs:363
msgid "Toppen av klokkekurven"
msgstr "Punto più alto della curva di frequenza"

#: crates/rigg/src/pages/kontroller.rs:365
msgid "NVML melder ingen begrensning, og kortet har last. Da går det så høyt spenningen tillater (det GPU-Z kaller VRel/VOp). Utledet, ikke lest fra kortet."
msgstr "NVML non segnala limiti mentre la GPU è sotto carico. La frequenza sale quindi al massimo consentito dalla tensione (VRel/VOp in GPU-Z). Valore dedotto, non letto dalla GPU."

#: crates/rigg/src/pages/kontroller.rs:368
msgid "Ingen"
msgstr "Nessuno"

#: crates/rigg/src/pages/kontroller.rs:368
msgid "Klokkene kan gå fritt"
msgstr "Nessun limite alla frequenza"

#: crates/rigg/src/pages/kontroller.rs:368
msgid "NVML melder ingen begrensning."
msgstr "NVML non segnala limiti."

#: crates/rigg/src/pages/kontroller.rs:374
msgid "full ytelse"
msgstr "prestazioni massime"

#: crates/rigg/src/pages/kontroller.rs:375
msgid "høy ytelse"
msgstr "prestazioni elevate"

#: crates/rigg/src/pages/kontroller.rs:376
msgid "middels"
msgstr "prestazioni medie"

#: crates/rigg/src/pages/kontroller.rs:377
msgid "tomgang"
msgstr "inattività"

#: crates/rigg/src/pages/kontroller.rs:378
msgid "laveste"
msgstr "prestazioni minime"

#: crates/rigg/src/pages/kontroller.rs:393
msgid "Hvor mye strøm kortet får bruke. 100 % er kortets oppgitte standardgrense."
msgstr "Potenza che la GPU può assorbire. Il 100% corrisponde al limite predefinito segnalato dalla scheda."

#: crates/rigg/src/pages/kontroller.rs:395
msgid "Kortet holder seg under grensen ved å senke klokken. Under tung last kan effektgrensen begrense GPU-boost; en høyere grense kan da gi høyere klokke."
msgstr "La GPU riduce la frequenza per restare entro il limite. Sotto carico elevato, il limite di potenza può frenare il boost; aumentarlo può consentire frequenze più alte."

#: crates/rigg/src/pages/kontroller.rs:396
msgid "Prisen er mer varme, mer viftestøy og høyere strømforbruk. En lavere grense gir et kjøligere og stillere kort med litt lavere ytelse."
msgstr "Un limite più alto aumenta calore, rumore delle ventole e consumi. Un limite più basso mantiene la GPU più fresca e silenziosa, a scapito di parte delle prestazioni."

#: crates/rigg/src/pages/kontroller.rs:402
msgid "Justering av GPU-klokken. 0 MHz betyr ingen justering; faktisk hastighet vises over."
msgstr "Offset della frequenza della GPU. 0 MHz indica nessun offset; la frequenza misurata è mostrata sopra."

#: crates/rigg/src/pages/kontroller.rs:404
msgid "Offset legges på hvert punkt på klokkekurven (spenning mot klokke). Kortet booster fortsatt selv, men lander høyere. Spenningen endres ikke."
msgstr "L’app applica l’offset a ogni punto della curva tensione/frequenza. Il boost resta automatico, ma la GPU raggiunge frequenze più alte. La tensione non cambia."

#: crates/rigg/src/pages/kontroller.rs:405
msgid "For høy offset gir krasj, feil i bildet eller at driveren starter på nytt. Prøv i steg på 15–25 MHz og test under last."
msgstr "Offset eccessivi possono causare arresti anomali, artefatti o riavvii del driver. Prova incrementi di 15–25 MHz e verifica sotto carico."

#: crates/rigg/src/pages/kontroller.rs:411
msgid "Justering av minneklokken. 0 MHz betyr ingen justering, ikke at minnet står stille."
msgstr "Offset della frequenza della memoria. 0 MHz indica nessun offset: la memoria continua a funzionare."

#: crates/rigg/src/pages/kontroller.rs:413
msgid "Dette er en justering i MHz, ikke en fast sluttklokke eller minnebåndbredde i Gb/s. Kortets målte hastighet vises separat. Appen regner om til driverens skala når verdien sendes."
msgstr "È un offset in MHz, non una frequenza finale fissa né la larghezza di banda della memoria in Gb/s. La frequenza misurata è mostrata a parte. L’app converte il valore nella scala del driver prima di inviarlo."

#: crates/rigg/src/pages/kontroller.rs:414
msgid "En høyere justering er bare nyttig hvis programmer faktisk kjører raskere. For høy justering kan gi bildefeil, lavere ytelse eller ustabilitet."
msgstr "Un offset più alto è utile solo se le applicazioni diventano effettivamente più veloci. Offset eccessivi possono causare artefatti visivi, cali di prestazioni o instabilità."

#: crates/rigg/src/pages/kontroller.rs:420
msgid "Temperaturen kortet holder seg under. Lavere gir et kjøligere kort og lavere klokke."
msgstr "Temperatura sotto la quale la GPU cerca di restare. Un obiettivo più basso mantiene la GPU più fresca, ma ne riduce le frequenze."

#: crates/rigg/src/pages/kontroller.rs:422
msgid "Når temperaturen når målet, senker kortet klokken (begrensningen «Temperaturmål»). Viftene styres fortsatt av viftemodusen."
msgstr "Raggiunto l’obiettivo, la GPU riduce le frequenze (limite «Temperatura obiettivo»). Le ventole continuano a seguire la modalità selezionata."

#: crates/rigg/src/pages/kontroller.rs:423
msgid "Nedklokking og avstenging er egne maskinvaregrenser. Temperaturmålet kan endres når kortet og driveren støtter det; grensen og støtten leses fra kortet."
msgstr "L’hardware ha soglie distinte per la riduzione delle frequenze e lo spegnimento. La temperatura obiettivo si può regolare se la GPU e il driver lo consentono; la GPU indica il supporto e l’intervallo."

#: crates/rigg/src/pages/kontroller.rs:429
msgid "Hvem som styrer viftene: driveren, viftekurven eller en fast fart."
msgstr "Scegli come regolare le ventole: tramite il driver, una curva o una velocità fissa."

#: crates/rigg/src/pages/kontroller.rs:431
msgid "Auto: driveren styrer etter temperaturen, som uten appen. Kurve: tjenesten setter farten fra viftekurven hvert sekund. Manuell: fast fart, uansett temperatur."
msgstr "Auto: il driver regola la velocità in base alla temperatura, come senza l’app. Curva: il servizio aggiorna la velocità ogni secondo in base alla curva. Manuale: velocità fissa a qualsiasi temperatura."

#: crates/rigg/src/pages/kontroller.rs:432
msgid "Manuell fart følger grensene NVIDIA-driveren rapporterer. Automatisk viftestopp kan avhenge av kortmodell og driver; støtte for det er ikke bekreftet på dette kortet."
msgstr "La velocità manuale rispetta l’intervallo indicato dal driver NVIDIA. L’arresto automatico delle ventole dipende dal modello e dal driver e non è stato confermato per questa GPU."

#: crates/rigg/src/pages/kontroller.rs:496
msgid "Viser det kortet har nå. Det du endrer, blir et utkast som lagres i appen og ikke sendes til kortet."
msgstr "Mostra le impostazioni attuali della GPU. Le modifiche vengono salvate nell’app come bozza e non inviate alla GPU."

#: crates/rigg/src/pages/kontroller.rs:511
msgid "GPU-klokke nå"
msgstr "Frequenza GPU attuale"

#: crates/rigg/src/pages/kontroller.rs:511
msgid "Minneklokke nå"
msgstr "Frequenza memoria attuale"

#: crates/rigg/src/pages/kontroller.rs:511
msgid "Temperatur nå"
