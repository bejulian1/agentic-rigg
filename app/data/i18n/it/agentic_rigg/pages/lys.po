#: crates/rigg/src/pages/lys.rs:154
msgid "Skjermkort"
msgstr "Scheda grafica"

#: crates/rigg/src/pages/lys.rs:156
msgid "Ikke aktivert"
msgstr "Non attivato"

#: crates/rigg/src/pages/lys.rs:160
msgid "3D"
msgstr "3D"

#: crates/rigg/src/pages/lys.rs:160
msgid "2D"
msgstr "2D"

#: crates/rigg/src/pages/lys.rs:160
msgid "Visning"
msgstr "Vista"

#: crates/rigg/src/pages/lys.rs:182
msgid "Dra for å vri · rull for zoom · 0 tilbakestiller"
msgstr "Trascina per ruotare · scorri per lo zoom · 0 reimposta"

#: crates/rigg/src/pages/lys.rs:188
msgid "Bygger 3D-kortet …"
msgstr "Costruzione della scheda 3D …"

#: crates/rigg/src/pages/lys.rs:226 crates/rigg/src/pages/lys.rs:232
msgid "Vinkel"
msgstr "Angolo"

#: crates/rigg/src/pages/lys.rs:228 crates/rigg/src/pages/lys.rs:229
msgid "Tilbakestill visningen"
msgstr "Reimposta vista"

#: crates/rigg/src/pages/lys.rs:239 crates/rigg/src/pages/lys.rs:242
msgid "Lag"
msgstr "Strati"

#: crates/rigg/src/pages/lys.rs:250 crates/rigg/src/pages/lys.rs:255
msgid "Skill lagene"
msgstr "Separa gli strati"

#: crates/rigg/src/pages/lys.rs:263 crates/rigg/src/pages/lys.rs:266
msgid "Bakgrunnslys"
msgstr "Luce ambientale"

#: crates/rigg/src/pages/lys.rs:293
msgid "Deler i 3D-modellen"
msgstr "Parti nel modello 3D"

#: crates/rigg/src/pages/lys.rs:528 crates/rigg/src/pages/lys.rs:546
msgid "Forhåndsvisning av valg"
msgstr "Anteprima della scelta"

#: crates/rigg/src/pages/lys.rs:530
msgid "Prøve på kortet"
msgstr "Prova sulla scheda"

#: crates/rigg/src/pages/lys.rs:532
msgid "Aktiv effekt"
msgstr "Effetto attivo"

#: crates/rigg/src/pages/lys.rs:544
msgid "Speiler kortlyset"
msgstr "Rispecchia la scheda"

#: crates/rigg/src/pages/lys.rs:559
msgid "Utgangspunkt: {farge} · {styrke}"
msgstr "Stato iniziale: {farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:561
msgid "Sist lest: {farge} · {styrke}"
msgstr "Ultima lettura: {farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:735 crates/rigg/src/pages/lys.rs:955
msgid "Lys vises i 2D"
msgstr "Visualizzazione in 2D"

#: crates/rigg/src/pages/lys.rs:735
msgid "3D-kortet kunne ikke tegnes med grafikken her. Det flate kortet viser de samme lysvalgene."
msgstr "Impossibile disegnare la scheda 3D con la grafica attuale. La vista 2D mostra le stesse scelte di illuminazione."

#: crates/rigg/src/pages/lys.rs:833
msgid "3D kan ikke tegnes her ({feil}). Klikk for å prøve igjen."
msgstr "Impossibile disegnare in 3D qui ({feil}). Fai clic per riprovare."

#: crates/rigg/src/pages/lys.rs:835
msgid "Grafikken tegnet 3D for tregt. Klikk for å prøve igjen."
msgstr "La grafica ha disegnato il 3D troppo lentamente. Fai clic per riprovare."

#: crates/rigg/src/pages/lys.rs:837
msgid "Kortet i 3D. Dra for å vri."
msgstr "Scheda in 3D. Trascina per ruotare."

#: crates/rigg/src/pages/lys.rs:842
msgid "Flatt kort sett forfra. Bruker minst ressurser."
msgstr "Scheda piatta vista frontalmente. Consuma meno risorse."

#: crates/rigg/src/pages/lys.rs:857
msgid "Stillbilde: grafikken tegner for tregt"
msgstr "Immagine fissa: il rendering grafico è troppo lento"

#: crates/rigg/src/pages/lys.rs:859
msgid "Animasjon av"
msgstr "Animazione disattivata"

#: crates/rigg/src/pages/lys.rs:955
msgid "Grafikken tegnet 3D-kortet for tregt. Velg 3D over visningen for å prøve igjen."
msgstr "Il rendering della scheda 3D era troppo lento. Seleziona 3D sopra la vista per riprovare."

#: crates/rigg/src/pages/lys.rs:1062
msgid "Kortlys er ikke aktivert."
msgstr "L’illuminazione della scheda non è attivata."

#: crates/rigg/src/pages/lys.rs:1064
msgid "Lysene er av."
msgstr "Le luci sono spente."

#: crates/rigg/src/pages/lys.rs:1066
msgid "Lysstyrke {styrke}."
msgstr "Luminosità {styrke}."

#: crates/rigg/src/pages/lys.rs:1080
msgid "{lag} · lagene skilt"
msgstr "{lag} · strati separati"

#: crates/rigg/src/pages/lys.rs:1103
msgid "Flatt skjermkort sett forfra."
msgstr "Scheda grafica piatta vista frontalmente."

#: crates/rigg/src/pages/lys.rs:1119
msgid "Kortet har én fysisk lyssone."
msgstr "La scheda dispone di una sola zona fisica di illuminazione."
