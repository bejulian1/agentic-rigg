msgstr "Aggiungi un punto dopo la selezione (+)"

#: crates/rigg/src/pages/viftekurve.rs:1914
msgid "Slik følges kurven"
msgstr "Come funziona la curva"

#: crates/rigg/src/pages/viftekurve.rs:1919
