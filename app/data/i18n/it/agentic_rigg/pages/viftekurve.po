msgstr "Ripristina i valori attuali della GPU e scarta la bozza. Usa Ctrl+Z per annullare."

#: crates/rigg/src/pages/viftekurve.rs:2002
msgid "Bruk"
msgstr "Applica"

#: crates/rigg/src/pages/viftekurve.rs:2092
msgid "Vifte 1"
msgstr "Ventola 1"

#: crates/rigg/src/pages/viftekurve.rs:2092
msgid "Vifte 2"
msgstr "Ventola 2"

#: crates/rigg/src/pages/viftekurve.rs:2094
msgid "Avlest viftefart"
msgstr "Velocità misurata delle ventole"

#: crates/rigg/src/pages/viftekurve.rs:2101
msgid "Avleste viftekanaler"
msgstr "Canali delle ventole misurati"

#: crates/rigg/src/pages/viftekurve.rs:2102
msgid "Historikken viser tilgjengelige målekanaler. Backendens fan0/fan1 dekker ikke nødvendigvis alle fysiske vifter på kortet."
msgstr "Lo storico mostra i canali dei sensori disponibili. I canali fan0 e fan1 del backend potrebbero non rappresentare tutte le ventole fisiche della GPU."

#: crates/rigg/src/pages/viftekurve.rs:2324
msgid "Utkastet er forkastet"
msgstr "Bozza scartata"

#: crates/rigg/src/pages/viftekurve.rs:2324
msgid "Angre"
msgstr "Annulla"

#: crates/rigg/src/pages/viftekurve.rs:2435
msgid "Siste 5 minutter med utkastet"
msgstr "Ultimi 5 minuti con la bozza"

#: crates/rigg/src/pages/viftekurve.rs:2438
msgid "Forhåndsvisning venter på støttet vifteantall."
msgstr "L’anteprima richiede un numero di ventole supportato."

#: crates/rigg/src/pages/viftekurve.rs:2444 crates/rigg/src/pages/viftekurve.rs:2489
msgid "Tjenesten svarer ikke."
msgstr "Il servizio non risponde."

#: crates/rigg/src/pages/viftekurve.rs:2444
msgid "Ingen målinger de siste 5 minuttene ennå."
msgstr "Non ci sono ancora campioni per gli ultimi 5 minuti."

#: crates/rigg/src/pages/viftekurve.rs:2446
