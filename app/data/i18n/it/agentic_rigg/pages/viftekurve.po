msgid_plural ", {n} målinger"
msgstr[0] ", {n} campione"
msgstr[1] ", {n} campioni"

#: crates/rigg/src/pages/viftekurve.rs:756
msgid "Viftekurven: viftefart mot GPU-temperatur"
msgstr "Curva delle ventole: velocità in funzione della temperatura della GPU"

#: crates/rigg/src/pages/viftekurve.rs:1156
msgid "nå"
msgstr "ora"

#: crates/rigg/src/pages/viftekurve.rs:1193
msgid "Viftene de siste fem minuttene, slik de gikk og med kurven"
msgstr "Ventole negli ultimi cinque minuti: velocità effettiva e anteprima della curva"

#: crates/rigg/src/pages/viftekurve.rs:1227 crates/rigg/src/pages/viftekurve.rs:2605
msgid "Auto (driveren)"
msgstr "Auto (driver)"

#: crates/rigg/src/pages/viftekurve.rs:1227
msgid "Driveren styrer viftene etter temperaturen, som uten appen. Standard."
msgstr "Il driver regola le ventole in base alla temperatura, come senza l’app. Modalità predefinita."

#: crates/rigg/src/pages/viftekurve.rs:1228 crates/rigg/src/pages/viftekurve.rs:2607
msgid "Kurve"
msgstr "Curva"

#: crates/rigg/src/pages/viftekurve.rs:1228
msgid "Agentic Rigg setter farten etter viftekurven hvert sekund."
msgstr "Agentic Rigg aggiorna la velocità ogni secondo in base alla curva."

#: crates/rigg/src/pages/viftekurve.rs:1229 crates/rigg/src/pages/viftekurve.rs:2606
msgid "Manuell"
msgstr "Manuale"

#: crates/rigg/src/pages/viftekurve.rs:1229
msgid "Fast fart, uansett temperatur. Pass på temperaturen under last."
msgstr "Velocità fissa a qualsiasi temperatura. Controlla la temperatura sotto carico."

#: crates/rigg/src/pages/viftekurve.rs:1236
msgid "Egen kurve er aktiv på kortet. Modusbyttet ligger bare i utkastet til du trykker Bruk og Behold."
msgstr "È attiva una curva personalizzata. Il cambio di modalità rimane nella bozza finché non fai clic su Applica e poi su Mantieni."

#: crates/rigg/src/pages/viftekurve.rs:1238
msgid "Egen kurve er aktiv på kortet. Du har et kurveutkast; åpne Avansert for å se og redigere det."
msgstr "È attiva una curva personalizzata e c’è una bozza salvata. Apri la vista Avanzata per vedere o modificare la bozza."

#: crates/rigg/src/pages/viftekurve.rs:1240
msgid "Egen kurve er aktiv. Viftene fortsetter å følge den i Enkel visning. Åpne Avansert for å se og redigere kurven."
msgstr "È attiva una curva personalizzata. Le ventole la seguono anche nella vista Semplice. Apri la vista Avanzata per vederla o modificarla."

#: crates/rigg/src/pages/viftekurve.rs:1243
msgid "Egen kurve er valgt i utkastet. Åpne Avansert for å se kurven. Kortet endres først med Bruk og Behold."
msgstr "La bozza usa una curva personalizzata. Apri la vista Avanzata per vederla. La GPU cambia impostazioni solo dopo Applica e Mantieni."

#: crates/rigg/src/pages/viftekurve.rs:1255
msgid "Felles kurve"
msgstr "Curva condivisa"

#: crates/rigg/src/pages/viftekurve.rs:1257
msgid "Vifte {i}"
msgstr "Ventola {i}"

#: crates/rigg/src/pages/viftekurve.rs:1265
msgid "Kurven som redigeres"
msgstr "Curva in modifica"

#: crates/rigg/src/pages/viftekurve.rs:1268
msgid "Én felles kurve for kortets vifter"
msgstr "Un’unica curva condivisa da tutte le ventole della GPU"

#: crates/rigg/src/pages/viftekurve.rs:1270
msgid "Egen kurve for vifte {id}. En annen vifte kan vises svakt bak."
msgstr "Curva personalizzata per la ventola {id}. Sullo sfondo può apparire in trasparenza la curva di un’altra ventola."

#: crates/rigg/src/pages/viftekurve.rs:1283
msgid "Antall GPU-vifter er ikke lest. Viftestyring venter på kortets informasjon."
msgstr "Il controllo delle ventole è in attesa che la GPU ne segnali il numero."

#: crates/rigg/src/pages/viftekurve.rs:1284
msgid "Kortet rapporterer ingen GPU-vifter. Viftestyring er utilgjengelig."
msgstr "La GPU non segnala alcuna ventola. Il controllo delle ventole non è disponibile."

#: crates/rigg/src/pages/viftekurve.rs:1285
msgid "Kortet rapporterer {n} vifter. Kurvemotoren støtter høyst {maks} vifter på ett kort."
msgstr "La GPU segnala {n} ventole. Il controllo tramite curva supporta fino a {maks} ventole per GPU."

