msgstr "No"

#: crates/rigg-core/src/report/gpu.rs:262
msgid "NVML displayActive. Med den åpne kjernemodulen på Wayland står det ofte «Nei» selv når en skjerm er koblet til."
msgstr "NVML displayActive. Su Wayland con il modulo kernel aperto spesso indica «No» anche se è collegato uno schermo."

#: crates/rigg-core/src/report/gpu.rs:267
msgid "Minne og buss"
msgstr "Memoria e bus"

#: crates/rigg-core/src/report/gpu.rs:268 crates/rigg-core/src/report/gpu.rs:563
msgid "Videominne"
msgstr "Memoria video"

#: crates/rigg-core/src/report/gpu.rs:268
msgid "{minne} er reservert av driveren og regnes ikke som brukt (MemoryInfo_v2)."
msgstr "Il driver riserva {minne}, non conteggiati come memoria in uso (MemoryInfo_v2)."

