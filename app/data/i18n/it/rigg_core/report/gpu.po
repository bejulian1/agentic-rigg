msgstr "Il collegamento usa Gen {na} per risparmiare energia a riposo e passa a Gen {maks} sotto carico. {rate_na}, {rate_maks}."

#: crates/rigg-core/src/report/gpu.rs:122
msgid "Lenken går på full hastighet. {rate}."
msgstr "Il collegamento funziona alla massima velocità. {rate}."

