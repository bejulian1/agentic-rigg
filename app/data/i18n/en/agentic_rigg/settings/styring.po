#: crates/rigg/src/settings/styring.rs:245
msgid "Manuell viftefart og Auto"
msgstr "Manual and automatic fan speed"

#: crates/rigg/src/settings/styring.rs:245
msgid "Viftekurve"
msgstr "Fan curve"

#: crates/rigg/src/settings/styring.rs:245
msgid "Kjerneklokke"
msgstr "Core clock"

#: crates/rigg/src/settings/styring.rs:245
msgid "Minneklokke"
