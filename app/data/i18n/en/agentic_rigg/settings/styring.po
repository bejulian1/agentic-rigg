msgid "Ikke undersøkt"
msgstr "Not checked"

#: crates/rigg/src/settings/styring.rs:247
msgid "Utilgjengelig"
msgstr "Unavailable"

#: crates/rigg/src/settings/styring.rs:250
msgid "Leses når administratorhjelperen aktiveres for dette kortet."
msgstr "Checked when the administrator helper is enabled for this GPU."

#: crates/rigg/src/settings/styring.rs:260
msgid "Kortets rapporterte område: {omraade}."
msgstr "Range reported by the card: {omraade}."

#: crates/rigg/src/settings/styring.rs:262
msgid "Støttes av den tilkoblede hjelperen."
msgstr "Supported by the connected helper."

#: crates/rigg/src/settings/styring.rs:311
msgid "Se RGB-lys"
msgstr "See RGB lighting"

#: crates/rigg/src/settings/styring.rs:312
msgid "Venter på at RGB-arbeideren skal starte."
msgstr "Waiting for the RGB worker to start."

#: crates/rigg/src/settings/styring.rs:313 crates/rigg/src/settings/styring.rs:449
msgid "Sjekk igjen"
msgstr "Check again"

#: crates/rigg/src/settings/styring.rs:330
msgid "Kortlys (RGB)"
msgstr "Card lighting (RGB)"

#: crates/rigg/src/settings/styring.rs:331
msgid "Tilgjengelige funksjoner"
msgstr "Available features"

#: crates/rigg/src/settings/styring.rs:332
msgid "Én administratoraktivering gjelder støttede funksjoner på det valgte kortet. Listen er status, ikke ekstra godkjenninger."
msgstr "One administrator activation covers the supported features on the selected GPU. This list shows status; it is not a set of extra approvals."

#: crates/rigg/src/settings/styring.rs:334
msgctxt "søkeord"
msgid "funksjoner støtte effekt vifter klokker temperatur"
msgstr "features support power fans clocks temperature"

#: crates/rigg/src/settings/styring.rs:365 crates/rigg/src/settings/styring.rs:382
msgid "Tillat endring av skjermkortet"
msgstr "Allow GPU tuning"

#: crates/rigg/src/settings/styring.rs:383
msgid "Tillater effekt, vifter, klokker og temperaturmål på valgt kort, samt kortlyset på støttede Palit-kort."
msgstr "Allows power, fan, clock and target temperature changes on the selected card, and lighting on supported Palit cards."

#: crates/rigg/src/settings/styring.rs:385
msgctxt "søkeord"
msgid "root polkit pkexec hjelper skriving endre overklokking"
msgstr "root polkit pkexec helper write change modify overclocking"

#: crates/rigg/src/settings/styring.rs:410
msgid "Venter"
msgstr "Waiting"

#: crates/rigg/src/settings/styring.rs:412 crates/rigg/src/settings/styring.rs:417
msgid "Oppdater hjelper"
msgstr "Update helper"

#: crates/rigg/src/settings/styring.rs:413
msgid "Klar"
msgstr "Ready"

#: crates/rigg/src/settings/styring.rs:414
msgid "Simulert"
msgstr "Simulated"

#: crates/rigg/src/settings/styring.rs:416
msgid "Feil"
msgstr "Error"

#: crates/rigg/src/settings/styring.rs:431
msgid "Åpne styring"
msgstr "Open GPU tuning"

#: crates/rigg/src/settings/styring.rs:443
msgid "Start på nytt"
msgstr "Restart"

#: crates/rigg/src/settings/styring.rs:464
msgctxt "søkeord"
msgid "systemkomponenter installasjon terminal"
msgstr "system components installation install terminal offline"

#: crates/rigg/src/settings/styring.rs:467
msgid "Endring av skjermkortet"
msgstr "GPU tuning"

#: crates/rigg/src/settings/styring.rs:469
msgid "Når du slår av tilgangen, stoppes begge arbeiderne. Lagret lys og uavklarte endringer bevares."
msgstr "Turning off access stops both workers. Saved lighting and unresolved changes are retained."

#: crates/rigg/src/settings/styring.rs:470
msgctxt "søkeord"
msgid "bryter av på status"
msgstr "switch off on status"

#: crates/rigg/src/settings/styring.rs:479
msgid "Hjelperen"
msgstr "Helper"

#: crates/rigg/src/settings/styring.rs:479
msgid "To isolerte arbeidere for GPU-styring og kortlys"
msgstr "Two isolated workers for GPU control and card lighting"

#: crates/rigg/src/settings/styring.rs:480
msgid "Passord"
msgstr "Password"

#: crates/rigg/src/settings/styring.rs:480
msgid "Én administratorgodkjenning ved aktivering. Vanlige endringer bruker Bruk og Behold"
msgstr "One administrator approval during activation. For ordinary changes, use Apply and Keep"

#: crates/rigg/src/settings/styring.rs:481
msgid "Hvem"
msgstr "Access"

#: crates/rigg/src/settings/styring.rs:481
msgid "Bare brukeren din. Andre brukere på maskinen slipper ikke til"
msgstr "Only your user account. Other accounts on the computer do not have access"

#: crates/rigg/src/settings/styring.rs:482
msgid "Vern"
msgstr "Safeguards"

#: crates/rigg/src/settings/styring.rs:482
msgid "Endringer rulles tilbake uten Behold innen fristen. Viftekurven har nødregel ved høy temperatur. Frakobling og stopp gjenoppretter utgangspunktet; eventuelle feil rapporteres"
msgstr "Changes revert unless you click Keep before the timer expires. The fan curve has an emergency rule for high temperatures. Disconnecting or stopping restores the original settings; any errors are reported"

#: crates/rigg/src/settings/styring.rs:483
msgid "Filene"
msgstr "Files"

#: crates/rigg/src/settings/styring.rs:483
