msgstr "{hjelper}\n{konfigurasjon} (user, card and activation)"

#: crates/rigg/src/settings/styring.rs:485
msgid "Skriptene"
msgstr "Scripts"

#: crates/rigg/src/settings/styring.rs:487
msgid "Hva bryteren gjør"
msgstr "How the switch works"

#: crates/rigg/src/settings/styring.rs:487
msgctxt "søkeord"
msgid "hjelper root polkit systemd sikkerhet passord"
msgstr "helper root polkit systemd security password"

