#: crates/rigg/src/settings/styring.rs:70
msgid "Venter på administratorgodkjenning …"
msgstr "Waiting for administrator approval…"

#: crates/rigg/src/settings/styring.rs:71
msgid "Tjenesten svarer ikke. Endringer er låst."
msgstr "The service is not responding. Changes are locked."

#: crates/rigg/src/settings/styring.rs:74
msgid "Styring er klar for det valgte skjermkortet. Endringer brukes først når du trykker Bruk."
msgstr "The selected GPU is ready to tune. Changes take effect only when you click Apply."

#: crates/rigg/src/settings/styring.rs:75
msgid "Simulert styring. Det ekte skjermkortet endres ikke."
msgstr "Simulated controls. The real GPU is not changed."

#: crates/rigg/src/settings/styring.rs:76
msgid "Hjelperen er ikke klar for kortet som vises. Se funksjonsstøtten under, eller trykk Sjekk igjen."
msgstr "The helper is not ready for this GPU. Check the supported features below, or click Check again."

#: crates/rigg/src/settings/styring.rs:77
msgid "Hjelperen må oppdateres. Slå bryteren av og på igjen for å aktivere denne versjonen."
msgstr "The helper needs an update. Turn the switch off and back on to activate this version."

#: crates/rigg/src/settings/styring.rs:78
msgid "Hjelperfilene mangler. Installer den nye appversjonen først."
msgstr "Helper files are missing. Install the new app version first."

#: crates/rigg/src/settings/styring.rs:79
msgid "Bare visning. Endring av skjermkortet er slått av."
msgstr "Monitoring only. GPU tuning is off."

#: crates/rigg/src/settings/styring.rs:88
msgid "agentic-rigg-helper {versjon} · bygg {b}"
msgstr "agentic-rigg-helper {versjon} · build {b}"

#: crates/rigg/src/settings/styring.rs:91
msgid "Simulert kort"
msgstr "Simulated GPU"

#: crates/rigg/src/settings/styring.rs:91
msgid "Det ekte kortet (NVML)"
msgstr "Real GPU (NVML)"

#: crates/rigg/src/settings/styring.rs:127
msgid "Avbrutt"
msgstr "Canceled"

#: crates/rigg/src/settings/styring.rs:127
msgid "Passordet ble ikke gitt. Ingenting er endret."
msgstr "No password was entered. Nothing changed."

#: crates/rigg/src/settings/styring.rs:128
msgid "Fant ikke pkexec, eller ingen kan spørre om passordet (polkit)."
msgstr "pkexec is unavailable or polkit cannot prompt for a password."

#: crates/rigg/src/settings/styring.rs:129
msgid "Skriptet feilet."
msgstr "The script failed."

#: crates/rigg/src/settings/styring.rs:137
msgid "Ingen skjermkort valgt"
msgstr "No GPU selected"

#: crates/rigg/src/settings/styring.rs:141
msgid "Kortidentiteten er ikke klar"
msgstr "GPU identity unavailable"

#: crates/rigg/src/settings/styring.rs:141
msgid "Vent til driveren har lest UUID, og prøv igjen."
msgstr "Wait for the driver to read the UUID, then try again."

#: crates/rigg/src/settings/styring.rs:148
msgid "Kunne ikke aktivere styring"
msgstr "Could not enable GPU tuning"

#: crates/rigg/src/settings/styring.rs:148
msgid "Kunne ikke slå av styring"
msgstr "Could not disable GPU tuning"

#: crates/rigg/src/settings/styring.rs:157
msgid "Skjermkortstyring er aktivert"
msgstr "GPU tuning enabled"

#: crates/rigg/src/settings/styring.rs:157
msgid "Velg endringer og trykk Bruk. Behold dem innen fristen, ellers rulles de tilbake."
msgstr "Make your changes and click Apply. Click Keep before the timer expires, or they will be reverted."

#: crates/rigg/src/settings/styring.rs:158
msgid "Hjelperen er installert, men styring er ikke klar"
msgstr "Helper installed, but GPU tuning is not ready"

#: crates/rigg/src/settings/styring.rs:159
msgid "Skjermkortstyring er slått av"
msgstr "GPU tuning disabled"

#: crates/rigg/src/settings/styring.rs:159
msgid "Hjelperen har gjenopprettet utgangspunktet og er fjernet."
msgstr "The helper restored the original settings and was removed."

#: crates/rigg/src/settings/styring.rs:168
msgid "Én aktivering"
msgstr "One-time activation"

#: crates/rigg/src/settings/styring.rs:168
msgid "Bruk Tillat endring av skjermkortet. Funksjonsstøtten bestemmes av kortet og driveren."
msgstr "Use Allow GPU tuning. The available features depend on the GPU and driver."

#: crates/rigg/src/settings/styring.rs:178
msgid "Effektgrense"
msgstr "Power limit"

#: crates/rigg/src/settings/styring.rs:178
msgid "Manuell viftefart og Auto"
msgstr "Manual and automatic fan speed"

#: crates/rigg/src/settings/styring.rs:178
msgid "Viftekurve"
msgstr "Fan curve"

#: crates/rigg/src/settings/styring.rs:178
msgid "Kjerneklokke"
msgstr "Core clock"

#: crates/rigg/src/settings/styring.rs:178
msgid "Minneklokke"
msgstr "Memory clock"

#: crates/rigg/src/settings/styring.rs:178
msgid "Temperaturmål"
msgstr "Temperature target"

#: crates/rigg/src/settings/styring.rs:178
msgid "RGB-lys"
msgstr "RGB lighting"

#: crates/rigg/src/settings/styring.rs:180
msgid "Tilgjengelig"
msgstr "Available"

#: crates/rigg/src/settings/styring.rs:180
msgid "Ikke undersøkt"
msgstr "Not checked"

#: crates/rigg/src/settings/styring.rs:180
msgid "Utilgjengelig"
msgstr "Unavailable"

#: crates/rigg/src/settings/styring.rs:183
msgid "Leses når administratorhjelperen aktiveres for dette kortet."
msgstr "Checked when the administrator helper is enabled for this GPU."

#: crates/rigg/src/settings/styring.rs:193
msgid "Kortets rapporterte område: {span}."
msgstr "Range reported by the GPU: {span}."

#: crates/rigg/src/settings/styring.rs:195
msgid "Støttes av den tilkoblede hjelperen."
msgstr "Supported by the connected helper."

#: crates/rigg/src/settings/styring.rs:200
msgid "Tilgjengelige funksjoner"
msgstr "Available features"

#: crates/rigg/src/settings/styring.rs:201
msgid "Én administratoraktivering gjelder støttede funksjoner på det valgte kortet. Listen er status, ikke ekstra godkjenninger."
msgstr "One administrator approval covers all supported features on the selected GPU. This list shows status only; no further approvals are needed."

#: crates/rigg/src/settings/styring.rs:202
msgid "RGB krever en egen identifisert lyskontroller. Funksjoner uten støtte kan ikke brukes på kortet."
msgstr "RGB requires a separate, identified lighting controller. Unsupported features cannot be used on this GPU."

#: crates/rigg/src/settings/styring.rs:231 crates/rigg/src/settings/styring.rs:245
msgid "Tillat endring av skjermkortet"
msgstr "Allow GPU tuning"

#: crates/rigg/src/settings/styring.rs:246
msgid "Gir Agentic Rigg tilgang til støttede GPU-funksjoner via en administratorhjelper. Du blir spurt om passord. Ingen verdier endres før du trykker Bruk på en styringsside."
msgstr "Gives Agentic Rigg access to supported GPU features through an administrator helper. You’ll be asked for your password. No values change until you click Apply on a tuning page."

#: crates/rigg/src/settings/styring.rs:263
msgid "Venter"
msgstr "Waiting"

#: crates/rigg/src/settings/styring.rs:264
msgid "Klar"
msgstr "Ready"

#: crates/rigg/src/settings/styring.rs:265
msgid "Simulert"
msgstr "Simulated"

#: crates/rigg/src/settings/styring.rs:266
msgid "Ikke klar"
msgstr "Not ready"

#: crates/rigg/src/settings/styring.rs:267
msgid "Feil"
msgstr "Error"

#: crates/rigg/src/settings/styring.rs:268
msgid "Slå på igjen"
msgstr "Re-enable"

#: crates/rigg/src/settings/styring.rs:269
msgid "Av"
msgstr "Off"

#: crates/rigg/src/settings/styring.rs:281
msgid "Åpne styring"
msgstr "Open GPU tuning"

#: crates/rigg/src/settings/styring.rs:287
msgid "Sjekk igjen"
msgstr "Check again"

#: crates/rigg/src/settings/styring.rs:297
msgid "Endring av skjermkortet"
msgstr "GPU tuning"

#: crates/rigg/src/settings/styring.rs:299
msgid "Slår du bryteren av, gjenopprettes det lagrede utgangspunktet før hjelperen fjernes. En feil vises hvis gjenopprettingen ikke kan bekreftes. Slå av styring før avinstallasjon."
msgstr "Turning the switch off restores the saved original settings before removing the helper. An error appears if restoration cannot be confirmed. Disable GPU tuning before uninstalling."

#: crates/rigg/src/settings/styring.rs:309
msgid "Hjelperen"
msgstr "Helper"

#: crates/rigg/src/settings/styring.rs:309
msgid "Et lite program som kjører i bakgrunnen med administratorrettigheter. Det kan bare endre effekt, vifter og klokker, innenfor det kortet selv tillater"
msgstr "A small program that runs in the background with administrator privileges. It can only adjust power, fans and clocks within the GPU’s limits"

#: crates/rigg/src/settings/styring.rs:310
msgid "Passord"
msgstr "Password"

#: crates/rigg/src/settings/styring.rs:310
msgid "Én administratorgodkjenning ved aktivering. Vanlige endringer bruker Bruk og Behold"
msgstr "One administrator approval during activation. For ordinary changes, use Apply and Keep"

#: crates/rigg/src/settings/styring.rs:311
msgid "Hvem"
msgstr "Access"

#: crates/rigg/src/settings/styring.rs:311
msgid "Bare brukeren din. Andre brukere på maskinen slipper ikke til"
msgstr "Only your user account. Other accounts on the computer do not have access"

#: crates/rigg/src/settings/styring.rs:312
msgid "Vern"
msgstr "Safeguards"

#: crates/rigg/src/settings/styring.rs:312
msgid "Endringer rulles tilbake uten Behold innen fristen. Viftekurven har nødregel ved høy temperatur. Frakobling og stopp gjenoppretter utgangspunktet; eventuelle feil rapporteres"
msgstr "Changes revert unless you click Keep before the timer expires. The fan curve has an emergency rule for high temperatures. Disconnecting or stopping restores the original settings; any errors are reported"

#: crates/rigg/src/settings/styring.rs:313
msgid "Filene"
msgstr "Files"

#: crates/rigg/src/settings/styring.rs:313
msgid "{binaer}\n{konfig} (bruker, kort og aktivering)"
msgstr "{binaer}\n{konfig} (user, GPU and activation)"

#: crates/rigg/src/settings/styring.rs:315
msgid "Skriptene"
msgstr "Scripts"

#: crates/rigg/src/settings/styring.rs:317
msgid "Hva bryteren gjør"
msgstr "How the switch works"
