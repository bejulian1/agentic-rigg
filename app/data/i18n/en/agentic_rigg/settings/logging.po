msgstr "Filter"

#: crates/rigg/src/settings/logging.rs:82
msgid "Sensorene vises når tjenesten har sendt første prøve."
msgstr "Sensors appear after the first reading."

#: crates/rigg/src/settings/logging.rs:91
msgid "Trådene (last og klokke per tråd) er med når du logger alle sensorene."
msgstr "Per-thread load and clock are included when logging all sensors."

#: crates/rigg/src/settings/logging.rs:109 crates/rigg/src/settings/logging.rs:144
msgid "Stopp loggen"
msgstr "Stop logging"

#: crates/rigg/src/settings/logging.rs:109 crates/rigg/src/settings/logging.rs:144
msgid "Start loggen"
msgstr "Start logging"

#: crates/rigg/src/settings/logging.rs:115
msgid "Vis i Filer"
msgstr "Show in Files"

#: crates/rigg/src/settings/logging.rs:152
msgid "Alle"
msgstr "All"

#: crates/rigg/src/settings/logging.rs:152
msgid "Utvalgte"
msgstr "Selected"

#: crates/rigg/src/settings/logging.rs:164 crates/rigg/src/settings/logging.rs:190
msgid "Velg …"
msgstr "Choose…"

#: crates/rigg/src/settings/logging.rs:164
msgid "{antall} valgt …"
msgstr "{antall} selected…"

#: crates/rigg/src/settings/logging.rs:173 crates/rigg/src/settings/logging.rs:240
msgid "Intervall"
msgstr "Interval"

#: crates/rigg/src/settings/logging.rs:197
msgid "Mappe for loggen"
msgstr "Log folder"

#: crates/rigg/src/settings/logging.rs:213
msgid "Tilbake til ~/Dokumenter/Agentic Rigg"
msgstr "Reset to ~/Dokumenter/Agentic Rigg"

#: crates/rigg/src/settings/logging.rs:214
msgid "Tilbake til standardmappa"
msgstr "Reset to default folder"

#: crates/rigg/src/settings/logging.rs:223
msgid "Standard CSV"
msgstr "Standard CSV"

#: crates/rigg/src/settings/logging.rs:223
msgid "Norsk regneark"
msgstr "Norwegian spreadsheet"

#: crates/rigg/src/settings/logging.rs:223 crates/rigg/src/settings/logging.rs:242
msgid "Format"
msgstr "Format"

#: crates/rigg/src/settings/logging.rs:230
msgid "Logg til fil"
msgstr "Log to file"

#: crates/rigg/src/settings/logging.rs:232
msgctxt "søkeord"
msgid "logg csv fil ctrl+l"
msgstr "log csv file ctrl+l"

#: crates/rigg/src/settings/logging.rs:233
msgid "Tjenesten skriver loggen, så den fortsetter når vinduet lukkes. Start og stopp også med knappen på Sensorer, eller Ctrl+L."
msgstr "The service writes the log, so it continues when the window closes. Also toggle from Sensors or with Ctrl+L."

#: crates/rigg/src/settings/logging.rs:234
msgid "Ny fil ved 100 MB. Loggen stopper med en melding hvis disken har under 500 MB ledig. Kolonnene ligger fast mens loggen går; nye sensorer tas med i neste logg."
msgstr "Rotates to a new file at 100 MB. Stops with a notice if free disk space drops below 500 MB. Columns stay fixed while logging; new sensors appear in the next log."

#: crates/rigg/src/settings/logging.rs:238
msgid "Status"
msgstr "Status"

#: crates/rigg/src/settings/logging.rs:238
msgctxt "søkeord"
msgid "logg status start stopp vis i filer"
msgstr "log status start stop show in files"

#: crates/rigg/src/settings/logging.rs:239
msgid "Sensorer"
msgstr "Sensors"

#: crates/rigg/src/settings/logging.rs:239
msgid "Alle sensorene, eller bare de du velger (også med høyreklikk på Sensorer › «Ta med i loggen»)."
msgstr "All sensors, or only selected ones (also via right-click on Sensors › “Include in log”)."

#: crates/rigg/src/settings/logging.rs:239
msgctxt "søkeord"
msgid "sensorer utvalgte alle"
msgstr "sensors selected all"

#: crates/rigg/src/settings/logging.rs:240
msgid "Hvor ofte en rad skrives. Raskere enn takten tjenesten leser i, gir ikke flere rader."
msgstr "How often a row is written. Faster than the service polling rate does not add more rows."

#: crates/rigg/src/settings/logging.rs:240
msgctxt "søkeord"
msgid "intervall sekunder"
msgstr "interval seconds"

#: crates/rigg/src/settings/logging.rs:241
msgid "Mappe"
msgstr "Folder"

#: crates/rigg/src/settings/logging.rs:241
msgid "Filnavn som rigg-2026-11-07_14-32-10.csv."
msgstr "Filenames like rigg-2026-11-07_14-32-10.csv."

#: crates/rigg/src/settings/logging.rs:241
msgctxt "søkeord"
msgid "mappe dokumenter sti"
msgstr "folder documents path"

#: crates/rigg/src/settings/logging.rs:242
msgid "Standard CSV bruker komma og desimalpunktum. Norsk regneark bruker semikolon og desimalkomma, og åpnes rett i LibreOffice og Excel med norsk oppsett."
msgstr "Standard CSV uses commas and decimal points. Norwegian spreadsheet uses semicolons and decimal commas for Norwegian LibreOffice and Excel setups."

#: crates/rigg/src/settings/logging.rs:242
msgctxt "søkeord"
msgid "format komma semikolon desimal regneark excel libreoffice"
msgstr "format comma semicolon decimal spreadsheet excel libreoffice"

#: crates/rigg/src/settings/logging.rs:251
msgid "Varsle ved rød grense"
msgstr "Notify on red threshold"

#: crates/rigg/src/settings/logging.rs:252
msgid "Et varsel på skrivebordet når en verdi har vært over den røde grensen i 10 s. Høyst ett varsel per verdi per 15 min. Virker også når vinduet er lukket og tjenesten går i bakgrunnen."
msgstr "Shows a desktop notification when a reading stays above the red threshold for 10 s. At most one alert per reading every 15 min. Also works in the background when the window is closed."

#: crates/rigg/src/settings/logging.rs:254
msgctxt "søkeord"
msgid "varsel skrivebord alarm rød grense"
msgstr "alert notification desktop alarm red threshold"

#: crates/rigg/src/settings/logging.rs:264
msgid "GPU-temperatur"
msgstr "GPU temperature"

#: crates/rigg/src/settings/logging.rs:265
msgid "Rød grense {grense}. Endres under Grafer og sensorer › Varselfarger."
msgstr "Red threshold {grense}. Change in Charts and sensors › Warning colors."

#: crates/rigg/src/settings/logging.rs:267
msgctxt "søkeord"
msgid "gpu temperatur varsel"
msgstr "gpu temperature alert"

#: crates/rigg/src/settings/logging.rs:275
msgid "CPU-temperatur"
msgstr "CPU temperature"

#: crates/rigg/src/settings/logging.rs:276
msgid "Rød grense {grense} (Tdie)."
msgstr "Red threshold {grense} (Tdie)."

#: crates/rigg/src/settings/logging.rs:278
msgctxt "søkeord"
msgid "cpu temperatur varsel tdie"
msgstr "cpu temperature alert tdie"

#: crates/rigg/src/settings/logging.rs:286
msgid "Skjermkortet svarer ikke"
msgstr "GPU not responding"

#: crates/rigg/src/settings/logging.rs:287
msgid "Også når driveren er oppdatert og maskinen må startes på nytt, eller driveren ikke kan leses."
msgstr "Also when the driver was updated and requires a reboot, or cannot be read."

#: crates/rigg/src/settings/logging.rs:289
msgctxt "søkeord"
msgid "skjermkort borte driver varsel"
msgstr "gpu lost driver alert"

#: crates/rigg/src/settings/logging.rs:297
msgid "Diskhelse"
msgstr "Drive health"

#: crates/rigg/src/settings/logging.rs:298
msgid "Når SMART melder at en disk feiler, eller antallet dårlige sektorer øker. Tjenesten ser på SMART hvert 10. minutt når vinduet er lukket."
msgstr "When SMART reports a failing drive or bad sectors increase. The service checks SMART every 10 minutes while the window is closed."

#: crates/rigg/src/settings/logging.rs:300
msgctxt "søkeord"
msgid "disk helse smart sektorer varsel"
msgstr "drive disk health smart sectors alert"

#: crates/rigg/src/settings/logging.rs:306
msgid "Klikk på et varsel for å åpne appen på riktig side. Varslene sendes av tjenesten, uten lyd."
msgstr "Click a notification to open the app on the relevant page. Notifications are sent silently by the service."

#: crates/rigg/src/settings/logging.rs:308
msgctxt "søkeord"
msgid "klikk varsel lyd"
msgstr "click notification sound"

#: crates/rigg/src/settings/logging.rs:309
msgid "Skrivebordsvarsler"
msgstr "Desktop notifications"

#: crates/rigg/src/settings/logging.rs:309
msgctxt "søkeord"
msgid "varsler notification"
msgstr "alerts notifications"
