msgid "GPU-minne og GPU-bruk per prosess er ikke tilgjengelig."
msgstr "Per-process GPU memory and GPU usage are unavailable."

#: crates/riggd/src/tasks.rs:81
msgid "Ugyldig søk eller sortering av oppgaver."
msgstr "Invalid task search or sort order."

#: crates/riggd/src/tasks.rs:83
msgid "Høyst 128 tegn i søket og 1–100 oppgaver per side."
msgstr "Use up to 128 characters in the search and 1–100 tasks per page."

#: crates/riggd/src/tasks.rs:86
msgid "For mange eller ugyldige utvidede grupper."
