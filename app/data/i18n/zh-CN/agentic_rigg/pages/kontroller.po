msgstr "保持最低转速直至"

#: crates/rigg/src/pages/kontroller.rs:260
msgid "Viftekurve"
msgstr "风扇曲线"

#: crates/rigg/src/pages/kontroller.rs:266 crates/rigg/src/pages/kontroller.rs:572
msgid "Auto"
msgstr "自动"

#: crates/rigg/src/pages/kontroller.rs:267 crates/rigg/src/pages/kontroller.rs:572
