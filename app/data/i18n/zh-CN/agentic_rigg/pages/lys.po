msgid "Skjermkort"
msgstr "显卡"

#: crates/rigg/src/pages/lys.rs:157 crates/rigg/src/pages/lys.rs:537
msgid "Ikke aktivert"
msgstr "未启用"

#: crates/rigg/src/pages/lys.rs:159
msgid "3D"
msgstr "3D"

#: crates/rigg/src/pages/lys.rs:159
msgid "2D"
msgstr "2D"

#: crates/rigg/src/pages/lys.rs:159
msgid "Visning"
msgstr "视图"

#: crates/rigg/src/pages/lys.rs:181
msgid "Dra for å vri · rull for zoom · 0 tilbakestiller"
msgstr "拖动旋转 · 滚轮缩放 · 按 0 重置"

#: crates/rigg/src/pages/lys.rs:187
msgid "Bygger 3D-kortet …"
msgstr "正在构建 3D 显卡 …"

#: crates/rigg/src/pages/lys.rs:225 crates/rigg/src/pages/lys.rs:231
msgid "Vinkel"
msgstr "视角"

#: crates/rigg/src/pages/lys.rs:227 crates/rigg/src/pages/lys.rs:228
msgid "Tilbakestill visningen"
msgstr "重置视图"

#: crates/rigg/src/pages/lys.rs:238 crates/rigg/src/pages/lys.rs:241
msgid "Lag"
msgstr "层级"

#: crates/rigg/src/pages/lys.rs:249 crates/rigg/src/pages/lys.rs:254
msgid "Skill lagene"
msgstr "展开层级"

#: crates/rigg/src/pages/lys.rs:262 crates/rigg/src/pages/lys.rs:265
msgid "Bakgrunnslys"
msgstr "环境光晕"

#: crates/rigg/src/pages/lys.rs:292
msgid "Deler i 3D-modellen"
msgstr "3D 模型中的部件"

#: crates/rigg/src/pages/lys.rs:539
msgid "Prøve på kortet"
msgstr "显卡测试中"

#: crates/rigg/src/pages/lys.rs:541
msgid "Aktiv effekt"
msgstr "效果运行中"

#: crates/rigg/src/pages/lys.rs:553
msgid "Speiler kortlyset"
msgstr "与显卡灯光一致"

#: crates/rigg/src/pages/lys.rs:555
msgid "Forhåndsvisning av valg"
msgstr "预览当前选择"

#: crates/rigg/src/pages/lys.rs:568
msgid "Utgangspunkt: {farge} · {styrke}"
msgstr "初始状态：{farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:570
msgid "Sist lest: {farge} · {styrke}"
msgstr "上次读取：{farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:739 crates/rigg/src/pages/lys.rs:942
msgid "Lys vises i 2D"
msgstr "以 2D 模式显示"

#: crates/rigg/src/pages/lys.rs:739
msgid "3D-kortet kunne ikke tegnes med grafikken her. Det flate kortet viser de samme lysvalgene."
msgstr "当前图形环境无法渲染 3D 显卡。平面 2D 视图会显示相同的灯光设置。"

#: crates/rigg/src/pages/lys.rs:820
msgid "3D kan ikke tegnes her ({feil}). Klikk for å prøve igjen."
msgstr "无法在此渲染 3D（{feil}）。点击重试。"

#: crates/rigg/src/pages/lys.rs:822
msgid "Grafikken tegnet 3D for tregt. Klikk for å prøve igjen."
msgstr "3D 渲染速度过慢。点击重试。"

#: crates/rigg/src/pages/lys.rs:824
msgid "Kortet i 3D. Dra for å vri."
msgstr "3D 显卡视图。拖动可旋转。"

#: crates/rigg/src/pages/lys.rs:829
msgid "Flatt kort sett forfra. Bruker minst ressurser."
msgstr "正面平面显卡视图。资源占用最低。"

#: crates/rigg/src/pages/lys.rs:844
msgid "Stillbilde: grafikken tegner for tregt"
msgstr "静止画面：图形渲染过慢"

#: crates/rigg/src/pages/lys.rs:846
msgid "Animasjon av"
msgstr "动画已关闭"

#: crates/rigg/src/pages/lys.rs:942
msgid "Grafikken tegnet 3D-kortet for tregt. Velg 3D over visningen for å prøve igjen."
msgstr "3D 显卡渲染过慢。可在视图上方重新选择 3D 重试。"

#: crates/rigg/src/pages/lys.rs:1049
msgid "Kortlys er ikke aktivert."
msgstr "显卡灯光未启用。"

#: crates/rigg/src/pages/lys.rs:1051
msgid "Lysene er av."
msgstr "灯光已关闭。"

#: crates/rigg/src/pages/lys.rs:1053
msgid "Lysstyrke {styrke}."
msgstr "亮度 {styrke}。"

#: crates/rigg/src/pages/lys.rs:1067
msgid "{lag} · lagene skilt"
msgstr "{lag} · 层级已展开"

#: crates/rigg/src/pages/lys.rs:1090
msgid "Flatt skjermkort sett forfra."
msgstr "正面平面显卡视图。"

#: crates/rigg/src/pages/lys.rs:1106
msgid "Kortet har én fysisk lyssone."
msgstr "该显卡只有一个物理灯区。"
