#: crates/rigg/src/pages/lys.rs:158
msgid "3D"
msgstr "3D"

#: crates/rigg/src/pages/lys.rs:158
msgid "2D"
msgstr "2D"

#: crates/rigg/src/pages/lys.rs:158
msgid "Visning"
msgstr "视图"

