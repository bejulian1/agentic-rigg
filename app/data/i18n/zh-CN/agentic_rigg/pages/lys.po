msgstr "与显卡灯光一致"

#: crates/rigg/src/pages/lys.rs:557
msgid "Utgangspunkt: {farge} · {styrke}"
msgstr "初始状态：{farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:559
msgid "Sist lest: {farge} · {styrke}"
msgstr "上次读取：{farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:733 crates/rigg/src/pages/lys.rs:953
msgid "Lys vises i 2D"
msgstr "以 2D 模式显示"

#: crates/rigg/src/pages/lys.rs:733
msgid "3D-kortet kunne ikke tegnes med grafikken her. Det flate kortet viser de samme lysvalgene."
msgstr "当前图形环境无法渲染 3D 显卡。平面 2D 视图会显示相同的灯光设置。"

#: crates/rigg/src/pages/lys.rs:831
msgid "3D kan ikke tegnes her ({feil}). Klikk for å prøve igjen."
msgstr "无法在此渲染 3D（{feil}）。点击重试。"

#: crates/rigg/src/pages/lys.rs:833
msgid "Grafikken tegnet 3D for tregt. Klikk for å prøve igjen."
msgstr "3D 渲染速度过慢。点击重试。"

#: crates/rigg/src/pages/lys.rs:835
msgid "Kortet i 3D. Dra for å vri."
msgstr "3D 显卡视图。拖动可旋转。"

#: crates/rigg/src/pages/lys.rs:840
msgid "Flatt kort sett forfra. Bruker minst ressurser."
msgstr "正面平面显卡视图。资源占用最低。"

#: crates/rigg/src/pages/lys.rs:855
msgid "Stillbilde: grafikken tegner for tregt"
msgstr "静止画面：图形渲染过慢"

#: crates/rigg/src/pages/lys.rs:857
msgid "Animasjon av"
msgstr "动画已关闭"

#: crates/rigg/src/pages/lys.rs:953
msgid "Grafikken tegnet 3D-kortet for tregt. Velg 3D over visningen for å prøve igjen."
msgstr "3D 显卡渲染过慢。可在视图上方重新选择 3D 重试。"

#: crates/rigg/src/pages/lys.rs:1060
msgid "Kortlys er ikke aktivert."
msgstr "显卡灯光未启用。"

#: crates/rigg/src/pages/lys.rs:1062
msgid "Lysene er av."
msgstr "灯光已关闭。"

#: crates/rigg/src/pages/lys.rs:1064
msgid "Lysstyrke {styrke}."
msgstr "亮度 {styrke}。"

#: crates/rigg/src/pages/lys.rs:1078
msgid "{lag} · lagene skilt"
msgstr "{lag} · 层级已展开"

#: crates/rigg/src/pages/lys.rs:1101
msgid "Flatt skjermkort sett forfra."
msgstr "正面平面显卡视图。"

#: crates/rigg/src/pages/lys.rs:1117
msgid "Kortet har én fysisk lyssone."
msgstr "该显卡只有一个物理灯区。"
