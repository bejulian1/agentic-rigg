"X-Rigg-Status: complete\n"

#: crates/rigg/src/pages/lys_kort.rs:118 crates/rigg/src/pages/lys_kort.rs:416
msgid "Pusting"
msgstr "呼吸"

#: crates/rigg/src/pages/lys_kort.rs:119 crates/rigg/src/pages/lys_kort.rs:417
msgid "Regnbue"
msgstr "彩虹"

#: crates/rigg/src/pages/lys_kort.rs:120 crates/rigg/src/pages/lys_kort.rs:418
msgid "Fargesyklus"
msgstr "颜色循环"

#: crates/rigg/src/pages/lys_kort.rs:138
msgid "Lysstyringen er opptatt eller tilhører et annet vindu."
msgstr "灯光控制正忙或由其他窗口持有。"

#: crates/rigg/src/pages/lys_kort.rs:139
msgid "Lysprøven finnes ikke lenger eller fristen er ute."
msgstr "灯光试用已结束或超时。"

#: crates/rigg/src/pages/lys_kort.rs:140
msgid "Nye lysendringer er sperret. Kontroller status og avklar eventuell gjenoppretting."
msgstr "已阻止新的灯光更改。请检查状态并处理未完成的恢复。"

#: crates/rigg/src/pages/lys_kort.rs:141
msgid "RGB-tillatelsen for dette kortet kunne ikke bekreftes."
msgstr "无法验证此显卡的 RGB 权限。"

#: crates/rigg/src/pages/lys_kort.rs:142
msgid "Det valgte kortet er ikke tilgjengelig."
msgstr "所选显卡不可用。"

#: crates/rigg/src/pages/lys_kort.rs:143 crates/rigg/src/pages/lys_kort.rs:1187
msgid "RGB-hjelperen støtter ikke dette lysvalget."
msgstr "RGB 辅助程序不支持此灯光设置。"

#: crates/rigg/src/pages/lys_kort.rs:144
msgid "RGB-hjelperen avviste forespørselen. Les status før du prøver igjen."
msgstr "RGB 辅助程序拒绝了请求。请检查状态后重试。"

#: crates/rigg/src/pages/lys_kort.rs:147
msgid "RGB-forespørselen mislyktes. Sjekk status og se på kortet før du prøver igjen."
msgstr "RGB 请求失败。请检查状态并查看显卡后重试。"

#: crates/rigg/src/pages/lys_kort.rs:168
msgid "Avlesning av kortlyset mislyktes. Nye lysendringer er sperret."
msgstr "无法读取显卡灯光。已阻止新的更改。"

#: crates/rigg/src/pages/lys_kort.rs:171
msgid "Gjenopprettingen er bekreftet av deg. Effektmodusen er fortsatt ikke maskinelt avlest."
msgstr "已确认恢复。仍未从硬件读取效果模式。"

#: crates/rigg/src/pages/lys_kort.rs:175
msgid "Farge og lysstyrke samsvarer etter tilbakeføring. Se på kortet før du bekrefter gjenopprettingen."
msgstr "回退后颜色和亮度匹配。请先查看显卡，再确认恢复。"

#: crates/rigg/src/pages/lys_kort.rs:176
msgid "Tilbakeføringen samsvarer ikke med avlesningen. Nye fargeendringer er sperret."
msgstr "回读值与预期的回退结果不符。已阻止新的颜色更改。"

#: crates/rigg/src/pages/lys_kort.rs:177 crates/rigg/src/pages/lys_kort.rs:178
msgid "Gjenopprettingen er uavklart. Nye fargeendringer er sperret."
msgstr "恢复尚未处理完成。已阻止新的颜色更改。"

#: crates/rigg/src/pages/lys_kort.rs:305 crates/rigg/src/pages/lys_kort.rs:415
msgid "Av"
msgstr "关闭"

#: crates/rigg/src/pages/lys_kort.rs:306
msgid "Fast farge {farge} · {styrke}"
msgstr "固定颜色 {farge} · {styrke}"

#: crates/rigg/src/pages/lys_kort.rs:307
msgid "Ingen kjent innstilling"
msgstr "无已知设置"

#: crates/rigg/src/pages/lys_kort.rs:379
msgid "Lys på kortet"
msgstr "显卡灯光"

#: crates/rigg/src/pages/lys_kort.rs:384 crates/rigg/src/pages/lys_kort.rs:981
msgid "Ikke aktivert"
msgstr "未启用"

#: crates/rigg/src/pages/lys_kort.rs:414
msgid "Fast farge"
msgstr "固定颜色"

#: crates/rigg/src/pages/lys_kort.rs:421
msgid "Fysisk lysmodus"
msgstr "实体灯光模式"

#: crates/rigg/src/pages/lys_kort.rs:425
msgid "Modus"
msgstr "模式"

#: crates/rigg/src/pages/lys_kort.rs:447
msgid "Farge på kortet, seks heksadesimale siffer"
msgstr "显卡灯光颜色，六位十六进制数"

#: crates/rigg/src/pages/lys_kort.rs:454
msgid "Hurtigfarger"
msgstr "快捷颜色"

#: crates/rigg/src/pages/lys_kort.rs:490
msgid "Farge"
msgstr "颜色"

#: crates/rigg/src/pages/lys_kort.rs:498 crates/rigg/src/pages/lys_kort.rs:508
msgid "Kortlysets lysstyrke i prosent"
msgstr "显卡灯光亮度百分比"

#: crates/rigg/src/pages/lys_kort.rs:514
msgid "Lysstyrke"
msgstr "亮度"

#: crates/rigg/src/pages/lys_kort.rs:526
msgid "Bruk"
msgstr "应用"

#: crates/rigg/src/pages/lys_kort.rs:529
msgid "Gjenopprett utgangspunkt"
msgstr "恢复原始设置"

#: crates/rigg/src/pages/lys_kort.rs:532 crates/rigg/src/pages/lys_kort.rs:1237
msgid "Avslutt lysstyring"
msgstr "释放灯光控制"

#: crates/rigg/src/pages/lys_kort.rs:533
msgid "Bekreft gjenoppretting …"
msgstr "确认恢复…"

#: crates/rigg/src/pages/lys_kort.rs:547
msgid "Behold"
msgstr "保留"

#: crates/rigg/src/pages/lys_kort.rs:548
msgid "Rull tilbake"
msgstr "回退"

#: crates/rigg/src/pages/lys_kort.rs:558
msgid "Avlesning: ukjent. Kortet er ikke undersøkt av denne visningen."
msgstr "回读未知。此视图尚未检查显卡。"

#: crates/rigg/src/pages/lys_kort.rs:562
msgid "Farge og lysstyrke kan leses tilbake. Effektmodusen kan ikke leses; en visuell bekreftelse er din observasjon."
msgstr "颜色和亮度可以回读，但效果模式无法回读；目视确认以实际看到的灯光为准。"

#: crates/rigg/src/pages/lys_kort.rs:563
msgid "Agentic HW Monitor støtter Palit GeForce RTX 2080 Super JetStream via den separate RGB-hjelperen."
msgstr "Agentic HW Monitor 通过独立的 RGB 辅助程序支持 Palit GeForce RTX 2080 Super JetStream。"

#: crates/rigg/src/pages/lys_kort.rs:570
msgid "Sjekk igjen"
msgstr "重新检查"

#: crates/rigg/src/pages/lys_kort.rs:571
msgid "Aktiver kortlys …"
msgstr "启用显卡灯光…"

#: crates/rigg/src/pages/lys_kort.rs:572
msgid "Gjenopprett lagret lys …"
msgstr "恢复已保存的灯光…"

#: crates/rigg/src/pages/lys_kort.rs:573
msgid "Avklar tidligere økt …"
msgstr "处理先前会话…"

#: crates/rigg/src/pages/lys_kort.rs:574
msgid "Slå av RGB-tilgang …"
msgstr "停用 RGB 访问…"

#: crates/rigg/src/pages/lys_kort.rs:579
msgid "Detaljer og feilsøking"
msgstr "详细信息与故障排除"

#: crates/rigg/src/pages/lys_kort.rs:716
msgid "Jeg ser at lyset på kortet er slukket."
msgstr "我看到显卡灯光已熄灭。"

#: crates/rigg/src/pages/lys_kort.rs:717
msgid "Jeg ser at lyset viser den forventede faste fargen."
msgstr "我看到显卡显示预期的固定颜色。"

#: crates/rigg/src/pages/lys_kort.rs:719 crates/rigg/src/pages/lys_kort.rs:1865
msgid "Bekreft lyset på kortet"
msgstr "确认显卡灯光"

#: crates/rigg/src/pages/lys_kort.rs:719
msgid "Forventet lys: {lys}.\n\nSe på det fysiske kortet. Samsvarende fargeverdier alene er ikke nok. Hjelperen leser verdiene på nytt før observasjonen din lagres."
msgstr "预期灯光：{lys}。\n\n请查看实体显卡。仅颜色值一致并不足够。辅助程序会再次读取数值，然后记录目视确认结果。"

#: crates/rigg/src/pages/lys_kort.rs:719 crates/rigg/src/pages/lys_kort.rs:1887
msgid "Bekreft min observasjon"
msgstr "确认我的观察"

#: crates/rigg/src/pages/lys_kort.rs:725
msgid "Lystilstanden er endret"
msgstr "灯光状态已更改"

#: crates/rigg/src/pages/lys_kort.rs:725
msgid "Kontroller det nye forventede lyset og åpne bekreftelsen på nytt."
msgstr "请检查新的预期灯光并重新打开确认窗口。"

#: crates/rigg/src/pages/lys_kort.rs:917
msgid "Kunne ikke lese kortlyset"
msgstr "无法读取显卡灯光"

#: crates/rigg/src/pages/lys_kort.rs:919
msgid "Lysendringen ble ikke fullført"
msgstr "灯光更改未完成"

#: crates/rigg/src/pages/lys_kort.rs:971
msgid "Venter …"
msgstr "等待中…"

#: crates/rigg/src/pages/lys_kort.rs:973
msgid "Frakoblet"
msgstr "已断开"

#: crates/rigg/src/pages/lys_kort.rs:975
msgid "Kortet er utilgjengelig"
msgstr "显卡不可用"

#: crates/rigg/src/pages/lys_kort.rs:977
msgid "Ikke klar"
msgstr "未就绪"

#: crates/rigg/src/pages/lys_kort.rs:979
msgid "Må oppdateres"
msgstr "需要更新"

#: crates/rigg/src/pages/lys_kort.rs:983
msgid "Prøve pågår"
msgstr "试用进行中"

#: crates/rigg/src/pages/lys_kort.rs:985
msgid "Effekt aktiv"
msgstr "效果已启用"

#: crates/rigg/src/pages/lys_kort.rs:987
msgid "Må avklares"
msgstr "需要处理"

#: crates/rigg/src/pages/lys_kort.rs:989
msgid "Egen RGB-tillatelse"
msgstr "单独的 RGB 权限"

#: crates/rigg/src/pages/lys_kort.rs:996
msgid "Simulerte RGB-data · {status}"
msgstr "模拟 RGB 数据 · {status}"

#: crates/rigg/src/pages/lys_kort.rs:1007
msgid "Venter på svar. Ingen ny endring kan sendes nå."
msgstr "正在等待响应。现在无法发送新更改。"

#: crates/rigg/src/pages/lys_kort.rs:1009
msgid "Forbindelsen til tjenesten er brutt. Hjelperen håndterer eventuell tilbakeføring."
msgstr "服务连接已断开。如需回退，由辅助程序处理。"

#: crates/rigg/src/pages/lys_kort.rs:1014
msgid "Kortet er ikke tilgjengelig. Nye lysendringer og aktivering er sperret."
msgstr "显卡不可用。已阻止灯光更改和启用。"

#: crates/rigg/src/pages/lys_kort.rs:1016
msgid "Et annet vindu styrer kortlyset. Her vises bare status."
msgstr "其他窗口正在控制显卡灯光。此处仅显示状态。"

#: crates/rigg/src/pages/lys_kort.rs:1018
msgid "Hele kortlyset er én sone. Ingenting sendes før du trykker «Bruk»."
msgstr "显卡灯光是一个区域。按“应用”之前不会发送任何内容。"

#: crates/rigg/src/pages/lys_kort.rs:1020
msgid "En tidligere RGB-økt er ikke avsluttet, og RGB-delen må oppdateres. Trykk «Bruk»: kortet settes tilbake til det lagrede lyset, du ser på kortet og bekrefter, og så oppdateres og aktiveres kortlyset med ett passord."
msgstr "之前的 RGB 会话尚未结束，RGB 部分需要更新。按“应用”：显卡先恢复到已保存的灯光，你查看显卡并确认，然后只需一次密码即可更新并启用显卡灯光。"

#: crates/rigg/src/pages/lys_kort.rs:1022
msgid "RGB-delen er eldre enn GPU-delen og må oppdateres. Trykk «Bruk» for å oppdatere og aktivere kortlyset med ett passord."
msgstr "RGB 部分比 GPU 部分旧，需要更新。按“应用”只需一次密码即可更新并启用显卡灯光。"

#: crates/rigg/src/pages/lys_kort.rs:1024
msgid "RGB-tillatelsen gjelder ikke kortet som er valgt. Ingen endringer kan sendes her."
msgstr "RGB 权限不适用于所选显卡。无法在此发送更改。"

#: crates/rigg/src/pages/lys_kort.rs:1027 crates/rigg/src/pages/lys_kort.rs:1625
msgid "RGB-hjelperen er ikke klar. Se «Detaljer og feilsøking» nedenfor."
msgstr "RGB 辅助程序尚未就绪。请查看下方的“详细信息与故障排除”。"

#: crates/rigg/src/pages/lys_kort.rs:1029
msgid "Velg lys og trykk «Bruk». RGB-hjelperen oppdateres først, og du skriver passordet én gang."
msgstr "选择灯光并按“应用”。会先更新 RGB 辅助程序，你只需输入一次密码。"

#: crates/rigg/src/pages/lys_kort.rs:1031
msgid "Velg lys og trykk «Bruk». Første gang aktiveres kortlyset med passordet ditt."
msgstr "选择灯光并按“应用”。首次使用时会用你的密码启用显卡灯光。"

#: crates/rigg/src/pages/lys_kort.rs:1044
msgid "Venter på kortets PCI-adresse og UUID."
msgstr "正在等待显卡的 PCI 地址和 UUID。"

#: crates/rigg/src/pages/lys_kort.rs:1045
msgid "Valgt kort: {pci}"
msgstr "所选显卡：{pci}"

#: crates/rigg/src/pages/lys_kort.rs:1050
msgid "{effekt} er valgt. Nå vises bare startfargen; animasjonen starter først etter «Behold»."
msgstr "已选择{effekt}。现在只显示起始颜色；选择“保留”后才开始动画。"

#: crates/rigg/src/pages/lys_kort.rs:1054
msgid "{effekt} er aktiv på hele kortlyset. Velg en annen modus eller farge og trykk «Bruk» for å bytte, eller «Stopp» for å gjenopprette det lagrede utgangspunktet."
msgstr "{effekt}正在整张显卡的灯光上运行。选择其他模式或颜色并点击“应用”即可切换，或点击“停止”以恢复已保存的初始状态。"

#: crates/rigg/src/pages/lys_kort.rs:1060
msgid "Pusting varierer lysstyrken i fargen du velger."
msgstr "呼吸效果会改变所选颜色的亮度。"

#: crates/rigg/src/pages/lys_kort.rs:1062
msgid "Regnbue går gjennom hele fargespekteret fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "彩虹效果从所选色相开始遍历整个色谱。灰色从红色开始。"

#: crates/rigg/src/pages/lys_kort.rs:1065
msgid "Fargesyklus veksler mellom seks tydelige fargetoner fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "颜色循环从所选色相开始，在六种明显不同的色相间切换。灰色从红色开始。"

#: crates/rigg/src/pages/lys_kort.rs:1068
msgid "{detalj} Først prøves startfargen; «Behold» starter animasjonen på én lyssone."
msgstr "{detalj} 首先试用起始颜色。选择“保留”将在一个区域启动动画。"

#: crates/rigg/src/pages/lys_kort.rs:1077
msgid "RGB-hjelperen meldte en driftsfeil. Kontroller lyset før du fortsetter."
msgstr "RGB 辅助程序报告运行错误。请检查灯光后再继续。"

#: crates/rigg/src/pages/lys_kort.rs:1089
msgid "{farge} · rå lysstyrke {styrke}, utenfor støttet område"
msgstr "{farge} · 原始亮度 {styrke}，超出支持范围"

#: crates/rigg/src/pages/lys_kort.rs:1094
msgid "Lagret utgangspunkt: {lys}. Dette er ikke en ny avlesning."
msgstr "已保存的基准状态：{lys}。这不是新的读数。"

#: crates/rigg/src/pages/lys_kort.rs:1097
msgid "Sist lest fra kortet: {lys}. Effektmodus: ukjent."
msgstr "显卡最后一次读数：{lys}。效果模式：未知。"

#: crates/rigg/src/pages/lys_kort.rs:1099
msgid "Avlesning: ukjent. Effektmodusen er ikke bekreftet."
msgstr "回读未知。效果模式未经确认。"

#: crates/rigg/src/pages/lys_kort.rs:1105
msgid "Sist bekreftede valg: {lys}. Valget er ikke bevis på avlest effektmodus."
msgstr "上次确认的选项：{lys}。这不能证明效果模式已回读。"

#: crates/rigg/src/pages/lys_kort.rs:1116
msgid "Kontroller startfargen på kortet. «Behold» starter animasjonen; «Rull tilbake» eller fristutløp går tilbake til utgangspunktet."
msgstr "请查看显卡的起始颜色。“保留”会启动动画；“回退”或超时会恢复基准状态。"

#: crates/rigg/src/pages/lys_kort.rs:1118
msgid "Se på det fysiske kortet før du beholder endringen. Uten bekreftelse forsøker hjelperen å rulle tilbake."
msgstr "保留更改前请查看实体显卡。若未确认，辅助程序会尝试回退。"

#: crates/rigg/src/pages/lys_kort.rs:1131
msgid "fristen styres av hjelperen"
msgstr "期限由辅助程序管理"

#: crates/rigg/src/pages/lys_kort.rs:1133
msgid "fristen er ute; venter på status"
msgstr "已超时；正在等待状态"

#: crates/rigg/src/pages/lys_kort.rs:1135
msgid "bekreft innen {tid}"
msgstr "请在 {tid} 内确认"

#: crates/rigg/src/pages/lys_kort.rs:1179
msgid "Oppgi en gyldig fargekode på seks tegn, for eksempel #3A7BF0."
msgstr "请输入有效的六位十六进制颜色代码，例如 #3A7BF0。"

#: crates/rigg/src/pages/lys_kort.rs:1183
msgid "Bekreft eller rull tilbake prøven som pågår før du bruker en ny innstilling."
msgstr "在应用新设置前，请先保留或回滚当前待确认的更改。"

#: crates/rigg/src/pages/lys_kort.rs:1185
msgid "Avklar gjenopprettingen eller feilen nedenfor før du bruker en ny innstilling."
msgstr "在应用新设置前，请先处理下方的恢复或错误状态。"

#: crates/rigg/src/pages/lys_kort.rs:1235 crates/rigg/src/pages/lys_kort.rs:1823
msgid "Stopp"
msgstr "停止"

#: crates/rigg/src/pages/lys_kort.rs:1239
msgid "Gjenopprett det lagrede utgangspunktet og frigi lysstyringen. Se på kortet før du bekrefter gjenopprettingen."
msgstr "恢复已保存的基准状态并释放灯光控制。确认恢复前请查看显卡。"

#: crates/rigg/src/pages/lys_kort.rs:1316 crates/rigg/src/pages/lys_kort.rs:1472
msgid "RGB-oppsettet er ikke klart"
msgstr "RGB 设置未就绪"

#: crates/rigg/src/pages/lys_kort.rs:1328
msgid "Slå av RGB-tilgang"
msgstr "停用 RGB 访问"

#: crates/rigg/src/pages/lys_kort.rs:1329
msgid "Dette stopper RGB-arbeideren og fjerner kortets RGB-tillatelse når gjenopprettingen er avklart. Det lagrede utgangspunktet beholdes."
msgstr "这将停止 RGB 工作进程，并在恢复处理完成后撤销显卡的 RGB 权限。保存的基准状态将保留。"

#: crates/rigg/src/pages/lys_kort.rs:1330
msgid "Jeg vil slå av RGB-tilgangen for dette kortet."
msgstr "我要停用此显卡的 RGB 访问。"

#: crates/rigg/src/pages/lys_kort.rs:1334
msgid "Gjenopprett lagret lys"
msgstr "恢复已保存的灯光"

#: crates/rigg/src/pages/lys_kort.rs:1335
msgid "Administratorhjelperen stopper RGB-arbeideren hvis den kjører. Hvis det finnes en uavklart journal, forsøker den deretter å gjenopprette det lagrede utgangspunktet. Kontroller lyset og velg «Avklar tidligere økt» etterpå."
msgstr "管理员辅助程序会停止正在运行的 RGB 工作进程。如果日志中有未解决的操作，辅助程序随后会尝试恢复已保存的基准状态。检查灯光，然后选择“处理先前会话”。"

#: crates/rigg/src/pages/lys_kort.rs:1336
msgid "Jeg vil gjenopprette det lagrede utgangspunktet på dette kortet."
msgstr "我要在此显卡上恢复已保存的基准状态。"

#: crates/rigg/src/pages/lys_kort.rs:1339
msgid "Aktiver lys på kortet"
msgstr "启用显卡灯光"

#: crates/rigg/src/pages/lys_kort.rs:1340
msgid "Se på det fysiske kortet før du fortsetter. Lyset må allerede vise én fast farge. Pust, fargeskift og et ukjent utgangspunkt kan ikke lagres som et sikkert utgangspunkt. Administratorgodkjenningen gjelder bare kortlyset; den endrer ikke GPU-tillatelsen."
msgstr "继续前请查看实体显卡。灯光必须已显示单一固定颜色。呼吸、变色或未知状态均无法保存为安全基准状态。管理员授权仅限灯光，不会更改 GPU 权限。"

#: crates/rigg/src/pages/lys_kort.rs:1341
msgid "Jeg ser kortet og bekrefter at det viser én fast farge."
msgstr "我看到了显卡，并确认它显示单一固定颜色。"

#: crates/rigg/src/pages/lys_kort.rs:1350
msgid "GPU-styringen røres ikke."
msgstr "不会改动 GPU 控制。"

#: crates/rigg/src/pages/lys_kort.rs:1352
msgid "GPU-hjelperen oppdateres også og startes på nytt: effekt, vifter og klokker går tilbake til utgangspunktet og må brukes på nytt."
msgstr "GPU 辅助程序也会更新并重启：功耗、风扇和频率会恢复到初始值，需要重新应用。"

#: crates/rigg/src/pages/lys_kort.rs:1356
msgid "Har en tidligere RGB-økt ikke blitt avsluttet, settes kortet først tilbake til det lagrede lyset i samme godkjenning. Deretter ber appen deg se på kortet og bekrefte det gjenopprettede lyset før økten avsluttes og oppdateringen fortsetter."
msgstr "如果之前的 RGB 会话没有结束，显卡会在同一次授权中先恢复为已保存的灯光。随后应用会请你查看显卡并确认已恢复的灯光，然后才结束会话并继续更新。"

#: crates/rigg/src/pages/lys_kort.rs:1365
msgid "Kort: {kort}\n\n{beskrivelse}"
msgstr "显卡：{kort}\n\n{beskrivelse}"

#: crates/rigg/src/pages/lys_kort.rs:1365
msgid "Lagret binding"
msgstr "已保存的显卡绑定"

#: crates/rigg/src/pages/lys_kort.rs:1367 crates/rigg/src/pages/lys_kort.rs:1381
msgid "Fortsett til administratorgodkjenning"
msgstr "继续进行管理员授权"

#: crates/rigg/src/pages/lys_kort.rs:1400
msgid "Avklar tidligere RGB-økt"
msgstr "处理先前的 RGB 会话"

#: crates/rigg/src/pages/lys_kort.rs:1401
msgid "Lagret lys for {kort}: {lys}.\n\nSe på kortet. Fortsett bare hvis lyset viser dette utgangspunktet som én fast farge."
msgstr "{kort} 的已保存灯光：{lys}。\n\n请查看显卡。仅当显卡以单一固定颜色显示此基准状态时才继续。"

#: crates/rigg/src/pages/lys_kort.rs:1402
msgid "Jeg ser at kortlyset viser det lagrede, faste utgangspunktet."
msgstr "我看到显卡显示已保存的固定基准状态。"

#: crates/rigg/src/pages/lys_kort.rs:1432
msgid "Bekreft og fortsett oppdateringen"
msgstr "确认并继续更新"

#: crates/rigg/src/pages/lys_kort.rs:1445 crates/rigg/src/pages/lys_kort.rs:1569
msgid "RGB-oppsettet er oppdatert. Kontroller status før du bruker en farge."
msgstr "RGB 设置已更新。应用颜色前请检查状态。"

#: crates/rigg/src/pages/lys_kort.rs:1447 crates/rigg/src/pages/lys_kort.rs:1577
msgid "RGB-oppsett"
msgstr "RGB 设置"

#: crates/rigg/src/pages/lys_kort.rs:1526 crates/rigg/src/pages/lys_kort.rs:1573
msgid "RGB-oppsettet kunne ikke fullføres."
msgstr "无法完成 RGB 设置。"

#: crates/rigg/src/pages/lys_kort.rs:1565
msgid "RGB-arbeideren er stoppet. Kontroller lyset og velg «Avklar tidligere økt» hvis en gjenoppretting gjenstår."
msgstr "RGB 工作进程已停止。请检查灯光，如仍有未完成的恢复，请选择“处理先前会话”。"

#: crates/rigg/src/pages/lys_kort.rs:1566
msgid "Ingen uavklart RGB-journal for kortet. Du kan slå av RGB-tilgangen."
msgstr "此显卡没有未处理的 RGB 日志。可以停用 RGB 访问。"

#: crates/rigg/src/pages/lys_kort.rs:1567
msgid "Gjenopprettingen er avklart. Du kan slå av RGB-tilgangen eller aktivere lysstyring på nytt."
msgstr "恢复已处理完成。可停用 RGB 访问或重新启用灯光控制。"

#: crates/rigg/src/pages/lys_kort.rs:1568
msgid "RGB-tilgangen er slått av."
msgstr "RGB 访问已停用。"

#: crates/rigg/src/pages/lys_kort.rs:1570
msgid "Administratorgodkjenningen ble avbrutt."
msgstr "管理员授权已取消。"

#: crates/rigg/src/pages/lys_kort.rs:1571
msgid "Avklaringsmålet er ugyldig eller gjelder et annet valgt kort."
msgstr "恢复目标无效或属于其他显卡。"

#: crates/rigg/src/pages/lys_kort.rs:1577
msgid "RGB-oppsett ble ikke fullført"
msgstr "RGB 设置未完成"

#: crates/rigg/src/pages/lys_kort.rs:1603
msgid "Administratorhandlinger for RGB krever appens vanlige maskinvareoppsett."
msgstr "RGB 管理员操作要求应用使用正常的硬件设置。"

#: crates/rigg/src/pages/lys_kort.rs:1627
msgid "Systemkomponentene mangler. Se «Uten nett: bruk terminal» under «Detaljer og feilsøking»."
msgstr "缺少系统组件。请查看“详细信息与故障排除”中的“离线：使用终端”。"

#: crates/rigg/src/pages/lys_kort.rs:1671
msgid "Avbryt"
msgstr "取消"
