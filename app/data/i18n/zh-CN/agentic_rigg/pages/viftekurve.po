#: crates/rigg/src/pages/viftekurve.rs:59
msgid "Stille"
msgstr "静音"

#: crates/rigg/src/pages/viftekurve.rs:66
msgid "Minste fart til 55 °C, 5 °C hysterese, rolig rampe (5 %/s opp, 2 %/s ned) og 5 s utjevning"
msgstr "55 °C 前保持最低转速，温度滞回 5 °C，缓慢变速（上升 5 %/s，下降 2 %/s），平滑 5 s"

#: crates/rigg/src/pages/viftekurve.rs:70
msgid "Balansert"
msgstr "均衡"

#: crates/rigg/src/pages/viftekurve.rs:77
msgid "Standardkurven: 3 °C hysterese, 10 %/s opp og 3 %/s ned, ingen utjevning"
msgstr "默认曲线：温度滞回 3 °C，上升 10 %/s，下降 3 %/s，不平滑"

#: crates/rigg/src/pages/viftekurve.rs:81
msgid "Ytelse"
msgstr "性能"

#: crates/rigg/src/pages/viftekurve.rs:88
msgid "Kjøligst: høyere kurve, 2 °C hysterese og rask rampe (20 %/s opp, 5 %/s ned)"
msgstr "散热优先：较高转速曲线，温度滞回 2 °C，快速变速（上升 20 %/s，下降 5 %/s）"

#: crates/rigg/src/pages/viftekurve.rs:121
msgid "{navn} · endret"
msgstr "{navn} · 已修改"

#: crates/rigg/src/pages/viftekurve.rs:528
msgid "GPU-temperatur"
msgstr "GPU 温度"

#: crates/rigg/src/pages/viftekurve.rs:529
msgid "Minst {fart} (driver)"
msgstr "最低转速 {fart}（驱动程序）"

#: crates/rigg/src/pages/viftekurve.rs:529
msgid "Minste fart er ikke avlest"
msgstr "未报告最低转速"

#: crates/rigg/src/pages/viftekurve.rs:532
msgid "Under {fart} er ikke mulig"
msgstr "不支持低于 {fart} 的转速"

#: crates/rigg/src/pages/viftekurve.rs:536
msgid "Nødregel {fart} over {temperatur}"
msgstr "高温保护：超过 {temperatur} 时转速设为 {fart}"

#: crates/rigg/src/pages/viftekurve.rs:595
msgid "Minst {fart} til {temperatur}"
msgstr "温度不超过 {temperatur} 时，转速至少为 {fart}"

#: crates/rigg/src/pages/viftekurve.rs:604
msgid "Ned · {grader} hysterese"
msgstr "降速 · 滞回 {grader}"

#: crates/rigg/src/pages/viftekurve.rs:631
msgid "Nå {temperatur} · {fart}"
msgstr "当前 {temperatur} · {fart}"

#: crates/rigg/src/pages/viftekurve.rs:686
msgid "Ved {temperatur}: kurven {fart}"
msgstr "{temperatur} 时：曲线设定值 {fart}"

#: crates/rigg/src/pages/viftekurve.rs:689
msgid " (ned {fart})"
msgstr "（降温时：{fart}）"

#: crates/rigg/src/pages/viftekurve.rs:692
msgid ", driveren {fart} (median av {n})"
msgstr "，驱动程序：{fart}（{n} 个样本的中位数）"

#: crates/rigg/src/pages/viftekurve.rs:693
msgid ", {n} måling"
msgid_plural ", {n} målinger"
msgstr[0] "，{n} 个样本"

#: crates/rigg/src/pages/viftekurve.rs:756
msgid "Viftekurven: viftefart mot GPU-temperatur"
msgstr "风扇曲线：风扇转速与 GPU 温度的关系"

#: crates/rigg/src/pages/viftekurve.rs:1156
msgid "nå"
msgstr "当前"

#: crates/rigg/src/pages/viftekurve.rs:1193
msgid "Viftene de siste fem minuttene, slik de gikk og med kurven"
msgstr "最近 5 分钟的风扇实际转速与曲线预览"

#: crates/rigg/src/pages/viftekurve.rs:1227 crates/rigg/src/pages/viftekurve.rs:2583
msgid "Auto (driveren)"
msgstr "自动（驱动程序）"

#: crates/rigg/src/pages/viftekurve.rs:1227
msgid "Driveren styrer viftene etter temperaturen, som uten appen. Standard."
msgstr "驱动程序按温度控制风扇，与不运行应用时相同。默认模式。"

#: crates/rigg/src/pages/viftekurve.rs:1228 crates/rigg/src/pages/viftekurve.rs:2585
msgid "Kurve"
msgstr "曲线"

#: crates/rigg/src/pages/viftekurve.rs:1228
msgid "Agentic HW Monitor setter farten etter viftekurven hvert sekund."
msgstr "Agentic HW Monitor 每秒按风扇曲线更新转速。"

#: crates/rigg/src/pages/viftekurve.rs:1229 crates/rigg/src/pages/viftekurve.rs:2584
msgid "Manuell"
msgstr "手动"

#: crates/rigg/src/pages/viftekurve.rs:1229
msgid "Fast fart, uansett temperatur. Pass på temperaturen under last."
msgstr "不随温度变化的固定转速。请关注负载下的温度。"

#: crates/rigg/src/pages/viftekurve.rs:1236
msgid "Egen kurve er aktiv på kortet. Modusbyttet ligger bare i utkastet til du trykker Bruk og Behold."
msgstr "自定义曲线已生效。模式更改仅保存在草稿中，直到依次点击“应用”和“保留”。"

#: crates/rigg/src/pages/viftekurve.rs:1238
msgid "Egen kurve er aktiv på kortet. Du har et kurveutkast; åpne Avansert for å se og redigere det."
msgstr "自定义曲线已生效，另有一份已保存的草稿。打开“高级”可查看或编辑草稿。"

#: crates/rigg/src/pages/viftekurve.rs:1240
msgid "Egen kurve er aktiv. Viftene fortsetter å følge den i Enkel visning. Åpne Avansert for å se og redigere kurven."
msgstr "自定义曲线已生效。在“基础”视图中，风扇仍按该曲线运行。打开“高级”可查看或编辑曲线。"

#: crates/rigg/src/pages/viftekurve.rs:1243
msgid "Egen kurve er valgt i utkastet. Åpne Avansert for å se kurven. Kortet endres først med Bruk og Behold."
msgstr "草稿使用自定义曲线。打开“高级”可查看。依次点击“应用”和“保留”后，更改才会保留在 GPU 上。"

#: crates/rigg/src/pages/viftekurve.rs:1255
msgid "Felles kurve"
msgstr "共用曲线"

#: crates/rigg/src/pages/viftekurve.rs:1257
msgid "Vifte {i}"
msgstr "风扇 {i}"

