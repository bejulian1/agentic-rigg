#: crates/rigg/src/widgets/locked.rs:38
msgid "Skjermkortet eller tjenesten svarer ikke. Endringer er låst."
msgstr "GPU 或服务无响应，暂时无法更改设置。"

#: crates/rigg/src/widgets/locked.rs:41
msgid "Hjelperen er aktivert for et annet kort. Aktiver styring for kortet som vises."
msgstr "辅助程序已为另一块 GPU 启用。请为此处显示的 GPU 启用调校。"

#: crates/rigg/src/widgets/locked.rs:85
msgid "Funksjonen er ikke tilgjengelig på dette kortet."
msgstr "此显卡无法使用该功能。"

#: crates/rigg/src/widgets/locked.rs:304
msgid "Valgt kort ble endret. Endringen på det opprinnelige kortet er rullet tilbake."
msgstr "所选显卡已更改。原显卡上的更改已回退。"

#: crates/rigg/src/widgets/locked.rs:305
msgid "Valgt kort ble endret. Tilbakestilling på det opprinnelige kortet er ikke bekreftet. Se status i Innstillinger › Skjermkortstyring."
msgstr "所选显卡已更改。尚未确认原显卡上的回退。请查看“设置 › GPU 控制”。"

#: crates/rigg/src/widgets/locked.rs:306
msgid "Valgt kort ble endret. Tilbakestilling på det opprinnelige kortet kunne ikke bekreftes: {feil}"
msgstr "所选显卡已更改。无法验证原显卡上的回退：{feil}"

#: crates/rigg/src/widgets/locked.rs:312
msgid "Valgt kort ble endret mens forespørselen ventet. Svaret brukes ikke på det nye kortet."
msgstr "等待响应期间，所选 GPU 已更改。此响应不会用于新选中的 GPU。"

#: crates/rigg/src/widgets/locked.rs:340 crates/rigg/src/widgets/locked.rs:675
msgid "Simulert kort"
msgstr "模拟显卡"

#: crates/rigg/src/widgets/locked.rs:340
msgid "Endringer gjelder bare simuleringen."
msgstr "更改仅影响模拟。"

#: crates/rigg/src/widgets/locked.rs:342 crates/rigg/src/widgets/locked.rs:679
msgid "Styring klar"
msgstr "控制已就绪"

#: crates/rigg/src/widgets/locked.rs:342
msgid "Støttede endringer sendes til det valgte kortet når du trykker Bruk."
msgstr "选择“应用”时，受支持的更改会发送到所选显卡。"

#: crates/rigg/src/widgets/locked.rs:343
msgid "Simulert styring"
msgstr "模拟控制"

#: crates/rigg/src/widgets/locked.rs:343
msgid "Endringer gjelder bare det simulerte kortet."
msgstr "更改仅影响模拟显卡。"

#: crates/rigg/src/widgets/locked.rs:344
msgid "Styring utilgjengelig"
msgstr "控制不可用"

#: crates/rigg/src/widgets/locked.rs:345
msgid "Styring: feil"
msgstr "控制错误"

#: crates/rigg/src/widgets/locked.rs:346
msgid "Oppdater hjelper"
msgstr "更新辅助程序"

#: crates/rigg/src/widgets/locked.rs:347
msgid "Bare visning"
msgstr "只读"

#: crates/rigg/src/widgets/locked.rs:347
msgid "Endringer på skjermkortet er slått av. Aktiver én gang med administratorpassord i Innstillinger › Skjermkortstyring."
msgstr "显卡调校已关闭。请在“设置 › GPU 控制”中使用管理员密码授权启用一次。"

#: crates/rigg/src/widgets/locked.rs:355
msgid "Hjelperen er ikke skriveklar for kortet som vises."
msgstr "辅助程序尚未就绪，无法调校此 GPU。"

#: crates/rigg/src/widgets/locked.rs:356
msgid "Hjelperen svarer ikke. Endringer er låst."
msgstr "辅助程序无响应。更改已锁定。"

#: crates/rigg/src/widgets/locked.rs:357
msgid "Hjelperen må oppdateres. Oppdater systemkomponentene fra Innstillinger › Skjermkortstyring."
msgstr "必须更新辅助程序。请在“设置 › GPU 控制”中更新系统组件。"

#: crates/rigg/src/widgets/locked.rs:516
msgid "Utkastet må oppdateres"
msgstr "草稿需要更新"

#: crates/rigg/src/widgets/locked.rs:544
msgid "Dette eldre utkastet mangler opprinnelig grunnlag. Behold det som referanse, eller forkast det og lag et nytt utkast fra kortets verdier."
msgstr "这份旧草稿没有保存原始设置。可保留以供参考，也可放弃并基于 GPU 的当前设置新建草稿。"

#: crates/rigg/src/widgets/locked.rs:547
msgid "Utkastet tilhører en annen kortidentitet. Velg det opprinnelige kortet, eller forkast utkastet før du lager et nytt."
msgstr "此草稿属于另一块 GPU。请选择原来的 GPU，或放弃此草稿后新建草稿。"

#: crates/rigg/src/widgets/locked.rs:553
msgid "Det finnes ikke noe utkast å bruke."
msgstr "没有可应用的草稿。"

#: crates/rigg/src/widgets/locked.rs:650 crates/rigg/src/widgets/locked.rs:683
msgid "Låst"
msgstr "已锁定"

#: crates/rigg/src/widgets/locked.rs:657
msgid "Hva skal til?"
msgstr "需要什么？"

#: crates/rigg/src/widgets/locked.rs:659
msgid "Aktivering og støtte for kortet"
msgstr "启用与显卡支持"

#: crates/rigg/src/widgets/locked.rs:673
msgid "Kortet svarer ikke"
msgstr "GPU 无响应"

#: crates/rigg/src/widgets/locked.rs:673
msgid "Verdiene vises igjen når kortet er tilbake. Utkastet beholdes."
msgstr "显卡恢复可用后会重新显示数值。草稿会保留。"

#: crates/rigg/src/widgets/locked.rs:675
msgid "Bruk sender utkastet til den simulerte backenden, med Behold eller Rull tilbake. Det ekte kortet røres ikke."
msgstr "“应用”会将草稿发送至模拟后端。可选择保留或回退。不会修改实体显卡。"

#: crates/rigg/src/widgets/locked.rs:677 crates/rigg/src/widgets/locked.rs:717
msgid "Utilgjengelig"
msgstr "不可用"

#: crates/rigg/src/widgets/locked.rs:679
msgid "Utkast"
msgstr "草稿"

#: crates/rigg/src/widgets/locked.rs:679
msgid "Endringene sendes til kortet når du trykker Bruk. Behold dem innen fristen, ellers rulles de tilbake."
msgstr "选择“应用”时会将更改发送给显卡。请在期限内保留，否则会回退。"

#: crates/rigg/src/widgets/locked.rs:679
msgid "Støttede funksjoner kan endres med Bruk og Behold."
msgstr "可通过“应用”和“保留”更改受支持的功能。"

#: crates/rigg/src/widgets/locked.rs:681
msgid "Utkast · låst"
msgstr "草稿 · 已锁定"

#: crates/rigg/src/widgets/locked.rs:681
msgid "Utkastet lagres i appen og sendes ikke til kortet. Styring er ikke tilgjengelig for kortet som vises, så Bruk er låst."
msgstr "草稿保存在应用中，不会发送到显卡。此显卡不可控制，因此“应用”已锁定。"

#: crates/rigg/src/widgets/locked.rs:706
msgid "Skjermkortstyring"
msgstr "GPU 控制"

#: crates/rigg/src/widgets/locked.rs:707
msgid "Aktiver styring én gang med administratorpassord i Innstillinger. Funksjonene under blir tilgjengelige der kortet og driveren støtter dem."
msgstr "请在设置中使用管理员密码启用一次控制。显卡和驱动程序支持的下列功能将可用。"

#: crates/rigg/src/widgets/locked.rs:711
msgid "Effektgrense"
msgstr "功率限制"

#: crates/rigg/src/widgets/locked.rs:711
msgid "Vifter"
msgstr "风扇"

#: crates/rigg/src/widgets/locked.rs:711
msgid "Viftekurve"
msgstr "风扇曲线"

#: crates/rigg/src/widgets/locked.rs:711
msgid "Kjerneklokke"
msgstr "核心频率"

#: crates/rigg/src/widgets/locked.rs:711
msgid "Minneklokke"
msgstr "显存频率"

#: crates/rigg/src/widgets/locked.rs:711
msgid "Temperaturmål"
msgstr "目标温度"

#: crates/rigg/src/widgets/locked.rs:717
msgid "Tilgjengelig"
msgstr "可用"

#: crates/rigg/src/widgets/locked.rs:717
msgid "Ikke undersøkt"
msgstr "未检查"

#: crates/rigg/src/widgets/locked.rs:721
msgid "Hver endring må beholdes innen fristen. Du kan alltid velge Rull tilbake."
msgstr "请在期限内保留每项更改。您始终可以选择“回退”。"

#: crates/rigg/src/widgets/locked.rs:725
msgid "Åpne Innstillinger › Skjermkortstyring"
msgstr "打开“设置 › GPU 控制”"

#: crates/rigg/src/widgets/locked.rs:940
msgid "Rull tilbake"
msgstr "回退"

#: crates/rigg/src/widgets/locked.rs:941
msgid "Behold"
msgstr "保留"

#: crates/rigg/src/widgets/locked.rs:961
msgid "Tilbakestilling kunne ikke bekreftes. Kortets tilstand er usikker. Prøv Rull tilbake, og se status i Innstillinger › Skjermkortstyring."
msgstr "无法验证回退。显卡状态不确定。请尝试“回退”，并在“设置 › GPU 控制”中检查状态。"

#: crates/rigg/src/widgets/locked.rs:965 crates/rigg/src/widgets/locked.rs:1053 crates/rigg/src/widgets/locked.rs:1107
msgid "Endringene er rullet tilbake"
msgstr "更改已回退"

#: crates/rigg/src/widgets/locked.rs:1025
msgid "Behold ({sek})"
msgstr "保留（{sek}）"

#: crates/rigg/src/widgets/locked.rs:1026
msgid "Kortet er byttet. Venter på bekreftet tilbakestilling på det opprinnelige kortet …"
msgstr "所选显卡已更改。正在等待确认原显卡上的回退…"

#: crates/rigg/src/widgets/locked.rs:1027
msgid "Fristen er ute. Venter på bekreftet tilbakestilling fra tjenesten …"
msgstr "已超时。正在等待服务确认回退…"

#: crates/rigg/src/widgets/locked.rs:1028
msgid "Behold endringene? Uten svar rulles de tilbake om {tid}."
msgstr "保留更改？如果没有响应，更改将在 {tid} 后回退。"

#: crates/rigg/src/widgets/locked.rs:1046
msgid "Tjenesten kan ikke bekrefte kortets tilstand eller tilbakestilling. Prøv Rull tilbake, og se status i Innstillinger › Skjermkortstyring."
msgstr "服务无法验证显卡状态或回退。请尝试“回退”，并查看“设置 › GPU 控制”。"

#: crates/rigg/src/widgets/locked.rs:1058
msgid "Kortets tilstand er bekreftet"
msgstr "显卡状态已验证"

#: crates/rigg/src/widgets/locked.rs:1058
msgid "Ingen ubekreftet endring venter."
msgstr "没有待确认的更改。"

#: crates/rigg/src/widgets/locked.rs:1107
msgid "Endringene er beholdt"
msgstr "更改已保留"

#: crates/rigg/src/widgets/locked.rs:1111
msgid "Tjenesten kan ikke bekrefte tilbakestillingen. Kortets tilstand er usikker. Prøv Rull tilbake."
msgstr "服务无法验证回退。显卡状态不确定。请尝试“回退”。"

#: crates/rigg/src/widgets/locked.rs:1112
msgid "Kunne ikke bekrefte svaret: {feil}. Prøv Rull tilbake. Endringen regnes ikke som tilbakestilt før tjenesten bekrefter det."
msgstr "无法验证响应：{feil}。请尝试“回退”。服务验证前，不视为已回退。"
