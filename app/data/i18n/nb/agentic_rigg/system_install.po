#: crates/rigg/src/system_install.rs:262
msgid "Nedlastingen stemmer ikke med summen GitHub oppgir. Ingen systemfiler er endret."
msgstr "Nedlastingen stemmer ikke med summen GitHub oppgir. Ingen systemfiler er endret."

#: crates/rigg/src/system_install.rs:263
msgid "Installasjonen feilet. Ingen nye tilganger er gitt."
msgstr "Installasjonen feilet. Ingen nye tilganger er gitt."

