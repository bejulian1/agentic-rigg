msgstr "Tak"

#: crates/rigg-core/src/report/gpu.rs:261
msgid "Nei"
msgstr "Nie"

#: crates/rigg-core/src/report/gpu.rs:262
msgid "NVML displayActive. Med den åpne kjernemodulen på Wayland står det ofte «Nei» selv når en skjerm er koblet til."
msgstr "NVML displayActive. W Wayland z otwartym modułem jądra pole często pokazuje „Nie”, nawet gdy ekran jest podłączony."

#: crates/rigg-core/src/report/gpu.rs:267
