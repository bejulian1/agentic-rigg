msgstr "Sterownik nie podaje domyślnego taktowania (taktowanie aplikacji wycofano)."

#: crates/rigg-core/src/report/gpu.rs:346
msgid "Boost etter spesifikasjonen er {klokke} (referanse, ikke målt)."
msgstr "Taktowanie boost według specyfikacji: {klokke} (wartość referencyjna, bez pomiaru)."

