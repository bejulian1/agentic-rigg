msgid "{antall} dårlig sektor (var {b}). Ta sikkerhetskopi av det som ligger på disken ({enhet})."
msgid_plural "{antall} dårlige sektorer (var {b}). Ta sikkerhetskopi av det som ligger på disken ({enhet})."
msgstr[0] "{antall} uszkodzony sektor (wcześniej: {b}). Utwórz kopię zapasową danych z tego dysku ({enhet})."
msgstr[1] "{antall} uszkodzone sektory (wcześniej: {b}). Utwórz kopię zapasową danych z tego dysku ({enhet})."
msgstr[2] "{antall} uszkodzonych sektorów (wcześniej: {b}). Utwórz kopię zapasową danych z tego dysku ({enhet})."

