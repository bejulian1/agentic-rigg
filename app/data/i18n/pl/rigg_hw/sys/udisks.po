#: crates/rigg-hw/src/sys/udisks.rs:190
msgid "Disken støtter ikke SMART."
msgstr "Ten dysk nie obsługuje SMART."

#: crates/rigg-hw/src/sys/udisks.rs:192
msgid "SMART er slått av på disken."
msgstr "SMART jest wyłączony na tym dysku."

#: crates/rigg-hw/src/sys/udisks.rs:194
msgid "UDisks2 har ikke lest SMART ennå."
msgstr "UDisks2 nie odczytał jeszcze danych SMART."

#: crates/rigg-hw/src/sys/udisks.rs:228
msgid "USB-broen sender ikke SMART videre."
msgstr "Mostek USB nie przekazuje danych SMART."

#: crates/rigg-hw/src/sys/udisks.rs:228
msgid "UDisks2 har ingen SMART for denne disken."
msgstr "UDisks2 nie ma danych SMART dla tego dysku."

#: crates/rigg-hw/src/sys/udisks.rs:252
msgid "Fikk ikke kontakt med systembussen ({feil})."
msgstr "Nie można połączyć się z magistralą systemową ({feil})."

#: crates/rigg-hw/src/sys/udisks.rs:271
msgid "UDisks2 svarer ikke på systembussen."
msgstr "UDisks2 nie odpowiada na magistrali systemowej."

#: crates/rigg-hw/src/sys/udisks.rs:273
msgid "UDisks2 svarte ikke ({feil})."
msgstr "UDisks2 nie odpowiedział ({feil})."
