#: crates/rigg/src/lys3d/mod.rs:38
msgid "Forfra"
msgstr "Przód"

#: crates/rigg/src/lys3d/mod.rs:39
msgid "Skrått"
msgstr "Pod kątem"

#: crates/rigg/src/lys3d/mod.rs:40
msgid "Ovenfra"
msgstr "Góra"

#: crates/rigg/src/lys3d/mod.rs:41
msgid "Bakfra"
msgstr "Tył"

#: crates/rigg/src/lys3d/mod.rs:44
msgid "Hel"
msgstr "Pełna"

#: crates/rigg/src/lys3d/mod.rs:45
msgid "Uten deksel"
msgstr "Bez osłony"

#: crates/rigg/src/lys3d/mod.rs:46
msgid "Uten kjøler"
msgstr "Bez chłodzenia"

#: crates/rigg/src/lys3d/mod.rs:47
msgid "Bare kretskort"
msgstr "Tylko PCB"

#: crates/rigg/src/lys3d/mod.rs:50
msgid "Alle deler er på: deksel med vifter og lys, kjøler, kretskort, brakett og bakplate."
msgstr "Wszystkie części zamontowane: osłona z wentylatorami i światłami, chłodzenie, PCB, śledź i backplate."

#: crates/rigg/src/lys3d/mod.rs:51
msgid "Dekselet og viftene er tatt av, så kjøleribben og varmerørene synes."
msgstr "Osłona i wentylatory są zdjęte, odsłaniając radiator i rurki cieplne."

#: crates/rigg/src/lys3d/mod.rs:52
msgid "Kjøleren er også tatt av. Kretskortet synes med brakett og bakplate."
msgstr "Chłodzenie również jest zdjęte. Widoczna jest płyta PCB ze śledziem i backplate."

#: crates/rigg/src/lys3d/mod.rs:53
msgid "Bare kretskortet: GPU-brikken, åtte minnebrikker, strømfaser, kontakter og utganger."
msgstr "Tylko PCB: układ GPU, osiem kości pamięci, fazy zasilania, złącza i wyjścia."

#: crates/rigg/src/lys3d/mod.rs:624
msgid "fra venstre"
msgstr "z lewej"

#: crates/rigg/src/lys3d/mod.rs:624
msgid "fra høyre"
msgstr "z prawej"

#: crates/rigg/src/lys3d/mod.rs:627
msgid "ovenfra, med lyslisten mot deg"
msgstr "z góry, z paskiem świetlnym zwróconym do Ciebie"

#: crates/rigg/src/lys3d/mod.rs:629
msgid "nedenfra"
msgstr "z dołu"

#: crates/rigg/src/lys3d/mod.rs:631
msgid "rett forfra"
msgstr "prosto z przodu"

#: crates/rigg/src/lys3d/mod.rs:633
msgid "skrått forfra {side}"
msgstr "pod kątem z przodu ({side})"

#: crates/rigg/src/lys3d/mod.rs:636
msgid "fra siden med braketten og utgangene"
msgstr "od strony śledzia i wyjść"

#: crates/rigg/src/lys3d/mod.rs:638
msgid "fra enden"
msgstr "od końca"

#: crates/rigg/src/lys3d/mod.rs:641
msgid "skrått bakfra {side}"
msgstr "pod kątem z tyłu ({side})"

#: crates/rigg/src/lys3d/mod.rs:643
msgid "rett bakfra, mot bakplaten"
msgstr "prosto z tyłu, na backplate"

#: crates/rigg/src/lys3d/mod.rs:646
msgid "Lagene er skilt fra hverandre ({prosent})."
msgstr "Warstwy są rozsunięte ({prosent})."

#: crates/rigg/src/lys3d/mod.rs:653
msgid "Viftene går på {fart}."
msgstr "Wentylatory pracują na {fart}."

#: crates/rigg/src/lys3d/mod.rs:655
msgid "Viftene står stille."
msgstr "Wentylatory są zatrzymane."

#: crates/rigg/src/lys3d/mod.rs:657
msgid "Skjermkort i 3D, sett {vinkel}. {lag}"
msgstr "Karta graficzna w 3D, widok {vinkel}. {lag}"

#: crates/rigg/src/lys3d/mod.rs:755
msgid "Skjermkortet i 3D"
msgstr "Karta graficzna w 3D"

#: crates/rigg/src/lys3d/mod.rs:756
msgid "3D-visning"
msgstr "Widok 3D"

#: crates/rigg/src/lys3d/mod.rs:835
msgid "GL kunne ikke startes: {feil}"
msgstr "Nie udało się uruchomić GL: {feil}"

#: crates/rigg/src/lys3d/mod.rs:898
msgid "GL-feil i GLArea"
msgstr "Błąd GL w GLArea"

#: crates/rigg/src/lys3d/mod.rs:917
msgid "3D-kortet kunne ikke startes: {feil}"
msgstr "Nie udało się uruchomić karty 3D: {feil}"

#: crates/rigg/src/lys3d/mod.rs:1134
msgid "Bygger 3D-kortet …"
msgstr "Budowanie karty 3D …"
