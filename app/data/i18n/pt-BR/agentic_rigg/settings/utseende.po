#: crates/rigg/src/settings/utseende.rs:410
msgctxt "søkeord"
msgid "tema mørk modus lys dark light"
msgstr "tema escuro claro modo aparência"

#: crates/rigg/src/settings/utseende.rs:414
msgid "Tonen i flater, rammer og tekst, i både lyst og mørkt."
msgstr "Tom de superfícies, bordas e texto nos modos claro e escuro."

#: crates/rigg/src/settings/utseende.rs:416
msgctxt "søkeord"
msgid "palett grafitt sand fjord midnatt"
msgstr "paleta grafite areia fiorde meia-noite"

