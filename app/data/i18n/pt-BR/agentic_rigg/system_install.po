#: crates/rigg/src/system_install.rs:119
msgid "Systemkomponentene mangler eller må oppdateres."
msgstr "Os componentes do sistema estão ausentes ou precisam ser atualizados."

#: crates/rigg/src/system_install.rs:120
msgid "Installer systemkomponenter"
msgstr "Instalar componentes do sistema"

#: crates/rigg/src/system_install.rs:124
msgid "Fant ikke pkexec. Bruk terminalkommandoen."
msgstr "pkexec não foi encontrado. Use o comando do terminal."

#: crates/rigg/src/system_install.rs:127
msgid "Henter Agentic Rigg {versjon} fra GitHub, kontrollerer den mot SHA-256-summen GitHub oppgir, og ber om administratorpassordet. Installasjonen gir ingen tilgang i seg selv."
msgstr "Baixa o Agentic Rigg {versjon} do GitHub, verifica-o com a soma SHA-256 publicada pelo GitHub e pede a senha de administrador. A instalação não concede nenhum acesso por si só."

#: crates/rigg/src/system_install.rs:144
msgid "Systemkomponentene er installert"
msgstr "Componentes do sistema instalados"

#: crates/rigg/src/system_install.rs:144
msgid "Slå på GPU-styring eller kortlys når du vil bruke dem."
msgstr "Ative os ajustes da GPU ou a iluminação da placa quando quiser usá-los."

#: crates/rigg/src/system_install.rs:151
msgid "Kjør kommandoen i en administratorterminal. Oppgi arkivstien og SHA-256 fra utgivelsessiden."
msgstr "Execute o comando em um terminal de administrador. Informe o caminho do arquivo e o SHA-256 da página da versão."

#: crates/rigg/src/system_install.rs:155
msgid "Kopier installasjonskommando"
msgstr "Copiar comando de instalação"

#: crates/rigg/src/system_install.rs:160
msgid "Uten nett: bruk terminal"
msgstr "Sem internet: usar um terminal"

#: crates/rigg/src/system_install.rs:168
msgid "Passordet ble ikke gitt. Ingenting er endret."
msgstr "Nenhuma senha foi informada. Nada foi alterado."

#: crates/rigg/src/system_install.rs:169
msgid "Fant ikke pkexec, eller ingen kan spørre om passordet (polkit)."
msgstr "pkexec não foi encontrado ou o polkit não pode solicitar a senha."

#: crates/rigg/src/system_install.rs:171
msgid "Fikk ikke kontakt med GitHub. Sjekk nettet, eller bruk terminalkommandoen."
msgstr "Não foi possível acessar o GitHub. Verifique a conexão ou use o comando do terminal."

#: crates/rigg/src/system_install.rs:172
msgid "Fant ikke utgivelsen for denne versjonen på GitHub."
msgstr "A versão correspondente não foi encontrada no GitHub."

#: crates/rigg/src/system_install.rs:174
msgid "Nedlastingen stemmer ikke med summen GitHub oppgir. Ingen systemfiler er endret."
msgstr "O download não corresponde à soma publicada pelo GitHub. Nenhum arquivo do sistema foi alterado."

#: crates/rigg/src/system_install.rs:175
msgid "Installasjonen feilet. Ingen nye tilganger er gitt."
msgstr "A instalação falhou. Nenhum novo acesso foi concedido."

#: crates/rigg/src/system_install.rs:176
msgid "Installasjonen feilet: {feil}"
msgstr "A instalação falhou: {feil}"

#: crates/rigg/src/system_install.rs:189
msgid "Vent til den andre administratorhandlingen er ferdig"
msgstr "Aguarde a outra ação de administrador terminar"

#: crates/rigg/src/system_install.rs:206 crates/rigg/src/system_install.rs:221
msgid "Installasjonen ble ikke fullført"
msgstr "Instalação não concluída"
