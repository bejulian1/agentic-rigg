#: crates/rigg/src/widgets/styrer.rs:32
msgid "NVIDIA-referansekort"
msgstr "Placa de referência NVIDIA"

#: crates/rigg/src/widgets/styrer.rs:33
msgid "PCI-leverandør {id}"
msgstr "Fornecedor PCI {id}"

#: crates/rigg/src/widgets/styrer.rs:53
msgid "Produsenten er satt av deg. Kortet melder NVIDIAs referanse i PCI-subsystemet ({s})."
msgstr "Você definiu o fabricante. A placa informa o ID de referência da NVIDIA no subsistema PCI ({s})."

#: crates/rigg/src/widgets/styrer.rs:54
msgid "Produsenten er satt av deg."
msgstr "Você definiu o fabricante."

#: crates/rigg/src/widgets/styrer.rs:55
msgid "Kortet melder NVIDIAs referanse i PCI-subsystemet ({s}). Det er et referansekort, eller en produsent som ikke setter sin egen ID. Du kan sette produsenten selv."
msgstr "A placa informa o ID de referência da NVIDIA no subsistema PCI ({s}). Pode ser uma placa de referência ou o fabricante pode não informar um ID próprio. Você pode definir o fabricante manualmente."

#: crates/rigg/src/widgets/styrer.rs:56
msgid "Fra PCI-subsystemet ({s})."
msgstr "Do subsistema PCI ({s})."

#: crates/rigg/src/widgets/styrer.rs:57
msgid "Produsenten er ikke lest."
msgstr "Fabricante não detectado."

#: crates/rigg/src/widgets/styrer.rs:82
msgid "Styrer"
msgstr "Controla"

#: crates/rigg/src/widgets/styrer.rs:105 crates/rigg/src/widgets/styrer.rs:106
msgid "Sett produsenten"
msgstr "Definir fabricante"

#: crates/rigg/src/widgets/styrer.rs:118
msgid "Velg kortet som styres"
msgstr "Selecionar a GPU a controlar"

#: crates/rigg/src/widgets/styrer.rs:177
msgid "Venter på tjenesten"
msgstr "Aguardando o serviço"

#: crates/rigg/src/widgets/styrer.rs:177
msgid "kortet vises når tjenesten svarer"
msgstr "a GPU aparece quando o serviço responder"

#: crates/rigg/src/widgets/styrer.rs:178
msgid "Leser skjermkortet …"
msgstr "Detectando GPU…"

#: crates/rigg/src/widgets/styrer.rs:179
msgid "Fant ingen NVIDIA-driver"
msgstr "Driver NVIDIA não encontrado"

#: crates/rigg/src/widgets/styrer.rs:179
msgid "ingen skjermkort å styre"
msgstr "nenhuma GPU para controlar"

#: crates/rigg/src/widgets/styrer.rs:182 crates/rigg/src/widgets/styrer.rs:190
msgid "Skjermkortet"
msgstr "GPU"

#: crates/rigg/src/widgets/styrer.rs:183
msgid "driveren er oppdatert · start maskinen på nytt for å styre kortet"
msgstr "driver atualizado · reinicie o computador para controlar a GPU"

#: crates/rigg/src/widgets/styrer.rs:191
msgid "svarer ikke siden {since} · styringen er utilgjengelig"
msgstr "sem resposta desde {since} · controle indisponível"

#: crates/rigg/src/widgets/styrer.rs:207
msgid "driver {d}"
msgstr "driver {d}"

#: crates/rigg/src/widgets/styrer.rs:209
msgid "{kort}\nProdusent: {produsent}\nPCI-adresse: {pci}\nVBIOS: {vbios}\n{detalj}"
msgstr "{kort}\nFabricante: {produsent}\nEndereço PCI: {pci}\nVBIOS: {vbios}\n{detalj}"

#: crates/rigg/src/widgets/styrer.rs:217
msgid "Skjermkort"
msgstr "GPU"

#: crates/rigg/src/widgets/styrer.rs:236
msgid "Kort {i} av {antall}"
msgstr "GPU {i} de {antall}"

#: crates/rigg/src/widgets/styrer.rs:238
msgid "Styrer: {name}. {meta}"
msgstr "GPU controlada: {name}. {meta}"

#: crates/rigg/src/widgets/styrer.rs:244
msgid "Kortet som styres"
msgstr "GPU a controlar"

#: crates/rigg/src/widgets/styrer.rs:284
msgid "Produsent (valgfritt)"
msgstr "Fabricante (opcional)"

#: crates/rigg/src/widgets/styrer.rs:296
msgid "Produsent"
msgstr "Fabricante"

#: crates/rigg/src/widgets/styrer.rs:298
msgid "Vises bare i appen, i Styrer-linja og i maskinhodet. Kortet endres ikke."
msgstr "Aparece apenas no seletor de GPU e no cabeçalho do sistema do app. Não altera a placa."

#: crates/rigg/src/widgets/styrer.rs:307
msgid "Fjern"
msgstr "Remover"

#: crates/rigg/src/widgets/styrer.rs:309
msgid "Lagre"
msgstr "Salvar"
