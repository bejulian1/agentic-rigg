#: crates/rigg/src/pages/oversikt.rs:92 crates/rigg/src/pages/oversikt.rs:102
msgid "Disker"
msgstr "Unidades"

#: crates/rigg/src/pages/oversikt.rs:93 crates/rigg/src/pages/oversikt.rs:1065
msgid "Nettverk"
msgstr "Rede"

#: crates/rigg/src/pages/oversikt.rs:100 crates/rigg/src/pages/oversikt.rs:744
msgid "Grafikkort"
msgstr "Placa de vídeo"

#: crates/rigg/src/pages/oversikt.rs:101
msgid "System"
msgstr "Sistema"

#: crates/rigg/src/pages/oversikt.rs:103
msgid "Klokker og effekt"
msgstr "Frequências e potência"

#: crates/rigg/src/pages/oversikt.rs:104
msgid "Sensorer"
msgstr "Sensores"

#: crates/rigg/src/pages/oversikt.rs:196
msgid "{what}\nSparklinja er siste minutt. Klikk for {side}."
msgstr "{what}\nO minigráfico mostra o último minuto. Clique para abrir {side}."

#: crates/rigg/src/pages/oversikt.rs:235
msgid "Prosessor: total last, temperatur (Tdie) og snittklokke over trådene."
msgstr "Processador: uso total, temperatura (Tdie) e frequência média entre as threads."

#: crates/rigg/src/pages/oversikt.rs:252
msgid "Ny driver"
msgstr "Novo driver"

#: crates/rigg/src/pages/oversikt.rs:252
msgid "Ingen driver"
msgstr "Sem driver"

#: crates/rigg/src/pages/oversikt.rs:254
msgid "start maskinen på nytt"
msgstr "reinicie o computador"

#: crates/rigg/src/pages/oversikt.rs:254
msgid "fant ikke NVIDIA-driveren"
msgstr "driver NVIDIA não encontrado"

#: crates/rigg/src/pages/oversikt.rs:255
msgid "En ny NVIDIA-driver er installert, men den gamle kjører fortsatt."
msgstr "Um novo driver NVIDIA foi instalado, mas o anterior ainda está em uso."

#: crates/rigg/src/pages/oversikt.rs:255
msgid "Fant ingen NVIDIA-driver. Prosessor, minne og disker vises som vanlig."
msgstr "Nenhum driver NVIDIA encontrado. O processador, a memória e as unidades são exibidos normalmente."

#: crates/rigg/src/pages/oversikt.rs:258
msgid "svarer ikke"
msgstr "sem resposta"

#: crates/rigg/src/pages/oversikt.rs:259
msgid "Skjermkortet svarer ikke. Tjenesten prøver å finne det igjen hvert 10. s."
msgstr "A GPU não responde. O serviço tenta detectá-la novamente a cada 10 s."

#: crates/rigg/src/pages/oversikt.rs:269
msgid "{brukt} av {totalt}"
msgstr "{brukt} de {totalt}"

#: crates/rigg/src/pages/oversikt.rs:276
msgid "Skjermkort: GPU-last, temperatur, effekt av effektgrensen og P-tilstand (P0 er full ytelse, P8 er tomgang)."
msgstr "Placa de vídeo: uso da GPU, temperatura, consumo em relação ao limite e estado de desempenho (P0 é desempenho máximo e P8 é repouso)."

#: crates/rigg/src/pages/oversikt.rs:289 crates/rigg/src/pages/oversikt.rs:304
msgid "av {verdi}"
msgstr "de {verdi}"

#: crates/rigg/src/pages/oversikt.rs:291
msgid "Minne: det programmene bruker, av totalt. Buffer og cache er ikke med."
msgstr "Memória: parte do total usada pelos aplicativos, sem buffers nem cache."

#: crates/rigg/src/pages/oversikt.rs:306
msgid "Videominne brukt på skjermkortet, av totalt. Gult over 85 %, rødt over 95 %."
msgstr "Memória de vídeo usada do total da placa. Amarelo acima de 85%, vermelho acima de 95%."

#: crates/rigg/src/pages/oversikt.rs:316
msgid "ingen disker"
msgstr "nenhuma unidade"

#: crates/rigg/src/pages/oversikt.rs:323
msgid "maks {verdi}"
msgstr "máx. {verdi}"

#: crates/rigg/src/pages/oversikt.rs:324
msgid "uten temperatur"
msgstr "sem leitura de temperatura"

#: crates/rigg/src/pages/oversikt.rs:336
msgid "Disker: samlet hastighet (lesing og skriving), varmeste disk og SMART-helsa.\n{helse}\nSparklinja er siste minutt. Klikk for Disker."
msgstr "Unidades: taxa total de leitura e gravação, unidade mais quente e integridade SMART.\n{helse}\nO minigráfico mostra o último minuto. Clique para abrir Unidades."

#: crates/rigg/src/pages/oversikt.rs:344
msgid "{fail} feil"
msgid_plural "{fail} med feil"
msgstr[0] "{fail} com falha"
msgstr[1] "{fail} com falhas"

#: crates/rigg/src/pages/oversikt.rs:348
msgid "alle OK"
msgstr "tudo OK"

#: crates/rigg/src/pages/oversikt.rs:350
msgid "helse ukjent"
msgstr "integridade desconhecida"

#: crates/rigg/src/pages/oversikt.rs:364
msgid "{u} ned"
msgstr "{u} download"

#: crates/rigg/src/pages/oversikt.rs:368
msgid "{verdi} opp"
msgstr "{verdi} upload"

#: crates/rigg/src/pages/oversikt.rs:369
msgid "Nettverk: mottatt og sendt over de fysiske nettverkskortene."
msgstr "Rede: tráfego recebido e enviado pelos adaptadores físicos de rede."

#: crates/rigg/src/pages/oversikt.rs:415
msgid "Skjermkortet svarer ikke"
msgstr "A GPU não responde"

#: crates/rigg/src/pages/oversikt.rs:417
msgid "siden {s} · tjenesten prøver igjen hvert 10. s"
msgstr "desde {s} · o serviço tenta novamente a cada 10 s"

#: crates/rigg/src/pages/oversikt.rs:418
msgid "tjenesten prøver igjen hvert 10. s"
msgstr "o serviço tenta novamente a cada 10 s"

#: crates/rigg/src/pages/oversikt.rs:422
msgid "Driveren er oppdatert"
msgstr "Driver atualizado"

#: crates/rigg/src/pages/oversikt.rs:422
msgid "start maskinen på nytt for å lese skjermkortet"
msgstr "reinicie o computador para ler os dados da GPU"

#: crates/rigg/src/pages/oversikt.rs:423
msgid "Fant ingen NVIDIA-driver"
msgstr "Nenhum driver NVIDIA encontrado"

#: crates/rigg/src/pages/oversikt.rs:423
msgid "prosessor, minne og disker vises som vanlig"
msgstr "o processador, a memória e as unidades são exibidos normalmente"

#: crates/rigg/src/pages/oversikt.rs:429
msgid "Skjermkortet nedklokker"
msgstr "A GPU está reduzindo a frequência"

#: crates/rigg/src/pages/oversikt.rs:435
msgid "over nedklokkingsgrensen ({verdi})"
msgstr "acima do limite de redução de frequência ({verdi})"

#: crates/rigg/src/pages/oversikt.rs:435
msgid "ved nedklokkingsgrensen ({verdi})"
msgstr "no limite de redução de frequência ({verdi})"

#: crates/rigg/src/pages/oversikt.rs:438 crates/rigg/src/pages/oversikt.rs:447
msgid "over rød grense ({verdi})"
msgstr "acima do limite crítico ({verdi})"

#: crates/rigg/src/pages/oversikt.rs:440 crates/rigg/src/pages/oversikt.rs:449
msgid "over gul grense ({verdi})"
msgstr "acima do limite de aviso ({verdi})"

#: crates/rigg/src/pages/oversikt.rs:453
msgid "Minne {verdi}"
msgstr "Memória {verdi}"

#: crates/rigg/src/pages/oversikt.rs:453
msgid "nesten fullt"
msgstr "quase cheia"

#: crates/rigg/src/pages/oversikt.rs:461
msgid "se SMART"
msgstr "consulte o SMART"

#: crates/rigg/src/pages/oversikt.rs:530
msgid "{status} {detalj}. Klikk for {side}."
msgstr "{status} {detalj}. Clique para abrir {side}."

#: crates/rigg/src/pages/oversikt.rs:548
msgid "Tilstand: {summary}"
msgstr "Status: {summary}"

#: crates/rigg/src/pages/oversikt.rs:590
msgid "Last"
msgstr "Uso"

#: crates/rigg/src/pages/oversikt.rs:613
msgid "Temperaturer"
msgstr "Temperaturas"

#: crates/rigg/src/pages/oversikt.rs:652
msgid "Minne og VRAM"
msgstr "Memória e VRAM"

#: crates/rigg/src/pages/oversikt.rs:687
msgid "Temperatur og effekt"
msgstr "Temperatura e potência"

#: crates/rigg/src/pages/oversikt.rs:696 crates/rigg/src/pages/oversikt.rs:711
msgid "GPU-temperatur"
msgstr "Temperatura da GPU"

#: crates/rigg/src/pages/oversikt.rs:709
msgid "Høyeste GPU-temperatur de siste 5 minuttene"
msgstr "Temperatura máxima da GPU nos últimos 5 minutos"

#: crates/rigg/src/pages/oversikt.rs:722 crates/rigg/src/pages/oversikt.rs:729 crates/rigg/src/pages/oversikt.rs:1061
msgid "GPU-effekt"
msgstr "Potência da GPU"

#: crates/rigg/src/pages/oversikt.rs:747
msgid "Alt driveren og kortet oppgir, på Grafikkort"
msgstr "Todos os dados do driver e da placa estão em Placa de vídeo"

#: crates/rigg/src/pages/oversikt.rs:755
msgid "Kjerneklokke"
msgstr "Frequência do núcleo"

#: crates/rigg/src/pages/oversikt.rs:755
msgid "Minneklokke"
msgstr "Frequência da memória"

#: crates/rigg/src/pages/oversikt.rs:766
msgid "Nå og kortets høyeste (fra driveren)"
msgstr "Frequência atual e máxima da placa (informadas pelo driver)"

#: crates/rigg/src/pages/oversikt.rs:770
msgid "Vifter"
msgstr "Ventoinhas"

#: crates/rigg/src/pages/oversikt.rs:771
msgid "Viftestyring"
msgstr "Controle das ventoinhas"

#: crates/rigg/src/pages/oversikt.rs:773
msgid "Video (enc / dek)"
msgstr "Vídeo (cod. / dec.)"

#: crates/rigg/src/pages/oversikt.rs:774
msgid "Last på maskinvarens videokoder (encoder) og -dekoder (decoder)."
msgstr "Uso do codificador e do decodificador de vídeo por hardware."

#: crates/rigg/src/pages/oversikt.rs:804
msgid "maks 5 min: {verdi}"
msgstr "Máx. 5 min: {verdi}"

#: crates/rigg/src/pages/oversikt.rs:819
msgid " · {verdi} under nedklokking"
msgstr " · {verdi} abaixo do limite de redução de frequência"

#: crates/rigg/src/pages/oversikt.rs:821
msgid " · over nedklokkingsgrensen"
msgstr " · acima do limite de redução de frequência"

#: crates/rigg/src/pages/oversikt.rs:823
msgid " · ved nedklokkingsgrensen"
msgstr " · no limite de redução de frequência"

#: crates/rigg/src/pages/oversikt.rs:827
msgid " · over rød grense ({verdi})"
msgstr " · acima do limite crítico ({verdi})"

#: crates/rigg/src/pages/oversikt.rs:828
msgid " · over gul grense ({verdi})"
msgstr " · acima do limite de aviso ({verdi})"

#: crates/rigg/src/pages/oversikt.rs:840
msgid "Mål"
msgstr "Alvo"

#: crates/rigg/src/pages/oversikt.rs:840
msgid "Nedklokking"
msgstr "Redução de frequência"

#: crates/rigg/src/pages/oversikt.rs:843 crates/rigg/src/pages/oversikt.rs:847
msgid "Avstenging"
msgstr "Desligamento"

#: crates/rigg/src/pages/oversikt.rs:847 crates/rigg/src/pages/oversikt.rs:892
msgid "Nå"
msgstr "Agora"

#: crates/rigg/src/pages/oversikt.rs:848
msgid "Fra {min} til avstenging ({avstenging}). Over målet ({target}) senker kortet klokken litt, ved {nedklokking} tvinger det nedklokking. Gul og rød fyll betyr over varselgrensene {gul} og {red} (Innstillinger › Grafer og sensorer)."
msgstr "De {min} até o desligamento ({avstenging}). Acima do alvo ({target}), a placa reduz um pouco a frequência. Em {nedklokking}, a redução é forçada. O preenchimento amarelo e vermelho indica que os limites {gul} e {red} foram ultrapassados (Configurações › Gráficos e sensores)."

#: crates/rigg/src/pages/oversikt.rs:852 crates/rigg/src/pages/oversikt.rs:897 crates/rigg/src/pages/oversikt.rs:939
msgid "Ikke støttet"
msgstr "Sem suporte"

#: crates/rigg/src/pages/oversikt.rs:866
msgid "{trekk} av {grense}"
msgstr "{trekk} de {grense}"

#: crates/rigg/src/pages/oversikt.rs:873
msgid "Grense (standard)"
msgstr "Limite (padrão)"

#: crates/rigg/src/pages/oversikt.rs:873
msgid "Grense"
msgstr "Limite"

#: crates/rigg/src/pages/oversikt.rs:875
msgid "Standard"
msgstr "Padrão"

#: crates/rigg/src/pages/oversikt.rs:879
msgid " Grensen kan settes fra {min} til {maks}."
msgstr " O limite pode ser ajustado entre {min} e {maks}."

#: crates/rigg/src/pages/oversikt.rs:884 crates/rigg/src/pages/oversikt.rs:892
msgid "Kortets maks"
msgstr "Máximo da placa"

#: crates/rigg/src/pages/oversikt.rs:893
msgid "Trekket nå mot effektgrensen, snitt fra energitelleren. Gult fyll betyr at kortet er ved grensen og holder igjen.{range}"
msgstr "Consumo atual em relação ao limite de potência, calculado pela média do contador de energia. O preenchimento amarelo indica que a placa atingiu o limite e está reduzindo o desempenho.{range}"

#: crates/rigg/src/pages/oversikt.rs:895
msgid "{verdi} av grensen"
msgstr "{verdi} do limite"

#: crates/rigg/src/pages/oversikt.rs:906
msgid "ingen begrensning"
msgstr "sem limitação"

#: crates/rigg/src/pages/oversikt.rs:913
msgid "P0 er full ytelse, P8 er dyp tomgang. Kortet bytter selv."
msgstr "P0 é o desempenho máximo e P8 é o repouso profundo. A placa alterna os estados automaticamente."

#: crates/rigg/src/pages/oversikt.rs:915
msgid "\nBegrensninger nå: {full}."
msgstr "\nLimitações atuais: {full}."

#: crates/rigg/src/pages/oversikt.rs:917
msgid "\nKlokken begrenses nå av: {x}."
msgstr "\nA frequência está limitada por: {x}."

#: crates/rigg/src/pages/oversikt.rs:920
msgid "\nI P8 leses ikke begrensningene (kallet koster 25 ms og vekker kortet)."
msgstr "\nAs causas de limitação não são consultadas em P8 (a consulta leva 25 ms e desperta a placa)."

#: crates/rigg/src/pages/oversikt.rs:937
msgid "{verdi1} · {verdi2} o/min"
msgstr "{verdi1} · {verdi2} o/min"

#: crates/rigg/src/pages/oversikt.rs:944
msgid "Auto · driveren styrer"
msgstr "Auto · controle pelo driver"

#: crates/rigg/src/pages/oversikt.rs:944
msgid "Driveren styrer viftene etter temperaturen, som uten appen."
msgstr "O driver controla as ventoinhas de acordo com a temperatura, como faria sem o aplicativo."

#: crates/rigg/src/pages/oversikt.rs:945
msgid "Manuell · satt utenfor appen"
msgstr "Manual · definido fora do aplicativo"

#: crates/rigg/src/pages/oversikt.rs:945
msgid "Minst én vifte er satt til fast fart utenfor appen."
msgstr "Pelo menos uma ventoinha foi definida com velocidade fixa fora do aplicativo."

#: crates/rigg/src/pages/oversikt.rs:946
msgid "Viftestyringen er ikke lest ennå, eller kortet oppgir den ikke."
msgstr "O modo de controle das ventoinhas ainda não foi lido ou a placa não o informa."

#: crates/rigg/src/pages/oversikt.rs:955
msgid "PCIe-lenken mellom kortet og hovedkortet."
msgstr "O link PCIe entre a placa de vídeo e a placa-mãe."

#: crates/rigg/src/pages/oversikt.rs:1064
msgid "Disk-I/O"
msgstr "E/S de disco"

#: crates/rigg/src/pages/oversikt.rs:1096
msgid "Tidsvindu for grafene på Oversikt"
msgstr "Intervalo dos gráficos da Visão geral"
