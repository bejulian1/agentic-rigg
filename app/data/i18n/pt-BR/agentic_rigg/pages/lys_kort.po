#: crates/rigg/src/pages/lys_kort.rs:112 crates/rigg/src/pages/lys_kort.rs:602
msgid "Pusting"
msgstr "Respiração"

#: crates/rigg/src/pages/lys_kort.rs:113 crates/rigg/src/pages/lys_kort.rs:603
msgid "Regnbue"
msgstr "Arco-íris"

#: crates/rigg/src/pages/lys_kort.rs:114 crates/rigg/src/pages/lys_kort.rs:604
msgid "Fargesyklus"
msgstr "Ciclo de cores"

#: crates/rigg/src/pages/lys_kort.rs:132
msgid "Lysstyringen er opptatt eller tilhører et annet vindu."
msgstr "O controle da iluminação está ocupado ou pertence a outra janela."

#: crates/rigg/src/pages/lys_kort.rs:133
msgid "Lysprøven finnes ikke lenger eller fristen er ute."
msgstr "O teste da iluminação não está mais ativo ou expirou."

#: crates/rigg/src/pages/lys_kort.rs:134
msgid "Nye lysendringer er sperret. Kontroller status og avklar eventuell gjenoppretting."
msgstr "Novas alterações de iluminação estão bloqueadas. Verifique o status e resolva qualquer restauração pendente."

#: crates/rigg/src/pages/lys_kort.rs:135
msgid "RGB-tillatelsen for dette kortet kunne ikke bekreftes."
msgstr "Não foi possível verificar a permissão RGB para esta placa."

#: crates/rigg/src/pages/lys_kort.rs:136
msgid "Det valgte kortet er ikke tilgjengelig."
msgstr "A placa selecionada está indisponível."

#: crates/rigg/src/pages/lys_kort.rs:137 crates/rigg/src/pages/lys_kort.rs:1642
msgid "RGB-hjelperen støtter ikke dette lysvalget."
msgstr "O auxiliar RGB não oferece suporte a este ajuste de iluminação."

#: crates/rigg/src/pages/lys_kort.rs:138
msgid "RGB-hjelperen avviste forespørselen. Les status før du prøver igjen."
msgstr "O auxiliar RGB rejeitou a solicitação. Verifique o status antes de tentar novamente."

#: crates/rigg/src/pages/lys_kort.rs:141
msgid "RGB-forespørselen mislyktes. Sjekk status og se på kortet før du prøver igjen."
msgstr "A solicitação RGB falhou. Verifique o status e observe a placa antes de tentar novamente."

#: crates/rigg/src/pages/lys_kort.rs:162
msgid "Avlesning av kortlyset mislyktes. Nye lysendringer er sperret."
msgstr "Não foi possível ler a iluminação. Novas alterações estão bloqueadas."

#: crates/rigg/src/pages/lys_kort.rs:165
msgid "Gjenopprettingen er bekreftet av deg. Effektmodusen er fortsatt ikke maskinelt avlest."
msgstr "Você confirmou a restauração. O modo do efeito ainda não foi lido do hardware."

#: crates/rigg/src/pages/lys_kort.rs:169
msgid "Farge og lysstyrke samsvarer etter tilbakeføring. Se på kortet før du bekrefter gjenopprettingen."
msgstr "A cor e o brilho correspondem após a reversão. Observe a placa antes de confirmar a restauração."

#: crates/rigg/src/pages/lys_kort.rs:170
msgid "Tilbakeføringen samsvarer ikke med avlesningen. Nye fargeendringer er sperret."
msgstr "A leitura não corresponde ao estado esperado após a reversão. Novas alterações de cor estão bloqueadas."

#: crates/rigg/src/pages/lys_kort.rs:171 crates/rigg/src/pages/lys_kort.rs:172
msgid "Gjenopprettingen er uavklart. Nye fargeendringer er sperret."
msgstr "A restauração não foi resolvida. Novas alterações de cor estão bloqueadas."

#: crates/rigg/src/pages/lys_kort.rs:178
msgid "Gjenopprett lagret Av"
msgstr "Restaurar a opção Desligado salva"

#: crates/rigg/src/pages/lys_kort.rs:178
msgid "Gjenopprett lagret lys"
msgstr "Restaurar iluminação salva"

#: crates/rigg/src/pages/lys_kort.rs:329
msgid "Svart med 0 %, holdt mens appen er åpen"
msgstr "Preto com 0 %, mantido enquanto o app estiver aberto"

#: crates/rigg/src/pages/lys_kort.rs:330
msgid "Svart med 100 %"
msgstr "Preto com 100 %"

#: crates/rigg/src/pages/lys_kort.rs:331
msgid "Svart med 0 %"
msgstr "Preto com 0 %"

#: crates/rigg/src/pages/lys_kort.rs:332
msgid "Valgt farge med 0 %"
msgstr "Cor escolhida com 0 %"

#: crates/rigg/src/pages/lys_kort.rs:333
msgid "Nesten svart (#010101) med 1 %"
msgstr "Quase preto (#010101) com 1 %"

#: crates/rigg/src/pages/lys_kort.rs:363 crates/rigg/src/pages/lys_kort.rs:366
msgid "Av"
msgstr "Desativado"

#: crates/rigg/src/pages/lys_kort.rs:368
msgid "fast farge {farge} · {styrke}"
msgstr "cor fixa {farge} · {styrke}"

#: crates/rigg/src/pages/lys_kort.rs:369
msgid "Ingen kjent innstilling"
msgstr "Nenhuma configuração conhecida"

#: crates/rigg/src/pages/lys_kort.rs:386 crates/rigg/src/pages/lys_kort.rs:1556
msgid "{farge} · rå lysstyrke {styrke}, utenfor støttet område"
msgstr "{farge} · brilho bruto {styrke}, fora da faixa suportada"

#: crates/rigg/src/pages/lys_kort.rs:387
msgid "et lys som ikke kunne leses"
msgstr "uma iluminação que não pôde ser lida"

#: crates/rigg/src/pages/lys_kort.rs:557
msgid "Lys på kortet"
msgstr "Iluminação da placa"

#: crates/rigg/src/pages/lys_kort.rs:562 crates/rigg/src/pages/lys_kort.rs:1443
msgid "Ikke aktivert"
msgstr "Não ativado"

#: crates/rigg/src/pages/lys_kort.rs:596
msgid "Kortlys på eller av"
msgstr "Iluminação da placa ligada ou desligada"

#: crates/rigg/src/pages/lys_kort.rs:597
msgid "Kortlys"
msgstr "Iluminação da placa"

#: crates/rigg/src/pages/lys_kort.rs:601
msgid "Fast farge"
msgstr "Cor fixa"

#: crates/rigg/src/pages/lys_kort.rs:607
msgid "Fysisk lysmodus"
msgstr "Modo de iluminação física"

#: crates/rigg/src/pages/lys_kort.rs:611
msgid "Modus"
msgstr "Modo"

#: crates/rigg/src/pages/lys_kort.rs:633
msgid "Farge på kortet, seks heksadesimale siffer"
msgstr "Cor da placa, seis dígitos hexadecimais"

#: crates/rigg/src/pages/lys_kort.rs:640 crates/rigg/src/pages/lys_kort.rs:641
msgid "Velg farge …"
msgstr "Escolher cor…"

#: crates/rigg/src/pages/lys_kort.rs:647
msgid "Hurtigfarger"
msgstr "Cores rápidas"

#: crates/rigg/src/pages/lys_kort.rs:679
msgid "Farge"
msgstr "Cor"

#: crates/rigg/src/pages/lys_kort.rs:689 crates/rigg/src/pages/lys_kort.rs:699
msgid "Kortlysets lysstyrke i prosent"
msgstr "Brilho da iluminação da placa em porcentagem"

#: crates/rigg/src/pages/lys_kort.rs:705
msgid "Lysstyrke"
msgstr "Brilho"

#: crates/rigg/src/pages/lys_kort.rs:708
msgid "Behold også etter at appen lukkes"
msgstr "Manter depois que o app for fechado"

#: crates/rigg/src/pages/lys_kort.rs:736
msgid "Bruk"
msgstr "Aplicar"

#: crates/rigg/src/pages/lys_kort.rs:739
msgid "Gjenopprett utgangspunkt"
msgstr "Restaurar ajustes originais"

#: crates/rigg/src/pages/lys_kort.rs:742 crates/rigg/src/pages/lys_kort.rs:1706
msgid "Avslutt lysstyring"
msgstr "Liberar controle da iluminação"

#: crates/rigg/src/pages/lys_kort.rs:743
msgid "Bekreft lyset …"
msgstr "Confirmar a iluminação…"

#: crates/rigg/src/pages/lys_kort.rs:759
msgid "Behold"
msgstr "Manter"

#: crates/rigg/src/pages/lys_kort.rs:760
msgid "Rull tilbake"
msgstr "Reverter"

#: crates/rigg/src/pages/lys_kort.rs:770
msgid "Avlesning: ukjent. Kortet er ikke undersøkt av denne visningen."
msgstr "Leitura desconhecida. Esta tela não consultou a placa."

#: crates/rigg/src/pages/lys_kort.rs:774
msgid "Farge og lysstyrke kan leses tilbake. Effektmodusen kan ikke leses; en visuell bekreftelse er din observasjon."
msgstr "É possível ler a cor e o brilho, mas não o modo do efeito. A confirmação visual se baseia no que você vê."

#: crates/rigg/src/pages/lys_kort.rs:775
msgid "Agentic HW Monitor støtter Palit GeForce RTX 2080 Super JetStream via den separate RGB-hjelperen."
msgstr "O Agentic HW Monitor é compatível com a Palit GeForce RTX 2080 Super JetStream por meio do auxiliar RGB separado."

#: crates/rigg/src/pages/lys_kort.rs:784 crates/rigg/src/pages/lys_kort.rs:786
msgid "Skrivemåte for «Av»"
msgstr "Forma de gravar “Desligado”"

#: crates/rigg/src/pages/lys_kort.rs:790
msgid "Sjekk igjen"
msgstr "Verificar novamente"

#: crates/rigg/src/pages/lys_kort.rs:791
msgid "Åpne Innstillinger › Skjermkortstyring"
msgstr "Abrir Configurações › Controle da GPU"

#: crates/rigg/src/pages/lys_kort.rs:792 crates/rigg/src/pages/lys_kort.rs:1661 crates/rigg/src/pages/lys_kort.rs:2260
msgid "Jeg ser én fast farge"
msgstr "Vejo uma cor fixa"

#: crates/rigg/src/pages/lys_kort.rs:795
msgid "Tilbake til fabrikklyset"
msgstr "Voltar à iluminação de fábrica"

#: crates/rigg/src/pages/lys_kort.rs:799
msgid "Detaljer og feilsøking"
msgstr "Detalhes e solução de problemas"

#: crates/rigg/src/pages/lys_kort.rs:916
msgid "Velg farge"
msgstr "Escolher cor"

#: crates/rigg/src/pages/lys_kort.rs:1021
msgid "Jeg ser at lyset på kortet er slukket."
msgstr "Vejo que a iluminação da placa está apagada."

#: crates/rigg/src/pages/lys_kort.rs:1022
msgid "Jeg ser at lyset viser den forventede faste fargen."
msgstr "Vejo a cor fixa esperada na placa."

#: crates/rigg/src/pages/lys_kort.rs:1024 crates/rigg/src/pages/lys_kort.rs:2024
msgid "Bekreft lyset på kortet"
msgstr "Confirmar iluminação da placa"

#: crates/rigg/src/pages/lys_kort.rs:1024
msgid "Forventet lys: {lys}.\n\nSe på det fysiske kortet. Samsvarende fargeverdier alene er ikke nok. Hjelperen leser verdiene på nytt før observasjonen din lagres."
msgstr "Iluminação esperada: {lys}.\n\nObserve a placa física. A correspondência dos valores de cor não basta. O auxiliar lê os valores novamente antes de salvar sua observação."

#: crates/rigg/src/pages/lys_kort.rs:1024 crates/rigg/src/pages/lys_kort.rs:2046
msgid "Bekreft min observasjon"
msgstr "Confirmar minha observação"

#: crates/rigg/src/pages/lys_kort.rs:1030 crates/rigg/src/pages/lys_kort.rs:1035
msgid "Lystilstanden er endret"
msgstr "O estado da iluminação mudou"

#: crates/rigg/src/pages/lys_kort.rs:1030 crates/rigg/src/pages/lys_kort.rs:1035
msgid "Kontroller det nye forventede lyset og åpne bekreftelsen på nytt."
msgstr "Verifique a nova iluminação esperada e reabra a confirmação."

#: crates/rigg/src/pages/lys_kort.rs:1276 crates/rigg/src/pages/lys_kort.rs:1688
msgid "Kortet viser ikke det lagrede utgangspunktet"
msgstr "A placa não mostra a referência salva"

#: crates/rigg/src/pages/lys_kort.rs:1283
msgid "Kunne ikke lese kortlyset"
msgstr "Não foi possível ler a iluminação da placa"

#: crates/rigg/src/pages/lys_kort.rs:1284 crates/rigg/src/pages/lys_kort.rs:1329
msgid "Valget ble ikke lagret som varig"
msgstr "A escolha não foi salva como permanente"

#: crates/rigg/src/pages/lys_kort.rs:1285 crates/rigg/src/pages/lys_kort.rs:1333
msgid "«Av» holdes ikke"
msgstr "“Desligado” não está sendo mantido"

#: crates/rigg/src/pages/lys_kort.rs:1286 crates/rigg/src/pages/lys_kort.rs:1673
msgid "Lysendringen ble ikke fullført"
msgstr "A alteração da iluminação não foi concluída"

#: crates/rigg/src/pages/lys_kort.rs:1330
msgid "Lyset er beholdt, men ikke lagret som kortets utgangspunkt. Trykk «Bruk» og «Behold» igjen for å prøve på nytt."
msgstr "A iluminação foi mantida, mas não salva como referência da placa. Pressione “Aplicar” e “Manter” de novo para tentar outra vez."

#: crates/rigg/src/pages/lys_kort.rs:1334
msgid "«Av» er satt, men skrives ikke på nytt mens appen er åpen. Trykk «Bruk» igjen for å starte det."
msgstr "“Desligado” está definido, mas não é regravado enquanto o app estiver aberto. Pressione “Aplicar” de novo para iniciar."

#: crates/rigg/src/pages/lys_kort.rs:1422 crates/rigg/src/pages/lys_kort.rs:2262
msgid "Bekreft kortets første lysopptak"
msgstr "Confirme a iluminação inicial da placa"

#: crates/rigg/src/pages/lys_kort.rs:1422 crates/rigg/src/pages/lys_kort.rs:1679 crates/rigg/src/pages/lys_kort.rs:2262
msgid "Lyset må avklares"
msgstr "A iluminação precisa ser resolvida"

#: crates/rigg/src/pages/lys_kort.rs:1424
msgid "Se på kortet. Bekreft bare hvis det viser én fast farge."
msgstr "Observe a placa. Confirme apenas se ela estiver acesa em uma única cor fixa."

#: crates/rigg/src/pages/lys_kort.rs:1426
msgid "Behold lyset du ser, eller gjenopprett det lagrede lyset."
msgstr "Mantenha a iluminação que você vê ou restaure a iluminação salva."

#: crates/rigg/src/pages/lys_kort.rs:1429
msgid "Venter …"
msgstr "Aguardando…"

#: crates/rigg/src/pages/lys_kort.rs:1431
msgid "Frakoblet"
msgstr "Desconectado"

#: crates/rigg/src/pages/lys_kort.rs:1433
msgid "Kortet er utilgjengelig"
msgstr "Placa indisponível"

#: crates/rigg/src/pages/lys_kort.rs:1435
msgid "Ikke klar"
msgstr "Não pronta"

#: crates/rigg/src/pages/lys_kort.rs:1437
msgid "Må oppdateres"
msgstr "Precisa de atualização"

#: crates/rigg/src/pages/lys_kort.rs:1439 crates/rigg/src/pages/lys_kort.rs:1488
msgid "Ikke støttet"
msgstr "Sem suporte"

#: crates/rigg/src/pages/lys_kort.rs:1441 crates/rigg/src/pages/lys_kort.rs:1490
msgid "Venter på enhet"
msgstr "Aguardando dispositivo"

#: crates/rigg/src/pages/lys_kort.rs:1445
msgid "Prøve pågår"
msgstr "Teste em andamento"

#: crates/rigg/src/pages/lys_kort.rs:1447 crates/rigg/src/pages/lys_kort.rs:2255
msgid "Må avklares"
msgstr "Requer resolução"

#: crates/rigg/src/pages/lys_kort.rs:1449
msgid "Avviker"
msgstr "Diverge"

#: crates/rigg/src/pages/lys_kort.rs:1451
msgid "Effekt aktiv"
msgstr "Efeito ativo"

#: crates/rigg/src/pages/lys_kort.rs:1453
msgid "Lyset er av"
msgstr "Iluminação desligada"

#: crates/rigg/src/pages/lys_kort.rs:1455
msgid "Klar"
msgstr "Pronto"

#: crates/rigg/src/pages/lys_kort.rs:1462
msgid "Simulerte RGB-data · {status}"
msgstr "Dados RGB simulados · {status}"

#: crates/rigg/src/pages/lys_kort.rs:1473
msgid "Venter på svar. Ingen ny endring kan sendes nå."
msgstr "Aguardando resposta. Não é possível enviar novas alterações agora."

#: crates/rigg/src/pages/lys_kort.rs:1475
msgid "Forbindelsen til tjenesten er brutt. Hjelperen håndterer eventuell tilbakeføring."
msgstr "A conexão com o serviço foi perdida. O auxiliar fará a reversão se necessário."

#: crates/rigg/src/pages/lys_kort.rs:1480
msgid "Kortet er ikke tilgjengelig. Nye lysendringer og aktivering er sperret."
msgstr "A placa está indisponível. A ativação e alterações de iluminação estão bloqueadas."

#: crates/rigg/src/pages/lys_kort.rs:1484
msgid "Et annet vindu styrer kortlyset. Her vises bare status."
msgstr "Outra janela controla a iluminação da placa. Aqui só o status é exibido."

#: crates/rigg/src/pages/lys_kort.rs:1486
msgid "Hele kortlyset er én sone. Ingenting sendes før du trykker «Bruk»."
msgstr "A iluminação da placa é uma única zona. Nada é enviado até você tocar em “Aplicar”."

#: crates/rigg/src/pages/lys_kort.rs:1492 crates/rigg/src/pages/lys_kort.rs:1498
msgid "RGB-hjelperen er ikke klar."
msgstr "O serviço RGB não está pronto."

#: crates/rigg/src/pages/lys_kort.rs:1494
msgid "Skjermkortstyring er slått av."
msgstr "O controle da GPU está desativado."

#: crates/rigg/src/pages/lys_kort.rs:1496
msgid "Tillatelsen gjelder et annet skjermkort."
msgstr "A permissão se aplica a outra placa de vídeo."

#: crates/rigg/src/pages/lys_kort.rs:1511
msgid "Venter på kortets PCI-adresse og UUID."
msgstr "Aguardando o endereço PCI e o UUID da placa."

#: crates/rigg/src/pages/lys_kort.rs:1512
msgid "Valgt kort: {pci}"
msgstr "Placa selecionada: {pci}"

#: crates/rigg/src/pages/lys_kort.rs:1517
msgid "{effekt} er valgt. Nå vises bare startfargen; animasjonen starter først etter «Behold»."
msgstr "{effekt} foi selecionado. Só a cor inicial é exibida; a animação começa ao selecionar «Manter»."

#: crates/rigg/src/pages/lys_kort.rs:1521
msgid "{effekt} er aktiv på hele kortlyset. Velg en annen modus eller farge og trykk «Bruk» for å bytte, eller «Stopp effekten» for å gå tilbake til utgangspunktet."
msgstr "{effekt} está ativo em toda a iluminação da placa. Escolha outro modo ou cor e pressione “Aplicar” para trocar, ou “Parar o efeito” para voltar ao estado inicial."

#: crates/rigg/src/pages/lys_kort.rs:1527
msgid "Pusting varierer lysstyrken i fargen du velger."
msgstr "«Respiração» varia o brilho da cor escolhida."

#: crates/rigg/src/pages/lys_kort.rs:1529
msgid "Regnbue går gjennom hele fargespekteret fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "«Arco-íris» percorre todo o espectro a partir do tom escolhido. Tons de cinza começam no vermelho."

#: crates/rigg/src/pages/lys_kort.rs:1532
msgid "Fargesyklus veksler mellom seks tydelige fargetoner fra fargetonen du velger. Gråtoner starter på rødt."
msgstr "«Ciclo de cores» alterna entre seis tons distintos a partir do tom escolhido. Tons de cinza começam no vermelho."

#: crates/rigg/src/pages/lys_kort.rs:1535
msgid "{detalj} Først prøves startfargen; «Behold» starter animasjonen på én lyssone."
msgstr "{detalj} A cor inicial é testada primeiro. «Manter» inicia a animação em uma zona."

#: crates/rigg/src/pages/lys_kort.rs:1544
msgid "RGB-hjelperen meldte en driftsfeil. Kontroller lyset før du fortsetter."
msgstr "O auxiliar RGB relatou um erro de execução. Verifique a iluminação antes de continuar."

#: crates/rigg/src/pages/lys_kort.rs:1561
msgid "Lagret utgangspunkt: {lys}. Dette er ikke en ny avlesning."
msgstr "Estado inicial salvo: {lys}. Esta não é uma nova leitura."

#: crates/rigg/src/pages/lys_kort.rs:1564
msgid "Sist lest fra kortet: {lys}. Effektmodus: ukjent."
msgstr "Última leitura da placa: {lys}. Modo do efeito: desconhecido."

#: crates/rigg/src/pages/lys_kort.rs:1566
msgid "Avlesning: ukjent. Effektmodusen er ikke bekreftet."
msgstr "Leitura desconhecida. O modo do efeito não foi confirmado."

#: crates/rigg/src/pages/lys_kort.rs:1572
msgid "Sist bekreftede valg: {lys}. Valget er ikke bevis på avlest effektmodus."
msgstr "Última opção confirmada: {lys}. Isso não comprova a leitura do modo do efeito."

#: crates/rigg/src/pages/lys_kort.rs:1584
msgid "Kontroller startfargen på kortet. «Behold» starter animasjonen; «Rull tilbake» eller fristutløp går tilbake til utgangspunktet."
msgstr "Confira a cor inicial na placa. «Manter» inicia a animação. O estado inicial é restaurado ao selecionar «Reverter» ou quando o prazo expira."

#: crates/rigg/src/pages/lys_kort.rs:1586
msgid "Se på det fysiske kortet før du beholder endringen. Uten bekreftelse forsøker hjelperen å rulle tilbake."
msgstr "Observe a placa física antes de manter a alteração. Sem confirmação, o auxiliar tentará revertê-la."

#: crates/rigg/src/pages/lys_kort.rs:1599
msgid "fristen styres av hjelperen"
msgstr "prazo gerido pelo auxiliar"

#: crates/rigg/src/pages/lys_kort.rs:1601
msgid "fristen er ute; venter på status"
msgstr "prazo expirado; aguardando o status"

#: crates/rigg/src/pages/lys_kort.rs:1603
msgid "bekreft innen {tid}"
msgstr "confirme em até {tid}"

#: crates/rigg/src/pages/lys_kort.rs:1634
msgid "Oppgi en gyldig fargekode på seks tegn, for eksempel #3A7BF0."
msgstr "Informe um código de cor hexadecimal válido de seis caracteres, por exemplo #3A7BF0."

#: crates/rigg/src/pages/lys_kort.rs:1638
msgid "Bekreft eller rull tilbake prøven som pågår før du bruker en ny innstilling."
msgstr "Mantenha ou reverta o teste em andamento antes de aplicar uma nova configuração."

#: crates/rigg/src/pages/lys_kort.rs:1661 crates/rigg/src/pages/lys_kort.rs:2260
msgid "Behold lyset jeg ser"
msgstr "Manter a luz que vejo"

#: crates/rigg/src/pages/lys_kort.rs:1664
msgid "Avlest lys: {lys}"
msgstr "Iluminação detectada: {lys}"

#: crates/rigg/src/pages/lys_kort.rs:1666
msgid "Lagret lys: {lys}"
msgstr "Iluminação salva: {lys}"

#: crates/rigg/src/pages/lys_kort.rs:1669
msgid "Fabrikklys: {lys}"
msgstr "Iluminação de fábrica: {lys}"

#: crates/rigg/src/pages/lys_kort.rs:1676
msgid "Se på kortet og bekreft lyset"
msgstr "Olhe a placa e confirme a iluminação"

#: crates/rigg/src/pages/lys_kort.rs:1677
msgid "Kortet er satt tilbake til {lys}. Hjelperen kan bare lese fargeverdiene, ikke hva kortet faktisk lyser. Bekreft når kortet viser dette, eller gjenopprett på nytt."
msgstr "A placa voltou para {lys}. O auxiliar só consegue ler os valores de cor, não o que a placa realmente mostra. Confirme quando a placa mostrar isso ou restaure novamente."

#: crates/rigg/src/pages/lys_kort.rs:1681
msgid "RGB-hjelperen meldte en driftsfeil. Gjenopprett utgangspunktet og kontroller lyset før du fortsetter."
msgstr "O auxiliar RGB relatou um erro de execução. Restaure o estado inicial e verifique a iluminação antes de continuar."

#: crates/rigg/src/pages/lys_kort.rs:1686
msgid "Utgangspunktet er {lys}."
msgstr "O estado inicial é {lys}."

#: crates/rigg/src/pages/lys_kort.rs:1690
msgid "Kortet viser {lest}. Velg «{knapp}» for å gjenopprette {lys}, og bekreft det du ser."
msgstr "A placa mostra {lest}. Selecione “{knapp}” para restaurar {lys} e confirme o que você vê."

#: crates/rigg/src/pages/lys_kort.rs:1696
msgid "Gjenopprett på nytt"
msgstr "Restaurar novamente"

#: crates/rigg/src/pages/lys_kort.rs:1702 crates/rigg/src/pages/lys_kort.rs:1980
msgid "Stopp effekten"
msgstr "Parar o efeito"

#: crates/rigg/src/pages/lys_kort.rs:1704 crates/rigg/src/pages/lys_kort.rs:2083
msgid "Slutt å holde av"
msgstr "Parar de manter desligado"

#: crates/rigg/src/pages/lys_kort.rs:1708
msgid "Kortet går tilbake til det lagrede utgangspunktet, og appen slipper lyset."
msgstr "A placa volta ao estado inicial salvo e o app libera a iluminação."

#: crates/rigg/src/pages/lys_kort.rs:1715
msgid "det lagrede utgangspunktet"
msgstr "o estado inicial salvo"

#: crates/rigg/src/pages/lys_kort.rs:1720
msgid "Effekter kjører bare mens appen er åpen. Når appen lukkes, stopper effekten og kortet går tilbake til {lys}."
msgstr "Os efeitos só rodam enquanto o app está aberto. Quando o app é fechado, o efeito para e a placa volta para {lys}."

#: crates/rigg/src/pages/lys_kort.rs:1724
msgid "«Av» er kortets utgangspunkt og skrives ikke tilbake når appen lukkes. Mens appen er åpen, skrives det på nytt hvert 2. sekund, fordi kortet ellers kan gå tilbake til fabrikklyset av seg selv. Det kan også skje etter at appen er lukket."
msgstr "“Desligado” é a referência da placa e não é regravado quando o app fecha. Enquanto o app estiver aberto, é regravado a cada 2 segundos, porque senão a placa pode voltar sozinha à iluminação de fábrica. Isso também pode acontecer depois que o app for fechado."

#: crates/rigg/src/pages/lys_kort.rs:1726
msgid "«Av» er kortets utgangspunkt, men skrives ikke på nytt nå. Trykk «Bruk» for å holde det mens appen er åpen."
msgstr "“Desligado” é a referência da placa, mas não está sendo regravado agora. Pressione “Aplicar” para mantê-lo enquanto o app estiver aberto."

#: crates/rigg/src/pages/lys_kort.rs:1729
msgid "«Av» blir kortets utgangspunkt etter «Behold» og skrives ikke tilbake når appen lukkes. Mens appen er åpen, skrives det på nytt hvert 2. sekund, fordi kortet ellers kan gå tilbake til fabrikklyset av seg selv. Det kan også skje etter at appen er lukket."
msgstr "Depois de “Manter”, “Desligado” passa a ser a referência da placa e não é regravado quando o app fecha. Enquanto o app estiver aberto, é regravado a cada 2 segundos, porque senão a placa pode voltar sozinha à iluminação de fábrica. Isso também pode acontecer depois que o app for fechado."

#: crates/rigg/src/pages/lys_kort.rs:1731
msgid "«Av» skrives på nytt hvert 2. sekund mens appen er åpen, fordi kortet ellers kan gå tilbake til fabrikklyset av seg selv. Når appen lukkes, går kortet tilbake til {lys}."
msgstr "“Desligado” é regravado a cada 2 segundos enquanto o app estiver aberto, porque senão a placa pode voltar sozinha à iluminação de fábrica. Quando o app fecha, a placa volta para {lys}."

#: crates/rigg/src/pages/lys_kort.rs:1733
msgid "Etter «Behold» blir valget kortets utgangspunkt og skrives ikke tilbake når appen lukkes. Om kortet selv beholder lyset etter omstart, er ikke verifisert."
msgstr "Depois de “Manter”, a escolha vira o estado inicial da placa e não é revertida quando o app é fechado. Não foi verificado se a própria placa mantém a iluminação após reiniciar."

#: crates/rigg/src/pages/lys_kort.rs:1735
msgid "Når appen lukkes, går kortet tilbake til {lys}."
msgstr "Quando o app é fechado, a placa volta para {lys}."

#: crates/rigg/src/pages/lys_kort.rs:1744
msgid "Fabrikklyset: {lys}. Prøves som et vanlig valg; «Behold» gjør det til utgangspunktet igjen."
msgstr "Iluminação de fábrica: {lys}. É testada como uma escolha normal; “Manter” a torna o estado inicial de novo."

#: crates/rigg/src/pages/lys_kort.rs:1827
msgid "Avbryt"
msgstr "Cancelar"
