msgstr "Sensorerna visas när tjänsten har skickat den första mätningen."

#: crates/rigg/src/settings/logging.rs:91
msgid "Trådene (last og klokke per tråd) er med når du logger alle sensorene."
msgstr "Trådarna (belastning och klocka per tråd) tas med när du loggar alla sensorer."

