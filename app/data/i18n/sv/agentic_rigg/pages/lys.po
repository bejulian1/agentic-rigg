msgid "Kortet i 3D. Dra for å vri."
msgstr "Kortet i 3D. Dra för att vrida."

#: crates/rigg/src/pages/lys.rs:842
msgid "Flatt kort sett forfra. Bruker minst ressurser."
msgstr "Platt kort sett framifrån. Använder minst resurser."

