#: crates/rigg/src/pages/kontroller.rs:622
msgid "Hent fyller utkastet med verdiene fra profilen. Ingenting sendes til kortet."
msgstr "Läs in fyller utkastet med värdena från profilen. Ingenting skickas till kortet."

#: crates/rigg/src/pages/kontroller.rs:628
msgid "Begrensninger"
msgstr "Begränsningar"

#: crates/rigg/src/pages/kontroller.rs:640
msgid "Funksjonsstøtte på kortet"
msgstr "Funktionsstöd på kortet"

#: crates/rigg/src/pages/kontroller.rs:644
