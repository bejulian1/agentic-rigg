msgstr "Spänningsoffset"

#: crates/rigg/src/pages/kontroller.rs:644
msgid "Spenningsstyring er ikke implementert i appen."
msgstr "Spänningsstyrning är inte implementerad i appen."

#: crates/rigg/src/pages/kontroller.rs:645
msgid "Klokkekurven (V/F)"
msgstr "Klockkurvan (V/F)"

#: crates/rigg/src/pages/kontroller.rs:645
msgid "Redigering av spennings-/klokkekurven er ikke implementert. GPU-justering bruker offset der driveren støtter det."
msgstr "Redigering av spännings-/klockkurvan är inte implementerad. GPU-justering använder offset där drivrutinen stöder det."

#: crates/rigg/src/pages/kontroller.rs:646
msgid "Låst minneklokke"
msgstr "Låst minnesklocka"

#: crates/rigg/src/pages/kontroller.rs:646
msgid "Fastlåsing av minneklokken er ikke implementert. Minnejustering bruker offset der driveren støtter det."
msgstr "Låsning av minnesklockan är inte implementerad. Minnesjustering använder offset där drivrutinen stöder det."

#: crates/rigg/src/pages/kontroller.rs:647
msgid "Viftestopp (0 %)"
msgstr "Fläktstopp (0 %)"

#: crates/rigg/src/pages/kontroller.rs:647
msgid "Egen viftestopp er ikke implementert. Manuell fart følger driverens område; automatisk viftestopp avhenger av kort og driver."
msgstr "Eget fläktstopp är inte implementerat. Manuell hastighet följer drivrutinens intervall; automatiskt fläktstopp beror på kort och drivrutin."

#: crates/rigg/src/pages/kontroller.rs:654
msgid "Avansert · kortets grenser og funksjoner"
msgstr "Avancerat · kortets gränser och funktioner"

#: crates/rigg/src/pages/kontroller.rs:666
msgid "Forkast utkast"
msgstr "Förkasta utkastet"

#: crates/rigg/src/pages/kontroller.rs:667
msgid "Tilbake til det kortet har. Utkastet slettes (Ctrl+Z angrer)."
msgstr "Tillbaka till det som kortet har. Utkastet tas bort (Ctrl+Z ångrar)."

#: crates/rigg/src/pages/kontroller.rs:668
msgid "Bruk"
msgstr "Verkställ"

#: crates/rigg/src/pages/kontroller.rs:716
msgid "Effektgrensen er nådd, eller strømforsyningen bremser."
msgstr "Effektgränsen är nådd, eller så bromsar nätaggregatet."

#: crates/rigg/src/pages/kontroller.rs:717
msgid "Temperaturmålet er nådd, eller maskinvaren klokker ned fordi kortet er for varmt."
msgstr "Temperaturmålet är nått, eller så klockar maskinvaran ned eftersom kortet är för varmt."

#: crates/rigg/src/pages/kontroller.rs:718
msgid "Utledet: ingen begrensning fra NVML mens kortet har last. Da står det på toppen av klokkekurven."
msgstr "Härlett: ingen begränsning från NVML medan kortet är belastat. Då ligger det på toppen av klockkurvan."

#: crates/rigg/src/pages/kontroller.rs:720
