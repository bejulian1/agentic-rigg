#: crates/rigg-hw/src/sys/process.rs:104
msgid "For stor /proc-fil"
msgstr "För stor /proc-fil"

#: crates/rigg-hw/src/sys/process.rs:114
msgid "Ugyldig prosessinformasjon"
msgstr "Ogiltig processinformation"

#: crates/rigg-hw/src/sys/process.rs:187
msgid "Ugyldig foreldrekjede for appen eller en tilkoblet klient"
msgstr "Ogiltig föräldrakedja för appen eller en ansluten klient"

#: crates/rigg-hw/src/sys/process.rs:196
msgid "Kunne ikke kontrollere foreldreprosesser for appen eller en tilkoblet klient"
msgstr "Det gick inte att kontrollera föräldraprocesserna för appen eller en ansluten klient"

#: crates/rigg-hw/src/sys/process.rs:202
msgid "Foreldrekjeden er for lang"
msgstr "Föräldrakedjan är för lång"

#: crates/rigg-hw/src/sys/process.rs:220
msgid "Systemets init-prosess er beskyttet"
msgstr "Systemets init-process är skyddad"

#: crates/rigg-hw/src/sys/process.rs:222
msgid "Appen eller en foreldreprosess er beskyttet"
msgstr "Appen eller en föräldraprocess är skyddad"

#: crates/rigg-hw/src/sys/process.rs:224
msgid "Viktig system- eller øktprosess er beskyttet"
msgstr "En viktig system- eller sessionsprocess är skyddad"

#: crates/rigg-hw/src/sys/process.rs:226
msgid "Prosessen er allerede avsluttet"
msgstr "Processen har redan avslutats"

#: crates/rigg-hw/src/sys/process.rs:228
msgid "Kjerneprosesser er beskyttet"
msgstr "Kärnprocesser är skyddade"

#: crates/rigg-hw/src/sys/process.rs:230 crates/rigg-hw/src/sys/process.rs:431
msgid "Avslutning krever en vanlig brukerøkt"
msgstr "Avslutning kräver en vanlig användarsession"

#: crates/rigg-hw/src/sys/process.rs:233
msgid "Root-prosesser er beskyttet"
msgstr "Root-processer är skyddade"

#: crates/rigg-hw/src/sys/process.rs:235
msgid "Prosessen tilhører en annen bruker eller har andre rettigheter"
msgstr "Processen tillhör en annan användare eller har andra rättigheter"

#: crates/rigg-hw/src/sys/process.rs:237
msgid "Prosessen har særskilte systemrettigheter"
msgstr "Processen har särskilda systemrättigheter"

#: crates/rigg-hw/src/sys/process.rs:242
msgid "Kan ikke kontrollere prosessens brukerrettigheter"
msgstr "Kan inte kontrollera processens användarrättigheter"

#: crates/rigg-hw/src/sys/process.rs:327
msgid "Prosesslisten er utilgjengelig"
msgstr "Processlistan är inte tillgänglig"

#: crates/rigg-hw/src/sys/process.rs:423
msgid "Avslutning er sperret for testdata"
msgstr "Avslutning är spärrad för testdata"

#: crates/rigg-hw/src/sys/process.rs:426
msgid "Ugyldig eller beskyttet prosess"
msgstr "Ogiltig eller skyddad process"

#: crates/rigg-hw/src/sys/process.rs:437
msgid "Kan ikke åpne sikker prosessreferanse: {feil}"
msgstr "Kan inte öppna en säker processreferens: {feil}"

#: crates/rigg-hw/src/sys/process.rs:445
msgid "Prosessen finnes ikke lenger eller kan ikke leses"
msgstr "Processen finns inte längre eller kan inte läsas"

#: crates/rigg-hw/src/sys/process.rs:447
msgid "Prosessen er erstattet. Oppdater listen og velg på nytt"
msgstr "Processen har ersatts. Uppdatera listan och välj igen"

#: crates/rigg-hw/src/sys/process.rs:456
msgid "Prosessen er erstattet eller avsluttet"
msgstr "Processen har ersatts eller avslutats"

#: crates/rigg-hw/src/sys/process.rs:468
msgid "Kunne ikke sende SIGTERM: {feil}"
msgstr "Det gick inte att skicka SIGTERM: {feil}"
