#: crates/rigg-core/src/specs.rs:163
msgid "Minneleverandøren (Samsung eller Micron) står i VBIOS-en. NVML oppgir den ikke, og VBIOS kan ikke leses uten root."
msgstr "メモリベンダー（Samsung または Micron）は VBIOS に記録されています。NVML では取得できず、VBIOS の読み取りには root 権限が必要です。"

#: crates/rigg-core/src/specs.rs:174
msgid "{rop} ROP × {mhz} MHz (referanse-boost) = {verdi} GPixel/s"
msgstr "{rop} ROP × {mhz} MHz（リファレンスブースト）= {verdi} GPixel/s"

#: crates/rigg-core/src/specs.rs:183
msgid "{tmu} TMU × {mhz} MHz (referanse-boost) = {verdi} GTexel/s"
msgstr "{tmu} TMU × {mhz} MHz（リファレンスブースト）= {verdi} GTexel/s"

#: crates/rigg-core/src/specs.rs:192
msgid "{cuda} CUDA-kjerner × 2 operasjoner (FMA) × {mhz} MHz = {verdi} TFLOPS"
msgstr "{cuda} CUDA コア × 2 演算（FMA）× {mhz} MHz = {verdi} TFLOPS"

#: crates/rigg-core/src/specs.rs:202
msgid "{bredde} bit ÷ 8 × {gbps} Gbps = {verdi} GB/s"
msgstr "{bredde} ビット ÷ 8 × {gbps} Gbps = {verdi} GB/s"
