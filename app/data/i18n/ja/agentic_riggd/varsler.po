#: crates/riggd/src/varsler.rs:89
msgid "{what} er {temperatur}"
msgstr "{what}: {temperatur}"

#: crates/riggd/src/varsler.rs:89
msgid "Over den røde grensen på {grense} siden {tid}."
msgstr "{tid} から危険しきい値 {grense} を超えています。"

#: crates/riggd/src/varsler.rs:121
msgid "Temperaturen på skjermkort {verdi}"
msgstr "GPU {verdi} の温度"

#: crates/riggd/src/varsler.rs:121
msgid "GPU-temperaturen"
msgstr "GPU 温度"

#: crates/riggd/src/varsler.rs:126
msgid "CPU-temperaturen"
msgstr "CPU 温度"

#: crates/riggd/src/varsler.rs:152
msgid "Skjermkortet svarer ikke"
msgstr "GPU が応答していません"

#: crates/riggd/src/varsler.rs:153
msgid "{kortnavn}Siden {tid}. Det skjer når kortet faller av bussen eller trekkes ut. Tallene før det er tatt vare på."
msgstr "{kortnavn}{tid} から応答していません。GPU がバスから切断されたか、取り外された可能性があります。以前の測定値は保持されています。"

#: crates/riggd/src/varsler.rs:156
msgid "Driveren er oppdatert"
msgstr "ドライバー更新済み"

#: crates/riggd/src/varsler.rs:157
msgid "Ny NVIDIA-driver ({ny}) er installert, men den gamle ({gammel}) kjører fortsatt. Start maskinen på nytt for å lese skjermkortet."
msgstr "新しい NVIDIA ドライバー（{ny}）がインストールされていますが、古いドライバー（{gammel}）がまだ動作中です。GPU を読み取るには再起動してください。"

#: crates/riggd/src/varsler.rs:159
msgid "ny"
msgstr "新版"

#: crates/riggd/src/varsler.rs:160
msgid "gammel"
msgstr "旧版"

#: crates/riggd/src/varsler.rs:163
msgid "Fant ingen NVIDIA-driver"
msgstr "NVIDIA ドライバーが見つかりません"

#: crates/riggd/src/varsler.rs:163
msgid "Prosessor, minne og sensorer vises som vanlig."
msgstr "プロセッサー、メモリ、センサーは通常どおり表示されます。"

#: crates/riggd/src/varsler.rs:164
msgid "Skjermkortet svarer igjen"
msgstr "GPU が再び応答しています"

#: crates/riggd/src/varsler.rs:164
msgid "{kortnavn}Det er funnet igjen og leses som før."
msgstr "{kortnavn}GPU を再検出し、監視を再開しました。"

#: crates/riggd/src/varsler.rs:200
msgid "Disken {name} feiler"
msgstr "ドライブ {name} に障害が発生しています"

#: crates/riggd/src/varsler.rs:200
msgid "{why}. Ta sikkerhetskopi av det som ligger på disken ({enhet})."
msgstr "{why}。このドライブ ({enhet}) のデータをバックアップしてください。"

#: crates/riggd/src/varsler.rs:207
msgid "Nye dårlige sektorer på {name}"
msgstr "{name} に新たな不良セクター"

#: crates/riggd/src/varsler.rs:208
msgid "{antall} dårlig sektor (var {b}). Ta sikkerhetskopi av det som ligger på disken ({enhet})."
msgid_plural "{antall} dårlige sektorer (var {b}). Ta sikkerhetskopi av det som ligger på disken ({enhet})."
msgstr[0] "不良セクターが {antall} 個あります（以前は {b} 個）。このドライブ ({enhet}) のデータをバックアップしてください。"

#: crates/riggd/src/varsler.rs:262
msgid "Åpne"
msgstr "開く"

#: crates/riggd/src/varsler.rs:284
msgid "Kunne ikke sende skrivebordsvarsel: {e}"
msgstr "デスクトップ通知を送信できませんでした: {e}"
