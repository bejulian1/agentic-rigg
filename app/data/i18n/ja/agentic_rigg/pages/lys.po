#: crates/rigg/src/pages/lys.rs:154
msgid "Skjermkort"
msgstr "グラフィックカード"

#: crates/rigg/src/pages/lys.rs:156
msgid "Ikke aktivert"
msgstr "未有効"

#: crates/rigg/src/pages/lys.rs:158
msgid "3D"
msgstr "3D"

#: crates/rigg/src/pages/lys.rs:158
msgid "2D"
msgstr "2D"

#: crates/rigg/src/pages/lys.rs:158
msgid "Visning"
msgstr "表示"

#: crates/rigg/src/pages/lys.rs:180
msgid "Dra for å vri · rull for zoom · 0 tilbakestiller"
msgstr "ドラッグで回転 · スクロールで拡大縮小 · 0 でリセット"

#: crates/rigg/src/pages/lys.rs:186
msgid "Bygger 3D-kortet …"
msgstr "3D カードを構築中 …"

#: crates/rigg/src/pages/lys.rs:224 crates/rigg/src/pages/lys.rs:230
msgid "Vinkel"
msgstr "角度"

#: crates/rigg/src/pages/lys.rs:226 crates/rigg/src/pages/lys.rs:227
msgid "Tilbakestill visningen"
msgstr "表示をリセット"

#: crates/rigg/src/pages/lys.rs:237 crates/rigg/src/pages/lys.rs:240
msgid "Lag"
msgstr "レイヤー"

#: crates/rigg/src/pages/lys.rs:248 crates/rigg/src/pages/lys.rs:253
msgid "Skill lagene"
msgstr "レイヤーを展開"

#: crates/rigg/src/pages/lys.rs:261 crates/rigg/src/pages/lys.rs:264
msgid "Bakgrunnslys"
msgstr "背景グロー"

#: crates/rigg/src/pages/lys.rs:291
msgid "Deler i 3D-modellen"
msgstr "3D モデルの部品"

#: crates/rigg/src/pages/lys.rs:526 crates/rigg/src/pages/lys.rs:544
msgid "Forhåndsvisning av valg"
msgstr "選択内容をプレビュー中"

#: crates/rigg/src/pages/lys.rs:528
msgid "Prøve på kortet"
msgstr "カードでテスト中"

#: crates/rigg/src/pages/lys.rs:530
msgid "Aktiv effekt"
msgstr "エフェクト動作中"

#: crates/rigg/src/pages/lys.rs:542
msgid "Speiler kortlyset"
msgstr "カードのライトと一致"

#: crates/rigg/src/pages/lys.rs:557
msgid "Utgangspunkt: {farge} · {styrke}"
msgstr "初期状態: {farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:559
msgid "Sist lest: {farge} · {styrke}"
msgstr "最終読み取り: {farge} · {styrke}"

#: crates/rigg/src/pages/lys.rs:733 crates/rigg/src/pages/lys.rs:953
msgid "Lys vises i 2D"
msgstr "2D 表示に切り替えました"

#: crates/rigg/src/pages/lys.rs:733
msgid "3D-kortet kunne ikke tegnes med grafikken her. Det flate kortet viser de samme lysvalgene."
msgstr "このグラフィックス環境では 3D カードを描画できませんでした。2D カードに同じライト設定を表示します。"

#: crates/rigg/src/pages/lys.rs:831
msgid "3D kan ikke tegnes her ({feil}). Klikk for å prøve igjen."
msgstr "ここでは 3D を描画できません ({feil})。クリックして再試行します。"

#: crates/rigg/src/pages/lys.rs:833
msgid "Grafikken tegnet 3D for tregt. Klikk for å prøve igjen."
msgstr "3D の描画が遅すぎます。クリックして再試行します。"

#: crates/rigg/src/pages/lys.rs:835
msgid "Kortet i 3D. Dra for å vri."
msgstr "カードの 3D 表示。ドラッグで回転できます。"

#: crates/rigg/src/pages/lys.rs:840
msgid "Flatt kort sett forfra. Bruker minst ressurser."
msgstr "正面からのフラット表示。最も負荷が低くなります。"

#: crates/rigg/src/pages/lys.rs:855
msgid "Stillbilde: grafikken tegner for tregt"
msgstr "静止画：グラフィックスの描画が遅すぎます"

#: crates/rigg/src/pages/lys.rs:857
msgid "Animasjon av"
msgstr "アニメーションオフ"

#: crates/rigg/src/pages/lys.rs:953
msgid "Grafikken tegnet 3D-kortet for tregt. Velg 3D over visningen for å prøve igjen."
msgstr "3D カードの描画が遅すぎました。表示上部の 3D を選ぶと再試行できます。"

#: crates/rigg/src/pages/lys.rs:1060
msgid "Kortlys er ikke aktivert."
msgstr "カードのライトは有効になっていません。"

#: crates/rigg/src/pages/lys.rs:1062
msgid "Lysene er av."
msgstr "ライトは消灯しています。"

#: crates/rigg/src/pages/lys.rs:1064
msgid "Lysstyrke {styrke}."
msgstr "明るさ {styrke}。"

#: crates/rigg/src/pages/lys.rs:1078
msgid "{lag} · lagene skilt"
msgstr "{lag} · レイヤー展開中"

#: crates/rigg/src/pages/lys.rs:1101
msgid "Flatt skjermkort sett forfra."
msgstr "正面から見たフラットなグラフィックカード。"

#: crates/rigg/src/pages/lys.rs:1117
msgid "Kortet har én fysisk lyssone."
msgstr "このカードには物理的なライトゾーンが 1 つだけあります。"
