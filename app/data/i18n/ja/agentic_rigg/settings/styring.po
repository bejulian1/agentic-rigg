#: crates/rigg/src/settings/styring.rs:54
msgid "Venter på administratorgodkjenning …"
msgstr "管理者の承認を待機中…"

#: crates/rigg/src/settings/styring.rs:55
msgid "Installerer systemkomponentene …"
msgstr "システムコンポーネントをインストールしています…"

#: crates/rigg/src/settings/styring.rs:56
msgid "Tjenesten svarer ikke. Endringer er låst."
msgstr "サービスが応答していません。設定は変更できません。"

#: crates/rigg/src/settings/styring.rs:59 crates/rigg/src/settings/styring.rs:65 crates/rigg/src/settings/styring.rs:148 crates/rigg/src/settings/styring.rs:229 crates/rigg/src/settings/styring.rs:376
msgid "Venter på enhet"
msgstr "デバイスを待機中"

#: crates/rigg/src/settings/styring.rs:60
msgid "Styring er klar for det valgte skjermkortet. Endringer brukes først når du trykker Bruk."
msgstr "選択したGPUを制御できます。「適用」をクリックするまで変更は反映されません。"

#: crates/rigg/src/settings/styring.rs:61
msgid "Simulert styring. Det ekte skjermkortet endres ikke."
msgstr "シミュレーション中です。実際のGPUは変更されません。"

#: crates/rigg/src/settings/styring.rs:62 crates/rigg/src/settings/styring.rs:64 crates/rigg/src/settings/styring.rs:231 crates/rigg/src/settings/styring.rs:402
msgid "Oppdater systemkomponenter"
msgstr "システムコンポーネントを更新"

#: crates/rigg/src/settings/styring.rs:63
msgid "Hjelperen er ikke klar for kortet som vises. Se funksjonsstøtten under, eller trykk Sjekk igjen."
msgstr "補助プログラムはこのGPUを制御できる状態ではありません。下の対応機能を確認するか、「再確認」をクリックしてください。"

#: crates/rigg/src/settings/styring.rs:66
msgid "Systemkomponentene mangler. Slå på bryteren for å installere dem og aktivere styring."
msgstr "システムコンポーネントがありません。スイッチをオンにすると、インストールして GPU の設定変更を有効にします。"

#: crates/rigg/src/settings/styring.rs:67
msgid "Systemkomponentene mangler eller må oppdateres."
msgstr "システムコンポーネントがないか、更新が必要です。"

#: crates/rigg/src/settings/styring.rs:68
msgid "Bare visning. Endring av skjermkortet er slått av."
msgstr "監視のみ。GPUの設定変更は無効です。"

#: crates/rigg/src/settings/styring.rs:77
msgid "agentic-rigg-helper {versjon} · bygg {bygg}"
msgstr "agentic-rigg-helper {versjon} · ビルド {bygg}"

#: crates/rigg/src/settings/styring.rs:80
msgid "Simulert kort"
msgstr "シミュレートされたGPU"

#: crates/rigg/src/settings/styring.rs:80
msgid "Det ekte kortet (NVML)"
msgstr "実際のGPU（NVML）"

#: crates/rigg/src/settings/styring.rs:116
msgid "Avbrutt"
msgstr "キャンセルしました"

#: crates/rigg/src/settings/styring.rs:116
msgid "Passordet ble ikke gitt. Ingenting er endret."
msgstr "パスワードが入力されなかったため、変更はありません。"

#: crates/rigg/src/settings/styring.rs:117
msgid "Fant ikke pkexec, eller ingen kan spørre om passordet (polkit)."
msgstr "pkexecが見つからないか、polkitでパスワードを要求できません。"

#: crates/rigg/src/settings/styring.rs:118
msgid "Skriptet feilet."
msgstr "スクリプトの実行に失敗しました。"

#: crates/rigg/src/settings/styring.rs:146 crates/rigg/src/settings/styring.rs:148
msgid "Skjermkortstyring er aktivert"
msgstr "GPUの設定変更を有効にしました"

#: crates/rigg/src/settings/styring.rs:146
msgid "Velg endringer og trykk Bruk. Behold dem innen fristen, ellers rulles de tilbake."
msgstr "設定を変更して「適用」をクリックしてください。制限時間内に「維持」をクリックしないと元に戻ります。"

#: crates/rigg/src/settings/styring.rs:150
msgid "Hjelperen er installert, men styring er ikke klar"
msgstr "補助プログラムはインストール済みですが、GPUを制御できません"

#: crates/rigg/src/settings/styring.rs:171
msgid "Ingen skjermkort valgt"
msgstr "GPUが選択されていません"

#: crates/rigg/src/settings/styring.rs:175
msgid "Kortidentiteten er ikke klar"
msgstr "GPUの識別情報を取得できません"

#: crates/rigg/src/settings/styring.rs:175
msgid "Vent til driveren har lest UUID, og prøv igjen."
msgstr "ドライバーがUUIDを読み取ってから、もう一度お試しください。"

#: crates/rigg/src/settings/styring.rs:195
msgid "Kunne ikke aktivere styring"
msgstr "GPUの設定変更を有効にできませんでした"

#: crates/rigg/src/settings/styring.rs:195
msgid "Kunne ikke slå av styring"
msgstr "GPUの設定変更を無効にできませんでした"

#: crates/rigg/src/settings/styring.rs:205
msgid "Skjermkortstyring er slått av"
msgstr "GPUの設定変更を無効にしました"

#: crates/rigg/src/settings/styring.rs:205
msgid "Tillatelsen er fjernet."
msgstr "権限を取り消しました。"

