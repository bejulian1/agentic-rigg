#!/usr/bin/python3 -IS
"""Installer bare navngitte systemfiler fra den kontrollerte pakkekopien."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
from contextlib import ExitStack, contextmanager
import re
import stat
import subprocess
import sys
import tarfile
import tempfile

LIB = Path('/usr/local/libexec')
SYSTEM = LIB / 'agentic-rigg-system'
NV = LIB / 'agentic-rigg'
RGB = LIB / 'agentic-rigg-rgb-v2'
POL = Path('/usr/share/polkit-1/actions')
ETC = Path('/etc/agentic-rigg')
UNITS = Path('/etc/systemd/system')
RUN = Path('/run/systemd/system')
STATE = Path('/var/lib')
GPU_INFO = Path('/proc/driver/nvidia/gpus')
GPU_UUID = r'GPU-[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}'
MARK = SYSTEM / 'revision'
# Bygget RGB-delen (RGB-mappa og RGB-policyen) faktisk ble installert fra.
# Skrives ved full installasjon. `--keep-rgb` lar RGB-delen og denne stå,
# så appen vurderer RGB etter de filene som faktisk kjører.
RGB_MARK = SYSTEM / 'rgb-revision'
SYSTEM_LOCK = '/run/agentic-rigg-system.lock'
LOCK_FD_ENV = 'AGENTIC_RIGG_SYSTEM_LOCK_FD'
MAX_ARCHIVE = 64 * 1024**2
DOMAINS = {'nvml': ('agentic-rigg-helper.service', 'helper.json', 'agentic-rigg', 'dirty.json'),
           'rgb': ('agentic-rigg-rgb.service', 'rgb.json', 'agentic-rigg-rgb', 'journal.json')}
ASSETS = {LIB / 'agentic-rigg-helper': ('bin/agentic-rigg-helper', 0o755),
          RGB / 'agentic-rigg-helper': ('bin/agentic-rigg-helper', 0o755)}
for directory, names in ((SYSTEM, ['system-install']), (NV, ['aktiver.sh', 'deaktiver.sh', 'nvml-admin.py', 'rgb-admin.py', 'agentic-rigg-helper.service']),
                         (RGB, ['rgb-admin.py', 'rgb-aktiver.sh', 'rgb-deaktiver.sh', 'rgb-avklar.sh',
                                'rgb-gjenopprett.sh', 'agentic-rigg-rgb.service']),
                         (POL, ['io.github.AgenticRigg.helper.policy', 'io.github.AgenticRigg.rgb.v2.policy'])):
    for name in names:
        ASSETS[directory / name] = ('data/hjelper/' + name, 0o755 if name.endswith('.sh') or name == 'system-install' else 0o644)


def directory(path):
    if path != Path('/'):
        directory(path.parent)
        path.mkdir(mode=0o755, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError(f'Utrygg systemmappe: {path}')


def put(path, data, mode):
    directory(path.parent)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as out:
        try:
            out.write(data)
            out.flush()
            os.fchmod(out.fileno(), mode)
            os.fsync(out.fileno())
            os.replace(out.name, path)
            sync_directory(path.parent)
        finally:
            Path(out.name).unlink(missing_ok=True)


def sync_directory(path):
    fd = os.open(path, os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def ctl(*args):
    return subprocess.check_output(['/usr/bin/systemctl', *args], text=True, timeout=60,
                                   env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'}).strip()


def stopped(unit):
    fields = dict(line.split('=', 1) for line in ctl('show', '--all', '--property=ActiveState,Job', unit).splitlines())
    return fields['ActiveState'] in ('inactive', 'failed') and fields['Job'] in ('', '0')


def active_files(domain):
    unit, config, state, journal = DOMAINS[domain]
    return [ETC / config, STATE / state / journal, UNITS / unit,
            (RUN if domain == 'rgb' else UNITS) / (unit + '.d') / ('50-agentic-rigg-card.conf' if domain == 'rgb' else 'gpu.conf')]


def remove_active(domain):
    config, _, unit, dropin = active_files(domain)
    if domain == 'nvml' and unit.exists():
        ctl('disable', unit.name)
    obsolete = UNITS / (unit.name + '.d/card.conf') if domain == 'rgb' else UNITS / 'multi-user.target.wants' / unit.name
    obsolete_run = [dropin.with_name('card.conf')] if domain == 'rgb' else []
    for path in (dropin, obsolete, *obsolete_run, unit, config):
        if path.parent.exists():
            directory(path.parent)
            path.unlink(missing_ok=True)
            sync_directory(path.parent)
    ctl('daemon-reload')


def require_card_absent(uuid):
    try:
        for gpu in GPU_INFO.iterdir():
            info = (gpu / 'information').read_text()
            fields = re.findall(r'^GPU UUID:([^\r\n]*)', info, re.MULTILINE)
            found = fields[0].strip() if len(fields) == 1 else ''
            if not re.fullmatch(GPU_UUID, found):
                raise ValueError(f'GPU-oversikten har ingen entydig, gyldig UUID for {gpu.name}. Arkivering avbrutt.')
            if found.lower() == uuid.lower():
                raise ValueError('Bundet kort finnes fortsatt. Bruk vanlig gjenoppretting.')
    except (OSError, UnicodeError) as error:
        raise ValueError(f'Kunne ikke kontrollere NVIDIA-driverens GPU-oversikt. Arkivering avbrutt: {error}') from error


def archive_state(domain, removed_uuid=None, *, revoke=False):
    config, journal, unit, _ = active_files(domain)
    if not stopped(unit.name):
        raise ValueError(f'Stopp først: sudo systemctl stop {unit.name}')
    state = journal.parent
    with ExitStack() as locked:
        if revoke and domain == 'rgb':
            directory(state.parent)
            state.mkdir(mode=0o700, exist_ok=True)
        if state.exists():
            directory(state)
            if domain == 'rgb':
                fd = os.open(state / 'worker.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
                locked.callback(os.close, fd)
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if removed_uuid is not None:
            directory(config.parent)
            receipt = state / 'arkivert-tillatelse.json'
            source = config if config.exists() else receipt
            fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, 'rb') as stream:
                info = os.fstat(stream.fileno())
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022 or info.st_nlink != 1:
                    raise ValueError('Utrygg fil for arkivbindingen.')
                raw = stream.read(16385)
            if len(raw) > 16384:
                raise ValueError('For stor arkivbinding.')
            auth = json.loads(raw)
            binding = auth.get('binding', auth)
            if binding['uuid'] != removed_uuid:
                raise ValueError(f"Bundet kort: {binding['pci']} {binding['uuid']}")
            if not re.fullmatch(r'[\da-fA-F]{4}:[\da-fA-F]{2}:[\da-fA-F]{2}\.[0-7]', binding['pci']):
                raise ValueError('Ugyldig arkivbinding.')
            require_card_absent(removed_uuid)
            if state.exists():
                put(receipt, raw, 0o600)
        elif os.path.lexists(journal) or (not revoke and config.exists()):
            raise ValueError(f'Slå av {domain}-tilgangen først. Tilstand og journal beholdes.')
        remove_active(domain)
        if state.exists() and not revoke:
            archive_dir = STATE / 'agentic-rigg-arkiv'
            directory(archive_dir)
            dest = Path(tempfile.mkdtemp(prefix=domain + '-', dir=archive_dir))
            state.rename(dest / 'tilstand')
            for parent in (dest, archive_dir, STATE):
                sync_directory(parent)
            print(f'Bevart i {dest}. Arkivering er ikke en bekreftet gjenoppretting.')
    if domain == 'rgb':
        put(STATE / 'agentic-rigg-rgb.inactive', b'Inaktiv\n', 0o644)
    if revoke:
        print('Tillatelsen er tilbakekalt. Grunnopptak og systemkomponenter beholdes.')


def approved_files(source, digest, staging='/var/tmp'):
    if not re.fullmatch('[a-fA-F0-9]{64}', digest):
        raise ValueError('Forventet en separat SHA-256 med 64 heksadesimale tegn.')
    with tempfile.TemporaryDirectory(dir=staging) as temp:
        copy = Path(temp) / 'release'
        fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, 'rb') as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode):
                raise ValueError('Pakkearkivet må være en regulær fil.')
            if info.st_size > MAX_ARCHIVE:
                raise ValueError('Pakkearkivet er større enn 64 MiB.')
            remaining = MAX_ARCHIVE
            with copy.open('xb') as out:
                while chunk := stream.read(min(1024**2, remaining + 1)):
                    remaining -= len(chunk)
                    if remaining < 0:
                        raise ValueError('Pakkearkivet er større enn 64 MiB.')
                    out.write(chunk)
        with copy.open('rb') as stream:
            if hashlib.file_digest(stream, 'sha256').hexdigest() != digest.lower():
                raise ValueError('Kontrollsummen stemmer ikke. Ingen systemfiler endret.')
        wanted = {'version.json', *(name for name, _ in ASSETS.values())}
        files = {}
        roots = set()
        with tarfile.open(copy, 'r:gz') as tar:
            for member in tar:
                root, _, key = member.name.partition('/')
                roots.add(root)
                if key not in wanted:
                    continue
                if key in files or not member.isfile() or member.size > MAX_ARCHIVE:
                    raise ValueError('Ugyldig pakkemedlem: ' + key)
                files[key] = tar.extractfile(member).read()
        if files.keys() != wanted or len(roots) != 1:
            raise ValueError('Ufullstendig eller tvetydig systempakke.')
        return files


def legacy():
    old = LIB / 'agentic-rigg-rgb'
    for path in (NV / 'trinn.sh', POL / 'io.github.AgenticRigg.rgb.policy', LIB / 'agentic-rigg-rgb-helper',
                 *(old / name for name in ('rgb-admin.py', 'rgb-aktiver.sh', 'rgb-avklar.sh', 'rgb-gjenopprett.sh', 'rgb-deaktiver.sh'))):
        if path.parent.exists():
            directory(path.parent)
            path.unlink(missing_ok=True)
    if old.is_dir() and not any(old.iterdir()):
        old.rmdir()


def trusted_file(path):
    directory(path.parent)
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022 or info.st_nlink != 1:
        raise ValueError(f'Utrygg systemfil: {path}')
    return path


def restore_nvml(template):
    binary = LIB / 'agentic-rigg-helper'
    command = [str(binary), '--backend', 'nvml', '--tilbakestill']
    try:
        trusted_file(binary)
        auth = json.loads(trusted_file(ETC / 'helper.json').read_text())
        pci = auth['pci']
        if not re.fullmatch(r'[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[01][0-9a-fA-F]\.[0-7]', pci):
            raise ValueError('Ugyldig PCI-binding.')
        info = (GPU_INFO / pci / 'information').read_text()
        fields = dict(line.split(':', 1) for line in info.splitlines() if ':' in line)
        minor = fields['Device Minor'].strip()
        if fields['GPU UUID'].strip() != auth['uuid'] or not re.fullmatch(r'[0-9]{1,4}', minor):
            raise ValueError('Driveren bekrefter ikke det bundne kortet.')
        service = template.decode().split('[Service]\n', 1)[1].split('\n[', 1)[0]
        skip = {'Type', 'ExecStart', 'ExecStopPost', 'Restart', 'RestartSec', 'TimeoutStopSec',
                'RuntimeDirectory', 'RuntimeDirectoryMode', 'StateDirectory', 'StateDirectoryMode'}
        props = [line for line in service.splitlines() if '=' in line and not line.startswith('#')
                 and line.partition('=')[0] not in skip]
        if ('DevicePolicy=closed' not in props or 'ProtectSystem=strict' not in props
                or [p for p in props if p.startswith('DeviceAllow=')] != ['DeviceAllow=/dev/nvidiactl rw']):
            raise ValueError('Ufullstendig enhetspolicy i NVML-malen.')
        props.extend((f'DeviceAllow=/dev/nvidia{minor} rw', 'ReadWritePaths=/var/lib/agentic-rigg', 'RuntimeMaxSec=45s'))
        argv = ['/usr/bin/systemd-run', '--wait', '--pipe', '--collect', '--quiet', '--service-type=exec',
                '--unit=agentic-rigg-nvml-restore', *('--property=' + p for p in props), '--', *command]
        result = subprocess.run(argv, text=True, capture_output=True, timeout=60, stdin=subprocess.DEVNULL,
                                env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'})
        if result.returncode:
            raise ValueError(f'systemd-run: {result.stderr.strip() or result.stdout.strip() or result.returncode}. '
                             'Kontroller systemd-egenskapene og journalen for agentic-rigg-nvml-restore.service.')
        if os.path.lexists(active_files('nvml')[1]):
            raise ValueError('Endringsjournalen finnes fortsatt.')
    except (OSError, KeyError, ValueError, TypeError, subprocess.SubprocessError) as error:
        raise ValueError(f'NVML-gjenoppretting er uavklart. Tillatelse og opptak beholdes. '
                         f'Sandkassekommando: {" ".join(command)}. {error}') from error


def rgb_asset(path):
    """Hører filen til RGB-delen (RGB-mappa eller RGB-policyen)?"""
    return path.parent == RGB or path == POL / 'io.github.AgenticRigg.rgb.v2.policy'


def nvml_asset(path):
    """Hører filen til GPU-delen (hjelperen, GPU-mappa eller GPU-policyen)?"""
    return path == LIB / 'agentic-rigg-helper' or path.parent == NV or path == POL / 'io.github.AgenticRigg.helper.policy'


def install(files, keep_rgb=False, keep_nvml=False):
    """Installer systemkomponentene.

    Med `keep_rgb` (GPU-bryteren) byttes bare GPU-delen og
    systeminstallasjonen: RGB-filene, tillatelsen, tjenesten og en eventuell
    uavklart journal blir stående nøyaktig som før. Er RGB-delen ufullstendig
    eller fra et ukjent bygg, stopper ikke det GPU-oppdateringen: RGB-delen
    står urørt og merkes med bygg 0 (`rgb-revision`), så appen krever en
    RGB-oppdatering før kortlyset brukes igjen.

    Med `keep_nvml` (RGB-lys, når GPU-delen allerede er fra nøyaktig denne
    utgivelsen) byttes bare RGB-delen og systeminstallasjonen. GPU-hjelperen
    stoppes ikke, så verdier brukeren har beholdt, står.
    """
    if keep_rgb and keep_nvml:
        raise ValueError('Bare én av delene kan beholdes.')
    build = json.loads(files['version.json'])['build']
    if type(build) is not int or not 0 < build <= 0xffffffff:
        raise ValueError('Ugyldig pakkebygg.')
    try:
        revision = MARK.read_text()
    except FileNotFoundError:
        revision = ''
    installed = re.fullmatch(r'2:([0-9]+)', revision.rstrip())
    if installed and int(installed[1]) > build:
        raise ValueError(f'Kan ikke nedgradere systemkomponentene fra bygg {installed[1]} til {build}.')
    if keep_nvml:
        # GPU-delen kan bare stå når den er fra nøyaktig denne utgivelsen og hel.
        if not installed or int(installed[1]) != build:
            raise ValueError('GPU-delen er fra et annet bygg og kan ikke beholdes. Ingen systemfiler endret.')
        try:
            for path in ASSETS:
                if nvml_asset(path):
                    trusted_file(path)
        except (OSError, ValueError) as error:
            raise ValueError(f'GPU-delen som skal beholdes, er ufullstendig. Ingen systemfiler endret. {error}') from error
    for path in ASSETS:
        directory(path.parent)
    # Også en eldre, uavklart installasjon skal ha den verifiserte,
    # rent administrative arkivveien uten å bytte en aktiv arbeider.
    recovery = SYSTEM / 'system-install'
    put(recovery, files[ASSETS[recovery][0]], 0o755)
    if keep_rgb:
        # Byggnummeret til RGB-delen som blir stående: den egne RGB-revisjonen
        # eller den felles. 0 betyr ukjent eller ufullstendig.
        rgb_build = 0
        try:
            for path in ASSETS:
                if rgb_asset(path):
                    trusted_file(path)
            rgb_revision = RGB_MARK.read_text() if RGB_MARK.exists() else revision
            known = re.fullmatch(r'2:([0-9]+)', rgb_revision.rstrip())
            rgb_build = int(known[1]) if known else 0
        except (OSError, ValueError):
            rgb_build = 0
        if rgb_build > build:
            raise ValueError(f'RGB-delen er fra et nyere bygg ({rgb_build}). Ingen systemfiler endret.')
    elif (ETC / 'rgb.json').exists() or not stopped(DOMAINS['rgb'][0]) or os.path.lexists(active_files('rgb')[1]):
        raise ValueError('Avklar og slå av eksisterende RGB-tilgang før installasjon.')
    if not keep_nvml:
        config, journal, unit, _ = active_files('nvml')
        if not stopped(unit.name):
            try:
                ctl('stop', unit.name)
            except subprocess.CalledProcessError:
                if not stopped(unit.name):
                    raise
        if not stopped(unit.name):
            raise ValueError('NVML-tjenesten er ikke stoppet. Tillatelse og opptak beholdes.')
        if os.path.lexists(journal):
            restore_nvml(files['data/hjelper/agentic-rigg-helper.service'])
        if not stopped(unit.name) or os.path.lexists(journal):
            raise ValueError('NVML-gjenoppretting er uavklart; tillatelse og opptak beholdes.')
    if keep_rgb:
        # Før den felles revisjonen endres: RGB-delen beholder sitt bygg.
        put(RGB_MARK, f'2:{rgb_build}\n'.encode(), 0o644)
    if not keep_nvml:
        MARK.unlink(missing_ok=True)
        remove_active('nvml')
    if not keep_rgb:
        remove_active('rgb')
    legacy()
    for path, (key, mode) in ASSETS.items():
        if not (keep_rgb and rgb_asset(path)) and not (keep_nvml and nvml_asset(path)):
            put(path, files[key], mode)
    if not keep_rgb:
        put(RGB_MARK, f'2:{build}\n'.encode(), 0o644)
    put(MARK, f'2:{build}\n'.encode(), 0o644)
    if keep_rgb:
        print('GPU-delen er installert. RGB-delen er urørt; avklar den på siden RGB-lys.')
    elif keep_nvml:
        print('RGB-delen er installert. GPU-hjelperen er urørt.')
    else:
        print('Systemkomponentene er installert. Aktiver ønsket tilgang separat i appen.')


def uninstall():
    for domain in DOMAINS:
        config, journal, unit, _ = active_files(domain)
        if config.exists() or os.path.lexists(journal) or not stopped(unit.name):
            raise ValueError('Avklar og slå av begge hjelpere før avinstallasjon.')
    for domain in DOMAINS:
        archive_state(domain)
    legacy()
    for path in (MARK, RGB_MARK, *ASSETS, STATE / 'agentic-rigg-rgb.inactive'):
        if path.parent.exists():
            directory(path.parent)
            path.unlink(missing_ok=True)
    for path in (NV, RGB, SYSTEM, ETC, *(base / (unit + '.d') for unit, *_ in DOMAINS.values() for base in (RUN, UNITS))):
        if path.is_dir() and not any(path.iterdir()):
            path.rmdir()
    print('Systemkomponentene er fjernet. Eventuelle arkiver er beholdt.')


@contextmanager
def system_lock(path=SYSTEM_LOCK):
    """Den felles administratorlåsen. system-hent.py holder den gjennom en hel
    oppdatering og gir den videre som et arvet filhåndtak (`LOCK_FD_ENV`);
    ellers tas den her."""
    raw = os.environ.get(LOCK_FD_ENV)
    if raw is not None:
        if not re.fullmatch(r'[3-9]|[1-9][0-9]{1,4}', raw, re.ASCII):
            raise ValueError('Ugyldig arvet systemlås.')
        fd = int(raw)
        held, named = os.fstat(fd), os.lstat(path)
        if (not stat.S_ISREG(held.st_mode) or held.st_uid != os.geteuid()
                or (held.st_dev, held.st_ino) != (named.st_dev, named.st_ino)):
            raise ValueError('Det arvede filhåndtaket er ikke systemlåsen.')
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError('En annen administratorhandling pågår. Vent og prøv igjen.') from None
        # Aldri LOCK_UN: låsen tilhører den som ga den videre.
        yield
        return
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, 'wb') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError('En annen administratorhandling pågår. Vent og prøv igjen.') from None
        yield


def main():
    parser = argparse.ArgumentParser(allow_abbrev=False)
    action = parser.add_mutually_exclusive_group()
    action.add_argument('--uninstall', action='store_true')
    action.add_argument('--archive-removed-card', choices=DOMAINS)
    action.add_argument('--revoke', choices=DOMAINS)
    keep = parser.add_mutually_exclusive_group()
    keep.add_argument('--keep-rgb', action='store_true')
    keep.add_argument('--keep-nvml', action='store_true')
    parser.add_argument('values', nargs='*')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('Systeminstallasjon krever administrator.')
    os.umask(0o022)
    if (args.keep_rgb or args.keep_nvml) and (args.uninstall or args.archive_removed_card or args.revoke):
        parser.error('--keep-rgb og --keep-nvml gjelder bare installasjon.')
    with system_lock():
        if args.uninstall and not args.values:
            uninstall()
        elif args.archive_removed_card and len(args.values) == 1:
            archive_state(args.archive_removed_card, args.values[0])
        elif args.revoke and not args.values:
            archive_state(args.revoke, revoke=True)
        elif not (args.uninstall or args.archive_removed_card or args.revoke) and len(args.values) == 2:
            install(approved_files(*args.values), keep_rgb=args.keep_rgb, keep_nvml=args.keep_nvml)
        else:
            parser.error('Forventet [--keep-rgb|--keep-nvml] ARKIV SHA256, --uninstall, --revoke DOMENE eller --archive-removed-card DOMENE UUID.')


if __name__ == '__main__':
    try:
        main()
    except BlockingIOError:
        sys.exit('En arbeider eller administratorhandling pågår. Vent og prøv igjen.')
    except (OSError, ValueError, KeyError, subprocess.SubprocessError, tarfile.TarError) as error:
        sys.exit(str(error))
