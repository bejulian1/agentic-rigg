# Agentic HW Monitor · kortbundet root-hjelper for GPU-styring.
# Legges i /etc/systemd/system/ av aktiver.sh (bryteren i Innstillinger ›
# Styring, via pkexec) og fjernes av deaktiver.sh. Se
# docs/produksjon/hjelper-sikkerhet.md.
#
# Hjelperen kjører som root med CAP_CHOWN for socketen og CAP_SYS_ADMIN for
# NVML. Systemet er skrivebeskyttet utenom egne tilstandsmapper; ingen
# hjemmemapper eller nett er tilgjengelige. Etter egne endringer forsøker
# ExecStopPost å gjenopprette de fangede grunnverdiene og krever tilbakelesing.

[Unit]
Description=Agentic HW Monitor – hjelper for endring av skjermkortet
ConditionPathExists=/etc/agentic-rigg/helper.json
ConditionPathExists=/run/systemd/system/agentic-rigg-helper.service.d/gpu.conf

[Service]
Type=notify
ExecStart=/usr/local/libexec/agentic-rigg-helper --backend nvml
ExecStopPost=/usr/local/libexec/agentic-rigg-helper --backend nvml --tilbakestill
Restart=no
RestartSec=2s
TimeoutStopSec=10s

# Socket: /run/agentic-rigg/helper.sock (0600, eies av brukeren i helper.json).
RuntimeDirectory=agentic-rigg
RuntimeDirectoryMode=0755
StateDirectory=agentic-rigg
StateDirectoryMode=0700
UMask=0077

# NVML krever administratorkapasitet; ingen shell eller vilkårlige kommandoer.
# CHOWN brukes bare til brukerens Unix-socket.
CapabilityBoundingSet=CAP_CHOWN CAP_SYS_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes

# Filsystemet: bare RuntimeDirectory og StateDirectory er skrivbare.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible

# Enheter: bare kontrollnoden og det bundne skjermkortet. Aldri I2C.
DevicePolicy=closed
DeviceAllow=/dev/nvidiactl rw
# aktiver.sh legger til kun den bundne /dev/nvidiaN i gpu.conf.

# Kjernen og resten av systemet.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @swap @reboot @raw-io @module @debug @cpu-emulation @obsolete
SystemCallFilter=fchown fchownat lchown chown
SystemCallErrorNumber=EPERM

# Liten og rolig.
MemoryMax=128M
TasksMax=32
