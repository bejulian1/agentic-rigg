/usr/bin/sudo /usr/bin/env -i PATH=/usr/bin:/bin /bin/bash -ceu 'umask 077; ulimit -f 1048576; tmp=$(mktemp -d /var/tmp/rigg.XXXXXXXX); trap '\''rm -rf -- "$tmp"'\'' EXIT; [[ $2 =~ ^[[:xdigit:]]{64}$ ]]; /usr/bin/python3 -I -S -c $'\''import os, stat, sys\nlimit = 64 * 1024**2\ntry:\n    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)\n    try:\n        info = os.fstat(fd)\n        if not stat.S_ISREG(info.st_mode):\n            sys.exit("Pakkearkivet må være en regulær fil.")\n        if info.st_size > limit:\n            sys.exit("Pakkearkivet er større enn 64 MiB.")\n        remaining = limit\n        with open(sys.argv[2], "xb") as out:\n            while remaining and (chunk := os.read(fd, min(1024**2, remaining))):\n                out.write(chunk)\n                remaining -= len(chunk)\n        if os.fstat(fd).st_size > limit:\n            sys.exit("Pakkearkivet er større enn 64 MiB.")\n    finally:\n        os.close(fd)\nexcept OSError as error:\n    sys.exit(f"Kunne ikke åpne eller kopiere pakkearkivet: {error}")'\'' "$1" "$tmp/release"; cd "$tmp"; printf "%s  release\n" "$2" | sha256sum --check --strict; member=$(tar -tzf release --quoting-style=escape --no-recursion --wildcards --no-wildcards-match-slash "*/data/hjelper/system-install"); [[ $member =~ ^[[:alnum:]_.-]+/data/hjelper/system-install$ ]] || { echo "Tvetydig systeminstallerer i pakken." >&2; exit 1; }; tar -xOzf release --no-recursion --no-wildcards -- "$member" > installer; /usr/bin/python3 -I -S installer release "$2"' rigg "$(printf 'Sti til pakkearkivet: ' >&2; IFS= read -r arkiv; printf %s "$arkiv")" "$(printf 'Godkjent SHA-256: ' >&2; IFS= read -r sum; printf %s "$sum")"
