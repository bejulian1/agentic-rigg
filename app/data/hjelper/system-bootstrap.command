/usr/bin/sudo /usr/bin/env -i PATH=/usr/bin:/bin /bin/bash -ceu 'umask 077; ulimit -f 1048576; tmp=$(mktemp -d /var/tmp/rigg.XXXXXXXX); trap '\''rm -rf -- "$tmp"'\'' EXIT; cp -- "$1" "$tmp/release"; cd "$tmp"; [[ $2 =~ ^[[:xdigit:]]{64}$ ]]; printf "%s  release\n" "$2" | sha256sum --check --strict; member=$(tar -tzf release --quoting-style=escape --no-recursion --wildcards --no-wildcards-match-slash "*/data/hjelper/system-install"); [[ $member =~ ^[[:alnum:]_.-]+/data/hjelper/system-install$ ]] || { echo "Tvetydig systeminstallerer i pakken." >&2; exit 1; }; tar -xOzf release --no-recursion --no-wildcards -- "$member" > installer; /usr/bin/python3 -I -S installer release "$2"' rigg "$(printf 'Sti til pakkearkivet: ' >&2; IFS= read -r arkiv; printf %s "$arkiv")" "$(printf 'Godkjent SHA-256: ' >&2; IFS= read -r sum; printf %s "$sum")"
