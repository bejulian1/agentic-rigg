# RGB er separat fra NVML-hjelperen. Ingen automatisk enable/ExecStopPost.
[Unit]
Description=Agentic HW Monitor – separat kortbundet RGB-hjelper
ConditionPathExists=/etc/agentic-rigg/rgb.json
ConditionPathExists=/run/systemd/system/agentic-rigg-rgb.service.d/50-agentic-rigg-card.conf

[Service]
Type=notify
TimeoutStartSec=20s
ExecStart=/usr/local/libexec/agentic-rigg-rgb-v2/agentic-rigg-helper --rgb-server
Restart=no
TimeoutStopSec=10s
RuntimeDirectory=agentic-rigg-rgb
RuntimeDirectoryMode=0755
StateDirectory=agentic-rigg-rgb
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
DevicePolicy=closed
# Bare ferskt identifisert /dev/i2c-N legges til i det flyktige korttillegget.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @swap @reboot @raw-io @module @debug @cpu-emulation @obsolete
SystemCallFilter=fchown fchownat lchown chown
SystemCallErrorNumber=EPERM
MemoryMax=96M
TasksMax=16
