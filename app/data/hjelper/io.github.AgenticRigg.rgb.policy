<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Agentic Rigg</vendor>
  <icon_name>io.github.AgenticRigg</icon_name>
  <action id="io.github.AgenticRigg.rgb.aktiver">
    <description>Gi Agentic Rigg tilgang til kortets RGB-lys</description>
    <message>Identifiser det valgte kortets lyskontroller og aktiver en separat RGB-hjelper. Utgangspunktet må være fast lys som du selv har bekreftet.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/agentic-rigg-rgb/rgb-aktiver.sh</annotate>
  </action>
  <action id="io.github.AgenticRigg.rgb.avklar">
    <description>Bekreft gjenopprettet RGB-utgangspunkt</description>
    <message>Les det lagrede utgangspunktet på nytt og registrer at du selv har sett det forventede faste lyset. Ingen farge skrives av avklaringen.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/agentic-rigg-rgb/rgb-avklar.sh</annotate>
  </action>
  <action id="io.github.AgenticRigg.rgb.gjenopprett">
    <description>Gjenopprett lagret RGB-utgangspunkt</description>
    <message>Skriv bare det tidligere lagrede statiske utgangspunktet til det samme identifiserte kortet. Etterpå må du selv kontrollere lyset.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/agentic-rigg-rgb/rgb-gjenopprett.sh</annotate>
  </action>
  <action id="io.github.AgenticRigg.rgb.deaktiver">
    <description>Slå av separat RGB-tilgang</description>
    <message>Fjern bare RGB-hjelperen etter avklart gjenoppretting. GPU-styringen av vifter, effekt og klokker beholdes.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/agentic-rigg-rgb/rgb-deaktiver.sh</annotate>
  </action>
</policyconfig>
